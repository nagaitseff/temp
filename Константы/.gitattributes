# 1C исходники и XML — храним как текст, нормализуем в LF
*.bsl text eol=lf
*.os  text eol=lf
*.xml text eol=lf
*.xsd text eol=lf
*.txt text eol=lf
*.htm text eol=lf
*.html text eol=lf

# Windows-скрипты — CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf
*.feature text eol=crlf

# Специальные файлы 1С
ParentConfigurations.bin text eol=lf
renames.txt text eol=lf

# Бинарники (не нормализовать, не диффить)
*.bin  binary
Form.bin binary
*.cfe  binary
*.epf  binary
*.erf  binary

# Картинки
*.png  binary
*.ico  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.bmp  binary
*.svg  binary

# Архивы
*.7z binary
*.gz binary
*.tar binary
*.tgz binary
*.zip binary

# Git LFS
*.cf filter=lfs diff=lfs merge=lfs -text
src/Ext/ParentConfigurations/*.cf filter=lfs diff=lfs merge=lfs -text