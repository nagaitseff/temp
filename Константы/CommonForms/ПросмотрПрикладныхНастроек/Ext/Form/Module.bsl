#Область ОписаниеПеременных

&НаКлиенте
Перем ИдентификаторСтрокиПоказанногоСписка;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Группы = Справочники.ГруппыПрикладныхНастроек.ИменаГруппОткрытыхНастроек();
	Элементы.Группа.СписокВыбора.ЗагрузитьЗначения(Группы);
	Если Группы.Количество() > 0 Тогда
		Группа = Группы[0];
	КонецЕсли;
	ОбновитьНастройкиГруппы();
	НастроитьОформление();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ГруппаПриИзменении(Элемент)
	ИдентификаторСтрокиПоказанногоСписка = Неопределено;
	ОбновитьНастройкиГруппы();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройки

&НаКлиенте
Процедура НастройкиПриАктивизацииСтроки(Элемент)

	ИдентификаторСтроки = Элемент.ТекущаяСтрока;
	Элементы.НастройкиПоказатьСписокЗначений.Доступность =
		СтрокиСписковЗначений.НайтиПоЗначению(ИдентификаторСтроки) <> Неопределено;
	Если ИдентификаторСтроки <> ИдентификаторСтрокиПоказанногоСписка Тогда
		СкрытьСоставСписка();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьСписокЗначений(Команда)

	СтрокаСписка = СтрокиСписковЗначений.НайтиПоЗначению(Элементы.Настройки.ТекущаяСтрока);
	Если СтрокаСписка = Неопределено Тогда
		СкрытьСоставСписка();
		Возврат;
	КонецЕсли;

	ТекстСписка = ТекстСоставаСписка(СтрокаСписка.Представление);
	Если ТекстСписка = Неопределено Тогда
		СкрытьСоставСписка();
		ОбновитьНастройкиГруппы();
		Возврат;
	КонецЕсли;

	ИдентификаторСтрокиПоказанногоСписка = СтрокаСписка.Значение;
	СоставСписка = ТекстСписка;
	Элементы.СоставСписка.Видимость = Истина;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СкрытьСоставСписка()

	ИдентификаторСтрокиПоказанногоСписка = Неопределено;
	СоставСписка = "";
	Элементы.СоставСписка.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Процедура ОбновитьНастройкиГруппы()

	СоставСписка = "";
	Элементы.СоставСписка.Видимость = Ложь;
	Элементы.НастройкиПоказатьСписокЗначений.Доступность = Ложь;
	СтрокиСписковЗначений.Очистить();
	Если ПустаяСтрока(Группа) Тогда
		Настройки.Очистить();
		Возврат;
	КонецЕсли;

	ТаблицаНастроек = Справочники.ГруппыПрикладныхНастроек.ОткрытыеНастройкиДляПросмотра(Группа);
	ЗначениеВРеквизитФормы(ТаблицаНастроек, "Настройки");
	Для ИндексСтроки = 0 По ТаблицаНастроек.Количество() - 1 Цикл
		СтрокаНастройки = ТаблицаНастроек[ИндексСтроки];
		Если СтрокаНастройки.ЭтоСписокЗначений Тогда
			ИдентификаторСтроки = Настройки[ИндексСтроки].ПолучитьИдентификатор();
			СтрокиСписковЗначений.Добавить(ИдентификаторСтроки, СтрокаНастройки.КлючНастройки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстСоставаСписка(Знач КлючНастройки)

	Список = Справочники.ГруппыПрикладныхНастроек.СписокЗначенийДляФормы(КлючНастройки);
	Если Список = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Представления = Новый Массив;
	Для Каждого ЭлементСписка Из Список Цикл
		Представления.Добавить(?(ПустаяСтрока(ЭлементСписка.Представление),
			Строка(ЭлементСписка.Значение), ЭлементСписка.Представление));
	КонецЦикла;

	Возврат ?(Представления.Количество() = 0, НСтр("ru = 'Пустой список'"),
		СтрСоединить(Представления, Символы.ПС));

КонецФункции

#КонецОбласти


&НаСервере
Процедура НастроитьОформление()
	ДобавитьЦветСтроки("Настройки.ТребуетсяПроверкаВызовов", Новый Цвет(210, 110, 0));
	ДобавитьЦветСтроки("Настройки.ПометкаУдаления", Новый Цвет(190, 0, 0));
КонецПроцедуры
&НаСервере
Процедура ДобавитьЦветСтроки(Знач Путь, Знач ЦветСтроки)
	Правило = УсловноеОформление.Элементы.Добавить();
	Правило.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветСтроки);
	Условие = Правило.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Путь);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	Условие.Использование = Истина;
	Поле = Правило.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("Настройки");
КонецПроцедуры
