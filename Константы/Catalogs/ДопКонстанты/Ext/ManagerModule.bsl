КонецФункции

Процедура УстановитьЗначениеКонстантыВГруппе(ГруппаКонстантОбъект, ИмяГруппы, ИмяКонстанты, Значение, 
											СоздаватьКонстантуПриОстутствии, 
											ДопускатьСменуТипаСуществующейКонстанты,
											КакХранилище, СтепеньСжатияХранилища) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	МожноПоместитьВЗначениеПоУмолчанию = ТипЗначения = Тип("Число")
										ИЛИ ТипЗначения = Тип("Дата")
										ИЛИ ТипЗначения = Тип("Булево")
										ИЛИ ПеременнаяСсылочногоТипа(Значение);
										
	ЗначениеЯвляетсяСтрокой = ТипЗначения = Тип("Строка");
	
	// Если то, что нам передали, не является ссылочным типом, числом, датой, логической переменной или строкой,
	// Будем сохранть как хранилище значения
	Если НЕ МожноПоместитьВЗначениеПоУмолчанию И НЕ ЗначениеЯвляетсяСтрокой Тогда
		КакХранилище = Истина;
	КонецЕсли;	 
	
	СтрокаГруппыКонстант = Неопределено;
	
	Для Каждого Стр Из ГруппаКонстантОбъект.ЗначенияКонстант Цикл
		Если Стр.ИмяКонстанты = ИмяКонстанты Тогда
			СтрокаГруппыКонстант = Стр;
			
			ТекущееЗначение = ПолучитьЗначениеКонстанты(ИмяГруппы+"."+ИмяКонстанты, ,Истина);
			Если ТипЗнч(ТекущееЗначение) <> ТипЗначения И НЕ ДопускатьСменуТипаСуществующейКонстанты Тогда
				ВызватьИсключение "Попытка присвоить переменной значение недопустимого типа";
			КонецЕсли;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаГруппыКонстант = Неопределено Тогда
		Если СоздаватьКонстантуПриОстутствии Тогда
			СтрокаГруппыКонстант = ГруппаКонстантОбъект.ЗначенияКонстант.Добавить();
		Иначе
			ВызватьИсключение "Не найдена константа: " + ИмяКонстанты + " В группе: " + ИмяГруппы;
		КонецЕсли;		
	КонецЕсли;
	
	СтрокаГруппыКонстант.ИмяКонстанты = ИмяКонстанты;
	
	Если СтрокаГруппыКонстант.ИмяКонстанты <> ИмяКонстанты Тогда
		ВызватьИсключение "Слишком длинное имя константы";
	КонецЕсли;
	
	Если КакХранилище Тогда
		
		Если ТипЗнч(Значение) <> Тип("ХранилищеЗначения") Тогда
			ХЗ = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(СтепеньСжатияХранилища));
		Иначе
		    ХЗ = Новый ХранилищеЗначения(Значение.Получить(), Новый СжатиеДанных(СтепеньСжатияХранилища));
		КонецЕсли;
			
		СтрокаГруппыКонстант.ЗначениеКонстантыХранилище = ХЗ;
		
		СтрокаГруппыКонстант.ЗначениеКонстанты 			= Неопределено;
		СтрокаГруппыКонстант.ЗначениеКонстантыСтрока 	= "";
		
	ИначеЕсли ЗначениеЯвляетсяСтрокой Тогда
		
		СтрокаГруппыКонстант.ЗначениеКонстантыСтрока = Значение;
		
		СтрокаГруппыКонстант.ЗначениеКонстанты 			= Неопределено;
		СтрокаГруппыКонстант.ЗначениеКонстантыХранилище = Новый ХранилищеЗначения(Неопределено);
		
	ИначеЕсли МожноПоместитьВЗначениеПоУмолчанию Тогда
		
		СтрокаГруппыКонстант.ЗначениеКонстанты = Значение;
		
		СтрокаГруппыКонстант.ЗначениеКонстантыХранилище = Новый ХранилищеЗначения(Неопределено);
		СтрокаГруппыКонстант.ЗначениеКонстантыСтрока 	= "";
		
	Иначе
		
		ВызватьИсключение "Что-то определенно пошло не так. Логически такого не должно быть.";
		
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область Тесты
Процедура ВыполнитьТесты() Экспорт
	
	МассивПростыхТестов = Новый Массив;
	СтруктураТестовИсключений = Новый Структура;
	
	// Запись
	МассивПростыхТестов.Добавить("ТестНаЗаписьКорректную");
	СтруктураТестовИсключений.Вставить("ТестНаЗаписьДублейГрупп", "Группа констант с наименованием Тест уже существует.");
	СтруктураТестовИсключений.Вставить("ТестНаЗаписьДублейВнутриГруппы", "В группе: Тест обнаружено более одной константы с именем: Тест1");
	СтруктураТестовИсключений.Вставить("ТестНаЗаписьНесколькихЗначенийЗначениеИСтрока", "Константе Тест.Тест1 установлено более одного значения.");
	СтруктураТестовИсключений.Вставить("ТестНаЗаписьНесколькихЗначенийЗначениеИХранилище", "Константе Тест.Тест1 установлено более одного значения.");
	СтруктураТестовИсключений.Вставить("ТестНаЗаписьНесколькихЗначенийЗначениеПустаяСсылкаИСтрока", "Константе Тест.Тест1 установлено более одного значения.");
	СтруктураТестовИсключений.Вставить("ТестНаЗаписьНесколькихЗначенийСтрокаИХранилище", "Константе Тест.Тест1 установлено более одного значения.");
	
	// API
	// Установка	
	МассивПростыхТестов.Добавить("ТестНаУстановкуЗначенияСуществующейКонстанты");
	МассивПростыхТестов.Добавить("ТестНаУстановкуЗначенияСсылочногоТипа");
	МассивПростыхТестов.Добавить("ТестНаУстановкуЗначенияСтроки");
	МассивПростыхТестов.Добавить("ТестНаУстановкуЗначенияХранилищаЗначения");
	МассивПростыхТестов.Добавить("ТестНаУстановкуЗначенияСтрокиКакХранилищаЗначения");
	
	СтруктураТестовИсключений.Вставить("ТестНаВалидациюПутиПриУстановкеЗначения_МногоТочек", "Неверный формат пути к константе: аа.бб.в");
	СтруктураТестовИсключений.Вставить("ТестНаВалидациюПутиПриУстановкеЗначения_МалоТочек", "Неверный формат пути к константе: аббв");
	СтруктураТестовИсключений.Вставить("ТестНаВалидациюПутиПриУстановкеЗначенияПроверкаДлиныИмениГруппы", "Слишком длинное имя группы констант");
	СтруктураТестовИсключений.Вставить("ТестНаВалидациюПутиПриУстановкеЗначенияПроверкаДлиныИмениКонстанты", "Слишком длинное имя константы");
	СтруктураТестовИсключений.Вставить("ТестНаОшибкуУстановкиЗначенияСуществующейКонстантыНетГруппы", "Не найдена группа констант: аа");
	СтруктураТестовИсключений.Вставить("ТестНаОшибкуУстановкиЗначенияСуществующейКонстантыНетКонстанты", "Не найдена константа: бб В группе: аа");
	
	МассивПростыхТестов.Добавить("ТестНаУстановкуНесуществующейКонстантыВСуществующейГруппе");
	МассивПростыхТестов.Добавить("ТестНаУстановкуНесуществующейКонстантыВНесуществующейГруппе");
	
	МассивПростыхТестов.Добавить("ТестНаКорректнуюУстановкуЗначенияНесовпадающегоТипа");
	СтруктураТестовИсключений.Вставить("ТестНаКонтрольУстановкиЗначенияНесовпадающегоТипа", "Попытка присвоить переменной значение недопустимого типа");
	МассивПростыхТестов.Добавить("ТестНаУстановкуСтепениСжатияХранилищаЗначения");
	// Получение
	МассивПростыхТестов.Добавить("ТестНаПолучениеЗначенияСуществующейКонстанты");
	
	СтруктураТестовИсключений.Вставить("ТестНаВалидациюПутиПриПолученииЗначения_МногоТочек", "Неверный формат пути к константе: Тест.Тест1.Тест2.Тест3");
	СтруктураТестовИсключений.Вставить("ТестНаВалидациюПутиПриПолученииЗначения_МалоТочек", "Неверный формат пути к константе: Все равны перед законом и судом");
	СтруктураТестовИсключений.Вставить("ТестНаКонтрольСуществованияПриПолученииЗначения", "Не найдена константа по пути: Точка.Точка");
	
	МассивПростыхТестов.Добавить("ТестНаОткрытиеХранилища");
	МассивПростыхТестов.Добавить("ТестНаНеоткрытиеХранилища");
	
	// Тесты текущего состония
	МассивПростыхТестов.Добавить("ТестНаСуществующиеДубли");
	
	ПроваленоТестов = 0;
	
	Для Каждого Тест Из МассивПростыхТестов Цикл
		
		НачатьТранзакцию();
		
		Попытка
			Выполнить(Тест + "()");
			Сообщить("Тест " + Тест + ": ОК");
		Исключение
			Сообщить("Тест " + Тест + ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
			ПроваленоТестов = ПроваленоТестов + 1;
		КонецПопытки;
		
		ОтменитьТранзакцию();
		
	КонецЦикла;
	
	Для Каждого КлючЗначение Из СтруктураТестовИсключений Цикл
		
		ИмяПроцедуры 		= КлючЗначение.Ключ;
		ТекстОписанияОшибки	= КлючЗначение.Значение;
		
		ОписаниеОшибки = "";
		
		НачатьТранзакцию();
		
		Попытка
			Выполнить(ИмяПроцедуры + "()");
		Исключение
			ОписаниеОшибки = ОписаниеОшибки();
		КонецПопытки;
		
		ОтменитьТранзакцию();
		
		Если ОписаниеОшибки = "" Тогда
			
			Сообщить("Тест " + ИмяПроцедуры + ": не вызвал исключения.", СтатусСообщения.ОченьВажное);
			ПроваленоТестов = ПроваленоТестов + 1;
			
		ИначеЕсли СтрНайти(ОписаниеОшибки, ТекстОписанияОшибки) = 0 Тогда
			
			Сообщить("Тест " + ИмяПроцедуры + ": " + ОписаниеОшибки, СтатусСообщения.ОченьВажное);
			ПроваленоТестов = ПроваленоТестов + 1;
			
		Иначе
			
			Сообщить("Тест " + ИмяПроцедуры + ": ОК");
			
