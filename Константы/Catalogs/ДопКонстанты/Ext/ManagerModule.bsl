Процедура ТестНаСуществующиеДубли()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДопКонстантыЗначенияКонстант.Ссылка.Наименование,
		|	ДопКонстантыЗначенияКонстант.ИмяКонстанты,
		|	СУММА(1) КАК Количество
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Справочник.ДопКонстанты.ЗначенияКонстант КАК ДопКонстантыЗначенияКонстант
		|
		|СГРУППИРОВАТЬ ПО
		|	ДопКонстантыЗначенияКонстант.Ссылка.Наименование,
		|	ДопКонстантыЗначенияКонстант.ИмяКонстанты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ.Наименование КАК ИмяГруппы,
		|	ВТ.ИмяКонстанты,
		|	ВТ.Количество
		|ИЗ
		|	ВТ КАК ВТ
		|ГДЕ
		|	ВТ.Количество > 1";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивПарДублей = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивПарДублей.Добавить("" + ВыборкаДетальныеЗаписи.ИмяГруппы + "." + ВыборкаДетальныеЗаписи.ИмяКонстанты);
	КонецЦикла;
	
	Если МассивПарДублей.Количество() > 0 Тогда
		
		ОписаниеОшибки = "Найдены задублированные имена констант: ";
		
		Для Каждого Имя Из МассивПарДублей Цикл
			
			ОписаниеОшибки = ОписаниеОшибки + Имя + ", ";
			
		КонецЦикла;
		
		ВызватьИсключение ОписаниеОшибки;
		
	КонецЕсли;
	
КонецПроцедуры

