Функция ПолучитьЗначениеКонстанты(ПутьККонстанте, КонтролироватьСуществование=Ложь, ОткрытьХранилище=Ложь) Экспорт
	
	МассивПодстрокПути = РазложитьСтрокуВМассивПодстрок(ПутьККонстанте, ".");
	
	Если МассивПодстрокПути.Количество() <> 2 Тогда
		ВызватьИсключение "Неверный формат пути к константе: " + ПутьККонстанте;
	КонецЕсли;
	
	ИмяГруппы = МассивПодстрокПути[0];
	ИмяКонстанты = МассивПодстрокПути[1];
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ДопКонстантыЗначенияКонстант.ЗначениеКонстанты КАК Значение,
		|	ДопКонстантыЗначенияКонстант.ЗначениеКонстантыСтрока КАК ЗначениеСтрока,
		|	ДопКонстантыЗначенияКонстант.ЗначениеКонстантыХранилище КАК ЗначениеХранилище
		|ИЗ
		|	Справочник.ДопКонстанты.ЗначенияКонстант КАК ДопКонстантыЗначенияКонстант
		|ГДЕ
		|	ДопКонстантыЗначенияКонстант.Ссылка.Наименование = &ИмяГруппы
		|	И ДопКонстантыЗначенияКонстант.ИмяКонстанты = &ИмяКонстанты";
	
	Запрос.УстановитьПараметр("ИмяГруппы", ИмяГруппы);
	Запрос.УстановитьПараметр("ИмяКонстанты", ИмяКонстанты);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.Значение <> Неопределено Тогда
			Возврат ВыборкаДетальныеЗаписи.Значение;		
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ЗначениеСтрока) Тогда
			Возврат ВыборкаДетальныеЗаписи.ЗначениеСтрока;
		ИначеЕсли ВыборкаДетальныеЗаписи.ЗначениеХранилище.Получить() <> Неопределено Тогда 
			Если ОткрытьХранилище Тогда
				Возврат ВыборкаДетальныеЗаписи.ЗначениеХранилище.Получить();
			Иначе
				Возврат ВыборкаДетальныеЗаписи.ЗначениеХранилище;
			КонецЕсли;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если КонтролироватьСуществование Тогда
		ВызватьИсключение "Не найдена константа по пути: " + ПутьККонстанте;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УстановитьЗначениеКонстанты(ПутьККонстанте, Значение, 
										СоздаватьГруппуПриОтсутствии=Ложь, СоздаватьКонстантуПриОстутствии=Ложь,
										ДопускатьСменуТипаСуществующейКонстанты=Ложь,
										КакХранилище=Ложь, СтепеньСжатияХранилища=0) Экспорт
	
	МассивПодстрокПути = РазложитьСтрокуВМассивПодстрок(ПутьККонстанте, ".");
	
	Если МассивПодстрокПути.Количество() <> 2 Тогда
		ВызватьИсключение "Неверный формат пути к константе: " + ПутьККонстанте;
	КонецЕсли;
	
	ИмяГруппы = МассивПодстрокПути[0];
	ИмяКонстанты = МассивПодстрокПути[1];
	
	ГруппаКонстант = Справочники.ДопКонстанты.НайтиПоНаименованию(ИмяГруппы, Истина);
	
	Если ГруппаКонстант.Пустая() Тогда
		Если СоздаватьГруппуПриОтсутствии Тогда
			ГруппаКонстантОбъект = СоздатьЭлемент();
			ГруппаКонстантОбъект.Наименование = ИмяГруппы;
			
			Если ГруппаКонстантОбъект.Наименование <> ИмяГруппы Тогда
				ВызватьИсключение "Слишком длинное имя группы констант";
			КонецЕсли;
			
		Иначе
			ВызватьИсключение "Не найдена группа констант: " + ИмяГруппы;
		КонецЕсли;
	Иначе
		ГруппаКонстантОбъект = ГруппаКонстант.ПолучитьОбъект();
	КонецЕсли;
	
	Если СоздаватьГруппуПриОтсутствии Тогда
		СоздаватьКонстантуПриОстутствии = Истина;
	КонецЕсли;
	
	УстановитьЗначениеКонстантыВГруппе(ГруппаКонстантОбъект, ИмяГруппы, ИмяКонстанты, Значение, 
									СоздаватьКонстантуПриОстутствии, 
									ДопускатьСменуТипаСуществующейКонстанты,
									КакХранилище, СтепеньСжатияХранилища);		
	
	ГруппаКонстантОбъект.Записать();
	
КонецПроцедуры
