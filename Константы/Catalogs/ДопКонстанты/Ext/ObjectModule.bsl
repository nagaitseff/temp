
Процедура ПередЗаписью(Отказ)
	
	ГруппаКонстантСТемЖеИменем = Справочники.ДопКонстанты.НайтиПоНаименованию(Наименование, Истина);
	
	Если НЕ ГруппаКонстантСТемЖеИменем.Пустая() И НЕ ГруппаКонстантСТемЖеИменем.Ссылка = Ссылка Тогда
		ВызватьИсключение "Группа констант с наименованием " + Наименование + " уже существует.";
	КонецЕсли;
	
	Для Каждого Стр Из ЗначенияКонстант Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИмяКонстанты", Стр.ИмяКонстанты);
		НайденныеСтроки = ЗначенияКонстант.НайтиСтроки(ПараметрыОтбора); 
		
		Если НайденныеСтроки.Количество() > 1 Тогда
			ВызватьИсключение "В группе: " + Наименование + " обнаружено более одной константы с именем: " + Стр.ИмяКонстанты;
		КонецЕсли;
		
		КоличествоЗаполненныхЗначений = (Стр.ЗначениеКонстанты <> Неопределено) + ЗначениеЗаполнено(Стр.ЗначениеКонстантыСтрока) + (Стр.ЗначениеКонстантыХранилище.Получить() <> Неопределено);
		
		Если КоличествоЗаполненныхЗначений > 1 Тогда
			ВызватьИсключение "Константе " + Наименование + "." + Стр.ИмяКонстанты + " установлено более одного значения.";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры
