
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьОтображениеЗначений();	
КонецПроцедуры


&НаСервере
Процедура ОбновитьОтображениеЗначений()
	
	РеальныйОбъект = РеквизитФормыВЗначение("Объект");
	СтрокиСХранилищами = Новый Массив;
	Для Каждого Стр Из РеальныйОбъект.ЗначенияКонстант Цикл
		Если Стр.ЗначениеКонстантыХранилище.Получить() <> Неопределено Тогда
			СтрокиСХранилищами.Добавить(Стр.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Стр Из Объект.ЗначенияКонстант Цикл
		Если СтрокиСХранилищами.Найти(Стр.НомерСтроки) <> Неопределено Тогда
			Стр.Значение = "ХранилищеЗначения";
		ИначеЕсли Стр.ЗначениеКонстанты <> Неопределено Тогда
			Стр.Значение = Строка(Стр.ЗначениеКонстанты);
		Иначе
			Стр.Значение = Стр.ЗначениеКонстантыСтрока;
		КонецЕсли;
		
		Стр.ПолноеИмяКонстанты = "" + Объект.Наименование + "." + Стр.ИмяКонстанты;
		
		Стр.НовоеЗначение = "Установить новое";
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияКонстантПриИзменении(Элемент)
	ОбновитьОтображениеЗначений();
КонецПроцедуры

&НаКлиенте
Процедура СменитьНаименование(Команда)
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаСменаНаименования", ЭтаФорма, Параметры);
	ПоказатьВопрос(Оповещение, "Вы уверены, что хотите изменить наименование группы констант?", Режим, 0); 

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаСменаНаименования(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	Подсказка = "Введите новое наименование";
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтрокиСменаНаименования", ЭтаФорма, Параметры);
	ПоказатьВводСтроки(Оповещение, "", Подсказка, 50, Ложь); 

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтрокиСменаНаименования(Строка, Параметры) Экспорт
	Если НЕ Строка = Неопределено И Строка <> ""  Тогда
		Если Объект.Наименование <> Строка Тогда
			Объект.Наименование = Строка;
			Попытка
				Записать();
			Исключение
				Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
			КонецПопытки;
			Прочитать();
		КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКонстанту(Команда)
	
	Подсказка = "Введите имя новой константы";
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтрокиВводИмениНовойКонстанты", ЭтаФорма, Параметры);
	ПоказатьВводСтроки(Оповещение, "", Подсказка, 200, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтрокиВводИмениНовойКонстанты(Строка, Параметры) Экспорт
    Если НЕ Строка = Неопределено И Строка <> "" Тогда
        Объект.ЗначенияКонстант.Добавить().ИмяКонстанты = Строка;
		Попытка
			Записать();
		Исключение
			Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		КонецПопытки;
		Прочитать();
	КонецЕсли;
	
	ОбновитьОтображениеЗначений();	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьКонстанту(Команда)
	
	ТекДанные = Элементы.ЗначенияКонстант.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
	
		Режим = РежимДиалогаВопрос.ДаНет;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаУдалениеКонстанты", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, "Вы уверены, что хотите удалить константу " + ТекДанные.ПолноеИмяКонстанты + "?", Режим, 0);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаУдалениеКонстанты(Результат, Параметры) Экспорт
    Если Результат = КодВозвратаДиалога.Нет Тогда
        Возврат;
	КонецЕсли;
	
	НомерСтроки = Элементы.ЗначенияКонстант.ТекущиеДанные.НомерСтроки;
	Объект.ЗначенияКонстант.Удалить(НомерСтроки-1);
	Попытка
		Записать();
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
	КонецПопытки;
	Прочитать();

КонецПроцедуры

&НаКлиенте
Процедура ЗначенияКонстантВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ЗначенияКонстантНовоеЗначение" Тогда
		
		ПолноеИмя 		= Объект.Наименование + "." + Элемент.ТекущиеДанные.ИмяКонстанты;
		
		ТекущееЗначение = Неопределено;
		Если Элемент.ТекущиеДанные.Значение = "ХранилищеЗначения" Тогда
			ТекущееЗначение = "ХранилищеЗначения";
		ИначеЕсли Элемент.ТекущиеДанные.ЗначениеКонстанты <> Неопределено Тогда
			ТекущееЗначение = Элемент.ТекущиеДанные.ЗначениеКонстанты;
		Иначе
			ТекущееЗначение = Элемент.ТекущиеДанные.ЗначениеКонстантыСтрока;
		КонецЕсли;
		
		ПараметрыДляПередачи = Новый Структура("ИмяКонстанты,ТекущееЗначение,ПолноеИмя", Элемент.ТекущиеДанные.ИмяКонстанты, ТекущееЗначение, ПолноеИмя);
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияФормыВыбораНовогоЗначения", ЭтаФорма, ПараметрыДляПередачи); 
		
		ОткрытьФорму("Справочник.ДопКонстанты.Форма.ФормаВыбораЗначения", ПараметрыДляПередачи, ЭтаФорма, ЭтаФорма,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс); 
		
	ИначеЕсли Поле.Имя = "ЗначенияКонстантСкрывать" Тогда
		
		Элемент.ТекущиеДанные.Скрывать = НЕ Элемент.ТекущиеДанные.Скрывать;
		
		Попытка
			Записать();
		Исключение
			Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
		КонецПопытки;
		Прочитать();
		ОбновитьОтображениеЗначений();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыВыбораНовогоЗначения(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда Возврат КонецЕсли;
	
	УстановитьЗначениеКонстантыНаСервере(Параметры.ИмяКонстанты, Результат);
	
	ОбновитьОтображениеЗначений();

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеКонстантыНаСервере(ИмяКонстанты, НовоеЗначение)
	
	РеальныйОбъект = РеквизитФормыВЗначение("Объект");
	
	Справочники.ДопКонстанты.УстановитьЗначениеКонстантыВГруппе(РеальныйОбъект, Объект.Наименование, ИмяКонстанты, НовоеЗначение, Ложь, Истина, Ложь, 0);
	
	Попытка
		РеальныйОбъект.Записать();
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
	КонецПопытки;
	Прочитать();
	
КонецПроцедуры


&НаКлиенте
Процедура ЗначенияКонстантСкрыватьПриИзменении(Элемент)
	
	Модифицированность = Ложь;
		
	Попытка
		Записать();
	Исключение
		Сообщить(ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
	КонецПопытки;
	Прочитать();
	ОбновитьОтображениеЗначений();
	Модифицированность = Ложь;
КонецПроцедуры

