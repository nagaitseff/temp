
&НаСервереБезКонтекста
Процедура ВыполнитьТестыНаСервере()
	
	Справочники.ДопКонстанты.ВыполнитьТесты();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТесты(Команда)
	ВыполнитьТестыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовуюГруппуКонстант(Команда)
	
	Подсказка = "Введите имя новой группы констант";
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтрокиВводИмениНовойГруппыКонстант", ЭтаФорма, Неопределено);
	ПоказатьВводСтроки(Оповещение, "", Подсказка, 50, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтрокиВводИмениНовойГруппыКонстант(Строка, Параметры) Экспорт
    Если НЕ Строка = Неопределено И Строка <> "" Тогда
        
		ПоказатьЗначение(,ЗаписатНовуюГруппуКонстант(Строка));
		ОбновитьИнтерфейс();
		
    КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаписатНовуюГруппуКонстант(ИмяНовойГруппыКонстант)
	
	НоваяГруппаОбъект = Справочники.ДопКонстанты.СоздатьЭлемент();
	НоваяГруппаОбъект.Наименование = ИмяНовойГруппыКонстант;
	НоваяГруппаОбъект.Записать();
	
	Возврат НоваяГруппаОбъект.Ссылка;
	
КонецФункции