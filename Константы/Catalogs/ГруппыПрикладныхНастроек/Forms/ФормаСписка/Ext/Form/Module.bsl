#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьГруппу(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВводаИмениГруппы", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, "", НСтр("ru = 'Введите имя группы настроек'"), 50);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТесты(Команда)

	Попытка
		ВыполнитьТестыНаСервере();
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обрабатывает завершение ввода имени группы.
//
// Параметры:
//  ИмяГруппы - Строка, Неопределено - введенное имя или результат отмены ввода.
//  ДополнительныеПараметры - Неопределено - дополнительный контекст оповещения.
//
&НаКлиенте
Процедура ПослеВводаИмениГруппы(ИмяГруппы, ДополнительныеПараметры) Экспорт

	Если ИмяГруппы = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СсылкаГруппы = СоздатьГруппуНаСервере(ИмяГруппы);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Элементы.Список.Обновить();
	Элементы.Список.ТекущаяСтрока = СсылкаГруппы;
	ОткрытьФорму("Справочник.ГруппыПрикладныхНастроек.ФормаОбъекта",
		Новый Структура("Ключ", СсылкаГруппы), ЭтотОбъект);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СоздатьГруппуНаСервере(Знач ИмяГруппы)

	Группа = Справочники.ГруппыПрикладныхНастроек.СоздатьЭлемент();
	Группа.Наименование = ИмяГруппы;
	Группа.Записать();

	Возврат Группа.Ссылка;

КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьТестыНаСервере()
	Справочники.ГруппыПрикладныхНастроек.ВыполнитьТесты();
КонецПроцедуры

#КонецОбласти
