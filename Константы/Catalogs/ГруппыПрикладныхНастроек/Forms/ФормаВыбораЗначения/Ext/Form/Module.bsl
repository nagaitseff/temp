#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПолноеИмя = Параметры.ПолноеИмя;
	АвтоЗаголовок = Ложь;
	Заголовок = "Настройка «" + ПолноеИмя + "»";
	Параметры.Свойство("ПредыдущийКлюч", ПредыдущийКлюч);
	Элементы.ПредыдущийКлюч.Видимость = Не ПустаяСтрока(ПредыдущийКлюч);
	Параметры.Свойство("Описание", Описание);
	Параметры.Свойство("Автор", Автор);
	Параметры.Свойство("НавигационнаяСсылка", НавигационнаяСсылка);
	ТекущееЗначение = Параметры.ТекущееЗначение;

	ЗагрузитьСписок = Ложь;
	Если Параметры.Свойство("ЗагрузитьСписок", ЗагрузитьСписок) И ЗагрузитьСписок Тогда
		ЗагрузитьСписокДляРедактирования();
	КонецЕсли;

	ОбновитьВидимостьРедакторов(Элементы, ИспользоватьСписокЗначений);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИспользоватьСписокЗначенийПриИзменении(Элемент)
	ОбновитьВидимостьРедакторов(Элементы, ИспользоватьСписокЗначений);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьЗначениеНастройки(Команда)

	Если Не РеквизитыНастройкиЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	Если ИспользоватьСписокЗначений Тогда
		Закрыть(РезультатРедактирования(ЗначенияСписка, Истина));
	Иначе
		Закрыть(РезультатРедактирования(НовоеЗначение, НовоеЗначение <> Неопределено));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗначение(Команда)
	Если РеквизитыНастройкиЗаполнены() Тогда
		Закрыть(РезультатРедактирования(Неопределено, Истина));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРедактирование(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьСписокДляРедактирования()

	Адрес = "";
	Если Параметры.Свойство("АдресЗначения", Адрес) Тогда
		СохраненныйСписок = ПолучитьИзВременногоХранилища(Адрес);
	Иначе
		СохраненныйСписок = Справочники.ГруппыПрикладныхНастроек.СписокЗначенийДляФормы(ПолноеИмя);
	КонецЕсли;
	Если СохраненныйСписок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипыЗначений = ЗначенияСписка.ТипЗначения;
	Для Каждого ЭлементСписка Из СохраненныйСписок Цикл
		Если ЭлементСписка.Значение <> Неопределено
			И Не ТипыЗначений.СодержитТип(ТипЗнч(ЭлементСписка.Значение)) Тогда
			ТекущееЗначение = НСтр("ru = 'Список содержит сложные значения. Его состав доступен из серверного кода.'");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ЗначенияСписка = СохраненныйСписок;
	ИспользоватьСписокЗначений = Истина;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьРедакторов(ЭлементыФормы, Знач ИспользоватьСписок)
	ЭлементыФормы.Значение.Видимость = Не ИспользоватьСписок;
	ЭлементыФормы.СписокЗначенийНастройки.Видимость = ИспользоватьСписок;
КонецПроцедуры

&НаКлиенте
Функция РеквизитыНастройкиЗаполнены()
	Если ПустаяСтрока(Описание) Или ПустаяСтрока(Автор) Или ПустаяСтрока(НавигационнаяСсылка) Тогда
		ПоказатьПредупреждение(, "Заполните описание, автора и навигационную ссылку.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Функция РезультатРедактирования(Знач Значение, Знач ИзменитьЗначение)
	Возврат Новый Структура("Значение,ИзменитьЗначение,Описание,Автор,НавигационнаяСсылка",
		Значение, ИзменитьЗначение, Описание, Автор, НавигационнаяСсылка);
КонецФункции

#КонецОбласти
