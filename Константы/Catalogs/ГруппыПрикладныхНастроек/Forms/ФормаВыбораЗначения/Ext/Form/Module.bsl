#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПолноеИмя = Параметры.ПолноеИмя;
	ТекущееЗначение = Параметры.ТекущееЗначение;

	ЗагрузитьСписок = Ложь;
	Если Параметры.Свойство("ЗагрузитьСписок", ЗагрузитьСписок) И ЗагрузитьСписок Тогда
		ЗагрузитьСписокДляРедактирования();
	КонецЕсли;

	ОбновитьВидимостьРедакторов(Элементы, ИспользоватьСписокЗначений);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьСписокЗначенийПриИзменении(Элемент)
	ОбновитьВидимостьРедакторов(Элементы, ИспользоватьСписокЗначений);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьЗначениеНастройки(Команда)

	Если ИспользоватьСписокЗначений Тогда
		Закрыть(Новый Структура("Значение", ЗначенияСписка));
		Возврат;
	КонецЕсли;

	Если НовоеЗначение = Неопределено Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите новое значение или нажмите «Очистить значение».'"));
		Возврат;
	КонецЕсли;

	Закрыть(Новый Структура("Значение", НовоеЗначение));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗначение(Команда)
	Закрыть(Новый Структура("Значение", Неопределено));
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРедактирование(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьСписокДляРедактирования()

	СохраненныйСписок = Справочники.ГруппыПрикладныхНастроек.СписокЗначенийДляФормы(ПолноеИмя);
	Если СохраненныйСписок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипыЗначений = ЗначенияСписка.ТипЗначения;
	Для Каждого ЭлементСписка Из СохраненныйСписок Цикл
		Если ЭлементСписка.Значение <> Неопределено
			И Не ТипыЗначений.СодержитТип(ТипЗнч(ЭлементСписка.Значение)) Тогда
			ТекущееЗначение = НСтр("ru = 'Список содержит сложные значения. Его состав доступен из серверного кода.'");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ЗначенияСписка = СохраненныйСписок;
	ИспользоватьСписокЗначений = Истина;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьРедакторов(ЭлементыФормы, Знач ИспользоватьСписок)
	ЭлементыФормы.Значение.Видимость = Не ИспользоватьСписок;
	ЭлементыФормы.СписокЗначенийНастройки.Видимость = ИспользоватьСписок;
КонецПроцедуры

#КонецОбласти
