#Область СлужебныеПроцедурыИФункции

#Область ПервоначальноеЗаполнение

Функция СоздатьНедостающиеНастройкиГруппы(Знач ИмяГруппы, Знач НачальныеНастройки)

	Если ТипЗнч(ИмяГруппы) <> Тип("Строка") Или Не ИмяНастройкиДопустимо(ИмяГруппы) Тогда
		ВызватьИсключение НСтр("ru = 'Имя группы должно быть непустой строкой без точки.'");
	КонецЕсли;
	МетаСправочник = Метаданные.Справочники.ГруппыПрикладныхНастроек;
	Если СтрДлина(ИмяГруппы) > МетаСправочник.ДлинаНаименования Тогда
		ВызватьИсключение НСтр("ru = 'Превышена допустимая длина имени группы настроек.'");
	КонецЕсли;
	ПроверитьТипНачальныхНастроек(НачальныеНастройки);
	Если НачальныеНастройки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	РеквизитыНастроек = МетаСправочник.ТабличныеЧасти.ЗначенияКонстант.Реквизиты;
	ДлинаИмени = РеквизитыНастроек.ИмяКонстанты.Тип.КвалификаторыСтроки.Длина;
	ПроверитьНачальныеИменаНастроек(НачальныеНастройки, ИмяГруппы, ДлинаИмени);

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьГруппуНастроек(ИмяГруппы);
		СостояниеГруппы = СсылкаИИменаНастроекГруппы(ИмяГруппы);
		НовыеНастройки = Новый Массив;
		Для Каждого Настройка Из НачальныеНастройки Цикл
			Если СостояниеГруппы.Имена.Получить(ИмяДляСравнения(Настройка.Ключ)) = Неопределено Тогда
				НовыеНастройки.Добавить(Настройка);
			КонецЕсли;
		КонецЦикла;

		Если НовыеНастройки.Количество() > 0 Тогда
			ЗаписатьНачальныеНастройкиГруппы(ИмяГруппы, СостояниеГруппы.Ссылка, НовыеНастройки,
				РеквизитыНастроек.ЗначениеКонстанты.Тип);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат НовыеНастройки.Количество();

КонецФункции

Процедура ПроверитьТипНачальныхНастроек(Знач КоллекцияНастроек)

	ТипКоллекции = ТипЗнч(КоллекцияНастроек);
	Если ТипКоллекции <> Тип("Структура") И ТипКоллекции <> Тип("ФиксированнаяСтруктура")
		И ТипКоллекции <> Тип("Соответствие") И ТипКоллекции <> Тип("ФиксированноеСоответствие") Тогда
		ВызватьИсключение НСтр("ru = 'Начальные настройки передаются в структуре или соответствии.'");
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьНачальныеИменаНастроек(Знач НачальныеНастройки, Знач ИмяГруппы, Знач ДлинаИмени)

	Имена = Новый Соответствие;
	Для Каждого Настройка Из НачальныеНастройки Цикл
		ПроверитьИмяНастройкиДляЗаписи(Настройка.Ключ, ДлинаИмени);
		КлючИмени = ИмяДляСравнения(Настройка.Ключ);
		Если Имена.Получить(КлючИмени) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'В начальных настройках группы «%1» повторяется имя «%2».'"),
				ИмяГруппы, Настройка.Ключ);
		КонецЕсли;
		Имена.Вставить(КлючИмени, Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьИмяНастройкиДляЗаписи(Знач ИмяНастройки, Знач ДлинаИмени)

	Если ТипЗнч(ИмяНастройки) <> Тип("Строка") Или Не ИмяНастройкиДопустимо(ИмяНастройки) Тогда
		ВызватьИсключение НСтр("ru = 'Имя настройки должно быть непустой строкой без точки.'");
	КонецЕсли;
	Если СтрДлина(ИмяНастройки) > ДлинаИмени Тогда
		ВызватьИсключение НСтр("ru = 'Превышена допустимая длина имени настройки.'");
	КонецЕсли;

КонецПроцедуры

Функция СсылкаИИменаНастроекГруппы(Знач ИмяГруппы)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Группы.Ссылка КАК СсылкаГруппы,
		|	Настройки.ИмяКонстанты КАК ИмяНастройки
		|ИЗ
		|	Справочник.ГруппыПрикладныхНастроек КАК Группы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Настройки
		|		ПО Группы.Ссылка = Настройки.Ссылка
		|ГДЕ
		|	Группы.Наименование = &ИмяГруппы");
	Запрос.УстановитьПараметр("ИмяГруппы", ИмяГруппы);

	СсылкаГруппы = ПустаяСсылка();
	ИменаНастроек = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если СсылкаГруппы.Пустая() Тогда
			СсылкаГруппы = Выборка.СсылкаГруппы;
		ИначеЕсли СсылкаГруппы <> Выборка.СсылкаГруппы Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Найдено несколько групп настроек с именем «%1».'"), ИмяГруппы);
		КонецЕсли;

		Если Выборка.ИмяНастройки <> Null Тогда
			ИменаНастроек.Вставить(ИмяДляСравнения(Выборка.ИмяНастройки), Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("Ссылка, Имена", СсылкаГруппы, ИменаНастроек);

КонецФункции

Процедура ЗаписатьНачальныеНастройкиГруппы(Знач ИмяГруппы, Знач СсылкаГруппы, Знач НовыеНастройки,
		Знач ТипПростогоЗначения)

	Если СсылкаГруппы.Пустая() Тогда
		Группа = СоздатьЭлемент();
		Группа.Наименование = ИмяГруппы;
	Иначе
		Группа = СсылкаГруппы.ПолучитьОбъект();
	КонецЕсли;

	Для Каждого Настройка Из НовыеНастройки Цикл
		СтрокаНастройки = Группа.ЗначенияКонстант.Добавить();
		СтрокаНастройки.ИмяКонстанты = Настройка.Ключ;
		Если ТипЗнч(Настройка.Значение) = Тип("ХранилищеЗначения") Тогда
			СтрокаНастройки.ЗначениеКонстантыХранилище = Настройка.Значение;
		Иначе
			ПоляЗначения = ПоляДляЗаписиЗначения(Настройка.Значение, ТипПростогоЗначения, Ложь, 0);
			ЗаполнитьПоляЗначенияНастройки(СтрокаНастройки, ПоляЗначения);
		КонецЕсли;
	КонецЦикла;
	Группа.Записать();

КонецПроцедуры

#КонецОбласти

Процедура ЗаполнитьПоляЗначенияНастройки(СтрокаНастройки, ПоляЗначения)
	СтрокаНастройки.ЗначениеКонстанты = ПоляЗначения.ПростоеЗначение;
	СтрокаНастройки.ЗначениеКонстантыСтрока = ПоляЗначения.СтроковоеЗначение;
	СтрокаНастройки.ЗначениеКонстантыХранилище = ПоляЗначения.Хранилище;
КонецПроцедуры

Функция ЧастиПутиКНастройке(Знач ПутьКНастройке)

	Если ТипЗнч(ПутьКНастройке) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Путь к настройке должен быть строкой в формате «Группа.Имя».'");
	КонецЕсли;

	ЧастиПути = СтрРазделить(ПутьКНастройке, ".", Истина);
	Если ЧастиПути.Количество() <> 2 Или ПустаяСтрока(ЧастиПути[0]) Или ПустаяСтрока(ЧастиПути[1]) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Недопустимый путь «%1». Укажите путь в формате «Группа.Имя».'"),
			ПутьКНастройке);
	КонецЕсли;

	Возврат ЧастиПути;

КонецФункции

Функция ВыборкаНастроек(Знач ИмяГруппы, Знач ИмяНастройки = Неопределено, Знач ТолькоОткрытыеЗначения = Ложь)

	ОграниченноеЧтение = ЧтениеТолькоОткрытыхНастроек();
	Если ИмяНастройки = Неопределено Тогда
		ЗаголовокЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ";
	Иначе
		ЗаголовокЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2";
	КонецЕсли;

	Запрос = Новый Запрос(ЗаголовокЗапроса + "
		|	Настройки.ИмяКонстанты КАК ИмяКонстанты,
		|	Настройки.ЗначениеКонстанты КАК ЗначениеКонстанты,
		|	Настройки.ЗначениеКонстантыСтрока КАК ЗначениеКонстантыСтрока,
		|	Настройки.ЗначениеКонстантыХранилище КАК ЗначениеКонстантыХранилище,
		|	Настройки.Скрывать КАК Скрывать
		|ИЗ
		|	Справочник.ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Настройки
		|ГДЕ
		|	Настройки.Ссылка.Наименование = &ИмяГруппы");
	Запрос.УстановитьПараметр("ИмяГруппы", ИмяГруппы);

	Если ИмяНастройки <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Настройки.ИмяКонстанты = &ИмяНастройки";
		Запрос.УстановитьПараметр("ИмяНастройки", ИмяНастройки);
	КонецЕсли;

	Если ТолькоОткрытыеЗначения Или ОграниченноеЧтение Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Настройки.Скрывать = ЛОЖЬ";
	КонецЕсли;

	Возврат ВыполнитьЗапросЧтенияНастроек(Запрос, ОграниченноеЧтение).Выбрать();

КонецФункции

Функция ЧтениеТолькоОткрытыхНастроек()

	Если ПривилегированныйРежим()
		Или ПравоДоступа("Чтение", Метаданные.Справочники.ГруппыПрикладныхНастроек) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Не РольДоступна("ЧтениеПрикладныхНастроек") Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для чтения прикладных настроек.'");
	КонецЕсли;

	Возврат Истина;

КонецФункции

Функция ВыполнитьЗапросЧтенияНастроек(Запрос, Знач ОграниченноеЧтение)

	Если Не ОграниченноеЧтение Тогда
		Возврат Запрос.Выполнить();
	КонецЕсли;

	// Роль чтения получает только запросы с условием Скрывать = ЛОЖЬ.
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = Запрос.Выполнить();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;

КонецФункции

Функция ЗначениеСтрокиНастройки(СтрокаНастройки, Знач ОткрытьХранилище = Ложь,
		СодержимоеХранилища = Неопределено)

	СодержимоеХранилища = Неопределено;
	Если СтрокаНастройки.ЗначениеКонстанты <> Неопределено Тогда
		Возврат СтрокаНастройки.ЗначениеКонстанты;
	КонецЕсли;

	Если СтрДлина(СтрокаНастройки.ЗначениеКонстантыСтрока) > 0 Тогда
		Возврат СтрокаНастройки.ЗначениеКонстантыСтрока;
	КонецЕсли;

	Хранилище = СтрокаНастройки.ЗначениеКонстантыХранилище;
	СодержимоеХранилища = Хранилище.Получить();
	Если ОткрытьХранилище Или СодержимоеХранилища = Неопределено Тогда
		Возврат СодержимоеХранилища;
	КонецЕсли;

	Возврат Хранилище;

КонецФункции

Функция СтрокаНастройкиПоИмени(НастройкиГруппы, Знач ИмяНастройки)

	СтрокаПоИмени = НастройкиГруппы.Найти(ИмяНастройки, "ИмяКонстанты");
	Если СтрокаПоИмени <> Неопределено Тогда
		Возврат СтрокаПоИмени;
	КонецЕсли;

	КлючПоиска = ИмяДляСравнения(ИмяНастройки);
	Для Каждого СтрокаНастройки Из НастройкиГруппы Цикл
		Если ИмяДляСравнения(СтрокаНастройки.ИмяКонстанты) = КлючПоиска Тогда
			Возврат СтрокаНастройки;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПоляДляЗаписиЗначения(Знач Значение, ТипПростогоЗначения, Знач КакХранилище, Знач СтепеньСжатия)

	Результат = Новый Структура("ПростоеЗначение, СтроковоеЗначение, Хранилище", Неопределено, "");
	Если Значение = Неопределено Тогда
		Результат.Хранилище = Новый ХранилищеЗначения(Неопределено);
	ИначеЕсли Не КакХранилище И ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > 0 Тогда
		Результат.СтроковоеЗначение = Значение;
		Результат.Хранилище = Новый ХранилищеЗначения(Неопределено);
	ИначеЕсли Не КакХранилище И ТипПростогоЗначения.СодержитТип(ТипЗнч(Значение))
		И ТипПростогоЗначения.ПривестиЗначение(Значение) = Значение Тогда

		Результат.ПростоеЗначение = Значение;
		Результат.Хранилище = Новый ХранилищеЗначения(Неопределено);
	Иначе
		// Пустая строка и числа вне точности реквизита сохраняются в хранилище без потери значения.
		ДопустимаяСтепеньСжатия = ТипЗнч(СтепеньСжатия) = Тип("Число")
			И СтепеньСжатия >= 0 И СтепеньСжатия <= 9;
		Если Не ДопустимаяСтепеньСжатия Или СтепеньСжатия <> Цел(СтепеньСжатия) Тогда
			ВызватьИсключение НСтр("ru = 'Степень сжатия должна быть целым числом от 0 до 9.'");
		КонецЕсли;
		Результат.Хранилище = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(СтепеньСжатия));
	КонецЕсли;

	Возврат Результат;

КонецФункции

#Область Тесты

Процедура ПроверитьЧтениеИЗаписьНастроек(Знач ИмяГруппы)

	Путь = ИмяГруппы + ".Признак";
	УстановитьЗначениеНастройки(Путь, Истина, Истина);
	УстановитьЗначениеНастройки(Путь, Ложь);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), Ложь, "Логическое значение");

	Путь = ИмяГруппы + ".Число";
	УстановитьЗначениеНастройки(Путь, 0, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), 0, "Нулевое значение");

	ТочноеЧисло = 1.123456789;
	УстановитьЗначениеНастройки(Путь, ТочноеЧисло);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина, Истина), ТочноеЧисло, "Точность числа");

	Путь = ИмяГруппы + ".Ссылка";
	ПустаяСсылка = Справочники.ГруппыПрикладныхНастроек.ПустаяСсылка();
	УстановитьЗначениеНастройки(Путь, ПустаяСсылка, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), ПустаяСсылка, "Пустая ссылка");

	СсылкаГруппы = НайтиПоНаименованию(ИмяГруппы, Истина);
	УстановитьЗначениеНастройки(Путь, СсылкаГруппы);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), СсылкаГруппы, "Ссылка");

	Путь = ИмяГруппы + ".Строка";
	ДлиннаяСтрока = "Первая строка" + Символы.ПС + "Следующая строка";
	Для Счетчик = 1 По 8 Цикл
		ДлиннаяСтрока = СтрШаблон("%1%2%1", ДлиннаяСтрока, Счетчик);
	КонецЦикла;
	УстановитьЗначениеНастройки(Путь, ДлиннаяСтрока, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), ДлиннаяСтрока, "Длинная строка");

	УстановитьЗначениеНастройки(Путь, "   ");
	ПроверитьРавенство(СтрДлина(ЗначениеНастройки(Путь, Истина)), 3, "Строка из пробелов");
	УстановитьЗначениеНастройки(Путь, "");
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина, Истина), "", "Пустая строка");

	Путь = ИмяГруппы + ".Состав";
	УстановитьЗначениеНастройки(Путь, Новый Структура("Количество", 1), , Истина, , , 5);
	УстановитьЗначениеНастройки(Путь, Новый ХранилищеЗначения(Новый Структура("Количество", 2)), , , , , 7);
	ПроверитьРавенство(ТипЗнч(ЗначениеНастройки(Путь, Истина)), Тип("ХранилищеЗначения"),
		"Чтение хранилища");
	Состав = ЗначениеНастройки(Путь, Истина, Истина);
	ПроверитьРавенство(Состав.Количество, 2, "Извлечение содержимого хранилища");

	Путь = ИмяГруппы + ".Заполняемая";
	УстановитьЗначениеНастройки(Путь, Неопределено, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), Неопределено, "Настройка без значения");
	УстановитьЗначениеНастройки(Путь, "Первое значение");
	УстановитьЗначениеНастройки(Путь, 10, , , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), 10, "Разрешенная смена типа");

	ПроверитьСохранениеСпискаЗначений(ИмяГруппы);

	ЗначенияГруппы = ЗначенияНастроекГруппы(ИмяГруппы, Истина);
	ПроверитьРавенство(ЗначенияГруппы.Количество(), 7, "Число настроек при групповом чтении");
	ПроверитьРавенство(ЗначенияГруппы.Получить("Признак"), Ложь, "Групповое чтение");
	ПроверитьРавенство(ЗначениеНастройки(ИмяГруппы + ".Отсутствующая"), Неопределено,
		"Чтение отсутствующей настройки");
	ПроверитьПереименованиеГруппы(СсылкаГруппы, ИмяГруппы, ЗначенияГруппы.Количество());

КонецПроцедуры

Процедура ПроверитьСохранениеСпискаЗначений(Знач ИмяГруппы)

	ИмяНастройки = "Список";
	Путь = ИмяГруппы + "." + ИмяНастройки;
	Список = Новый СписокЗначений;
	Список.Добавить("Первое значение");
	Список.Добавить(Ложь);
	Список.Добавить(0);
	УстановитьЗначениеНастройки(Путь, Список, , Истина);

	СохраненныйСписок = ЗначениеНастройки(Путь, Истина, Истина);
	ПроверитьРавенство(ТипЗнч(СохраненныйСписок), Тип("СписокЗначений"), "Тип сохраненного списка");
	Значения = СохраненныйСписок.ВыгрузитьЗначения();
	ПроверитьРавенство(Значения.Количество(), 3, "Число элементов списка");
	ПроверитьРавенство(Значения[0], "Первое значение", "Порядок элементов списка");
	ПроверитьРавенство(Значения[1], Ложь, "Логическое значение в списке");
	ПроверитьРавенство(Значения[2], 0, "Ноль в списке");
	СписокДляФормы = СписокЗначенийДляФормы(Путь);
	ПроверитьРавенство(СписокДляФормы.Количество(), 3, "Загрузка списка в редактор");

	УстановитьЗначениеНастройки(Путь, Новый СписокЗначений);
	СохраненныйСписок = ЗначениеНастройки(Путь, Истина, Истина);
	ПроверитьРавенство(СохраненныйСписок.Количество(), 0, "Сохранение пустого списка");

	Группа = НайтиПоНаименованию(ИмяГруппы, Истина).ПолучитьОбъект();
	СтрокаНастройки = СтрокаНастройкиПоИмени(Группа.ЗначенияКонстант, ИмяНастройки);
	ЭтоСписокЗначений = Ложь;
	ЗначениеНастройкиДляФормы(СтрокаНастройки, ЭтоСписокЗначений);
	ПроверитьРавенство(ЭтоСписокЗначений, Истина, "Представление пустого списка");

	СтрокаНастройки.Скрывать = Истина;
	Группа.Записать();
	ПроверитьРавенство(ЗначениеНастройкиДляФормы(СтрокаНастройки, ЭтоСписокЗначений), "**",
		"Представление скрытого списка");
	ПроверитьРавенство(ЭтоСписокЗначений, Ложь, "Признак скрытого списка");
	ПроверитьРавенство(СписокЗначенийДляФормы(Путь), Неопределено, "Загрузка скрытого списка");

КонецПроцедуры

Процедура ПроверитьПакетноеСозданиеНастроек(Знач ИмяГруппы)

	НачальныеЗначения = Новый Структура("РазмерПакета, Пустое, Признак", 100, Неопределено, Ложь);
	НастройкиПоГруппам = Новый Соответствие;
	НастройкиПоГруппам.Вставить(ИмяГруппы, НачальныеЗначения);
	ПроверитьРавенство(СоздатьНедостающиеНастройки(НастройкиПоГруппам), 3, "Первоначальное заполнение группы");

	УстановитьЗначениеНастройки(ИмяГруппы + ".РазмерПакета", 0);
	НовыеЗначения = Новый Соответствие;
	НовыеЗначения.Вставить("размерпакета", 200);
	НовыеЗначения.Вставить("Пустое", "Значение по умолчанию");
	НовыеЗначения.Вставить("Признак", Истина);
	НовыеЗначения.Вставить("Список", Новый СписокЗначений);
	НовыеЗначения.Вставить("Значение в хранилище", Новый ХранилищеЗначения("Текст"));
	НастройкиПоГруппам.Вставить(ИмяГруппы, НовыеЗначения);

	ПроверитьРавенство(СоздатьНедостающиеНастройки(НастройкиПоГруппам), 2, "Добавление недостающих настроек");
	ПроверитьРавенство(СоздатьНедостающиеНастройки(НастройкиПоГруппам), 0, "Повторное заполнение группы");
	ЗначенияГруппы = ЗначенияНастроекГруппы(ИмяГруппы, Истина);
	ПроверитьРавенство(ЗначенияГруппы.Получить("РазмерПакета"), 0, "Сохранение пользовательского нуля");
	ПроверитьРавенство(ЗначенияГруппы.Получить("Пустое"), Неопределено, "Сохранение пустой настройки");
	ПроверитьРавенство(ЗначенияГруппы.Получить("Признак"), Ложь, "Сохранение пользовательского признака");
	ПроверитьРавенство(ЗначенияГруппы.Получить("Список").Количество(), 0, "Пакетное создание пустого списка");
	ПроверитьРавенство(ЗначенияГруппы.Получить("Значение в хранилище"), "Текст", "Пакетная запись хранилища");

КонецПроцедуры

Процедура ПроверитьПереименованиеГруппы(СсылкаГруппы, Знач СтароеИмя, Знач ЧислоНастроек)

	НовоеИмя = "ТестИмени_" + Прав(СтароеИмя, 36);
	Группа = СсылкаГруппы.ПолучитьОбъект();
	Группа.Наименование = НовоеИмя;
	Группа.Записать();

	ПроверитьРавенство(НайтиПоНаименованию(НовоеИмя, Истина), СсылкаГруппы, "Ссылка на переименованную группу");
	ПроверитьРавенство(ЗначенияНастроекГруппы(НовоеИмя).Количество(), ЧислоНастроек,
		"Количество настроек после переименования");
	ПроверитьРавенство(ЗначениеНастройки(НовоеИмя + ".Признак", Истина), Ложь,
		"Чтение настройки по новому ключу");
	ПроверитьРавенство(ЗначенияНастроекГруппы(СтароеИмя).Количество(), 0,
		"Чтение настроек по прежнему имени группы");

КонецПроцедуры

Процедура ПроверитьОграниченияЗаписи(Знач ИмяГруппы)

	Для Каждого Проверка Из СтрРазделить("Группа,Ключ,Поля,Тип,Путь,Отсутствие", ",") Цикл
		НачатьТранзакцию();
		Попытка
			ПроверитьОтказОперации(ИмяГруппы, Проверка);
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		ОтменитьТранзакцию();
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОтказОперации(Знач ИмяГруппы, Знач Проверка)

	Группа = СоздатьЭлемент();
	Группа.Наименование = ИмяГруппы;
	СтрокаНастройки = Группа.ЗначенияКонстант.Добавить();
	СтрокаНастройки.ИмяКонстанты = "Настройка";
	СтрокаНастройки.ЗначениеКонстанты = Ложь;

	Если Проверка = "Группа" Тогда
		Группа.Записать();
		Группа = СоздатьЭлемент();
		Группа.Наименование = ИмяГруппы;
		ОжидаемыйТекст = "уже существует";
	ИначеЕсли Проверка = "Ключ" Тогда
		Группа.ЗначенияКонстант.Добавить().ИмяКонстанты = "настройка";
		ОжидаемыйТекст = "уже есть в группе";
	ИначеЕсли Проверка = "Поля" Тогда
		СтрокаНастройки.ЗначениеКонстантыХранилище = Новый ХранилищеЗначения("Другое значение");
		ОжидаемыйТекст = "заполнено несколько полей значения";
	ИначеЕсли Проверка = "Тип" Тогда
		Группа.Записать();
		ОжидаемыйТекст = "запрещено изменение типа";
	ИначеЕсли Проверка = "Путь" Тогда
		ОжидаемыйТекст = "Недопустимый путь";
	Иначе
		ОжидаемыйТекст = "не найдена";
	КонецЕсли;

	ТекстОшибки = "";
	Попытка
		Если Проверка = "Тип" Тогда
			УстановитьЗначениеНастройки(ИмяГруппы + ".Настройка", "Другой тип");
		ИначеЕсли Проверка = "Путь" Тогда
			ЗначениеНастройки(ИмяГруппы + ".");
		ИначеЕсли Проверка = "Отсутствие" Тогда
			ЗначениеНастройки(ИмяГруппы + ".Отсутствующая", Истина);
		Иначе
			Группа.Записать();
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Если СтрНайти(ТекстОшибки, ОжидаемыйТекст) = 0 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Проверка «%1» не пройдена. Ожидалась ошибка «%2». Результат: %3.'"),
			Проверка, ОжидаемыйТекст, ?(ПустаяСтрока(ТекстОшибки), НСтр("ru = 'операция выполнена'"), ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРавенство(Знач Получено, Знач Ожидалось, Знач НазваниеПроверки)

	Если ТипЗнч(Получено) <> ТипЗнч(Ожидалось) Или Получено <> Ожидалось Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Проверка «%1» не пройдена. Ожидалось «%2», получено «%3».'"),
			НазваниеПроверки, Ожидалось, Получено);
	КонецЕсли;

КонецПроцедуры

