#Область ПрограммныйИнтерфейс

// Возвращает значение настройки по пути «Группа.Имя».
//
// Параметры:
//  ПутьКНастройке - Строка - наименование группы и имя настройки, разделенные одной точкой.
//  КонтролироватьСуществование - Булево - вызывать исключение, если строка настройки отсутствует.
//  ОткрытьХранилище - Булево - возвращать содержимое хранилища вместо контейнера.
//
// Возвращаемое значение:
//  Произвольный - сохраненное значение настройки.
//  ХранилищеЗначения - контейнер, если значение хранится в нем и ОткрытьХранилище = Ложь.
//  Неопределено - строка без значения или отсутствующая строка при отключенном контроле существования.
//
// Пример:
//  РазмерПакета = Справочники.ГруппыПрикладныхНастроек.ЗначениеНастройки("ВыгрузкаЗаказов.РазмерПакета", Истина);
//
Функция ЗначениеНастройки(Знач ПутьКНастройке, Знач КонтролироватьСуществование = Ложь,
		Знач ОткрытьХранилище = Ложь) Экспорт

	ЧастиПути = ЧастиПутиКНастройке(ПутьКНастройке);
	Выборка = ВыборкаНастроек(ЧастиПути[0], ЧастиПути[1]);
	Если Выборка.Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Найдено несколько настроек по пути «%1».'"), ПутьКНастройке);
	КонецЕсли;

	Если Выборка.Следующий() Тогда
		Возврат ЗначениеСтрокиНастройки(Выборка, ОткрытьХранилище);
	КонецЕсли;

	Если КонтролироватьСуществование Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Настройка «%1» не найдена.'"), ПутьКНастройке);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает настройки группы одним запросом.
//
// Параметры:
//  ИмяГруппы - Строка - наименование группы.
//  ОткрытьХранилища - Булево - извлечь содержимое хранилищ значений.
//
// Возвращаемое значение:
//  Соответствие - имена настроек в сохраненном регистре служат ключами. Значения соответствуют результату
//                 функции ЗначениеНастройки. Для отсутствующей группы возвращается пустое соответствие.
//
Функция ЗначенияНастроекГруппы(Знач ИмяГруппы, Знач ОткрытьХранилища = Ложь) Экспорт

	Если ТипЗнч(ИмяГруппы) <> Тип("Строка") Или Не ИмяНастройкиДопустимо(ИмяГруппы) Тогда
		ВызватьИсключение НСтр("ru = 'Имя группы должно быть непустой строкой без точки.'");
	КонецЕсли;

	Выборка = ВыборкаНастроек(ИмяГруппы);
	Результат = Новый Соответствие;
	ИменаНастроек = Новый Соответствие;

	Пока Выборка.Следующий() Цикл
		ИмяНастройки = Выборка.ИмяКонстанты;
		КлючИмени = ИмяДляСравнения(ИмяНастройки);
		Если ИменаНастроек.Получить(КлючИмени) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Найдено несколько настроек по пути «%1.%2».'"),
				ИмяГруппы, ИмяНастройки);
		КонецЕсли;

		ИменаНастроек.Вставить(КлючИмени, Истина);
		Результат.Вставить(ИмяНастройки, ЗначениеСтрокиНастройки(Выборка, ОткрытьХранилища));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Записывает значение настройки. Неопределено сбрасывает значение, сохраняя строку настройки.
//
// Параметры:
//  ПутьКНастройке - Строка - наименование группы и имя настройки, разделенные точкой.
//  Значение - Произвольный - число, дата, булево, строка, ссылка или сериализуемое значение.
//  СоздаватьГруппуПриОтсутствии - Булево - создавать группу и разрешить добавление новой настройки.
//  СоздаватьНастройкуПриОтсутствии - Булево - добавлять настройку в существующую группу.
//  ДопускатьСменуТипа - Булево - разрешить смену типа ранее установленного значения, включая его сброс.
//  КакХранилище - Булево - записать значение в хранилище, даже если его можно записать в обычное поле.
//  СтепеньСжатияХранилища - Число - целое число от 0 до 9, используется при записи в хранилище.
//
Процедура УстановитьЗначениеНастройки(Знач ПутьКНастройке, Знач Значение,
		Знач СоздаватьГруппуПриОтсутствии = Ложь, Знач СоздаватьНастройкуПриОтсутствии = Ложь,
		Знач ДопускатьСменуТипа = Ложь, Знач КакХранилище = Ложь, Знач СтепеньСжатияХранилища = 0) Экспорт

	ЧастиПути = ЧастиПутиКНастройке(ПутьКНастройке);
	ИмяГруппы = ЧастиПути[0];
	ИмяНастройки = ЧастиПути[1];
	МетаСправочник = Метаданные.Справочники.ГруппыПрикладныхНастроек;
	Если СтрДлина(ИмяГруппы) > МетаСправочник.ДлинаНаименования Тогда
		ВызватьИсключение НСтр("ru = 'Превышена допустимая длина имени группы настроек.'");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьГруппуНастроек(ИмяГруппы);
		СсылкаГруппы = НайтиПоНаименованию(ИмяГруппы, Истина);
		Если Не СсылкаГруппы.Пустая() Тогда
			ГруппаНастроек = СсылкаГруппы.ПолучитьОбъект();
		ИначеЕсли СоздаватьГруппуПриОтсутствии Тогда
			ГруппаНастроек = СоздатьЭлемент();
			ГруппаНастроек.Наименование = ИмяГруппы;
		Иначе
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Группа настроек «%1» не найдена.'"), ИмяГруппы);
		КонецЕсли;

		УстановитьЗначениеНастройкиВГруппе(ГруппаНастроек, ИмяНастройки, Значение,
			СоздаватьГруппуПриОтсутствии Или СоздаватьНастройкуПриОтсутствии,
			ДопускатьСменуТипа, КакХранилище, СтепеньСжатияХранилища);
		ГруппаНастроек.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#Область УстаревшийПрограммныйИнтерфейс

// Устарела. См. ЗначениеНастройки.
Функция ПолучитьЗначениеНастройки(Знач ПутьКНастройке, Знач КонтролироватьСуществование = Ложь,
		Знач ОткрытьХранилище = Ложь) Экспорт

	Возврат ЗначениеНастройки(ПутьКНастройке, КонтролироватьСуществование, ОткрытьХранилище);

КонецФункции

// Устарела. См. ЗначенияНастроекГруппы.
Функция ПолучитьЗначенияГруппы(Знач ИмяГруппы, Знач ОткрытьХранилища = Ложь) Экспорт

	Возврат ЗначенияНастроекГруппы(ИмяГруппы, ОткрытьХранилища);

КонецФункции

// Устарела. См. ЗначениеНастройки.
Функция ПолучитьЗначениеКонстанты(Знач ПутьККонстанте, Знач КонтролироватьСуществование = Ложь,
		Знач ОткрытьХранилище = Ложь) Экспорт

	Возврат ЗначениеНастройки(ПутьККонстанте, КонтролироватьСуществование, ОткрытьХранилище);

КонецФункции

// Устарела. См. УстановитьЗначениеНастройки.
Процедура УстановитьЗначениеКонстанты(Знач ПутьККонстанте, Знач Значение,
		Знач СоздаватьГруппуПриОтсутствии = Ложь, Знач СоздаватьКонстантуПриОтсутствии = Ложь,
		Знач ДопускатьСменуТипаСуществующейКонстанты = Ложь, Знач КакХранилище = Ложь,
		Знач СтепеньСжатияХранилища = 0) Экспорт

	УстановитьЗначениеНастройки(ПутьККонстанте, Значение, СоздаватьГруппуПриОтсутствии,
		СоздаватьКонстантуПриОтсутствии, ДопускатьСменуТипаСуществующейКонстанты,
		КакХранилище, СтепеньСжатияХранилища);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Применяет значение к строке объекта в памяти. Запись выполняет вызывающий код.
//
// Параметры:
//  ГруппаНастроек - СправочникОбъект.ГруппыПрикладныхНастроек - изменяемая группа.
//  ИмяНастройки - Строка - имя строки в группе.
//  Значение - Произвольный - значение для записи.
//  СоздаватьНастройку - Булево - добавлять строку при её отсутствии.
//  ДопускатьСменуТипа - Булево - разрешить изменение типа или сброс значения.
//  КакХранилище - Булево - сохранить значение в хранилище.
//  СтепеньСжатия - Число - уровень сжатия от 0 до 9.
//
Процедура УстановитьЗначениеНастройкиВГруппе(ГруппаНастроек, Знач ИмяНастройки, Знач Значение,
		Знач СоздаватьНастройку = Ложь, Знач ДопускатьСменуТипа = Истина,
		Знач КакХранилище = Ложь, Знач СтепеньСжатия = 0) Экспорт

	Если Не ИмяНастройкиДопустимо(ИмяНастройки) Тогда
		ВызватьИсключение НСтр("ru = 'Имя настройки должно быть непустой строкой без точки.'");
	КонецЕсли;

	РеквизитыНастроек = Метаданные.Справочники.ГруппыПрикладныхНастроек.ТабличныеЧасти.ЗначенияКонстант.Реквизиты;
	Если СтрДлина(ИмяНастройки) > РеквизитыНастроек.ИмяКонстанты.Тип.КвалификаторыСтроки.Длина Тогда
		ВызватьИсключение НСтр("ru = 'Превышена допустимая длина имени настройки.'");
	КонецЕсли;

	СтрокаНастройки = СтрокаНастройкиПоИмени(ГруппаНастроек.ЗначенияКонстант, ИмяНастройки);
	Если СтрокаНастройки = Неопределено И Не СоздаватьНастройку Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Настройка «%1.%2» не найдена.'"),
			ГруппаНастроек.Наименование, ИмяНастройки);
	КонецЕсли;

	ПереданоХранилище = ТипЗнч(Значение) = Тип("ХранилищеЗначения");
	СохраняемоеЗначение = Значение;
	Если ПереданоХранилище Тогда
		СохраняемоеЗначение = Значение.Получить();
	КонецЕсли;

	Если СтрокаНастройки <> Неопределено И Не ДопускатьСменуТипа Тогда
		ТекущееЗначение = ЗначениеСтрокиНастройки(СтрокаНастройки, Истина);
		Если ТекущееЗначение <> Неопределено И ТипЗнч(ТекущееЗначение) <> ТипЗнч(СохраняемоеЗначение) Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'Для настройки «%1.%2» запрещено изменение типа с «%3» на «%4».'"),
				ГруппаНастроек.Наименование, ИмяНастройки, ТипЗнч(ТекущееЗначение), ТипЗнч(СохраняемоеЗначение));
		КонецЕсли;
	КонецЕсли;

	ТипПростогоЗначения = РеквизитыНастроек.ЗначениеКонстанты.Тип;
	ПоляЗначения = ПоляДляЗаписиЗначения(СохраняемоеЗначение, ТипПростогоЗначения,
		КакХранилище Или ПереданоХранилище, СтепеньСжатия);

	Если СтрокаНастройки = Неопределено Тогда
		СтрокаНастройки = ГруппаНастроек.ЗначенияКонстант.Добавить();
		СтрокаНастройки.ИмяКонстанты = ИмяНастройки;
	КонецЕсли;

	СтрокаНастройки.ЗначениеКонстанты = ПоляЗначения.ПростоеЗначение;
	СтрокаНастройки.ЗначениеКонстантыСтрока = ПоляЗначения.СтроковоеЗначение;
	СтрокаНастройки.ЗначениеКонстантыХранилище = ПоляЗначения.Хранилище;

КонецПроцедуры

// Устанавливает исключительную блокировку имени до конца уже начатой транзакции.
//
// Параметры:
//  ИмяГруппы - Строка - имя группы, по которому выполняется блокировка.
//
Процедура ЗаблокироватьГруппуНастроек(Знач ИмяГруппы) Экспорт

	Блокировка = Новый БлокировкаДанных;
	БлокировкаГруппы = Блокировка.Добавить("Справочник.ГруппыПрикладныхНастроек");
	БлокировкаГруппы.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаГруппы.УстановитьЗначение("Наименование", ИмяДляСравнения(ИмяГруппы));
	Блокировка.Заблокировать();

КонецПроцедуры

// Проверяет, можно ли использовать имя в качестве части ключа настройки.
//
// Параметры:
//  Имя - Строка - имя группы или настройки.
//
// Возвращаемое значение:
//  Булево - Истина, если имя содержит непробельные символы и не содержит точки.
//
Функция ИмяНастройкиДопустимо(Знач Имя) Экспорт
	Возврат Не ПустаяСтрока(Имя) И СтрНайти(Имя, ".") = 0;
КонецФункции

// Возвращает имя для поиска дублей и блокировки группы.
//
// Параметры:
//  Имя - Строка - имя группы или настройки.
//
// Возвращаемое значение:
//  Строка - имя в верхнем регистре с удаленными пробелами в конце.
//
Функция ИмяДляСравнения(Знач Имя) Экспорт
	Возврат ВРег(СокрП(Имя));
КонецФункции

// Возвращает значение для формы. Для скрытых настроек и хранилищ возвращает текстовое представление.
//
// Параметры:
//  СтрокаНастройки - СправочникТабличнаяЧастьСтрока.ГруппыПрикладныхНастроек.ЗначенияКонстант - строка группы.
//
// Возвращаемое значение:
//  Произвольный - значение настройки, маска скрытого значения или представление хранилища.
//
Функция ЗначениеНастройкиДляФормы(СтрокаНастройки) Экспорт

	Если СтрокаНастройки.Скрывать Тогда
		Возврат "**";
	КонецЕсли;

	Значение = ЗначениеСтрокиНастройки(СтрокаНастройки);
	Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
		Возврат НСтр("ru = 'Хранилище значения'");
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Выполняет проверки чтения, записи, переименования и ограничений справочника.
// Откатывает тестовые записи и сообщает о результате. При сбое вызывает исключение с описанием проверки.
Процедура ВыполнитьТесты() Экспорт

	ИмяГруппы = "ТестНастроек_" + Строка(Новый УникальныйИдентификатор);
	НачатьТранзакцию();
	Попытка
		ПроверитьЧтениеИЗаписьНастроек(ИмяГруппы);
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Проверка чтения и записи настроек завершилась ошибкой. %1'"),
			ОписаниеОшибки());
	КонецПопытки;
	ОтменитьТранзакцию();

	ПроверитьОграниченияЗаписи(ИмяГруппы);
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'Проверка прикладных настроек завершена. Все тесты пройдены.'");
	Сообщение.Сообщить();

КонецПроцедуры

#Область УстаревшийПрограммныйИнтерфейс

// Устарела. См. УстановитьЗначениеНастройкиВГруппе.
//
// Параметры:
//  ГруппаНастроек - См. УстановитьЗначениеНастройкиВГруппе.ГруппаНастроек
//  ИмяГруппы - Строка - параметр совместимости, имя берется из объекта группы.
//  ИмяКонстанты - См. УстановитьЗначениеНастройкиВГруппе.ИмяНастройки
//  Значение - См. УстановитьЗначениеНастройкиВГруппе.Значение
//  СоздаватьКонстантуПриОтсутствии - См. УстановитьЗначениеНастройкиВГруппе.СоздаватьНастройку
//  ДопускатьСменуТипаСуществующейКонстанты - См. УстановитьЗначениеНастройкиВГруппе.ДопускатьСменуТипа
//  КакХранилище - См. УстановитьЗначениеНастройкиВГруппе.КакХранилище
//  СтепеньСжатияХранилища - См. УстановитьЗначениеНастройкиВГруппе.СтепеньСжатия
//
Процедура УстановитьЗначениеКонстантыВГруппе(ГруппаНастроек, Знач ИмяГруппы, Знач ИмяКонстанты,
		Знач Значение, Знач СоздаватьКонстантуПриОтсутствии, Знач ДопускатьСменуТипаСуществующейКонстанты,
		Знач КакХранилище, Знач СтепеньСжатияХранилища) Экспорт

	УстановитьЗначениеНастройкиВГруппе(ГруппаНастроек, ИмяКонстанты, Значение, СоздаватьКонстантуПриОтсутствии,
		ДопускатьСменуТипаСуществующейКонстанты, КакХранилище, СтепеньСжатияХранилища);

КонецПроцедуры

// Устарела. См. ИмяНастройкиДопустимо.
