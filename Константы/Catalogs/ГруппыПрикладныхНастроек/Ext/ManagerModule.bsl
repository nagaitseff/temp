#Область СлужебныеПроцедурыИФункции

Функция ЧастиПутиКНастройке(Знач ПутьКНастройке)

	Если ТипЗнч(ПутьКНастройке) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Путь к настройке должен быть строкой в формате «Группа.Имя».'");
	КонецЕсли;

	ЧастиПути = СтрРазделить(ПутьКНастройке, ".", Истина);
	Если ЧастиПути.Количество() <> 2 Или ПустаяСтрока(ЧастиПути[0]) Или ПустаяСтрока(ЧастиПути[1]) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Недопустимый путь «%1». Укажите путь в формате «Группа.Имя».'"),
			ПутьКНастройке);
	КонецЕсли;

	Возврат ЧастиПути;

КонецФункции

Функция ВыборкаНастроек(Знач ИмяГруппы, Знач ИмяНастройки = Неопределено)

	Если ИмяНастройки = Неопределено Тогда
		ЗаголовокЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ";
	Иначе
		ЗаголовокЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2";
	КонецЕсли;

	Запрос = Новый Запрос(ЗаголовокЗапроса + "
		|	Настройки.ИмяКонстанты КАК ИмяКонстанты,
		|	Настройки.ЗначениеКонстанты КАК ЗначениеКонстанты,
		|	Настройки.ЗначениеКонстантыСтрока КАК ЗначениеКонстантыСтрока,
		|	Настройки.ЗначениеКонстантыХранилище КАК ЗначениеКонстантыХранилище
		|ИЗ
		|	Справочник.ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Настройки
		|ГДЕ
		|	Настройки.Ссылка.Наименование = &ИмяГруппы");
	Запрос.УстановитьПараметр("ИмяГруппы", ИмяГруппы);

	Если ИмяНастройки <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И Настройки.ИмяКонстанты = &ИмяНастройки";
		Запрос.УстановитьПараметр("ИмяНастройки", ИмяНастройки);
	КонецЕсли;

	Возврат Запрос.Выполнить().Выбрать();

КонецФункции

Функция ЗначениеСтрокиНастройки(СтрокаНастройки, Знач ОткрытьХранилище = Ложь)

	Если СтрокаНастройки.ЗначениеКонстанты <> Неопределено Тогда
		Возврат СтрокаНастройки.ЗначениеКонстанты;
	КонецЕсли;

	Если СтрДлина(СтрокаНастройки.ЗначениеКонстантыСтрока) > 0 Тогда
		Возврат СтрокаНастройки.ЗначениеКонстантыСтрока;
	КонецЕсли;

	Хранилище = СтрокаНастройки.ЗначениеКонстантыХранилище;
	Содержимое = Хранилище.Получить();
	Если ОткрытьХранилище Или Содержимое = Неопределено Тогда
		Возврат Содержимое;
	КонецЕсли;

	Возврат Хранилище;

КонецФункции

Функция СтрокаНастройкиПоИмени(НастройкиГруппы, Знач ИмяНастройки)

	СтрокаПоИмени = НастройкиГруппы.Найти(ИмяНастройки, "ИмяКонстанты");
	Если СтрокаПоИмени <> Неопределено Тогда
		Возврат СтрокаПоИмени;
	КонецЕсли;

	КлючПоиска = ИмяДляСравнения(ИмяНастройки);
	Для Каждого СтрокаНастройки Из НастройкиГруппы Цикл
		Если ИмяДляСравнения(СтрокаНастройки.ИмяКонстанты) = КлючПоиска Тогда
			Возврат СтрокаНастройки;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПоляДляЗаписиЗначения(Знач Значение, ТипПростогоЗначения, Знач КакХранилище, Знач СтепеньСжатия)

	Результат = Новый Структура("ПростоеЗначение, СтроковоеЗначение, Хранилище", Неопределено, "");
	Если Значение = Неопределено Тогда
		Результат.Хранилище = Новый ХранилищеЗначения(Неопределено);
	ИначеЕсли Не КакХранилище И ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) > 0 Тогда
		Результат.СтроковоеЗначение = Значение;
		Результат.Хранилище = Новый ХранилищеЗначения(Неопределено);
	ИначеЕсли Не КакХранилище И ТипПростогоЗначения.СодержитТип(ТипЗнч(Значение))
		И ТипПростогоЗначения.ПривестиЗначение(Значение) = Значение Тогда

		Результат.ПростоеЗначение = Значение;
		Результат.Хранилище = Новый ХранилищеЗначения(Неопределено);
	Иначе
		// Пустая строка и числа вне точности реквизита сохраняются в хранилище без потери значения.
		ДопустимаяСтепеньСжатия = ТипЗнч(СтепеньСжатия) = Тип("Число")
			И СтепеньСжатия >= 0 И СтепеньСжатия <= 9;
		Если Не ДопустимаяСтепеньСжатия Или СтепеньСжатия <> Цел(СтепеньСжатия) Тогда
			ВызватьИсключение НСтр("ru = 'Степень сжатия должна быть целым числом от 0 до 9.'");
		КонецЕсли;
		Результат.Хранилище = Новый ХранилищеЗначения(Значение, Новый СжатиеДанных(СтепеньСжатия));
	КонецЕсли;

	Возврат Результат;

КонецФункции

#Область Тесты

Процедура ПроверитьЧтениеИЗаписьНастроек(Знач ИмяГруппы)

	Путь = ИмяГруппы + ".Признак";
	УстановитьЗначениеНастройки(Путь, Истина, Истина);
	УстановитьЗначениеНастройки(Путь, Ложь);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), Ложь, "Логическое значение");

	Путь = ИмяГруппы + ".Число";
	УстановитьЗначениеНастройки(Путь, 0, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), 0, "Нулевое значение");

	ТочноеЧисло = 1.123456789;
	УстановитьЗначениеНастройки(Путь, ТочноеЧисло);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина, Истина), ТочноеЧисло, "Точность числа");

	Путь = ИмяГруппы + ".Ссылка";
	ПустаяСсылка = Справочники.ГруппыПрикладныхНастроек.ПустаяСсылка();
	УстановитьЗначениеНастройки(Путь, ПустаяСсылка, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), ПустаяСсылка, "Пустая ссылка");

	СсылкаГруппы = НайтиПоНаименованию(ИмяГруппы, Истина);
	УстановитьЗначениеНастройки(Путь, СсылкаГруппы);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), СсылкаГруппы, "Ссылка");

	Путь = ИмяГруппы + ".Строка";
	ДлиннаяСтрока = "Первая строка" + Символы.ПС + "Следующая строка";
	Для Счетчик = 1 По 8 Цикл
		ДлиннаяСтрока = СтрШаблон("%1%2%1", ДлиннаяСтрока, Счетчик);
	КонецЦикла;
	УстановитьЗначениеНастройки(Путь, ДлиннаяСтрока, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), ДлиннаяСтрока, "Длинная строка");

	УстановитьЗначениеНастройки(Путь, "   ");
	ПроверитьРавенство(СтрДлина(ЗначениеНастройки(Путь, Истина)), 3, "Строка из пробелов");
	УстановитьЗначениеНастройки(Путь, "");
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина, Истина), "", "Пустая строка");

	Путь = ИмяГруппы + ".Состав";
	УстановитьЗначениеНастройки(Путь, Новый Структура("Количество", 1), , Истина, , , 5);
	УстановитьЗначениеНастройки(Путь, Новый ХранилищеЗначения(Новый Структура("Количество", 2)), , , , , 7);
	ПроверитьРавенство(ТипЗнч(ЗначениеНастройки(Путь, Истина)), Тип("ХранилищеЗначения"),
		"Чтение хранилища");
	Состав = ЗначениеНастройки(Путь, Истина, Истина);
	ПроверитьРавенство(Состав.Количество, 2, "Извлечение содержимого хранилища");

	Путь = ИмяГруппы + ".Заполняемая";
	УстановитьЗначениеНастройки(Путь, Неопределено, , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), Неопределено, "Настройка без значения");
	УстановитьЗначениеНастройки(Путь, "Первое значение");
	УстановитьЗначениеНастройки(Путь, 10, , , Истина);
	ПроверитьРавенство(ЗначениеНастройки(Путь, Истина), 10, "Разрешенная смена типа");

	ЗначенияГруппы = ЗначенияНастроекГруппы(ИмяГруппы, Истина);
	ПроверитьРавенство(ЗначенияГруппы.Количество(), 6, "Число настроек при групповом чтении");
	ПроверитьРавенство(ЗначенияГруппы.Получить("Признак"), Ложь, "Групповое чтение");
	ПроверитьРавенство(ЗначениеНастройки(ИмяГруппы + ".Отсутствующая"), Неопределено,
		"Чтение отсутствующей настройки");
	ПроверитьПереименованиеГруппы(СсылкаГруппы, ИмяГруппы, ЗначенияГруппы.Количество());

КонецПроцедуры

Процедура ПроверитьПереименованиеГруппы(СсылкаГруппы, Знач СтароеИмя, Знач ЧислоНастроек)

	НовоеИмя = "ТестИмени_" + Прав(СтароеИмя, 36);
	Группа = СсылкаГруппы.ПолучитьОбъект();
	Группа.Наименование = НовоеИмя;
	Группа.Записать();

	ПроверитьРавенство(НайтиПоНаименованию(НовоеИмя, Истина), СсылкаГруппы, "Ссылка на переименованную группу");
	ПроверитьРавенство(ЗначенияНастроекГруппы(НовоеИмя).Количество(), ЧислоНастроек,
		"Количество настроек после переименования");
	ПроверитьРавенство(ЗначениеНастройки(НовоеИмя + ".Признак", Истина), Ложь,
		"Чтение настройки по новому ключу");
	ПроверитьРавенство(ЗначенияНастроекГруппы(СтароеИмя).Количество(), 0,
		"Чтение настроек по прежнему имени группы");

КонецПроцедуры

Процедура ПроверитьОграниченияЗаписи(Знач ИмяГруппы)

	Для Каждого Проверка Из СтрРазделить("Группа,Ключ,Поля,Тип,Путь,Отсутствие", ",") Цикл
		НачатьТранзакцию();
		Попытка
			ПроверитьОтказОперации(ИмяГруппы, Проверка);
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
		ОтменитьТранзакцию();
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьОтказОперации(Знач ИмяГруппы, Знач Проверка)

	Группа = СоздатьЭлемент();
	Группа.Наименование = ИмяГруппы;
	СтрокаНастройки = Группа.ЗначенияКонстант.Добавить();
	СтрокаНастройки.ИмяКонстанты = "Настройка";
	СтрокаНастройки.ЗначениеКонстанты = Ложь;

	Если Проверка = "Группа" Тогда
		Группа.Записать();
		Группа = СоздатьЭлемент();
		Группа.Наименование = ИмяГруппы;
		ОжидаемыйТекст = "уже существует";
	ИначеЕсли Проверка = "Ключ" Тогда
		Группа.ЗначенияКонстант.Добавить().ИмяКонстанты = "настройка";
		ОжидаемыйТекст = "уже есть в группе";
	ИначеЕсли Проверка = "Поля" Тогда
		СтрокаНастройки.ЗначениеКонстантыХранилище = Новый ХранилищеЗначения("Другое значение");
		ОжидаемыйТекст = "заполнено несколько полей значения";
	ИначеЕсли Проверка = "Тип" Тогда
		Группа.Записать();
		ОжидаемыйТекст = "запрещено изменение типа";
	ИначеЕсли Проверка = "Путь" Тогда
		ОжидаемыйТекст = "Недопустимый путь";
	Иначе
		ОжидаемыйТекст = "не найдена";
	КонецЕсли;

	ТекстОшибки = "";
	Попытка
		Если Проверка = "Тип" Тогда
			УстановитьЗначениеНастройки(ИмяГруппы + ".Настройка", "Другой тип");
		ИначеЕсли Проверка = "Путь" Тогда
			ЗначениеНастройки(ИмяГруппы + ".");
		ИначеЕсли Проверка = "Отсутствие" Тогда
			ЗначениеНастройки(ИмяГруппы + ".Отсутствующая", Истина);
		Иначе
			Группа.Записать();
		КонецЕсли;
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	Если СтрНайти(ТекстОшибки, ОжидаемыйТекст) = 0 Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Проверка «%1» не пройдена. Ожидалась ошибка «%2». Результат: %3.'"),
			Проверка, ОжидаемыйТекст, ?(ПустаяСтрока(ТекстОшибки), НСтр("ru = 'операция выполнена'"), ТекстОшибки));
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьРавенство(Знач Получено, Знач Ожидалось, Знач НазваниеПроверки)

	Если ТипЗнч(Получено) <> ТипЗнч(Ожидалось) Или Получено <> Ожидалось Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Проверка «%1» не пройдена. Ожидалось «%2», получено «%3».'"),
			НазваниеПроверки, Ожидалось, Получено);
	КонецЕсли;

КонецПроцедуры

