#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	// Целостность ключей проверяется при каждой записи, включая загрузку данных.
	МенеджерНастроек = Справочники.ГруппыПрикладныхНастроек;
	Если Не МенеджерНастроек.ИмяНастройкиДопустимо(Наименование) Тогда
		ВызватьИсключение НСтр("ru = 'Имя группы должно быть непустой строкой без точки.'");
	КонецЕсли;

	ПроверитьСтрокиНастроек(МенеджерНастроек);
	МенеджерНастроек.ЗаблокироватьГруппуНастроек(Наименование);
	ПроверитьУникальностьИмениГруппы();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСтрокиНастроек(МенеджерНастроек)

	ИменаНастроек = Новый Соответствие;
	Для Каждого СтрокаНастройки Из ЗначенияКонстант Цикл
		ИмяНастройки = СтрокаНастройки.ИмяКонстанты;
		Если Не МенеджерНастроек.ИмяНастройкиДопустимо(ИмяНастройки) Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'В строке %1 укажите непустое имя настройки без точки.'"), СтрокаНастройки.НомерСтроки);
		КонецЕсли;

		КлючИмени = МенеджерНастроек.ИмяДляСравнения(ИмяНастройки);
		Если ИменаНастроек.Получить(КлючИмени) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Настройка «%1» уже есть в группе «%2».'"),
				ИмяНастройки, Наименование);
		КонецЕсли;
		ИменаНастроек.Вставить(КлючИмени, Истина);

		ЗаполненоПростоеЗначение = СтрокаНастройки.ЗначениеКонстанты <> Неопределено;
		ЗаполненаСтрока = СтрДлина(СтрокаНастройки.ЗначениеКонстантыСтрока) > 0;
		Если Не ЗаполненоПростоеЗначение И Не ЗаполненаСтрока Тогда
			Продолжить;
		КонецЕсли;

		Если (ЗаполненоПростоеЗначение И ЗаполненаСтрока)
			Или СтрокаНастройки.ЗначениеКонстантыХранилище.Получить() <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Для настройки «%1.%2» заполнено несколько полей значения.'"),
				Наименование, ИмяНастройки);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьУникальностьИмениГруппы()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Группы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыПрикладныхНастроек КАК Группы
		|ГДЕ
		|	Группы.Наименование = &ИмяГруппы
		|	И Группы.Ссылка <> &ТекущаяГруппа");
	Запрос.УстановитьПараметр("ИмяГруппы", Наименование);
	Запрос.УстановитьПараметр("ТекущаяГруппа", Ссылка);

	Если Не Запрос.Выполнить().Пустой() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Группа настроек «%1» уже существует.'"), Наименование);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
