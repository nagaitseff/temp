#Область ПрограммныйИнтерфейс

// Возвращает описание программной настройки.
// Параметры:
//  Набор - Строка - уникальное имя набора до 50 символов без точки.
//  Имя - Строка - имя настройки до 200 символов без точки.
//  Значение - Произвольный - начальное сериализуемое значение.
//  Описание - Строка - назначение до 500 символов.
//  Автор - Строка - автор до 150 символов.
//  НавигационнаяСсылка - Строка - ссылка до 500 символов.
//  Каталог - Строка - путь каталогов через "/", пустая строка означает корень.
//  ИдентификаторПоставки - Строка - постоянный идентификатор до 100 символов.
//  СхемаОтбора - СхемаКомпоновкиДанных, Неопределено - доступные поля редактора отбора.
// Возвращаемое значение:
//  Структура - описание для ОбеспечитьНастройки и СостояниеНастроек.
Функция ОписаниеНастройки(Знач Набор, Знач Имя, Знач Значение, Знач Описание, Знач Автор,
		Знач НавигационнаяСсылка, Знач Каталог = "", Знач ИдентификаторПоставки = "", Знач СхемаОтбора = Неопределено) Экспорт
	Если ПустаяСтрока(ИдентификаторПоставки) Тогда
		ИдентификаторПоставки = Набор + "." + Имя;
	КонецЕсли;
	Возврат Новый Структура("Набор, Имя, Значение, Описание, Автор, НавигационнаяСсылка, Каталог, ИдентификаторПоставки, СхемаОтбора",
		Набор, Имя, Значение, Описание, Автор, НавигационнаяСсылка, Каталог, ИдентификаторПоставки, СхемаОтбора);
КонецФункции

// Создает отсутствующие настройки. Существующие значения сохраняются.
// Все добавления фиксируются одной транзакцией. Каждый измененный набор записывается один раз.
// Параметры:
//  Описания - Массив из Структура - результаты ОписаниеНастройки.
// Возвращаемое значение:
//  Число - количество добавленных настроек.
Функция ОбеспечитьНастройки(Описания) Экспорт
	ПроверитьПравоИзменения();
	ПроверитьОписания(Описания);
	Менеджер = Справочники.ГруппыПрикладныхНастроек;
	НачатьТранзакцию();
	Попытка
		Менеджер.ЗаблокироватьГруппуНастроек("ПоставкаПрикладныхНастроек");
		ИменаНаборов = Новый ТаблицаЗначений;
		ИменаНаборов.Колонки.Добавить("Имя");
		Для Каждого Описание Из Описания Цикл
			ИменаНаборов.Добавить().Имя = Описание.Набор;
		КонецЦикла;
		ИменаНаборов.Свернуть("Имя");
		ИменаНаборов.Сортировать("Имя");
		Для Каждого Набор Из ИменаНаборов Цикл
			Менеджер.ЗаблокироватьГруппуНастроек(Набор.Имя);
		КонецЦикла;
		Состояние = ИндексыСостояния();
		ИзмененныеНаборы = Новый Соответствие;
		Создано = 0;
		Для Каждого Описание Из Описания Цикл
			Найденная = НайтиНастройку(Описание, Состояние);
			Если Найденная <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КлючНабора = ВРег(Описание.Набор);
			Набор = ИзмененныеНаборы.Получить(КлючНабора);
			Если Набор = Неопределено Тогда
				Набор = ОбъектНабора(Описание.Набор);
				Если Набор.ЭтоНовый() Тогда
					Набор.Родитель = ОбеспечитьКаталоги(Описание.Каталог);
				КонецЕсли;
				ИзмененныеНаборы.Вставить(КлючНабора, Набор);
			КонецЕсли;
			Менеджер.УстановитьЗначениеНастройкиВГруппе(Набор, Описание.Имя, Описание.Значение, Истина);
			СтрокаНастройки = Набор.ЗначенияКонстант.Найти(Описание.Имя, "ИмяКонстанты");
			ЗаполнитьЗначенияСвойств(СтрокаНастройки, Описание, "Описание,Автор,НавигационнаяСсылка,ИдентификаторПоставки");
			Если Описание.СхемаОтбора <> Неопределено Тогда
				СтрокаНастройки.СхемаОтбора = Новый ХранилищеЗначения(Описание.СхемаОтбора);
			КонецЕсли;
			Создано = Создано + 1;
		КонецЦикла;
		Для Каждого Набор Из ИзмененныеНаборы Цикл
			Набор.Значение.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Создано;
КонецФункции

// Возвращает состояние каждой декларации, без чтения значений настроек.
// Параметры:
//  Описания - Массив из Структура - результаты ОписаниеНастройки.
// Возвращаемое значение:
//  ТаблицаЗначений - ИдентификаторПоставки, ОжидаемыйКлюч, ТекущийКлюч, Состояние.
Функция СостояниеНастроек(Описания) Экспорт
	ПроверитьПравоИзменения();
	ПроверитьОписания(Описания);
	Индексы = ИндексыСостояния();
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("ИдентификаторПоставки,ОжидаемыйКлюч,ТекущийКлюч,Состояние", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	Для Каждого Описание Из Описания Цикл
		Строка = Таблица.Добавить();
		Строка.ИдентификаторПоставки = Описание.ИдентификаторПоставки;
		Строка.ОжидаемыйКлюч = Описание.Набор + "." + Описание.Имя;
		Строка.Состояние = "Отсутствует";
		Найденная = НайтиНастройку(Описание, Индексы);
		Если Найденная = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка.ТекущийКлюч = Найденная.Ключ;
		Если Найденная.ПометкаУдаления Тогда
			Строка.Состояние = "Помечена на удаление";
		ИначеЕсли Строка.ОжидаемыйКлюч <> Найденная.Ключ Тогда
			Строка.Состояние = "Переименована";
		ИначеЕсли ПустаяСтрока(Найденная.ИдентификаторПоставки) Тогда
			Строка.Состояние = "Есть, создана вручную";
		Иначе
			Строка.Состояние = "Создана";
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;
КонецФункции

// Возвращает примеры скалярных значений, списка, структуры и отбора.
// Возвращаемое значение:
//  Массив из Структура - описания настроек в каталоге "Примеры".
Функция ОписанияПримеров() Экспорт
	Результат = Новый Массив;
	Значения = Новый Структура("РазмерПакета, ОбменВключен, ДатаНачала, Подпись, ПустаяСтрока, НеЗадано",
		250, Истина, Дата(2026, 1, 1), "Пример настройки", "", Неопределено);
	Для Каждого Параметр Из Значения Цикл
		Результат.Добавить(ОписаниеПримера(Параметр.Ключ, Параметр.Значение, "Пример значения " + Параметр.Ключ));
	КонецЦикла;
	Список = Новый СписокЗначений;
	Список.Добавить("Подтвержден");
	Список.Добавить("КОтгрузке");
	Результат.Добавить(ОписаниеПримера("СтатусыЗаказов", Список, "Список кодов статусов для параметра запроса."));
	Результат.Добавить(ОписаниеПримера("ПустойСписок", Новый СписокЗначений, "Пример пустого списка."));
	Результат.Добавить(ОписаниеПримера("ПараметрыОбмена", Новый Структура("РазмерПакета, ПовторятьОшибки", 250, Ложь),
		"Структура параметров обмена. Получайте с раскрытием хранилища."));
	Отбор = Новый ОтборКомпоновкиДанных;
	Группа = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	Группа.Использование = Истина;
	Условие = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = "Подтвержден";
	Условие.Использование = Истина;
	Условие = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Сумма");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Условие.ПравоеЗначение = 100000;
	Условие.Использование = Истина;
	Описание = ОписаниеПримера("ОтборЗаказов", Отбор, "Отбор заказов по статусу или сумме. Откройте командой «Настроить отбор».");
	Описание.СхемаОтбора = СхемаОтбораЗаказов();
	Результат.Добавить(Описание);
	Возврат Результат;
КонецФункции

// Создает демонстрационные настройки. Повторный запуск сохраняет значения.
// Возвращаемое значение:
//  Число - количество добавленных строк.
Функция ДобавитьПримеры() Экспорт
	Возврат ОбеспечитьНастройки(ОписанияПримеров());
КонецФункции

// Обработчик обновления и начального заполнения БСП.
Процедура ДобавитьПрограммныеНастройки() Экспорт
	Обновлено = ОбновитьРеквизитыНастроек();
	Создано = ОбеспечитьНастройки(ОписанияПрограммныхНастроек());
КонецПроцедуры

// Заполняет новые служебные реквизиты строк, созданных до версии 1.2.
// Возвращаемое значение:
//  Число - количество обновленных наборов.
Функция ОбновитьРеквизитыНастроек() Экспорт
	ПроверитьПравоИзменения();
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Строки.Ссылка
		|ИЗ Справочник.ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Строки
		|ГДЕ Строки.ИдентификаторНастройки = """"");
	Ссылки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Для Каждого Ссылка Из Ссылки Цикл
		НачатьТранзакцию();
		Попытка
			Справочники.ГруппыПрикладныхНастроек.ЗаблокироватьГруппуНастроек(Ссылка.Наименование);
			Набор = Ссылка.ПолучитьОбъект();
			Набор.Записать();
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	Возврат Ссылки.Количество();
КонецФункции


// Возвращает декларации текущей поставки.
// Возвращаемое значение:
//  Массив из Структура - результаты ОписаниеНастройки.
Функция ОписанияПрограммныхНастроек() Экспорт
	Описания = ОписанияПримеров();
	// Добавляйте прикладные декларации в этот массив.
	Возврат Описания;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПравоИзменения()
	Если Не ПривилегированныйРежим() И Не ПравоДоступа("Изменение", Метаданные.Справочники.ГруппыПрикладныхНастроек) Тогда
		ВызватьИсключение "Недостаточно прав для программного заполнения настроек.";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОписания(Описания)
	Идентификаторы = Новый Соответствие;
	Ключи = Новый Соответствие;
	Для Каждого Описание Из Описания Цикл
		Для Каждого Имя Из СтрРазделить("Набор,Имя,Описание,Автор,НавигационнаяСсылка,ИдентификаторПоставки", ",") Цикл
			Если ТипЗнч(Описание[Имя]) <> Тип("Строка") Или ПустаяСтрока(Описание[Имя]) Тогда
				ВызватьИсключение "В описании программной настройки заполните поле " + Имя + ".";
			КонецЕсли;
		КонецЦикла;
		Если СтрДлина(Описание.Набор) > 50 Или СтрДлина(Описание.Имя) > 200
			Или СтрДлина(Описание.Описание) > 500 Или СтрДлина(Описание.Автор) > 150
			Или СтрДлина(Описание.НавигационнаяСсылка) > 500 Или СтрДлина(Описание.ИдентификаторПоставки) > 100 Тогда
			ВызватьИсключение "Превышена длина реквизита программной настройки.";
		КонецЕсли;
		Менеджер = Справочники.ГруппыПрикладныхНастроек;
		Если Не Менеджер.ИмяНастройкиДопустимо(Описание.Набор) Или Не Менеджер.ИмяНастройкиДопустимо(Описание.Имя) Тогда
			ВызватьИсключение "Имя набора и настройки должно быть заполнено и не содержать точку.";
		КонецЕсли;
		Ключ = Менеджер.ИмяДляСравнения(Описание.Набор + "." + Описание.Имя);
		Идентификатор = Менеджер.ИмяДляСравнения(Описание.ИдентификаторПоставки);
		Если Ключи.Получить(Ключ) <> Неопределено Или Идентификаторы.Получить(Идентификатор) <> Неопределено Тогда
			ВызватьИсключение "В поставке повторяется ключ или идентификатор настройки.";
		КонецЕсли;
		Ключи.Вставить(Ключ, Истина);
		Идентификаторы.Вставить(Идентификатор, Истина);
	КонецЦикла;
КонецПроцедуры

Функция ИндексыСостояния()
	Запрос = Новый Запрос("ВЫБРАТЬ
		|	Строки.Ссылка.Наименование + ""."" + Строки.ИмяКонстанты КАК Ключ,
		|	Строки.ИдентификаторПоставки, Строки.ПометкаУдаления
		|ИЗ Справочник.ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Строки");
	ПоКлючу = Новый Соответствие;
	ПоИдентификатору = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура("Ключ,ИдентификаторПоставки,ПометкаУдаления",
			Выборка.Ключ, Выборка.ИдентификаторПоставки, Выборка.ПометкаУдаления);
		ПоКлючу.Вставить(ВРег(Строка.Ключ), Строка);
		Если Не ПустаяСтрока(Строка.ИдентификаторПоставки) Тогда
			ИД = ВРег(Строка.ИдентификаторПоставки);
			Если ПоИдентификатору.Получить(ИД) <> Неопределено Тогда
				ВызватьИсключение "В базе повторяется идентификатор поставки " + Строка.ИдентификаторПоставки + ".";
			КонецЕсли;
			ПоИдентификатору.Вставить(ИД, Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ПоКлючу,ПоИдентификатору", ПоКлючу, ПоИдентификатору);
КонецФункции

Функция НайтиНастройку(Описание, Индексы)
	ПоИД = Индексы.ПоИдентификатору.Получить(ВРег(Описание.ИдентификаторПоставки));
	ПоКлючу = Индексы.ПоКлючу.Получить(ВРег(Описание.Набор + "." + Описание.Имя));
	Если ПоКлючу <> Неопределено И Не ПустаяСтрока(ПоКлючу.ИдентификаторПоставки)
		И ВРег(ПоКлючу.ИдентификаторПоставки) <> ВРег(Описание.ИдентификаторПоставки) Тогда
		ВызватьИсключение "Ключ настройки занят другой декларацией: " + ПоКлючу.Ключ;
	КонецЕсли;
	Если ПоИД <> Неопределено Тогда
		Возврат ПоИД;
	КонецЕсли;
	Возврат ПоКлючу;
КонецФункции

Функция ОбъектНабора(Имя)
	Запрос = Новый Запрос("ВЫБРАТЬ Наборы.Ссылка ИЗ Справочник.ГруппыПрикладныхНастроек КАК Наборы
		|ГДЕ Наборы.Наименование = &Имя И НЕ Наборы.ЭтоГруппа");
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Набор = Справочники.ГруппыПрикладныхНастроек.СоздатьЭлемент();
	Набор.Наименование = Имя;
	Возврат Набор;
КонецФункции

Функция ОбеспечитьКаталоги(Путь)
	Родитель = Справочники.ГруппыПрикладныхНастроек.ПустаяСсылка();
	Если ПустаяСтрока(Путь) Тогда
		Возврат Родитель;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить(Путь, "/", Истина) Цикл
		Если ПустаяСтрока(Имя) Или СтрДлина(Имя) > 50 Тогда
			ВызватьИсключение "В пути каталога укажите имена длиной от 1 до 50 символов.";
		КонецЕсли;
		Запрос = Новый Запрос("ВЫБРАТЬ Каталоги.Ссылка ИЗ Справочник.ГруппыПрикладныхНастроек КАК Каталоги
			|ГДЕ Каталоги.ЭтоГруппа И Каталоги.Наименование = &Имя И Каталоги.Родитель = &Родитель");
		Запрос.УстановитьПараметр("Имя", Имя);
		Запрос.УстановитьПараметр("Родитель", Родитель);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Родитель = Выборка.Ссылка;
		Иначе
			Каталог = Справочники.ГруппыПрикладныхНастроек.СоздатьГруппу();
			Каталог.Наименование = Имя;
			Каталог.Родитель = Родитель;
			Каталог.Записать();
			Родитель = Каталог.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Родитель;
КонецФункции

Функция ОписаниеПримера(Имя, Значение, Описание)
	Возврат ОписаниеНастройки("ПримерыНастроек", Имя, Значение, Описание, "Поставка прикладных настроек",
		"e1cib/list/Справочник.ГруппыПрикладныхНастроек", "Примеры", "Примеры." + Имя);
КонецФункции

Функция СхемаОтбораЗаказов()
	Схема = Новый СхемаКомпоновкиДанных;
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "Локальный";
	Источник.ТипИсточникаДанных = "Local";
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя = "Заказы";
	Набор.ИсточникДанных = Источник.Имя;
	Набор.ИмяОбъекта = "Заказы";
	Для Каждого ИмяПоля Из СтрРазделить("Организация,Статус,Сумма", ",") Цикл
		Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.ПутьКДанным = ИмяПоля;
		Поле.Поле = ИмяПоля;
		Поле.Заголовок = ИмяПоля;
		Поле.ТипЗначения = Новый ОписаниеТипов(?(ИмяПоля = "Сумма", "Число", "Строка"));
	КонецЦикла;
	Возврат Схема;
КонецФункции

#КонецОбласти
