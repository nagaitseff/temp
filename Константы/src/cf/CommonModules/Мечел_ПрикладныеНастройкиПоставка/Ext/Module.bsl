#Область ПрограммныйИнтерфейс

// Создает реквизиты декларации. Заполните описание, автора и ссылку перед вызовом ОписаниеНастройки.
//
// Возвращаемое значение:
//  Структура:
//  * Описание - Строка - назначение, до 500 символов.
//  * Автор - Строка - ответственный, до 150 символов.
//  * НавигационнаяСсылка - Строка - ссылка, до 500 символов.
//  * Каталог - Строка - путь через «/». Пустой путь означает верхний уровень.
//  * ИдентификаторПоставки - Строка - постоянный идентификатор до 100 символов. Пустой заменяется ключом.
//  * СхемаОтбора - СхемаКомпоновкиДанных, Неопределено - доступные поля редактора отбора.
//  * Скрывать - Булево - скрывать настройку от читателей.
//
Функция ПараметрыПрограммнойНастройки() Экспорт

	ПараметрыНастройки = Новый Структура;
	ПараметрыНастройки.Вставить("Описание", "");
	ПараметрыНастройки.Вставить("Автор", "");
	ПараметрыНастройки.Вставить("НавигационнаяСсылка", "");
	ПараметрыНастройки.Вставить("Каталог", "");
	ПараметрыНастройки.Вставить("ИдентификаторПоставки", "");
	ПараметрыНастройки.Вставить("СхемаОтбора", Неопределено);
	ПараметрыНастройки.Вставить("Скрывать", Ложь);
	Возврат ПараметрыНастройки;

КонецФункции

// Возвращает декларацию для ОбеспечитьНастройки и СостояниеНастроек.
//
// Параметры:
//  Набор - Строка - уникальное имя набора до 50 символов без точки.
//  Имя - Строка - имя настройки до 200 символов без точки.
//  Значение - Произвольный - начальное сериализуемое значение.
//  ПараметрыНастройки - см. ПараметрыПрограммнойНастройки
//
// Возвращаемое значение:
//  Структура:
//  * Набор - Строка - имя набора.
//  * Имя - Строка - имя настройки.
//  * Значение - Произвольный - начальное значение.
//  * Описание, Автор, НавигационнаяСсылка, Каталог, ИдентификаторПоставки, СхемаОтбора, Скрывать -
//    см. ПараметрыПрограммнойНастройки
//
Функция ОписаниеНастройки(Знач Набор, Знач Имя, Знач Значение, ПараметрыНастройки) Экспорт

	Декларация = ПараметрыПрограммнойНастройки();
	ЗаполнитьЗначенияСвойств(Декларация, ПараметрыНастройки);
	Декларация.Вставить("Набор", Набор);
	Декларация.Вставить("Имя", Имя);
	Декларация.Вставить("Значение", Значение);
	Если ПустаяСтрока(Декларация.ИдентификаторПоставки) Тогда
		Декларация.ИдентификаторПоставки = Набор + "." + Имя;
	КонецЕсли;
	Возврат Декларация;

КонецФункции

// Создает отсутствующие настройки. Существующие значения сохраняются.
// Каждая новая строка записывается в своей транзакции. Ошибки строк сообщаются и журналируются.
//
// Параметры:
//  Описания - Массив из Структура - декларации, см. ОписаниеНастройки.
//
// Возвращаемое значение:
//  Число - количество добавленных настроек.
//
Функция ОбеспечитьНастройки(Описания) Экспорт

	ПроверитьПравоИзменения();
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение НСтр("ru = 'Запустите заполнение настроек вне транзакции.'");
	КонецЕсли;
	Если ТипЗнч(Описания) <> Тип("Массив") И ТипЗнч(Описания) <> Тип("ФиксированныйМассив") Тогда
		ВызватьИсключение НСтр("ru = 'Передайте массив деклараций настроек.'");
	КонецЕсли;

	Если Описания.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;

	НачальноеСостояние = ИндексыСостояния();
	Создано = 0;
	Ключи = Новый Соответствие;
	Идентификаторы = Новый Соответствие;
	НомерДекларации = 0;
	Для Каждого Описание Из Описания Цикл
		НомерДекларации = НомерДекларации + 1;
		Попытка
			ПроверитьОписание(Описание);
			Ключ = КлючДляПоиска(Описание.Набор, Описание.Имя);
			Идентификатор = Справочники.Мечел_ГруппыПрикладныхНастроек.ИмяДляСравнения(Описание.ИдентификаторПоставки);
			Если Ключи.Получить(Ключ) = Истина Или Идентификаторы.Получить(Идентификатор) = Истина Тогда
				ВызватьИсключение НСтр("ru = 'Ключ или идентификатор повторяется в списке деклараций.'");
			КонецЕсли;
			// Существующие строки пропускаем по единой выборке. Новые сверяем под блокировкой.
			Если НайтиНастройку(Описание, НачальноеСостояние) = Неопределено И СоздатьНастройку(Описание) Тогда
				Создано = Создано + 1;
			КонецЕсли;
			Ключи.Вставить(Ключ, Истина);
			Идентификаторы.Вставить(Идентификатор, Истина);
		Исключение
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Набор «%1», настройка «%2» (декларация %3). %4'"),
				ПолеДекларации(Описание, "Набор"), ПолеДекларации(Описание, "Имя"), НомерДекларации,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			СообщитьОбОшибкеЗаполнения(ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	Возврат Создано;

КонецФункции

// Возвращает состояние каждой декларации без чтения значений настроек.
//
// Параметры:
//  Описания - Массив из Структура - декларации, см. ОписаниеНастройки.
//
// Возвращаемое значение:
//  ТаблицаЗначений - результат по одной строке на декларацию:
//  * ИдентификаторПоставки - Строка - постоянный идентификатор декларации.
//  * ОжидаемыйКлюч - Строка - ключ из декларации.
//  * ТекущийКлюч - Строка - найденный ключ или пустая строка.
//  * Состояние - Строка - представление результата сверки.
//
Функция СостояниеНастроек(Описания) Экспорт

	ПроверитьПравоИзменения();
	Индексы = ИндексыСостояния();
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Имя Из СтрРазделить("ИдентификаторПоставки,ОжидаемыйКлюч,ТекущийКлюч,Состояние", ",") Цикл
		Таблица.Колонки.Добавить(Имя, Новый ОписаниеТипов("Строка"));
	КонецЦикла;

	Для Каждого Описание Из Описания Цикл
		СведенияОНастройке = Таблица.Добавить();
		СведенияОНастройке.ИдентификаторПоставки = ПолеДекларации(Описание, "ИдентификаторПоставки");
		СведенияОНастройке.ОжидаемыйКлюч = ПолеДекларации(Описание, "Набор") + "." + ПолеДекларации(Описание, "Имя");
		СведенияОНастройке.Состояние = НСтр("ru = 'Отсутствует'");

		Попытка
			ПроверитьОписание(Описание);
			Найденная = НайтиНастройку(Описание, Индексы);
		Исключение
			СведенияОНастройке.Состояние = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Продолжить;
		КонецПопытки;
		Если Найденная = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СведенияОНастройке.ТекущийКлюч = Найденная.Ключ;
		Если Найденная.ПометкаУдаления Тогда
			СведенияОНастройке.Состояние = НСтр("ru = 'Помечена на удаление'");
		ИначеЕсли Найденная.ТребуетсяПроверкаВызовов Тогда
			СведенияОНастройке.Состояние = НСтр("ru = 'Приостановлена до проверки'");
		ИначеЕсли СведенияОНастройке.ОжидаемыйКлюч <> Найденная.Ключ Тогда
			СведенияОНастройке.Состояние = НСтр("ru = 'Переименована'");
		ИначеЕсли ПустаяСтрока(Найденная.ИдентификаторПоставки) Тогда
			СведенияОНастройке.Состояние = НСтр("ru = 'Есть, создана вручную'");
		Иначе
			СведенияОНастройке.Состояние = НСтр("ru = 'Создана'");
		КонецЕсли;
	КонецЦикла;

	Возврат Таблица;

КонецФункции

// Создает недостающие настройки в ходе обновления БСП.
//
// Параметры:
//  ПараметрыОбновления - Структура, Неопределено - параметры обязательного обработчика БСП:
//   * МонопольныйРежим - Булево - режим выполнения. При пробном вызове запрашивает монопольный запуск.
//
Процедура ДобавитьПрограммныеНастройки(ПараметрыОбновления = Неопределено) Экспорт

	Если ПараметрыОбновления <> Неопределено
		И ПараметрыОбновления.Свойство("МонопольныйРежим")
		И Не ПараметрыОбновления.МонопольныйРежим Тогда
		ПараметрыОбновления.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;

	ЗаполнитьПрограммныеНастройки();

КонецПроцедуры

// Обновляет реквизиты старых строк и добавляет недостающие рабочие настройки.
//
// Возвращаемое значение:
//  Число - количество новых рабочих настроек.
//
Функция ЗаполнитьПрограммныеНастройки() Экспорт

	ОбновитьРеквизитыНастроек();
	Возврат ОбеспечитьНастройки(ОписанияПрограммныхНастроек());

КонецФункции

// Заполняет новые служебные реквизиты строк, созданных до версии 1.2.
// Возвращаемое значение:
//  Число - количество обновленных наборов.
Функция ОбновитьРеквизитыНастроек() Экспорт

	ПроверитьПравоИзменения();
	Если ТранзакцияАктивна() Тогда
		ВызватьИсключение НСтр("ru = 'Запустите заполнение настроек вне транзакции.'");
	КонецЕсли;
	ЗапросНастроек = Новый Запрос();
	ЗапросНастроек.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Строки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Строки
		|ГДЕ
		|	Строки.ИдентификаторНастройки = """"";

	Ссылки = ЗапросНастроек.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Обновлено = 0;

	Для Каждого Ссылка Из Ссылки Цикл
		НачатьТранзакцию();
		Попытка
			Справочники.Мечел_ГруппыПрикладныхНастроек.ЗаблокироватьГруппуНастроек(Ссылка.Наименование);
			Набор = Ссылка.ПолучитьОбъект();
			Набор.Записать();
			ЗафиксироватьТранзакцию();
			Обновлено = Обновлено + 1;
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Набор «%1». Не удалось обновить реквизиты. %2'"),
				Ссылка.Наименование, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			СообщитьОбОшибкеЗаполнения(ТекстОшибки);
		КонецПопытки;
	КонецЦикла;

	Возврат Обновлено;

КонецФункции

// Возвращает декларации текущей поставки.
// Возвращаемое значение:
//  Массив из Структура - результаты ОписаниеНастройки.
Функция ОписанияПрограммныхНастроек() Экспорт
	
	Описания = Мечел_ПрикладныеНастройкиДобавление.ДекларацииСозданияНастроек();
	
	Возврат Описания;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПравоИзменения()

	Если Не ПривилегированныйРежим()
		И Не ПравоДоступа("Изменение", Метаданные.Справочники.Мечел_ГруппыПрикладныхНастроек) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для программного заполнения настроек.'");
	КонецЕсли;

КонецПроцедуры

Функция СоздатьНастройку(Описание)

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	Создана = Ложь;
	НачатьТранзакцию();
	Попытка
		Менеджер.ЗаблокироватьГруппуНастроек("ПоставкаПрикладныхНастроек");
		Менеджер.ЗаблокироватьГруппуНастроек(Описание.Набор);

		Индексы = ИндексыСостояния(Описание);
		Если НайтиНастройку(Описание, Индексы) = Неопределено Тогда
			НаборНастроек = ОбъектНабора(Описание.Набор);
			Если НаборНастроек.ЭтоНовый() Тогда
				НаборНастроек.Родитель = ОбеспечитьКаталоги(Описание.Каталог);
			КонецЕсли;
			СтрокаНастройки = НаборНастроек.ЗначенияКонстант.Добавить();
			СтрокаНастройки.ИмяКонстанты = Описание.Имя;
			Менеджер.ЗаполнитьЗначениеСтрокиНастройки(СтрокаНастройки, Описание.Значение);
			ЗаполнитьЗначенияСвойств(СтрокаНастройки, Описание,
				"Описание,Автор,НавигационнаяСсылка,ИдентификаторПоставки,Скрывать");
			Если Описание.СхемаОтбора <> Неопределено Тогда
				СтрокаНастройки.СхемаОтбора = Новый ХранилищеЗначения(Описание.СхемаОтбора);
			КонецЕсли;
			НаборНастроек.Записать();
			Создана = Истина;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Создана;

КонецФункции

Процедура ПроверитьОписание(Описание)

	Если ТипЗнч(Описание) <> Тип("Структура") И ТипЗнч(Описание) <> Тип("ФиксированнаяСтруктура") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидалась структура декларации.'");
	КонецЕсли;
	ОбязательныеПоля = Новый Структура;
	ОбязательныеПоля.Вставить("Набор", 50);
	ОбязательныеПоля.Вставить("Имя", 200);
	ОбязательныеПоля.Вставить("Описание", 500);
	ОбязательныеПоля.Вставить("Автор", 150);
	ОбязательныеПоля.Вставить("НавигационнаяСсылка", 500);
	ОбязательныеПоля.Вставить("ИдентификаторПоставки", 100);
	Для Каждого Поле Из ОбязательныеПоля Цикл
		ТекстПоля = ПолеДекларации(Описание, Поле.Ключ);
		Если ПустаяСтрока(ТекстПоля) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Заполните поле «%1» строковым значением.'"), Поле.Ключ);
		КонецЕсли;
		Если СтрДлина(ТекстПоля) > Поле.Значение Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Поле «%1» должно содержать не более %2 символов.'"),
				Поле.Ключ, Поле.Значение);
		КонецЕсли;
	КонецЦикла;
	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	Если Не Менеджер.ИмяНастройкиДопустимо(Описание.Набор) Или Не Менеджер.ИмяНастройкиДопустимо(Описание.Имя) Тогда
		ВызватьИсключение НСтр("ru = 'Укажите имена набора и настройки без точки.'");
	КонецЕсли;
	Если Описание.СхемаОтбора <> Неопределено И ТипЗнч(Описание.СхемаОтбора) <> Тип("СхемаКомпоновкиДанных") Тогда
		ВызватьИсключение НСтр("ru = 'Передайте схему компоновки данных в поле «СхемаОтбора».'");
	КонецЕсли;
	Если Описание.Свойство("Скрывать") И ТипЗнч(Описание.Скрывать) <> Тип("Булево") Тогда
		ВызватьИсключение НСтр("ru = 'Поле «Скрывать» должно быть булевым.'");
	КонецЕсли;

КонецПроцедуры

Функция ПолеДекларации(Описание, ИмяСвойства)

	ЗначениеСвойства = Неопределено;
	Если (ТипЗнч(Описание) = Тип("Структура") Или ТипЗнч(Описание) = Тип("ФиксированнаяСтруктура"))
		И Описание.Свойство(ИмяСвойства, ЗначениеСвойства) И ТипЗнч(ЗначениеСвойства) = Тип("Строка") Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура СообщитьОбОшибкеЗаполнения(ТекстОшибки)

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Прикладные настройки. Ошибка заполнения'"),
		УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.Мечел_ГруппыПрикладныхНастроек, , ТекстОшибки);
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Сообщить();

КонецПроцедуры

Функция КлючДляПоиска(ИмяНабора, ИмяНастройки)

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	Возврат Менеджер.ИмяДляСравнения(ИмяНабора) + "." + Менеджер.ИмяДляСравнения(ИмяНастройки);

КонецФункции

Функция ИндексыСостояния(Описание = Неопределено)

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	ЗапросНастроек = Новый Запрос();
	ЗапросНастроек.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Строки.Ссылка.Наименование КАК ИмяНабора,
		|	Строки.ИмяКонстанты КАК ИмяНастройки,
		|	Строки.ИдентификаторПоставки КАК ИдентификаторПоставки,
		|	Строки.ПометкаУдаления КАК ПометкаУдаления,
		|	Строки.ТребуетсяПроверкаВызовов КАК ТребуетсяПроверкаВызовов
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Строки";

	Если Описание <> Неопределено Тогда
		// Для записи проверяем текущий ключ и постоянный идентификатор, в том числе после переименования.
		ЗапросНастроек.Текст = ЗапросНастроек.Текст + "
		|ГДЕ
		|	Строки.ИдентификаторПоставки = &Идентификатор
		|	ИЛИ (Строки.Ссылка.Наименование = &Набор И Строки.ИмяКонстанты = &Имя)";
		ЗапросНастроек.УстановитьПараметр("Идентификатор", Описание.ИдентификаторПоставки);
		ЗапросНастроек.УстановитьПараметр("Набор", Описание.Набор);
		ЗапросНастроек.УстановитьПараметр("Имя", Описание.Имя);
	КонецЕсли;

	ПоКлючу = Новый Соответствие;
	ПоИдентификатору = Новый Соответствие;
	ПовторяющиесяИдентификаторы = Новый Соответствие;
	Выборка = ЗапросНастроек.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СведенияОНастройке = Новый Структура;
		СведенияОНастройке.Вставить("Ключ", Выборка.ИмяНабора + "." + Выборка.ИмяНастройки);
		СведенияОНастройке.Вставить("ИдентификаторПоставки", Выборка.ИдентификаторПоставки);
		СведенияОНастройке.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
		СведенияОНастройке.Вставить("ТребуетсяПроверкаВызовов", Выборка.ТребуетсяПроверкаВызовов);
		ПоКлючу.Вставить(КлючДляПоиска(Выборка.ИмяНабора, Выборка.ИмяНастройки), СведенияОНастройке);
		Если Не ПустаяСтрока(СведенияОНастройке.ИдентификаторПоставки) Тогда
			ИД = Менеджер.ИмяДляСравнения(СведенияОНастройке.ИдентификаторПоставки);
			Если ПоИдентификатору.Получить(ИД) <> Неопределено Тогда
				ПовторяющиесяИдентификаторы.Вставить(ИД, Истина);
			КонецЕсли;
			ПоИдентификатору.Вставить(ИД, СведенияОНастройке);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("ПоКлючу, ПоИдентификатору, ПовторяющиесяИдентификаторы",
		ПоКлючу, ПоИдентификатору, ПовторяющиесяИдентификаторы);

КонецФункции

Функция НайтиНастройку(Описание, Индексы)

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	Идентификатор = Менеджер.ИмяДляСравнения(Описание.ИдентификаторПоставки);
	Если Индексы.ПовторяющиесяИдентификаторы.Получить(Идентификатор) = Истина Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В базе повторяется идентификатор поставки «%1».'"),
			Описание.ИдентификаторПоставки);
	КонецЕсли;
	ПоИД = Индексы.ПоИдентификатору.Получить(Идентификатор);
	ПоКлючу = Индексы.ПоКлючу.Получить(КлючДляПоиска(Описание.Набор, Описание.Имя));
	Если ПоКлючу <> Неопределено И Не ПустаяСтрока(ПоКлючу.ИдентификаторПоставки)
		И Менеджер.ИмяДляСравнения(ПоКлючу.ИдентификаторПоставки) <> Идентификатор Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ключ настройки «%1» занят другой декларацией.'"), ПоКлючу.Ключ);
	КонецЕсли;
	Если ПоИД <> Неопределено Тогда
		Возврат ПоИД;
	КонецЕсли;

	Возврат ПоКлючу;

КонецФункции

Функция ОбъектНабора(Имя)

	ЗапросНастроек = Новый Запрос();
	ЗапросНастроек.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Наборы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек КАК Наборы
		|ГДЕ
		|	Наборы.Наименование = &Имя
		|	И НЕ Наборы.ЭтоГруппа";
	ЗапросНастроек.УстановитьПараметр("Имя", Имя);
	Выборка = ЗапросНастроек.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Набор = Справочники.Мечел_ГруппыПрикладныхНастроек.СоздатьЭлемент();
	Набор.Наименование = Имя;

	Возврат Набор;

КонецФункции

Функция ОбеспечитьКаталоги(Путь)

	Родитель = Справочники.Мечел_ГруппыПрикладныхНастроек.ПустаяСсылка();
	Если ПустаяСтрока(Путь) Тогда
		Возврат Родитель;
	КонецЕсли;

	ЧастиПути = СтрРазделить(Путь, "/", Истина);
	Для Каждого ИмяКаталога Из ЧастиПути Цикл
		Если ПустаяСтрока(ИмяКаталога) Или СтрДлина(ИмяКаталога) > 50 Тогда
			ВызватьИсключение НСтр("ru = 'В пути каталога укажите имена длиной от 1 до 50 символов.'");
		КонецЕсли;
	КонецЦикла;

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	КаталогиПоРодителям = КаталогиПоИменам(ЧастиПути);
	Для Каждого ИмяКаталога Из ЧастиПути Цикл
		ДочерниеКаталоги = КаталогиПоРодителям.Получить(Родитель);
		СсылкаКаталога = Неопределено;
		Если ДочерниеКаталоги <> Неопределено Тогда
			СсылкаКаталога = ДочерниеКаталоги.Получить(Менеджер.ИмяДляСравнения(ИмяКаталога));
		КонецЕсли;
		Если СсылкаКаталога = Неопределено Тогда
			Каталог = Менеджер.СоздатьГруппу();
			Каталог.Наименование = ИмяКаталога;
			Каталог.Родитель = Родитель;
			Каталог.Записать();
			СсылкаКаталога = Каталог.Ссылка;
		КонецЕсли;
		Родитель = СсылкаКаталога;
	КонецЦикла;

	Возврат Родитель;

КонецФункции

Функция КаталогиПоИменам(ИменаКаталогов)

	ЗапросКаталогов = Новый Запрос;
	ЗапросКаталогов.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Каталоги.Ссылка КАК Ссылка,
		|	Каталоги.Наименование КАК Имя,
		|	Каталоги.Родитель КАК Родитель
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек КАК Каталоги
		|ГДЕ
		|	Каталоги.ЭтоГруппа
		|	И Каталоги.Наименование В (&Имена)";
	ЗапросКаталогов.УстановитьПараметр("Имена", ИменаКаталогов);
	Выборка = ЗапросКаталогов.Выполнить().Выбрать();

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	КаталогиПоРодителям = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		ДочерниеКаталоги = КаталогиПоРодителям.Получить(Выборка.Родитель);
		Если ДочерниеКаталоги = Неопределено Тогда
			ДочерниеКаталоги = Новый Соответствие;
			КаталогиПоРодителям.Вставить(Выборка.Родитель, ДочерниеКаталоги);
		КонецЕсли;
		ДочерниеКаталоги.Вставить(Менеджер.ИмяДляСравнения(Выборка.Имя), Выборка.Ссылка);
	КонецЦикла;

	Возврат КаталогиПоРодителям;

КонецФункции

#КонецОбласти