#Область СлужебныйПрограммныйИнтерфейс

Функция ДекларацииСозданияНастроек() Экспорт
	
	ОписанияНастроек = Новый Массив;
	
	ОписанияНастроек.Добавить(ОписанияПримеров(ОписанияНастроек));
	ОписанияНастроек.Добавить(ИспользоватьКонтролиЗаявкиНаОплатуУХ());
	
	Возврат ОписанияНастроек;
	
КонецФункции

// Возвращает примеры скалярных значений, списка, структуры и отбора.
// Возвращаемое значение:
//  Массив из Структура - описания настроек в каталоге "Примеры".
Функция ОписанияПримеров(ОписанияНастроек = Неопределено) Экспорт
	
	Если ОписанияНастроек = Неопределено Тогда
		ОписанияНастроек = Новый Массив;
	КонецЕсли;
	
	РазмерПакета = 250;
	
	Значения = Новый Структура;
	Значения.Вставить("РазмерПакета", РазмерПакета);
	Значения.Вставить("ОбменВключен", Истина);
	Значения.Вставить("ДатаНачала", Дата(2026, 1, 1));
	Значения.Вставить("Подпись", "Пример настройки");
	Значения.Вставить("ПустаяСтрока", "");
	Значения.Вставить("НеЗадано", Неопределено);
	Для Каждого Параметр Из Значения Цикл
		ОписанияНастроек.Добавить(ОписаниеПримера(Параметр.Ключ, Параметр.Значение, "Пример значения " + Параметр.Ключ));
	КонецЦикла;
	
	Список = Новый СписокЗначений;
	Список.Добавить("Подтвержден");
	Список.Добавить("КОтгрузке");
	
	ОписанияНастроек.Добавить(ОписаниеПримера("СтатусыЗаказов", Список, "Список кодов статусов для параметра запроса."));
	ОписанияНастроек.Добавить(ОписаниеПримера("ПустойСписок", Новый СписокЗначений, "Пример пустого списка."));
	ПараметрыОбмена = Новый Структура("РазмерПакета, ПовторятьОшибки", РазмерПакета, Ложь);
	ОписанияНастроек.Добавить(ОписаниеПримера("ПараметрыОбмена", ПараметрыОбмена,
		"Структура параметров обмена. Получайте с раскрытием хранилища."));
	
	ОтборЗаказов = Новый ОтборКомпоновкиДанных;
	Группа = ОтборЗаказов.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	Группа.Использование = Истина;
	Условие = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = "Подтвержден";
	Условие.Использование = Истина;
	Условие = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Сумма");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Условие.ПравоеЗначение = 100000;
	Условие.Использование = Истина;
	
	Описание = ОписаниеПримера("ОтборЗаказов",
		ОтборЗаказов, "Отбор заказов по статусу или сумме. Откройте командой «Настроить отбор».");
	Описание.СхемаОтбора = ПримерСхемаОтбораЗаказов();
	
	ОписанияНастроек.Добавить(Описание);
	
	Возврат ОписанияНастроек;
	
КонецФункции

// Создает демонстрационные настройки. Повторный запуск сохраняет значения.
// Возвращаемое значение:
//  Число - количество добавленных строк.
Функция ДобавитьПримеры() Экспорт

	Возврат Мечел_ПрикладныеНастройкиПоставка.ОбеспечитьНастройки(ОписанияПримеров());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область МечелНастройки

// Общее описание настройки
// 
Функция ОписаниеНастройки(Набор, Имя, Значение, Описание, Автор, НавигационнаяСсылка, Родитель = "")
	
	ПараметрыНастройки = Мечел_ПрикладныеНастройкиПоставка.ПараметрыПрограммнойНастройки();
	ПараметрыНастройки.Описание = Описание;
	ПараметрыНастройки.Автор = НСтр("ru = """ + Автор + """");
	ПараметрыНастройки.НавигационнаяСсылка = "e1c://server/UKM-SAPP143/IT_SPPR#" + НавигационнаяСсылка;
	ПараметрыНастройки.Каталог = Родитель;
	ПараметрыНастройки.ИдентификаторПоставки = Родитель + "." + Имя;
	
	Возврат Мечел_ПрикладныеНастройкиПоставка.ОписаниеНастройки(Набор, Имя, Значение, ПараметрыНастройки);
	
КонецФункции

#Область НаборRMQ

Функция ИспользоватьКонтролиЗаявкиНаОплатуУХ()
	
	ОписаниеНастройки = ОписаниеНастройки(
		"RMQ", 
		"ИспользоватьКонтролиЗаявкиНаОплатуУХ",
		Истина, 
		"Включение контролей необходимых для интеграции заявки на расходование ДС в 1С УХ.",
		"Бутгусаим Артем Евгеньевич",
		"e1cib/data/Справочник.ТехническиеПроекты?ref=8bb130e1715fd51f11ed9bc006321165");
	
	Возврат ОписаниеНастройки;
	
КонецФункции

