#Область СлужебныйПрограммныйИнтерфейс

// Возвращает декларации рабочих настроек.
// Возвращаемое значение:
//  Массив из Структура - см. Мечел_ПрикладныеНастройкиПоставка.ОписаниеНастройки.
Функция ДекларацииСозданияНастроек() Экспорт

	ОписанияНастроек = Новый Массив;

	ОписанияНастроек.Добавить(ИспользоватьКонтролиЗаявкиНаОплатуУХ());

	Возврат ОписанияНастроек;

КонецФункции

// Возвращает примеры скалярных значений, списка, структуры и отбора.
// Возвращаемое значение:
//  Массив из Структура - описания настроек в каталоге "Примеры".
Функция ОписанияПримеров() Экспорт

	ОписанияНастроек = Новый Массив;
	ОписанияНастроек.Добавить(ПримерРазмерПакета());
	ОписанияНастроек.Добавить(ПримерОбменВключен());
	ОписанияНастроек.Добавить(ПримерДатаНачала());
	ОписанияНастроек.Добавить(ПримерПодпись());
	ОписанияНастроек.Добавить(ПримерПустаяСтрока());
	ОписанияНастроек.Добавить(ПримерНеЗадано());
	ОписанияНастроек.Добавить(ПримерСтатусыЗаказов());
	ОписанияНастроек.Добавить(ПримерПустойСписок());
	ОписанияНастроек.Добавить(ПримерПараметрыОбмена());
	ОписанияНастроек.Добавить(ПримерОтборЗаказов());

	Возврат ОписанияНастроек;

КонецФункции

// Создает демонстрационные настройки. Повторный запуск сохраняет значения.
// Возвращаемое значение:
//  Число - количество добавленных строк.
Функция ДобавитьПримеры() Экспорт

	Возврат Мечел_ПрикладныеНастройкиПоставка.ОбеспечитьНастройки(ОписанияПримеров());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область МечелНастройки

Функция ОписаниеРабочейНастройки(Набор, Имя, Значение, Описание, Автор, НавигационнаяСсылка, Каталог = "")

	ПараметрыНастройки = Мечел_ПрикладныеНастройкиПоставка.ПараметрыПрограммнойНастройки();
	ПараметрыНастройки.Описание = Описание;
	ПараметрыНастройки.Автор = Автор;
	ПараметрыНастройки.НавигационнаяСсылка = НавигационнаяСсылка;
	Если СтрНачинаетсяС(НавигационнаяСсылка, "e1cib/") Тогда
		ПараметрыНастройки.НавигационнаяСсылка = "e1c://server/UKM-SAPP143/IT_SPPR#" + НавигационнаяСсылка;
	КонецЕсли;
	ПараметрыНастройки.Каталог = Каталог;

	Возврат Мечел_ПрикладныеНастройкиПоставка.ОписаниеНастройки(Набор, Имя, Значение, ПараметрыНастройки);

КонецФункции

Функция ИспользоватьКонтролиЗаявкиНаОплатуУХ()

	ИмяНастройки = "ИспользоватьКонтролиЗаявкиНаОплатуУХ";
	Описание = ОписаниеРабочейНастройки("RMQ", ИмяНастройки, Истина,
		НСтр("ru = 'Включение контролей для интеграции заявки на расходование ДС в 1С УХ.'"),
		"Бутгусаим Артем Евгеньевич",
		"e1cib/data/Справочник.ТехническиеПроекты?ref=8bb130e1715fd51f11ed9bc006321165");
	// Сохраняем ранее объявленный идентификатор рабочей настройки.
	Описание.ИдентификаторПоставки = "." + ИмяНастройки;

	Возврат Описание;

КонецФункции

#КонецОбласти

