#Область СлужебныйПрограммныйИнтерфейс

// Возвращает примеры скалярных значений, списка, структуры и отбора.
// Возвращаемое значение:
//  Массив из Структура - описания настроек в каталоге "Примеры".
Функция ОписанияПримеров() Экспорт
	
	Результат = Новый Массив;
	РазмерПакета = 250;
	
	// Здесь в качестве примера, при разработке создание структур настроек должно быть по стандарту 1с
	// 
	Значения = Новый Структура;
	Значения.Вставить("РазмерПакета", РазмерПакета);
	Значения.Вставить("ОбменВключен", Истина);
	Значения.Вставить("ДатаНачала", Дата(2026, 1, 1));
	Значения.Вставить("Подпись", "Пример настройки");
	Значения.Вставить("ПустаяСтрока", "");
	Значения.Вставить("НеЗадано", Неопределено);
	Для Каждого Параметр Из Значения Цикл
		Результат.Добавить(ОписаниеПримера(Параметр.Ключ, Параметр.Значение, "Пример значения " + Параметр.Ключ));
	КонецЦикла;
	
	Список = Новый СписокЗначений;
	Список.Добавить("Подтвержден");
	Список.Добавить("КОтгрузке");
	
	Результат.Добавить(ОписаниеПримера("СтатусыЗаказов", Список, "Список кодов статусов для параметра запроса."));
	Результат.Добавить(ОписаниеПримера("ПустойСписок", Новый СписокЗначений, "Пример пустого списка."));
	Результат.Добавить(ОписаниеПримера("ПараметрыОбмена", 
		Новый Структура("РазмерПакета, ПовторятьОшибки", РазмерПакета, Ложь),
		"Структура параметров обмена. Получайте с раскрытием хранилища."));
	
	ОтборЗаказов = Новый ОтборКомпоновкиДанных;
	Группа = ОтборЗаказов.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	Группа.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	Группа.Использование = Истина;
	Условие = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = "Подтвержден";
	Условие.Использование = Истина;
	Условие = Группа.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Сумма");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше;
	Условие.ПравоеЗначение = 100000;
	Условие.Использование = Истина;
	
	Описание = ОписаниеПримера("ОтборЗаказов", 
		ОтборЗаказов, "Отбор заказов по статусу или сумме. Откройте командой «Настроить отбор».");
	Описание.СхемаОтбора = СхемаОтбораЗаказов();
	
	Результат.Добавить(Описание);
	
	Возврат Результат;
	
КонецФункции

// Создает демонстрационные настройки. Повторный запуск сохраняет значения.
// Возвращаемое значение:
//  Число - количество добавленных строк.
Функция ДобавитьПримеры() Экспорт
	
	Возврат Мечел_ПрикладныеНастройкиПоставка.ОбеспечитьНастройки(ОписанияПримеров());
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Примеры

Функция ОписаниеПримера(Имя, Значение, Описание)
	
	Возврат Мечел_ПрикладныеНастройкиПоставка.ОписаниеНастройки(
		"ПримерыНастроек", Имя, Значение, Описание, "Поставка прикладных настроек",
		"e1cib/list/Справочник.Мечел_ГруппыПрикладныхНастроек", "Примеры", "Примеры." + Имя);
	
КонецФункции

Функция СхемаОтбораЗаказов()
	
	Схема = Новый СхемаКомпоновкиДанных;
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "Локальный";
	Источник.ТипИсточникаДанных = "Local";
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя = "Заказы";
	Набор.ИсточникДанных = Источник.Имя;
	Набор.ИмяОбъекта = "Заказы";
	
	ЕстьСправочникОрганизаций = Метаданные.Справочники.Найти("Организации") <> Неопределено;
	Для Каждого ИмяПоля Из СтрРазделить("Организация,Статус,Сумма", ",") Цикл
		ПолеОтбора = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеОтбора.ПутьКДанным = ИмяПоля;
		ПолеОтбора.Поле = ИмяПоля;
		ПолеОтбора.Заголовок = ИмяПоля;
		ИмяТипаПоля = ?(ИмяПоля = "Сумма", "Число", "Строка");
		Если ИмяПоля = "Организация" Тогда
			Если ЕстьСправочникОрганизаций Тогда
				ИмяТипаПоля = "СправочникСсылка.Организации";
			Иначе
				ПолеОтбора.Заголовок = НСтр("ru = 'Название организации'");
			КонецЕсли;
		КонецЕсли;
		ПолеОтбора.ТипЗначения = Новый ОписаниеТипов(ИмяТипаПоля);
	КонецЦикла;
	
	Возврат Схема;
	
КонецФункции

#КонецОбласти

#КонецОбласти