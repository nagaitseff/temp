#Область Примеры

Функция ОписаниеПримера(Имя, Значение, Описание)
	
	ПараметрыНастройки = Мечел_ПрикладныеНастройкиПоставка.ПараметрыПрограммнойНастройки();
	ПараметрыНастройки.Описание = Описание;
	ПараметрыНастройки.Автор = НСтр("ru = 'Поставка прикладных настроек'");
	ПараметрыНастройки.НавигационнаяСсылка = "e1cib/list/Справочник.Мечел_ГруппыПрикладныхНастроек";
	ПараметрыНастройки.Каталог = "Примеры";
	ПараметрыНастройки.ИдентификаторПоставки = "Примеры." + Имя;
	
	Возврат Мечел_ПрикладныеНастройкиПоставка.ОписаниеНастройки("ПримерыНастроек", Имя, Значение, ПараметрыНастройки);
	
КонецФункции

Функция ПримерСхемаОтбораЗаказов()
	
	Схема = Новый СхемаКомпоновкиДанных;
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "Локальный";
	Источник.ТипИсточникаДанных = "Local";
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя = "Заказы";
	Набор.ИсточникДанных = Источник.Имя;
	Набор.ИмяОбъекта = "Заказы";
	
	ЕстьСправочникОрганизаций = Метаданные.Справочники.Найти("Организации") <> Неопределено;
	Для Каждого ИмяПоля Из СтрРазделить("Организация,Статус,Сумма", ",") Цикл
		ПолеОтбора = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеОтбора.ПутьКДанным = ИмяПоля;
		ПолеОтбора.Поле = ИмяПоля;
		ПолеОтбора.Заголовок = ИмяПоля;
		ИмяТипаПоля = ?(ИмяПоля = "Сумма", "Число", "Строка");
		Если ИмяПоля = "Организация" Тогда
			Если ЕстьСправочникОрганизаций Тогда
				ИмяТипаПоля = "СправочникСсылка.Организации";
			Иначе
				ПолеОтбора.Заголовок = НСтр("ru = 'Название организации'");
			КонецЕсли;
		КонецЕсли;
		ПолеОтбора.ТипЗначения = Новый ОписаниеТипов(ИмяТипаПоля);
	КонецЦикла;
	
	Возврат Схема;
	
КонецФункции

#КонецОбласти

