#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ЭтоГруппа Тогда
		ПроверитьГлубинуКаталога();
		Если ПустаяСтрока(Наименование) Тогда
			ВызватьИсключение НСтр("ru = 'Укажите наименование каталога.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	Если Не Менеджер.ИмяНастройкиДопустимо(Наименование) Тогда
		ВызватьИсключение НСтр("ru = 'Имя набора должно быть непустой строкой без точки.'");
	КонецЕсли;
	Менеджер.ЗаблокироватьГруппуНастроек(Наименование);
	СтарыеДанные = СостояниеДоЗаписи();
	Если СтарыеДанные.ИмяНабора <> "" И СтарыеДанные.ИмяНабора <> Наименование Тогда
		Менеджер.ЗаблокироватьГруппуНастроек(СтарыеДанные.ИмяНабора);
	КонецЕсли;
	ПроверитьУникальностьИмени();
	ПодготовитьСтроки(СтарыеДанные);
	ПроверитьСтрокиНастроек(Менеджер);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Для Каждого СтрокаНастройки Из ЗначенияКонстант Цикл
		СтрокаНастройки.ИдентификаторНастройки = "";
		СтрокаНастройки.ИдентификаторПоставки = "";
		СтрокаНастройки.ПредыдущийКлюч = "";
		СтрокаНастройки.ТребуетсяПроверкаВызовов = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьГлубинуКаталога()

	Если Не ЭтоНовый() И Родитель = Ссылка.Родитель Тогда
		Возврат;
	КонецЕсли;
	Глубина = 1;
	Предок = Родитель;
	Пока ЗначениеЗаполнено(Предок) Цикл
		Глубина = Глубина + 1;
		Если Глубина > 3 Или Предок = Ссылка Тогда
			ВызватьИсключение НСтр("ru = 'Допускаются три уровня каталогов. Выберите другой родительский каталог.'");
		КонецЕсли;
		Предок = Предок.Родитель;
	КонецЦикла;
	Если ЭтоНовый() Или Родитель.Пустая() Тогда
		Возврат;
	КонецЕсли;
	ЗапросКаталогов = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Каталоги.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек КАК Каталоги
		|ГДЕ
		|	Каталоги.ЭтоГруппа И (Каталоги.Родитель.Родитель = &Ссылка
		|	ИЛИ (&Глубина = 3 И Каталоги.Родитель = &Ссылка))");
	ЗапросКаталогов.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросКаталогов.УстановитьПараметр("Глубина", Глубина);
	Если Не ЗапросКаталогов.Выполнить().Пустой() Тогда
		ВызватьИсключение НСтр("ru = 'После переноса вложенность дочерних каталогов превысит три уровня.'");
	КонецЕсли;

КонецПроцедуры

Функция СостояниеДоЗаписи()

	Результат = Новый Структура("ИмяНабора, Строки", "", Новый Соответствие);
	Если ЭтоНовый() Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.ИмяНабора = Ссылка.Наименование;
	ЗапросНаборов = Новый Запрос(
		"ВЫБРАТЬ
		|	Строки.НомерСтроки КАК НомерСтроки,
		|	Строки.ИмяКонстанты КАК ИмяКонстанты,
		|	Строки.ИдентификаторНастройки КАК ИдентификаторНастройки,
		|	Строки.ИдентификаторПоставки КАК ИдентификаторПоставки,
		|	Строки.ПометкаУдаления КАК ПометкаУдаления,
		|	Строки.ПредыдущийКлюч КАК ПредыдущийКлюч
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Строки
		|ГДЕ
		|	Строки.Ссылка = &Ссылка");
	ЗапросНаборов.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = ЗапросНаборов.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючНастройки = ?(ПустаяСтрока(Выборка.ИдентификаторНастройки),
			"#" + Формат(Выборка.НомерСтроки, "ЧГ=0"), Выборка.ИдентификаторНастройки);
		СведенияСтроки = Новый Структура;
		СведенияСтроки.Вставить("Имя", Выборка.ИмяКонстанты);
		СведенияСтроки.Вставить("ИдентификаторПоставки", Выборка.ИдентификаторПоставки);
		СведенияСтроки.Вставить("ПометкаУдаления", Выборка.ПометкаУдаления);
		СведенияСтроки.Вставить("ПредыдущийКлюч", Выборка.ПредыдущийКлюч);
		Результат.Строки.Вставить(КлючНастройки, СведенияСтроки);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПодготовитьСтроки(СтарыеДанные)

	Если Ссылка.Пустая() Тогда
		МенеджерНастроек = Справочники.Мечел_ГруппыПрикладныхНастроек;
		УстановитьСсылкуНового(МенеджерНастроек.ПолучитьСсылку(Новый УникальныйИдентификатор));
	КонецЕсли;
	НовыеКлючи = Новый Соответствие;
	ПрежниеКлючи = Новый Соответствие;
	Для Каждого Настройка Из ЗначенияКонстант Цикл
		Идентификатор = Настройка.ИдентификаторНастройки;
		КлючСтроки = ?(ПустаяСтрока(Идентификатор),
			"#" + Формат(Настройка.НомерСтроки, "ЧГ=0"), Идентификатор);
		СтараяСтрока = СтарыеДанные.Строки.Получить(КлючСтроки);
		БылаПомечена = СтараяСтрока <> Неопределено И СтараяСтрока.ПометкаУдаления;
		Если Настройка.ПометкаУдаления <> БылаПомечена Тогда
			ПравоПометки = ?(БылаПомечена, "ИнтерактивноеСнятиеПометкиУдаления", "ИнтерактивнаяПометкаУдаления");
			Если Не ПравоДоступа(ПравоПометки, Метаданные.Справочники.Мечел_ГруппыПрикладныхНастроек) Тогда
				ВызватьИсключение НСтр("ru = 'Недостаточно прав для изменения пометки удаления.'");
			КонецЕсли;
		КонецЕсли;
		Если СтараяСтрока <> Неопределено Тогда
			СтарыеДанные.Строки.Удалить(КлючСтроки);
		КонецЕсли;
		Если ПустаяСтрока(Идентификатор) Тогда
			Настройка.ИдентификаторНастройки = Строка(Новый УникальныйИдентификатор);
			Если СтараяСтрока <> Неопределено Тогда
				ЗаполнитьРеквизитыСтаройСтроки(Настройка);
			КонецЕсли;
		КонецЕсли;
		НовыйКлюч = Наименование + "." + Настройка.ИмяКонстанты;
		Если СтараяСтрока = Неопределено Тогда
			НовыеКлючи.Вставить(ВРег(НовыйКлюч), Истина);
			Настройка.ТребуетсяПроверкаВызовов = Ложь;
			Настройка.ПредыдущийКлюч = "";
			Продолжить;
		КонецЕсли;
		Если СтараяСтрока.ИдентификаторПоставки <> Настройка.ИдентификаторПоставки Тогда
			ВызватьИсключение НСтр("ru = 'Идентификатор поставки существующей настройки изменять нельзя.'");
		КонецЕсли;
		СтарыйКлюч = СтарыеДанные.ИмяНабора + "." + СтараяСтрока.Имя;
		Если СтарыйКлюч <> НовыйКлюч Тогда
			НовыеКлючи.Вставить(ВРег(НовыйКлюч), Истина);
			Настройка.ПредыдущийКлюч = ?(ПустаяСтрока(СтараяСтрока.ПредыдущийКлюч),
				СтарыйКлюч, СтараяСтрока.ПредыдущийКлюч);
			Настройка.ТребуетсяПроверкаВызовов = Истина;
		ИначеЕсли Не Настройка.ТребуетсяПроверкаВызовов Или ПустаяСтрока(СтараяСтрока.ПредыдущийКлюч) Тогда
			Настройка.ТребуетсяПроверкаВызовов = Ложь;
			Настройка.ПредыдущийКлюч = "";
		КонецЕсли;
		Если Настройка.ТребуетсяПроверкаВызовов И ВРег(НовыйКлюч) <> ВРег(Настройка.ПредыдущийКлюч) Тогда
			ПрежниеКлючи.Вставить(ВРег(Настройка.ПредыдущийКлюч), Истина);
		КонецЕсли;
	КонецЦикла;

	ПроверитьПрежниеКлючи(НовыеКлючи, ПрежниеКлючи);
	Если СтарыеДанные.Строки.Количество() > 0 Тогда
		ПроверитьУдалениеСтрок(СтарыеДанные);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПрежниеКлючи(НовыеКлючи, ПрежниеКлючи)
	Если НовыеКлючи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	КлючиПоиска = Новый Массив;
	Для Каждого ПараКлюча Из НовыеКлючи Цикл
		Если ПрежниеКлючи.Получить(ПараКлюча.Ключ) = Истина Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Ключ «%1» ожидает проверки после переименования.'"),
				ПараКлюча.Ключ);
		КонецЕсли;
		КлючиПоиска.Добавить(ПараКлюча.Ключ);
	КонецЦикла;
	ЗапросКлючей = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Строки.ПредыдущийКлюч КАК ПредыдущийКлюч
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Строки
		|ГДЕ
		|	Строки.Ссылка <> &Ссылка
		|	И Строки.ТребуетсяПроверкаВызовов
		|	И Строки.ПредыдущийКлюч В (&Ключи)");
	ЗапросКлючей.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросКлючей.УстановитьПараметр("Ключи", КлючиПоиска);
	ВыборкаКлючей = ЗапросКлючей.Выполнить().Выбрать();
	Если ВыборкаКлючей.Следующий() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Ключ «%1» ожидает проверки после переименования.'"),
			ВыборкаКлючей.ПредыдущийКлюч);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУдалениеСтрок(СтарыеДанные)

	Если Не ПравоДоступа("Удаление", Метаданные.Справочники.Мечел_ГруппыПрикладныхНастроек) Тогда
		ВызватьИсключение НСтр("ru = 'Недостаточно прав для удаления настроек.'");
	КонецЕсли;
	ИдентификаторыПоставки = Новый Соответствие;
	ИменаПоставки = Новый Соответствие;
	Для Каждого Декларация Из Мечел_ПрикладныеНастройкиПоставка.ОписанияПрограммныхНастроек() Цикл
		ИдентификаторыПоставки.Вставить(ВРег(Декларация.ИдентификаторПоставки), Истина);
		Если ВРег(Декларация.Набор) = ВРег(СтарыеДанные.ИмяНабора) Тогда
			ИменаПоставки.Вставить(ВРег(Декларация.Имя), Истина);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ПараСтроки Из СтарыеДанные.Строки Цикл
		Настройка = ПараСтроки.Значение;
		Если Не Настройка.ПометкаУдаления Тогда
			ВызватьИсключение НСтр("ru = 'Перед удалением пометьте настройку и запишите набор.'");
		КонецЕсли;
		Если ИдентификаторыПоставки.Получить(ВРег(Настройка.ИдентификаторПоставки)) = Истина
			Или ИменаПоставки.Получить(ВРег(Настройка.Имя)) = Истина Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Сначала исключите настройку «%1» из поставки.'"),
				Настройка.Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыСтаройСтроки(Настройка)

	Если ПустаяСтрока(Настройка.Описание) Тогда
		Настройка.Описание = СтрШаблон(НСтр("ru = 'Настройка «%1». Описание перенесено из имени при обновлении.'"),
			Настройка.ИмяКонстанты);
	КонецЕсли;
	Если ПустаяСтрока(Настройка.Автор) Тогда
		Настройка.Автор = НСтр("ru = 'Не указан в исходной версии'");
	КонецЕсли;
	Если ПустаяСтрока(Настройка.НавигационнаяСсылка) Тогда
		Настройка.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСтрокиНастроек(Менеджер)

	Имена = Новый Соответствие;
	Идентификаторы = Новый Соответствие;
	Для Каждого Настройка Из ЗначенияКонстант Цикл
		Имя = Настройка.ИмяКонстанты;
		Если Не Менеджер.ИмяНастройкиДопустимо(Имя) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'В строке %1 укажите имя настройки без точки.'"),
				Настройка.НомерСтроки);
		КонецЕсли;
		КлючНастройки = Менеджер.ИмяДляСравнения(Имя);
		Если Имена.Получить(КлючНастройки) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Настройка «%1» уже есть в наборе «%2».'"), Имя, Наименование);
		КонецЕсли;
		Имена.Вставить(КлючНастройки, Истина);
		Если Идентификаторы.Получить(Настройка.ИдентификаторНастройки) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Идентификаторы строк настроек должны быть уникальными.'");
		КонецЕсли;
		Идентификаторы.Вставить(Настройка.ИдентификаторНастройки, Истина);
		Для Каждого Реквизит Из СтрРазделить("Описание,Автор,НавигационнаяСсылка", ",") Цикл
			Если ПустаяСтрока(Настройка[Реквизит]) Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Для настройки «%1» заполните поле «%2».'"), Имя, Реквизит);
			КонецЕсли;
		КонецЦикла;
		ПростоеЗначение = Настройка.ЗначениеКонстанты <> Неопределено;
		СтроковоеЗначение = СтрДлина(Настройка.ЗначениеКонстантыСтрока) > 0;
		Если (ПростоеЗначение И СтроковоеЗначение)
			Или ((ПростоеЗначение Или СтроковоеЗначение)
				И Настройка.ЗначениеКонстантыХранилище.Получить() <> Неопределено) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Для настройки «%1.%2» заполнено несколько полей значения.'"),
				Наименование, Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьУникальностьИмени()

	ЗапросНаборов = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	Наборы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Мечел_ГруппыПрикладныхНастроек КАК Наборы
		|ГДЕ
		|	Наборы.Наименование = &Имя
		|	И НЕ Наборы.ЭтоГруппа
		|	И Наборы.Ссылка <> &Ссылка");
	ЗапросНаборов.УстановитьПараметр("Имя", Наименование);
	ЗапросНаборов.УстановитьПараметр("Ссылка", Ссылка);
	Если Не ЗапросНаборов.Выполнить().Пустой() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Набор настроек «%1» уже существует.'"), Наименование);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
