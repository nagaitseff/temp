#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)

	Если ЭтоГруппа Тогда
		Если ПустаяСтрока(Наименование) Тогда
			ВызватьИсключение НСтр("ru = 'Укажите наименование каталога.'");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Менеджер = Справочники.Мечел_ГруппыПрикладныхНастроек;
	Если Не Менеджер.ИмяНастройкиДопустимо(Наименование) Тогда
		ВызватьИсключение НСтр("ru = 'Имя набора должно быть непустой строкой без точки.'");
	КонецЕсли;
	Менеджер.ЗаблокироватьГруппуНастроек(Наименование);
	СтарыеДанные = СостояниеДоЗаписи();
	Если СтарыеДанные.ИмяНабора <> "" И СтарыеДанные.ИмяНабора <> Наименование Тогда
		Менеджер.ЗаблокироватьГруппуНастроек(СтарыеДанные.ИмяНабора);
	КонецЕсли;
	ПроверитьУникальностьИмени();
	ПодготовитьСтроки(СтарыеДанные);
	ПроверитьСтрокиНастроек(Менеджер);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Для Каждого СтрокаНастройки Из ЗначенияКонстант Цикл
		СтрокаНастройки.ИдентификаторНастройки = "";
		СтрокаНастройки.ИдентификаторПоставки = "";
		СтрокаНастройки.ПредыдущийКлюч = "";
		СтрокаНастройки.ТребуетсяПроверкаВызовов = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СостояниеДоЗаписи()

	Результат = Новый Структура("ИмяНабора, Строки", "", Новый Соответствие);
	Если ЭтоНовый() Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.ИмяНабора = Ссылка.Наименование;
	ЗапросНаборов = Новый Запрос(
		"ВЫБРАТЬ
		|	Строки.НомерСтроки, Строки.ИмяКонстанты, Строки.ИдентификаторНастройки,
		|	Строки.ИдентификаторПоставки
		|ИЗ Справочник.Мечел_ГруппыПрикладныхНастроек.ЗначенияКонстант КАК Строки
		|ГДЕ Строки.Ссылка = &Ссылка");
	ЗапросНаборов.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = ЗапросНаборов.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КлючНастройки = ?(ПустаяСтрока(Выборка.ИдентификаторНастройки),
			"#" + Формат(Выборка.НомерСтроки, "ЧГ=0"), Выборка.ИдентификаторНастройки);
		Результат.Строки.Вставить(КлючНастройки, Новый Структура("Имя, ИдентификаторПоставки",
			Выборка.ИмяКонстанты, Выборка.ИдентификаторПоставки));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПодготовитьСтроки(СтарыеДанные)

	Если Ссылка.Пустая() Тогда
		МенеджерНастроек = Справочники.Мечел_ГруппыПрикладныхНастроек;
		УстановитьСсылкуНового(МенеджерНастроек.ПолучитьСсылку(Новый УникальныйИдентификатор));
	КонецЕсли;
	Для Каждого Настройка Из ЗначенияКонстант Цикл
		Идентификатор = Настройка.ИдентификаторНастройки;
		СтараяСтрока = СтарыеДанные.Строки.Получить(?(ПустаяСтрока(Идентификатор),
			"#" + Формат(Настройка.НомерСтроки, "ЧГ=0"), Идентификатор));
		Если ПустаяСтрока(Идентификатор) Тогда
			Настройка.ИдентификаторНастройки = Строка(Новый УникальныйИдентификатор);
			Если СтараяСтрока <> Неопределено Тогда
				ЗаполнитьРеквизитыСтаройСтроки(Настройка);
			КонецЕсли;
		КонецЕсли;
		Если СтараяСтрока = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтараяСтрока.ИдентификаторПоставки <> Настройка.ИдентификаторПоставки Тогда
			ВызватьИсключение НСтр("ru = 'Идентификатор поставки существующей настройки изменять нельзя.'");
		КонецЕсли;
		СтарыйКлюч = СтарыеДанные.ИмяНабора + "." + СтараяСтрока.Имя;
		НовыйКлюч = Наименование + "." + Настройка.ИмяКонстанты;
		Если СтарыйКлюч <> НовыйКлюч Тогда
			Если Не Настройка.ТребуетсяПроверкаВызовов Тогда
				Настройка.ПредыдущийКлюч = СтарыйКлюч;
			КонецЕсли;
			Настройка.ТребуетсяПроверкаВызовов = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьРеквизитыСтаройСтроки(Настройка)

	Если ПустаяСтрока(Настройка.Описание) Тогда
		Настройка.Описание = СтрШаблон(НСтр("ru = 'Настройка «%1». Описание перенесено из имени при обновлении.'"),
			Настройка.ИмяКонстанты);
	КонецЕсли;
	Если ПустаяСтрока(Настройка.Автор) Тогда
		Настройка.Автор = НСтр("ru = 'Не указан в исходной версии'");
	КонецЕсли;
	Если ПустаяСтрока(Настройка.НавигационнаяСсылка) Тогда
		Настройка.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьСтрокиНастроек(Менеджер)

	Имена = Новый Соответствие;
	Идентификаторы = Новый Соответствие;
	Для Каждого Настройка Из ЗначенияКонстант Цикл
		Имя = Настройка.ИмяКонстанты;
		Если Не Менеджер.ИмяНастройкиДопустимо(Имя) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'В строке %1 укажите имя настройки без точки.'"),
				Настройка.НомерСтроки);
		КонецЕсли;
		КлючНастройки = Менеджер.ИмяДляСравнения(Имя);
		Если Имена.Получить(КлючНастройки) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Настройка «%1» уже есть в наборе «%2».'"), Имя, Наименование);
		КонецЕсли;
		Имена.Вставить(КлючНастройки, Истина);
		Если Идентификаторы.Получить(Настройка.ИдентификаторНастройки) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Идентификаторы строк настроек должны быть уникальными.'");
		КонецЕсли;
		Идентификаторы.Вставить(Настройка.ИдентификаторНастройки, Истина);
		Для Каждого Реквизит Из СтрРазделить("Описание,Автор,НавигационнаяСсылка", ",") Цикл
			Если ПустаяСтрока(Настройка[Реквизит]) Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Для настройки «%1» заполните поле «%2».'"), Имя, Реквизит);
			КонецЕсли;
		КонецЦикла;
		ПростоеЗначение = Настройка.ЗначениеКонстанты <> Неопределено;
		СтроковоеЗначение = СтрДлина(Настройка.ЗначениеКонстантыСтрока) > 0;
		Если (ПростоеЗначение И СтроковоеЗначение)
			Или ((ПростоеЗначение Или СтроковоеЗначение)
				И Настройка.ЗначениеКонстантыХранилище.Получить() <> Неопределено) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Для настройки «%1.%2» заполнено несколько полей значения.'"),
				Наименование, Имя);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьУникальностьИмени()

	ЗапросНаборов = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Наборы.Ссылка
		|ИЗ Справочник.Мечел_ГруппыПрикладныхНастроек КАК Наборы
		|ГДЕ Наборы.Наименование = &Имя И НЕ Наборы.ЭтоГруппа И Наборы.Ссылка <> &Ссылка");
	ЗапросНаборов.УстановитьПараметр("Имя", Наименование);
	ЗапросНаборов.УстановитьПараметр("Ссылка", Ссылка);
	Если Не ЗапросНаборов.Выполнить().Пустой() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Набор настроек «%1» уже существует.'"), Наименование);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
