#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПолноеИмя = Параметры.ПолноеИмя;
	Параметры.Свойство("ПредыдущийКлюч", ПредыдущийКлюч);
	Элементы.ПредыдущийКлюч.Видимость = Не ПустаяСтрока(ПредыдущийКлюч);
	Параметры.Свойство("Описание", Описание);
	Параметры.Свойство("Автор", Автор);
	Параметры.Свойство("НавигационнаяСсылка", НавигационнаяСсылкаПроект);
	ТекущееЗначение = Параметры.ТекущееЗначение;
	Элементы.ВидЗначенияНастройки.СписокВыбора.Добавить("Обычное", НСтр("ru = 'Обычное значение'"));
	Элементы.ВидЗначенияНастройки.СписокВыбора.Добавить("Список", НСтр("ru = 'Список значений'"));
	Элементы.ВидЗначенияНастройки.СписокВыбора.Добавить("ОтборСКД", НСтр("ru = 'Отбор СКД'"));
	ВидЗначенияНастройки = "Обычное";

	ЗагрузитьСписок = Ложь;
	Если Параметры.Свойство("ЗагрузитьСписок", ЗагрузитьСписок) И ЗагрузитьСписок Тогда
		ЗагрузитьСписокДляРедактирования();
	КонецЕсли;

	Параметры.Свойство("АдресОтбора", АдресОтбораНастройки);
	Если ЗначениеЗаполнено(АдресОтбораНастройки) Тогда
		ДанныеОтбора = ПолучитьИзВременногоХранилища(АдресОтбораНастройки);
		ЭтоСохраненныйОтбор = ТипЗнч(ДанныеОтбора.Значение) = Тип("ОтборКомпоновкиДанных");
		Если ЭтоСохраненныйОтбор Тогда
			ВидЗначенияНастройки = "ОтборСКД";
		КонецЕсли;
	КонецЕсли;
	ОбновитьВидимостьРедакторов(Элементы, ВидЗначенияНастройки, ЭтоСохраненныйОтбор, ИзмененОтбор);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидЗначенияНастройкиПриИзменении(Элемент)

	ОбновитьВидимостьРедакторов(Элементы, ВидЗначенияНастройки, ЭтоСохраненныйОтбор, ИзмененОтбор);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьЗначениеНастройки(Команда)

	Если Не РеквизитыНастройкиЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	Если ВидЗначенияНастройки = "ОтборСКД" Тогда
		Если Не ЭтоСохраненныйОтбор И Не ИзмененОтбор Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Нажмите «Настроить отбор» и укажите поля.'"));
			Возврат;
		КонецЕсли;
		АдресРезультата = ?(ИзмененОтбор, АдресОтбораНастройки, "");
		Закрыть(РезультатРедактирования(Неопределено, Ложь, АдресРезультата));
	ИначеЕсли ВидЗначенияНастройки = "Список" Тогда
		Закрыть(РезультатРедактирования(ЗначенияСписка, Истина));
	Иначе
		Закрыть(РезультатРедактирования(НовоеЗначение, НовоеЗначение <> Неопределено));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура НастроитьУсловияОтбора(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеФормыОтбора", ЭтотОбъект);
	ПараметрыРедактора = Новый Структура("АдресПараметров", АдресОтбораНастройки);
	ОткрытьФорму("ОбщаяФорма.Мечел_РедакторОтбораПрикладнойНастройки", ПараметрыРедактора,
		ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьЗначение(Команда)

	Если РеквизитыНастройкиЗаполнены() Тогда
		Закрыть(РезультатРедактирования(Неопределено, Истина));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРедактирование(Команда)

	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обновляет состояние редактора после применения отбора.
//
// Параметры:
//  Результат - Строка, Неопределено - адрес результата или отмена.
//  ПараметрыОповещения - Неопределено - дополнительный контекст.
//
&НаКлиенте
Процедура ПослеФормыОтбора(Результат, ПараметрыОповещения) Экспорт

	Если Результат <> Неопределено Тогда
		ИзмененОтбор = Истина;
		ОбновитьВидимостьРедакторов(Элементы, ВидЗначенияНастройки, ЭтоСохраненныйОтбор, ИзмененОтбор);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокДляРедактирования()

	Адрес = "";
	Если Параметры.Свойство("АдресЗначения", Адрес) Тогда
		СохраненныйСписок = ПолучитьИзВременногоХранилища(Адрес);
	Иначе
		СохраненныйСписок = Справочники.Мечел_ГруппыПрикладныхНастроек.СписокЗначенийДляФормы(ПолноеИмя);
	КонецЕсли;
	Если СохраненныйСписок = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТипыЗначений = ЗначенияСписка.ТипЗначения;
	Для Каждого ЭлементСписка Из СохраненныйСписок Цикл
		Если ЭлементСписка.Значение <> Неопределено
			И Не ТипыЗначений.СодержитТип(ТипЗнч(ЭлементСписка.Значение)) Тогда
			ТекущееЗначение = НСтр("ru = 'Список содержит сложные значения. Его состав доступен из серверного кода.'");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	ЗначенияСписка = СохраненныйСписок;
	ВидЗначенияНастройки = "Список";

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьВидимостьРедакторов(КоллекцияЭлементов, Знач ВидЗначения, Знач СохраненОтбор, Знач ОтборИзменен)

	КоллекцияЭлементов.Значение.Видимость = ВидЗначения = "Обычное";
	КоллекцияЭлементов.СписокЗначенийНастройки.Видимость = ВидЗначения = "Список";
	КоллекцияЭлементов.НастройкаОтбора.Видимость = ВидЗначения = "ОтборСКД";
	Если ОтборИзменен Тогда
		КоллекцияЭлементов.ПодсказкаОтбора.Заголовок = НСтр("ru = 'Изменения готовы к применению.'");
	ИначеЕсли СохраненОтбор Тогда
		КоллекцияЭлементов.ПодсказкаОтбора.Заголовок = НСтр("ru = 'Измените поля или условия.'");
	Иначе
		КоллекцияЭлементов.ПодсказкаОтбора.Заголовок = НСтр("ru = 'Сначала задайте поля, затем добавьте условия.'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция РеквизитыНастройкиЗаполнены()

	Если ПустаяСтрока(НавигационнаяСсылкаПроект) Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.НавигационнаяСсылкаПроект;
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите навигационную ссылку.'"));
	ИначеЕсли ПустаяСтрока(Автор) Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.Автор;
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите автора настройки.'"));
	ИначеЕсли ПустаяСтрока(Описание) Тогда
		ЭтаФорма.ТекущийЭлемент = Элементы.Описание;
		ПоказатьПредупреждение(, НСтр("ru = 'Заполните описание настройки.'"));
	Иначе
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция РезультатРедактирования(Знач Значение, Знач ИзменитьЗначение, Знач АдресОтбора = "")

	РезультатРедактора = Новый Структура;
	РезультатРедактора.Вставить("Значение", Значение);
	РезультатРедактора.Вставить("ИзменитьЗначение", ИзменитьЗначение);
	РезультатРедактора.Вставить("Описание", Описание);
	РезультатРедактора.Вставить("Автор", Автор);
	РезультатРедактора.Вставить("НавигационнаяСсылка", НавигационнаяСсылкаПроект);
	РезультатРедактора.Вставить("АдресОтбора", АдресОтбора);
	Возврат РезультатРедактора;

КонецФункции

#КонецОбласти
