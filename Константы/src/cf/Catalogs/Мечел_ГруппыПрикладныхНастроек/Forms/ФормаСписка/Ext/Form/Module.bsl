#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьТесты(Команда)
	
	Попытка
		ВыполнитьТестыНаСервере();
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПримеры(Команда)
	
	Попытка
		Создано = ЗаполнитьПримерыНаСервере();
		Элементы.Список.Обновить();
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Добавлено настроек: %1.'"), Создано));
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПрограммныеНастройки(Команда)
	
	Попытка
		Создано = ЗаполнитьПрограммныеНастройкиНаСервере();
		Элементы.Список.Обновить();
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru = 'Добавлено программных настроек: %1.'"), Создано));
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоставку(Команда)
	
	ОткрытьФорму("ОбщаяФорма.Мечел_СостояниеПрограммныхНастроек");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ВыполнитьТестыНаСервере()
	
	Справочники.Мечел_ГруппыПрикладныхНастроек.ВыполнитьТесты();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьПрограммныеНастройкиНаСервере()

	Возврат Мечел_ПрикладныеНастройкиПоставка.ЗаполнитьПрограммныеНастройки();

КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьПримерыНаСервере()

	Мечел_ПрикладныеНастройкиПоставка.ОбновитьРеквизитыНастроек();

	Возврат Мечел_ПрикладныеНастройкиДобавление.ДобавитьПримеры();

КонецФункции

#КонецОбласти