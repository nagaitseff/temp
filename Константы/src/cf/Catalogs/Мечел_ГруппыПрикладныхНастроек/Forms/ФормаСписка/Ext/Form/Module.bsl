#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьГруппу(Команда)

	ОткрытьФорму("Справочник.Мечел_ГруппыПрикладныхНастроек.ФормаОбъекта", ПараметрыНовогоОбъекта(), ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьТесты(Команда)

	Попытка
		ВыполнитьТестыНаСервере();
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПримеры(Команда)
	Попытка
		Создано = ЗаполнитьПримерыНаСервере();
		Элементы.Список.Обновить();
		ПоказатьПредупреждение(, СтрШаблон("Добавлено настроек: %1.", Создано));
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПоставку(Команда)
	ОткрытьФорму("ОбщаяФорма.Мечел_СостояниеПрограммныхНастроек");
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКаталогНастроек(Команда)
	ОткрытьФорму("Справочник.Мечел_ГруппыПрикладныхНастроек.ФормаГруппы", ПараметрыНовогоОбъекта(), ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ВыполнитьТестыНаСервере()
	Справочники.Мечел_ГруппыПрикладныхНастроек.ВыполнитьТесты();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьПримерыНаСервере()
	Обновлено = Мечел_ПрикладныеНастройкиПоставка.ОбновитьРеквизитыНастроек();
	Возврат Мечел_ПрикладныеНастройкиПоставка.ДобавитьПримеры();
КонецФункции

&НаКлиенте
Функция ПараметрыНовогоОбъекта()
	Каталог = КаталогДляСоздания(Элементы.Список.ТекущаяСтрока);
	Возврат Новый Структура("ЗначенияЗаполнения", Новый Структура("Родитель", Каталог));
КонецФункции

&НаСервереБезКонтекста
Функция КаталогДляСоздания(Знач СсылкаСтроки)
	Если Не ЗначениеЗаполнено(СсылкаСтроки) Тогда
		Возврат Справочники.Мечел_ГруппыПрикладныхНастроек.ПустаяСсылка();
	КонецЕсли;
	Возврат ?(СсылкаСтроки.ЭтоГруппа, СсылкаСтроки, СсылкаСтроки.Родитель);
КонецФункции

#КонецОбласти
