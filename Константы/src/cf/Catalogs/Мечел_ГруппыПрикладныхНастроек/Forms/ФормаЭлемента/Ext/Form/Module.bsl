#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка.Пустая() Тогда
		Набор = РеквизитФормыВЗначение("Объект");
		МенеджерНастроек = Справочники.Мечел_ГруппыПрикладныхНастроек;
		Набор.УстановитьСсылкуНового(МенеджерНастроек.ПолучитьСсылку(Новый УникальныйИдентификатор));
		ЗначениеВРеквизитФормы(Набор, "Объект");
	КонецЕсли;
	Элементы.Наименование.ТолькоПросмотр = Не РеквизитФормыВЗначение("Объект").ЭтоНовый();
	АдресИзменений = ПоместитьВоВременноеХранилище(Новый Соответствие, УникальныйИдентификатор);
	НастроитьОформлениеНастроек();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ОбновитьПредставленияНастроек(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Изменения = ПолучитьИзВременногоХранилища(АдресИзменений);
	Для Каждого ИзменениеСтроки Из Изменения Цикл
		Настройка = ТекущийОбъект.ЗначенияКонстант.Найти(ИзменениеСтроки.Ключ, "ИдентификаторНастройки");
		Если Настройка <> Неопределено Тогда
			Справочники.Мечел_ГруппыПрикладныхНастроек.УстановитьЗначениеНастройкиВГруппе(
				ТекущийОбъект, Настройка.ИмяКонстанты, ИзменениеСтроки.Значение.Значение);
			Настройка.СхемаОтбора = Новый ХранилищеЗначения(ИзменениеСтроки.Значение.СхемаОтбора);
		КонецЕсли;
	КонецЦикла;

	Изменение = Неопределено;
	Если ПараметрыЗаписи.Свойство("ИзменениеНастройки", Изменение) Тогда
		Справочники.Мечел_ГруппыПрикладныхНастроек.УстановитьЗначениеНастройкиВГруппе(
			ТекущийОбъект, Изменение.ИмяНастройки, Изменение.Значение);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ПоместитьВоВременноеХранилище(Новый Соответствие, АдресИзменений);
	Элементы.Наименование.ТолькоПросмотр = Истина;
	ОбновитьПредставленияНастроек(ТекущийОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗначенияКонстантВыбор(Элемент, ВыбраннаяСтрока, КолонкаНастройки, СтандартнаяОбработка)

	Если КолонкаНастройки <> Неопределено И КолонкаНастройки.Имя = "ЗначенияКонстантЗначение" Тогда
		СтандартнаяОбработка = Ложь;
		СтрокаНастройки = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ВыбраннаяСтрока);
		Если СтрокаНастройки <> Неопределено И СтрокаНастройки.ЭтоОтбор Тогда
			ОткрытьРедакторОтбора(ВыбраннаяСтрока);
		Иначе
			ОткрытьРедакторЗначения(СтрокаНастройки);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗначенияКонстантСкрыватьПриИзменении(Элемент)
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияКонстантИмяПриИзменении(Элемент)
	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не Настройка.ТребуетсяПроверкаВызовов Тогда
		Настройка.ПредыдущийКлюч = Настройка.ПолноеИмяКонстанты;
	КонецЕсли;
	Настройка.ТребуетсяПроверкаВызовов = Истина;
	Настройка.ПолноеИмяКонстанты = Объект.Наименование + "." + Настройка.ИмяКонстанты;
	ЭтаФорма.Модифицированность = Истина;
	ОбновитьДоступностьКомандНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияКонстантПриАктивизацииСтроки(Элемент)
	ОбновитьДоступностьКомандНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПереименоватьНабор(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВводаИмениГруппы", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, Объект.Наименование, НСтр("ru = 'Введите имя набора'"), 50);

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНастройку(Команда)

	Оповещение = Новый ОписаниеОповещения("ПослеВводаИмениНастройки", ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение, "", НСтр("ru = 'Введите имя настройки'"), 200);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьНастройку(Команда)
	ОткрытьРедакторЗначения(ТекущаяНастройка());
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПометкуУдаленияНастройки(Команда)

	СтрокаНастройки = ТекущаяНастройка();
	Если СтрокаНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтрокаНастройки.ПометкаУдаления = Не СтрокаНастройки.ПометкаУдаления;
	ЭтаФорма.Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьНабор(Команда)
	ЗаписатьИзменения();
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьНабор(Команда)
	Если ЗаписатьИзменения() Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьПроверкуВызовов(Команда)
	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Или Не Настройка.ТребуетсяПроверкаВызовов Тогда
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПроверки", ЭтотОбъект, Настройка.ПолучитьИдентификатор());
	ПоказатьВопрос(Оповещение,
		СтрШаблон(НСтр("ru = 'Подтвердить обновление обращений с «%1» на «%2»?'"),
			Настройка.ПредыдущийКлюч, Настройка.ПолноеИмяКонстанты), РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоСсылке(Команда)
	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Или ПустаяСтрока(Настройка.НавигационнаяСсылка) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Навигационная ссылка не задана.'"));
		Возврат;
	КонецЕсли;
	Попытка
		ПерейтиПоНавигационнойСсылке(Настройка.НавигационнаяСсылка);
	Исключение
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось открыть навигационную ссылку. %1'"), ОписаниеОшибки());
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтбор(Команда)
	Настройка = ТекущаяНастройка();
	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьРедакторОтбора(Настройка.ПолучитьИдентификатор());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьДоступностьКомандНастройки()

	Настройка = ТекущаяНастройка();
	ЕстьТекущаяНастройка = Настройка <> Неопределено;
	Элементы.ПодтвердитьПроверкуВызовов.Видимость =
		ЕстьТекущаяНастройка И Настройка.ТребуетсяПроверкаВызовов;
	Элементы.ЗначенияКонстантИзменитьНастройку.Доступность = ЕстьТекущаяНастройка;
	Элементы.НастроитьОтбор.Доступность = ЕстьТекущаяНастройка;
	Элементы.ЗначенияКонстантИзменитьПометкуУдаленияНастройки.Доступность = ЕстьТекущаяНастройка;
	Элементы.ПерейтиПоСсылке.Доступность = ЕстьТекущаяНастройка
		И Не ПустаяСтрока(Настройка.НавигационнаяСсылка);

КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставленияНастроек(ТекущийОбъект)

	МенеджерНастроек = Справочники.Мечел_ГруппыПрикладныхНастроек;
	ИндексСтроки = 0;
	Для Каждого СтрокаНастройки Из ТекущийОбъект.ЗначенияКонстант Цикл
		СтрокаФормы = Объект.ЗначенияКонстант[ИндексСтроки];
		СтрокаФормы.ПолноеИмяКонстанты = ТекущийОбъект.Наименование + "." + СтрокаНастройки.ИмяКонстанты;
		ЭтоСписокЗначений = Ложь;
		ЭтоОтбор = Ложь;
		ЗначениеНастройки = МенеджерНастроек.ЗначениеНастройкиДляФормы(СтрокаНастройки, ЭтоСписокЗначений, ЭтоОтбор);
		СтрокаФормы.Значение = Строка(ЗначениеНастройки);
		СтрокаФормы.ЭтоСписокЗначений = ЭтоСписокЗначений;
		СтрокаФормы.ЭтоОтбор = ЭтоОтбор;
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;

КонецПроцедуры

// Обрабатывает завершение ввода имени набора.
//
// Параметры:
//  ИмяГруппы - Строка, Неопределено - введенное имя или результат отмены ввода.
//  ПараметрыОповещения - Неопределено - дополнительный контекст оповещения.
//
&НаКлиенте
Процедура ПослеВводаИмениГруппы(ИмяГруппы, ПараметрыОповещения) Экспорт

	Если ИмяГруппы = Неопределено Или Объект.Наименование = ИмяГруппы Тогда
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ИмяГруппы) Или СтрНайти(ИмяГруппы, ".") > 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Имя набора должно быть непустой строкой без точки.'"));
		Возврат;
	КонецЕсли;

	Если Объект.Ссылка.Пустая() Или ВРег(СокрП(ИмяГруппы)) = ВРег(СокрП(Объект.Наименование)) Тогда
		СохранитьИмяГруппы(ИмяГруппы);
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПодтвержденияПереименования", ЭтотОбъект, ИмяГруппы);
	ТекстПодтверждения = СтрШаблон(
		НСтр("ru = 'Ключи настроек изменятся с «%1.ИмяНастройки» на «%2.ИмяНастройки».
			|Обновите обращения в коде и регламентных заданиях.
			|
			|Переименовать набор?'"),
		Объект.Наименование, ИмяГруппы);
	ПоказатьВопрос(Оповещение, ТекстПодтверждения, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

// Сохраняет новое имя набора после подтверждения пользователем.
//
// Параметры:
//  Результат - КодВозвратаДиалога - ответ на вопрос о переименовании.
//  ИмяГруппы - Строка - новое имя набора.
//
&НаКлиенте
Процедура ПослеПодтвержденияПереименования(Результат, ИмяГруппы) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьИмяГруппы(ИмяГруппы);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИмяГруппы(Знач ИмяГруппы)

	Для Каждого Настройка Из Объект.ЗначенияКонстант Цикл
		Если Не Настройка.ТребуетсяПроверкаВызовов Тогда
			Настройка.ПредыдущийКлюч = Объект.Наименование + "." + Настройка.ИмяКонстанты;
		КонецЕсли;
		Настройка.ТребуетсяПроверкаВызовов = Истина;
		Настройка.ПолноеИмяКонстанты = ИмяГруппы + "." + Настройка.ИмяКонстанты;
	КонецЦикла;
	Объект.Наименование = ИмяГруппы;
	ЭтаФорма.Модифицированность = Истина;
	ОбновитьДоступностьКомандНастройки();
КонецПроцедуры

// Добавляет запись настройки после ввода ее имени.
//
// Параметры:
//  ИмяНастройки - Строка, Неопределено - введенное имя или результат отмены ввода.
//  ПараметрыОповещения - Неопределено - дополнительный контекст оповещения.
//
&НаКлиенте
Процедура ПослеВводаИмениНастройки(ИмяНастройки, ПараметрыОповещения) Экспорт

	Если ИмяНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ИмяНастройки) Или СтрНайти(ИмяНастройки, ".") > 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите имя настройки без точки.'"));
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура("ПолноеИмя, ТекущееЗначение", Объект.Наименование + "." + ИмяНастройки, "");
	ОткрытьФормуРедактораНастройки(ПараметрыФормы, Неопределено, ИмяНастройки);

КонецПроцедуры

// Добавляет строку после применения реквизитов новой настройки.
//
// Параметры:
//  Результат - См. ПослеРедактированияЗначения.Результат
//  ИмяНастройки - Строка - введенное пользователем имя.
//
&НаКлиенте
Процедура ПослеДобавленияНастройки(Результат, ИмяНастройки) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаНастройки = Объект.ЗначенияКонстант.Добавить();
	СтрокаНастройки.ИмяКонстанты = ИмяНастройки;
	СтрокаНастройки.ИдентификаторНастройки = Строка(Новый УникальныйИдентификатор);
	СтрокаНастройки.ПолноеИмяКонстанты = Объект.Наименование + "." + ИмяНастройки;
	ИдентификаторСтроки = СтрокаНастройки.ПолучитьИдентификатор();
	Элементы.ЗначенияКонстант.ТекущаяСтрока = ИдентификаторСтроки;
	ПослеРедактированияЗначения(Результат, ИдентификаторСтроки);

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедакторЗначения(СтрокаНастройки)

	Если СтрокаНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = ПараметрыРедактораНастройки(СтрокаНастройки);
	ОткрытьФормуРедактораНастройки(ПараметрыФормы, СтрокаНастройки.ПолучитьИдентификатор());

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактораНастройки(ПараметрыФормы, ИдентификаторСтроки, Знач ИмяНовойНастройки = "")

	АдресОтбора = ПараметрыОтбораНаСервере(ИдентификаторСтроки, ПараметрыФормы.ПолноеИмя);
	ПараметрыФормы.Вставить("АдресОтбора", АдресОтбора);
	ПараметрыОповещения = Новый Структура("ИдентификаторСтроки, ИмяНовойНастройки, АдресОтбора",
		ИдентификаторСтроки, ИмяНовойНастройки, АдресОтбора);
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияРедактораНастройки", ЭтотОбъект, ПараметрыОповещения);
	ОткрытьФорму("Справочник.Мечел_ГруппыПрикладныхНастроек.Форма.ФормаВыбораЗначения",
		ПараметрыФормы, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Принимает результат редактора и освобождает подготовленные данные отбора.
//
// Параметры:
//  Результат - См. ПослеРедактированияЗначения.Результат
//  ПараметрыОповещения - Структура - адрес отбора и имя новой строки или идентификатор существующей.
//
&НаКлиенте
Процедура ПослеЗакрытияРедактораНастройки(Результат, ПараметрыОповещения) Экспорт

	Если ПараметрыОповещения.ИдентификаторСтроки = Неопределено Тогда
		ПослеДобавленияНастройки(Результат, ПараметрыОповещения.ИмяНовойНастройки);
	Иначе
		ПослеРедактированияЗначения(Результат, ПараметрыОповещения.ИдентификаторСтроки);
	КонецЕсли;
	АдресРезультата = "";
	Если Результат <> Неопределено Тогда
		Результат.Свойство("АдресОтбора", АдресРезультата);
	КонецЕсли;
	Если АдресРезультата <> ПараметрыОповещения.АдресОтбора Тогда
		ОчиститьПараметрыОтбора(ПараметрыОповещения.АдресОтбора);
	КонецЕсли;

КонецПроцедуры

// Сохраняет результат работы редактора значения настройки.
//
// Параметры:
//  Результат - Структура, Неопределено - результат редактирования или отмены.
//    * Значение - Произвольный - установленное значение или Неопределено для очистки.
//    * АдресОтбора - Строка - адрес сохраненного отбора при изменении условий.
//  ИдентификаторСтроки - Число - идентификатор строки в данных формы.
//
&НаКлиенте
Процедура ПослеРедактированияЗначения(Результат, ИдентификаторСтроки) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СтрокаНастройки = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаНастройки <> Неопределено Тогда
		ИзменитьЗначение = Истина;
		АдресОтбора = "";
		Результат.Свойство("АдресОтбора", АдресОтбора);
		Если Не Результат.Свойство("ИзменитьЗначение", ИзменитьЗначение) Тогда
			ИзменитьЗначение = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(АдресОтбора) Тогда
			ПрименитьОтборНаСервере(ИдентификаторСтроки, АдресОтбора);
			СтрокаНастройки = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
		ИначеЕсли ИзменитьЗначение Тогда
			ПрименитьЗначениеНаСервере(ИдентификаторСтроки, Результат.Значение);
			СтрокаНастройки = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
		КонецЕсли;
		Если Результат.Свойство("Описание") Тогда
			ЗаполнитьЗначенияСвойств(СтрокаНастройки, Результат, "Описание,Автор,НавигационнаяСсылка");
		КонецЕсли;
		ЭтаФорма.Модифицированность = Истина;
		ОбновитьДоступностьКомандНастройки();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЗаписатьИзменения(Знач ПараметрыЗаписи = Неопределено)

	Попытка
		Если Записать(ПараметрыЗаписи) Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;

	Возврат Ложь;

КонецФункции

// Обрабатывает подтверждение проверки программных обращений.
// Параметры:
//  Результат - КодВозвратаДиалога - ответ пользователя.
//  ИдентификаторСтроки - Число - идентификатор строки формы.
&НаКлиенте
Процедура ПослеПодтвержденияПроверки(Результат, ИдентификаторСтроки) Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Настройка = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если Настройка <> Неопределено Тогда
		Настройка.ТребуетсяПроверкаВызовов = Ложь;
		Настройка.ПредыдущийКлюч = "";
		ЭтаФорма.Модифицированность = Истина;
		ОбновитьДоступностьКомандНастройки();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ТекущаяНастройка()
	ИдентификаторСтроки = Элементы.ЗначенияКонстант.ТекущаяСтрока;
	Если ИдентификаторСтроки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
КонецФункции

&НаСервере
Процедура ПрименитьЗначениеНаСервере(Знач ИдентификаторСтроки, Знач НовоеЗначение, Знач СхемаОтбора = Неопределено)

	СтрокаФормы = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ПустаяСтрока(СтрокаФормы.ИдентификаторНастройки) Тогда
		СтрокаФормы.ИдентификаторНастройки = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;
	ИдентификаторНастройки = СтрокаФормы.ИдентификаторНастройки;
	Набор = РеквизитФормыВЗначение("Объект");
	Справочники.Мечел_ГруппыПрикладныхНастроек.УстановитьЗначениеНастройкиВГруппе(
		Набор, СтрокаФормы.ИмяКонстанты, НовоеЗначение);
	СтрокаНастройки = Набор.ЗначенияКонстант.Найти(ИдентификаторНастройки, "ИдентификаторНастройки");
	СтрокаНастройки.СхемаОтбора = Новый ХранилищеЗначения(СхемаОтбора);

	Изменения = ПолучитьИзВременногоХранилища(АдресИзменений);
	Изменения.Вставить(ИдентификаторНастройки, Новый Структура("Значение, СхемаОтбора", НовоеЗначение, СхемаОтбора));
	ПоместитьВоВременноеХранилище(Изменения, АдресИзменений);
	ЗначениеВРеквизитФормы(Набор, "Объект");
	ОбновитьПредставленияНастроек(Набор);

КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеНастроек()
	ДобавитьЦветСтроки("Объект.ЗначенияКонстант.ТребуетсяПроверкаВызовов", Новый Цвет(210, 110, 0));
	ДобавитьЦветСтроки("Объект.ЗначенияКонстант.ПометкаУдаления", Новый Цвет(190, 0, 0));
КонецПроцедуры

&НаСервере
Процедура ДобавитьЦветСтроки(Знач Путь, Знач ЦветСтроки)
	Правило = УсловноеОформление.Элементы.Добавить();
	Правило.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветСтроки);
	Условие = Правило.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Путь);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	Условие.Использование = Истина;
	ОформляемоеПоле = Правило.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ЗначенияКонстант");
КонецПроцедуры

// Применяет результат редактора к незаписанному набору.
// Параметры:
//  Результат - Строка, Неопределено - адрес результата или отмена.
//  ИдентификаторСтроки - Число - идентификатор строки формы.
&НаКлиенте
Процедура ПослеРедактированияОтбора(Результат, ИдентификаторСтроки) Экспорт
	Если Результат <> Неопределено Тогда
		ПрименитьОтборНаСервере(ИдентификаторСтроки, Результат);
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПараметрыОтбораНаСервере(Знач ИдентификаторСтроки, Знач КлючНастройки = "")

	Если ИдентификаторСтроки = Неопределено Тогда
		ПараметрыРедактора = Новый Структура("СхемаОтбора, Значение, КлючНастройки",
			Неопределено, Неопределено, КлючНастройки);
		Возврат ПоместитьВоВременноеХранилище(ПараметрыРедактора, УникальныйИдентификатор);
	КонецЕсли;
	СтрокаФормы = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
	ИндексСтроки = Объект.ЗначенияКонстант.Индекс(СтрокаФормы);
	Набор = РеквизитФормыВЗначение("Объект");
	Настройка = Набор.ЗначенияКонстант[ИндексСтроки];
	ОжидающиеИзменения = ПолучитьИзВременногоХранилища(АдресИзменений);
	ИзменениеНастройки = ОжидающиеИзменения.Получить(Настройка.ИдентификаторНастройки);
	Если ИзменениеНастройки = Неопределено Тогда
		СхемаОтбора = Настройка.СхемаОтбора.Получить();
		УсловияОтбора = ?(СтрокаФормы.ЭтоОтбор Или Настройка.Скрывать Или СхемаОтбора <> Неопределено,
			Настройка.ЗначениеКонстантыХранилище.Получить(), Неопределено);
	Иначе
		СхемаОтбора = ИзменениеНастройки.СхемаОтбора;
		УсловияОтбора = ИзменениеНастройки.Значение;
	КонецЕсли;
	Если ТипЗнч(УсловияОтбора) <> Тип("ОтборКомпоновкиДанных") Тогда
		УсловияОтбора = Неопределено;
	КонецЕсли;
	ПараметрыРедактора = Новый Структура("СхемаОтбора, Значение, КлючНастройки",
		СхемаОтбора, УсловияОтбора, СтрокаФормы.ПолноеИмяКонстанты);
	Возврат ПоместитьВоВременноеХранилище(ПараметрыРедактора, УникальныйИдентификатор);

КонецФункции

&НаКлиенте
Процедура ОткрытьРедакторОтбора(Знач ИдентификаторСтроки)

	АдресПараметров = ПараметрыОтбораНаСервере(ИдентификаторСтроки);
	ПараметрыРедактора = Новый Структура("АдресПараметров", АдресПараметров);
	Оповещение = Новый ОписаниеОповещения("ПослеРедактированияОтбора", ЭтотОбъект, ИдентификаторСтроки);
	ОткрытьФорму("ОбщаяФорма.Мечел_РедакторОтбораПрикладнойНастройки", ПараметрыРедактора,
		ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборНаСервере(Знач ИдентификаторСтроки, Знач Адрес)

	ДанныеОтбора = ПолучитьИзВременногоХранилища(Адрес);
	ПрименитьЗначениеНаСервере(ИдентификаторСтроки, ДанныеОтбора.Значение, ДанныеОтбора.СхемаОтбора);
	УдалитьИзВременногоХранилища(Адрес);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОчиститьПараметрыОтбора(Знач АдресОтбора)
	Если ЭтоАдресВременногоХранилища(АдресОтбора) Тогда
		УдалитьИзВременногоХранилища(АдресОтбора);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция АдресЗначенияНаСервере(Знач ИдентификаторСтроки)
	СтрокаФормы = Объект.ЗначенияКонстант.НайтиПоИдентификатору(ИдентификаторСтроки);
	Набор = РеквизитФормыВЗначение("Объект");
	Настройка = Набор.ЗначенияКонстант.Найти(СтрокаФормы.ИмяКонстанты, "ИмяКонстанты");
	Значение = Неопределено;
	Изменения = ПолучитьИзВременногоХранилища(АдресИзменений);
	Изменение = Изменения.Получить(Настройка.ИдентификаторНастройки);
	Если Изменение <> Неопределено И Не Настройка.Скрывать Тогда
		Возврат ПоместитьВоВременноеХранилище(Изменение.Значение, УникальныйИдентификатор);
	КонецЕсли;
	Если Не Настройка.Скрывать Тогда
		Значение = Настройка.ЗначениеКонстантыХранилище.Получить();
	КонецЕсли;
	Возврат ПоместитьВоВременноеХранилище(Значение, УникальныйИдентификатор);
КонецФункции

&НаКлиенте
Функция ПараметрыРедактораНастройки(СтрокаНастройки)
	ПараметрыФормы = Новый Структура("ПолноеИмя, ТекущееЗначение, ЗагрузитьСписок",
		СтрокаНастройки.ПолноеИмяКонстанты, СтрокаНастройки.Значение, СтрокаНастройки.ЭтоСписокЗначений);
	ПараметрыФормы.Вставить("Описание", СтрокаНастройки.Описание);
	ПараметрыФормы.Вставить("ПредыдущийКлюч", СтрокаНастройки.ПредыдущийКлюч);
	ПараметрыФормы.Вставить("Автор", СтрокаНастройки.Автор);
	ПараметрыФормы.Вставить("НавигационнаяСсылка", СтрокаНастройки.НавигационнаяСсылка);
	Если СтрокаНастройки.ЭтоСписокЗначений Тогда
		ПараметрыФормы.Вставить("АдресЗначения", АдресЗначенияНаСервере(СтрокаНастройки.ПолучитьИдентификатор()));
	КонецЕсли;
	Возврат ПараметрыФормы;
КонецФункции

#КонецОбласти
