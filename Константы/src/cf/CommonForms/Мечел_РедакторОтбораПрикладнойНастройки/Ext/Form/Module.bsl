#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресПараметров = Параметры.АдресПараметров;
	ДанныеОтбора = ПолучитьИзВременногоХранилища(АдресПараметров);
	Если ДанныеОтбора = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ЭтаФорма.Заголовок = СтрШаблон(НСтр("ru = 'Отбор настройки «%1»'"), ДанныеОтбора.КлючНастройки);
	Если ТипЗнч(ДанныеОтбора.СхемаОтбора) = Тип("СхемаКомпоновкиДанных") Тогда
		ИнициализироватьОтбор(ДанныеОтбора.СхемаОтбора, ДанныеОтбора.Значение);
	Иначе
		ПоказатьВводПолей(Элементы, Истина, Ложь, Истина);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ПоляОтбораПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		СтрокаПоля = Элемент.ТекущиеДанные;
		СтрокаПоля.ИсходноеИмяПоля = "";
		Если Не Копирование Тогда
			УстановитьТипПоля(СтрокаПоля, Новый ОписаниеТипов("Строка"));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИмяПоляПриИзменении(Элемент)

	СтрокаПоля = Элементы.ПоляОтбора.ТекущиеДанные;
	СтрокаПоля.ЗаголовокПоля = СокрЛП(СтрокаПоля.ИмяПоля);

КонецПроцедуры

&НаКлиенте
Процедура ТипПоляНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаПоля = Элементы.ПоляОтбора.ТекущиеДанные;
	Если СтрокаПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТипыПолей = Новый СписокЗначений;
	ТипыПолей.Добавить("Строка", НСтр("ru = 'Строка'"));
	ТипыПолей.Добавить("Число", НСтр("ru = 'Число'"));
	ТипыПолей.Добавить("Дата", НСтр("ru = 'Дата'"));
	ТипыПолей.Добавить("Булево", НСтр("ru = 'Булево'"));
	ТипыПолей.Добавить("Ссылочный", НСтр("ru = 'Ссылка на объект конфигурации…'"));
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораТипаПоля", ЭтотОбъект, СтрокаПоля.ПолучитьИдентификатор());
	ТипыПолей.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Тип значения поля'"));

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)

	СохранитьРезультат();
	Закрыть(АдресПараметров);

КонецПроцедуры

&НаКлиенте
Процедура ЗадатьПоляВручную(Команда)

	ОчиститьСообщения();
	ПодготовитьВводПолей();

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоляОтчета(Команда)

	ОчиститьСообщения();
	Если ЕстьУсловияОтбора() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Для смены отчета начните с пустого отбора.'"));
		Возврат;
	КонецЕсли;
	ДоступныеОтчеты = ОтчетыСоСхемойОтбора();
	Если ДоступныеОтчеты.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отчеты со схемой недоступны. Подберите поля объекта или введите вручную.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораОтчета", ЭтотОбъект);
	ДоступныеОтчеты.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Выберите отчет'"));

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПоляОбъекта(Команда)

	ОчиститьСообщения();
	ВыбратьВидОбъекта(Неопределено);

КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьПоля(Команда)

	ОчиститьСообщения();
	ПроверитьИЗагрузитьПоля();

КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКУсловиям(Команда)

	ОчиститьСообщения();
	ПоказатьВводПолей(Элементы, Ложь, Истина, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Загружает доступные поля из выбранного отчета.
//
// Параметры:
//  ВыбранныйОтчет - ЭлементСпискаЗначений, Неопределено - имя отчета в списке или отмена.
//  ПараметрыОповещения - Неопределено - дополнительный контекст.
//
&НаКлиенте
Процедура ПослеВыбораОтчета(ВыбранныйОтчет, ПараметрыОповещения) Экспорт

	Если ВыбранныйОтчет <> Неопределено Тогда
		ЗагрузитьПоляОтчета(ВыбранныйОтчет.Значение);
	КонецЕсли;

КонецПроцедуры

// Сохраняет простой тип или открывает выбор ссылочного объекта.
//
// Параметры:
//  ВыбранныйТип - ЭлементСпискаЗначений, Неопределено - выбранный тип или отмена.
//  ИдентификаторСтроки - Число - идентификатор редактируемого поля.
//
&НаКлиенте
Процедура ПослеВыбораТипаПоля(ВыбранныйТип, ИдентификаторСтроки) Экспорт

	Если ВыбранныйТип = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ВыбранныйТип.Значение = "Ссылочный" Тогда
		ВыбратьВидОбъекта(ИдентификаторСтроки);
	Иначе
		СтрокаПоля = ПоляОтбора.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаПоля <> Неопределено Тогда
			УстановитьТипПоля(СтрокаПоля, Новый ОписаниеТипов(ВыбранныйТип.Значение));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидОбъекта(Знач ИдентификаторСтроки)

	ДляСсылочногоТипа = ИдентификаторСтроки <> Неопределено;
	ВидыОбъектов = ДоступныеВидыОбъектов(ДляСсылочногоТипа);
	Если ВидыОбъектов.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Доступные объекты конфигурации не найдены.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораВидаОбъекта", ЭтотОбъект, ИдентификаторСтроки);
	ВидыОбъектов.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Выберите вид объекта'"));

КонецПроцедуры

// Показывает доступные объекты выбранного вида.
//
// Параметры:
//  ВыбранныйВид - ЭлементСпискаЗначений, Неопределено - имя коллекции метаданных или отмена.
//  ИдентификаторСтроки - Число, Неопределено - поле для ссылочного типа или подбор полей.
//
&НаКлиенте
Процедура ПослеВыбораВидаОбъекта(ВыбранныйВид, ИдентификаторСтроки) Экспорт

	Если ВыбранныйВид = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОбъектыКонфигурации = ДоступныеОбъектыКонфигурации(ВыбранныйВид.Значение, ИдентификаторСтроки <> Неопределено);
	Если ОбъектыКонфигурации.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Объектов этого вида с правом чтения нет.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораОбъектаКонфигурации", ЭтотОбъект, ИдентификаторСтроки);
	ОбъектыКонфигурации.ПоказатьВыборЭлемента(Оповещение, НСтр("ru = 'Выберите объект конфигурации'"));

КонецПроцедуры

// Назначает тип ссылки выбранного объекта или предлагает его поля для добавления.
//
// Параметры:
//  ВыбранныйОбъект - ЭлементСпискаЗначений, Неопределено - полное имя объекта или отмена.
//  ИдентификаторСтроки - Число, Неопределено - поле для ссылочного типа или подбор полей.
//
&НаКлиенте
Процедура ПослеВыбораОбъектаКонфигурации(ВыбранныйОбъект, ИдентификаторСтроки) Экспорт

	Если ВыбранныйОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ИдентификаторСтроки <> Неопределено Тогда
		СтрокаПоля = ПоляОтбора.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаПоля <> Неопределено Тогда
			ИмяТипаСсылки = СтрЗаменить(ВыбранныйОбъект.Значение, ".", "Ссылка.");
			УстановитьТипПоля(СтрокаПоля, Новый ОписаниеТипов(ИмяТипаСсылки));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ПоляОбъекта = ДоступныеПоляОбъекта(ВыбранныйОбъект.Значение);
	Если ПоляОбъекта.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У выбранного объекта нет доступных полей для отбора.'"));
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеПодбораПолей", ЭтотОбъект);
	ПоляОбъекта.ПоказатьОтметкуЭлементов(Оповещение, НСтр("ru = 'Отметьте поля для добавления'"));

КонецПроцедуры

// Добавляет отмеченные реквизиты с заголовками и типами метаданных.
//
// Параметры:
//  ВыбранныеПоля - СписокЗначений, Неопределено - поля объекта с пометками или отмена.
//  ПараметрыОповещения - Неопределено - дополнительный контекст.
//
&НаКлиенте
Процедура ПослеПодбораПолей(ВыбранныеПоля, ПараметрыОповещения) Экспорт

	Если ВыбранныеПоля = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИменаПолей = Новый Соответствие;
	Для Каждого СтрокаПоля Из ПоляОтбора Цикл
		ИменаПолей.Вставить(ВРег(СокрЛП(СтрокаПоля.ИмяПоля)), Истина);
	КонецЦикла;
	Для Каждого ВыбранноеПоле Из ВыбранныеПоля Цикл
		ДанныеПоля = ВыбранноеПоле.Значение;
		КлючПоля = ВРег(ДанныеПоля.ИмяПоля);
		Если ВыбранноеПоле.Пометка И ИменаПолей.Получить(КлючПоля) = Неопределено Тогда
			СтрокаПоля = ПоляОтбора.Добавить();
			СтрокаПоля.ИмяПоля = ДанныеПоля.ИмяПоля;
			СтрокаПоля.ЗаголовокПоля = ДанныеПоля.ЗаголовокПоля;
			УстановитьТипПоля(СтрокаПоля, ДанныеПоля.ОписаниеТиповПоля);
			ИменаПолей.Вставить(КлючПоля, Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#Область ИсточникиПолей

&НаСервереБезКонтекста
Функция КоллекцииОбъектовКонфигурации(Знач ДляСсылочногоТипа)

	КоллекцииМетаданных = Новый Структура;
	КоллекцииМетаданных.Вставить("Справочники", НСтр("ru = 'Справочники'"));
	КоллекцииМетаданных.Вставить("Документы", НСтр("ru = 'Документы'"));
	КоллекцииМетаданных.Вставить("ПланыВидовХарактеристик", НСтр("ru = 'Планы видов характеристик'"));
	КоллекцииМетаданных.Вставить("ПланыСчетов", НСтр("ru = 'Планы счетов'"));
	КоллекцииМетаданных.Вставить("ПланыВидовРасчета", НСтр("ru = 'Планы видов расчета'"));
	КоллекцииМетаданных.Вставить("ПланыОбмена", НСтр("ru = 'Планы обмена'"));
	КоллекцииМетаданных.Вставить("БизнесПроцессы", НСтр("ru = 'Бизнес-процессы'"));
	КоллекцииМетаданных.Вставить("Задачи", НСтр("ru = 'Задачи'"));
	Если ДляСсылочногоТипа Тогда
		КоллекцииМетаданных.Вставить("Перечисления", НСтр("ru = 'Перечисления'"));
	Иначе
		КоллекцииМетаданных.Вставить("РегистрыСведений", НСтр("ru = 'Регистры сведений'"));
		КоллекцииМетаданных.Вставить("РегистрыНакопления", НСтр("ru = 'Регистры накопления'"));
		КоллекцииМетаданных.Вставить("РегистрыБухгалтерии", НСтр("ru = 'Регистры бухгалтерии'"));
		КоллекцииМетаданных.Вставить("РегистрыРасчета", НСтр("ru = 'Регистры расчета'"));
	КонецЕсли;
	Возврат КоллекцииМетаданных;

КонецФункции

&НаСервереБезКонтекста
Функция ДоступныеВидыОбъектов(Знач ДляСсылочногоТипа)

	ВидыОбъектов = Новый СписокЗначений;
	Для Каждого ВидОбъекта Из КоллекцииОбъектовКонфигурации(ДляСсылочногоТипа) Цикл
		Если Метаданные[ВидОбъекта.Ключ].Количество() > 0 Тогда
			ВидыОбъектов.Добавить(ВидОбъекта.Ключ, ВидОбъекта.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат ВидыОбъектов;

КонецФункции

&НаСервереБезКонтекста
Функция ДоступныеОбъектыКонфигурации(Знач ИмяКоллекции, Знач ДляСсылочногоТипа)

	ДоступныеОбъекты = Новый СписокЗначений;
	Если Не КоллекцииОбъектовКонфигурации(ДляСсылочногоТипа).Свойство(ИмяКоллекции) Тогда
		Возврат ДоступныеОбъекты;
	КонецЕсли;
	Для Каждого МетаданныеОбъекта Из Метаданные[ИмяКоллекции] Цикл
		Если ПравоДоступа("Чтение", МетаданныеОбъекта) Тогда
			ЗаголовокОбъекта = ЗаголовокСИменем(МетаданныеОбъекта.Синоним, МетаданныеОбъекта.Имя);
			ДоступныеОбъекты.Добавить(МетаданныеОбъекта.ПолноеИмя(), ЗаголовокОбъекта);
		КонецЕсли;
	КонецЦикла;
	ДоступныеОбъекты.СортироватьПоПредставлению();
	Возврат ДоступныеОбъекты;

КонецФункции

&НаСервереБезКонтекста
Функция ДоступныеПоляОбъекта(Знач ИмяОбъекта)

	ПоляОбъекта = Новый СписокЗначений;
	МетаданныеОбъекта = Метаданные.НайтиПоПолномуИмени(ИмяОбъекта);
	Если МетаданныеОбъекта = Неопределено Или Не ПравоДоступа("Чтение", МетаданныеОбъекта) Тогда
		Возврат ПоляОбъекта;
	КонецЕсли;
	ДобавитьПоляМетаданных(ПоляОбъекта, МетаданныеОбъекта.СтандартныеРеквизиты);
	ДобавитьПоляМетаданных(ПоляОбъекта, МетаданныеОбъекта.Реквизиты);
	Если Лев(ИмяОбъекта, 7) = "Регистр" Тогда
		ДобавитьПоляМетаданных(ПоляОбъекта, МетаданныеОбъекта.Измерения);
		ДобавитьПоляМетаданных(ПоляОбъекта, МетаданныеОбъекта.Ресурсы);
	КонецЕсли;
	ПоляОбъекта.СортироватьПоПредставлению();
	Возврат ПоляОбъекта;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьПоляМетаданных(ПоляОбъекта, РеквизитыМетаданных)

	Для Каждого РеквизитМетаданных Из РеквизитыМетаданных Цикл
		ТипРеквизита = РеквизитМетаданных.Тип;
		Если ТипРеквизита.Типы().Количество() = 0 Или ТипРеквизита.СодержитТип(Тип("ХранилищеЗначения")) Тогда
			Продолжить;
		КонецЕсли;
		ЗаголовокПоля = ?(ПустаяСтрока(РеквизитМетаданных.Синоним), РеквизитМетаданных.Имя, РеквизитМетаданных.Синоним);
		ДанныеПоля = Новый Структура("ИмяПоля, ЗаголовокПоля, ОписаниеТиповПоля",
			РеквизитМетаданных.Имя, ЗаголовокПоля, ТипРеквизита);
		ПоляОбъекта.Добавить(ДанныеПоля, ЗаголовокСИменем(ЗаголовокПоля, РеквизитМетаданных.Имя));
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаголовокСИменем(Знач НаименованиеОбъекта, Знач ТехническоеИмя)

	Если ПустаяСтрока(НаименованиеОбъекта) Или НаименованиеОбъекта = ТехническоеИмя Тогда
		Возврат ТехническоеИмя;
	КонецЕсли;
	Возврат СтрШаблон("%1 (%2)", НаименованиеОбъекта, ТехническоеИмя);

КонецФункции

&НаСервереБезКонтекста
Функция ОтчетыСоСхемойОтбора()

	ДоступныеОтчеты = Новый СписокЗначений;
	Для Каждого МетаданныеОтчета Из Метаданные.Отчеты Цикл
		Если МетаданныеОтчета.ОсновнаяСхемаКомпоновкиДанных <> Неопределено
			И ПравоДоступа("Использование", МетаданныеОтчета) Тогда
			ДоступныеОтчеты.Добавить(МетаданныеОтчета.Имя, Строка(МетаданныеОтчета));
		КонецЕсли;
	КонецЦикла;
	ДоступныеОтчеты.СортироватьПоПредставлению();
	Возврат ДоступныеОтчеты;

КонецФункции

&НаСервере
Процедура ЗагрузитьПоляОтчета(Знач ИмяОтчета)

	МетаданныеОтчета = Метаданные.Отчеты.Найти(ИмяОтчета);
	Если МетаданныеОтчета = Неопределено
		Или МетаданныеОтчета.ОсновнаяСхемаКомпоновкиДанных = Неопределено
		Или Не ПравоДоступа("Использование", МетаданныеОтчета) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Не удалось загрузить поля выбранного отчета.'"));
		Возврат;
	КонецЕсли;
	Если ЕстьУсловияОтбора() Тогда
		Возврат;
	КонецЕсли;
	ИмяМакета = МетаданныеОтчета.ОсновнаяСхемаКомпоновкиДанных.Имя;
	СхемаОтбора = Отчеты[ИмяОтчета].ПолучитьМакет(ИмяМакета);
	ИнициализироватьОтбор(СхемаОтбора, ТекущийОтбор());

КонецПроцедуры

#КонецОбласти

#Область РедактированиеПолей

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТипПоля(СтрокаПоля, ОписаниеТиповПоля)

	СтрокаПоля.ОписаниеТиповПоля = ОписаниеТиповПоля;
	ИменаТипов = Новый Массив;
	Для Каждого ТипЗначенияПоля Из ОписаниеТиповПоля.Типы() Цикл
		ИменаТипов.Добавить(Строка(ТипЗначенияПоля));
	КонецЦикла;
	СтрокаПоля.ТипДанных = СтрСоединить(ИменаТипов, ", ");

КонецПроцедуры

&НаСервереБезКонтекста
Функция РедактируемыйНаборПолей(СхемаОтбора)

	Если СхемаОтбора = Неопределено Или СхемаОтбора.НаборыДанных.Количество() <> 1
		Или СхемаОтбора.ВычисляемыеПоля.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	НаборПолей = СхемаОтбора.НаборыДанных[0];
	Если ТипЗнч(НаборПолей) <> Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ПолеСхемы Из НаборПолей.Поля Цикл
		Если ТипЗнч(ПолеСхемы) <> Тип("ПолеНабораДанныхСхемыКомпоновкиДанных")
			Или ПолеСхемы.Поле <> ПолеСхемы.ПутьКДанным Или Не ИмяПоляДопустимо(ПолеСхемы.ПутьКДанным) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат НаборПолей;

КонецФункции

&НаСервере
Процедура ПодготовитьВводПолей()

	СхемаОтбора = ТекущаяСхемаОтбора();
	НаборПолей = РедактируемыйНаборПолей(СхемаОтбора);
	Если СхемаОтбора <> Неопределено И НаборПолей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПоляОтбора.Очистить();
	Если НаборПолей <> Неопределено Тогда
		Для Каждого ПолеСхемы Из НаборПолей.Поля Цикл
			СтрокаПоля = ПоляОтбора.Добавить();
			СтрокаПоля.ИмяПоля = ПолеСхемы.ПутьКДанным;
			СтрокаПоля.ИсходноеИмяПоля = ПолеСхемы.ПутьКДанным;
			СтрокаПоля.ЗаголовокПоля = ПолеСхемы.Заголовок;
			УстановитьТипПоля(СтрокаПоля, ПолеСхемы.ТипЗначения);
		КонецЦикла;
	КонецЕсли;
	ПоказатьВводПолей(Элементы, Истина, СхемаОтбора <> Неопределено, Истина);

КонецПроцедуры

&НаСервере
Процедура ПроверитьИЗагрузитьПоля()

	Если ПоляОтбора.Количество() = 0 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Добавьте поле вручную или подберите из объекта конфигурации.'"), "ПоляОтбора");
		Возврат;
	КонецЕсли;
	Переименования = Новый Соответствие;
	ТипыНовыхПолей = ТипыВведенныхПолей(Переименования);
	Если ТипыНовыхПолей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СхемаОтбора = ТекущаяСхемаОтбора();
	НаборПолей = РедактируемыйНаборПолей(СхемаОтбора);
	Если СхемаОтбора <> Неопределено И НаборПолей = Неопределено Тогда
		СообщитьОбОшибке(НСтр("ru = 'Выберите поля этой схемы при добавлении условия.'"));
		Возврат;
	КонецЕсли;
	СохраненныйОтбор = ТекущийОтбор();
	Если Не ПоляУсловийДопустимы(СохраненныйОтбор, НаборПолей, ТипыНовыхПолей, Переименования) Тогда
		Возврат;
	КонецЕсли;
	Если СхемаОтбора = Неопределено Тогда
		СхемаОтбора = СхемаСРучнымиПолями();
		НаборПолей = СхемаОтбора.НаборыДанных[0];
	КонецЕсли;
	ОбновитьНаборПолей(НаборПолей);
	ИнициализироватьОтбор(СхемаОтбора, СохраненныйОтбор, Переименования);

КонецПроцедуры

&НаСервере
Функция ТипыВведенныхПолей(Переименования)

	ТипыПолей = Новый Соответствие;
	Для НомерПоля = 0 По ПоляОтбора.Количество() - 1 Цикл
		СтрокаПоля = ПоляОтбора[НомерПоля];
		ИмяПоля = СокрЛП(СтрокаПоля.ИмяПоля);
		ПутьКСтроке = СтрШаблон("ПоляОтбора[%1].", Формат(НомерПоля, "ЧГ=0"));
		КлючПоля = ВРег(ИмяПоля);
		Если Не ИмяПоляДопустимо(ИмяПоля) Тогда
			СообщитьОбОшибке(НСтр("ru = 'Начните имя с буквы или _. Далее допустимы буквы, цифры и _.'"),
				ПутьКСтроке + "ИмяПоля");
			Возврат Неопределено;
		КонецЕсли;
		Если ТипыПолей.Получить(КлючПоля) <> Неопределено Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Имя поля «%1» уже используется.'"), ИмяПоля),
				ПутьКСтроке + "ИмяПоля");
			Возврат Неопределено;
		КонецЕсли;
		ОписаниеПоля = СтрокаПоля.ОписаниеТиповПоля;
		Если ОписаниеПоля = Неопределено Или ОписаниеПоля.Типы().Количество() = 0 Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Выберите тип для поля «%1».'"), ИмяПоля), ПутьКСтроке + "ТипДанных");
			Возврат Неопределено;
		КонецЕсли;
		ТипыПолей.Вставить(КлючПоля, ОписаниеПоля);
		Если Не ПустаяСтрока(СтрокаПоля.ИсходноеИмяПоля) И СтрокаПоля.ИсходноеИмяПоля <> ИмяПоля Тогда
			Переименования.Вставить(ВРег(СтрокаПоля.ИсходноеИмяПоля), ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат ТипыПолей;

КонецФункции

&НаСервереБезКонтекста
Функция ИмяПоляДопустимо(Знач ИмяПоля)

	Если ПустаяСтрока(ИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;
	Буквы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ_";
	БуквыИЦифры = Буквы + "0123456789";
	Если СтрНайти(Буквы, ВРег(Лев(ИмяПоля, 1))) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для ПозицияЗнака = 2 По СтрДлина(ИмяПоля) Цикл
		Если СтрНайти(БуквыИЦифры, ВРег(Сред(ИмяПоля, ПозицияЗнака, 1))) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция СхемаСРучнымиПолями()

	СхемаОтбора = Новый СхемаКомпоновкиДанных;
	ИсточникПолей = СхемаОтбора.ИсточникиДанных.Добавить();
	ИсточникПолей.Имя = "Local";
	ИсточникПолей.ТипИсточникаДанных = "Local";
	НаборПолей = СхемаОтбора.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборПолей.Имя = "Мечел_ПоляОтбора";
	НаборПолей.ИмяОбъекта = "ПоляОтбора";
	НаборПолей.ИсточникДанных = ИсточникПолей.Имя;
	Возврат СхемаОтбора;

КонецФункции

&НаСервере
Процедура ОбновитьНаборПолей(НаборПолей)

	ПоляСхемыПоИменам = Новый Соответствие;
	Для Каждого ПолеСхемы Из НаборПолей.Поля Цикл
		ПоляСхемыПоИменам.Вставить(ВРег(ПолеСхемы.ПутьКДанным), ПолеСхемы);
	КонецЦикла;
	Для Каждого СтрокаПоля Из ПоляОтбора Цикл
		КлючПоля = ВРег(СтрокаПоля.ИсходноеИмяПоля);
		ПолеСхемы = ПоляСхемыПоИменам.Получить(КлючПоля);
		Если ПолеСхемы = Неопределено Тогда
			ПолеСхемы = НаборПолей.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Иначе
			ПоляСхемыПоИменам.Удалить(КлючПоля);
		КонецЕсли;
		ИмяПоля = СокрЛП(СтрокаПоля.ИмяПоля);
		ПолеСхемы.ПутьКДанным = ИмяПоля;
		ПолеСхемы.Поле = ИмяПоля;
		ПолеСхемы.Заголовок = ?(ПустаяСтрока(СтрокаПоля.ЗаголовокПоля), ИмяПоля, СокрЛП(СтрокаПоля.ЗаголовокПоля));
		ПолеСхемы.ТипЗначения = СтрокаПоля.ОписаниеТиповПоля;
	КонецЦикла;
	Для Каждого СтароеПоле Из ПоляСхемыПоИменам Цикл
		НаборПолей.Поля.Удалить(СтароеПоле.Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПоляУсловийДопустимы(СохраненныйОтбор, НаборПолей, ТипыНовыхПолей, Переименования)

	Если ТипЗнч(СохраненныйОтбор) <> Тип("ОтборКомпоновкиДанных") Тогда
		Возврат Истина;
	КонецЕсли;
	ТипыСтарыхПолей = Новый Соответствие;
	Если НаборПолей <> Неопределено Тогда
		Для Каждого ПолеСхемы Из НаборПолей.Поля Цикл
			ТипыСтарыхПолей.Вставить(ВРег(ПолеСхемы.ПутьКДанным), ПолеСхемы.ТипЗначения);
		КонецЦикла;
	КонецЕсли;
	ИспользуемыеПоля = Новый Соответствие;
	ЗаполнитьИспользуемыеПоля(СохраненныйОтбор.Элементы, ИспользуемыеПоля);
	Для Каждого ИспользуемоеПоле Из ИспользуемыеПоля Цикл
		ПрежнееИмя = ИспользуемоеПоле.Значение;
		НовоеИмя = Переименования.Получить(ИспользуемоеПоле.Ключ);
		ИмяПослеПравок = ?(НовоеИмя = Неопределено, ПрежнееИмя, НовоеИмя);
		НовыйТипПоля = ТипыНовыхПолей.Получить(ВРег(ИмяПослеПравок));
		Если НовыйТипПоля = Неопределено Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Верните поле «%1» или измените использующее его условие.'"),
				ПрежнееИмя), "ПоляОтбора");
			Возврат Ложь;
		КонецЕсли;
		СтарыйТипПоля = ТипыСтарыхПолей.Получить(ИспользуемоеПоле.Ключ);
		Если СтарыйТипПоля <> Неопределено И Не ТипыПолейСовпадают(СтарыйТипПоля, НовыйТипПоля) Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Поле «%1» используется в условиях. Сохраните его текущий тип.'"),
				ПрежнееИмя), "ПоляОтбора");
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Функция ТипыПолейСовпадают(СтарыйТипПоля, НовыйТипПоля)

	Если СтарыйТипПоля.Типы().Количество() <> НовыйТипПоля.Типы().Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ТипЗначенияПоля Из СтарыйТипПоля.Типы() Цикл
		Если Не НовыйТипПоля.СодержитТип(ТипЗначенияПоля) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьИспользуемыеПоля(УсловияОтбора, ИспользуемыеПоля)

	Для Каждого Условие Из УсловияОтбора Цикл
		Если ТипЗнч(Условие) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ЗаполнитьИспользуемыеПоля(Условие.Элементы, ИспользуемыеПоля);
		Иначе
			ДобавитьИспользуемоеПоле(Условие.ЛевоеЗначение, ИспользуемыеПоля);
			ДобавитьИспользуемоеПоле(Условие.ПравоеЗначение, ИспользуемыеПоля);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьИспользуемоеПоле(Знач Операнд, ИспользуемыеПоля)

	Если ТипЗнч(Операнд) = Тип("ПолеКомпоновкиДанных") Тогда
		ИмяПоля = СтрРазделить(Строка(Операнд), ".")[0];
		ИспользуемыеПоля.Вставить(ВРег(ИмяПоля), ИмяПоля);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РаботаСКомпоновщиком

&НаСервере
Функция ТекущаяСхемаОтбора()

	Возврат ?(ПустаяСтрока(АдресСхемыОтбора), Неопределено, ПолучитьИзВременногоХранилища(АдресСхемыОтбора));

КонецФункции

&НаСервере
Функция ТекущийОтбор()

	Если Не ПустаяСтрока(АдресСхемыОтбора) Тогда
		Возврат КомпоновщикНастроек.ПолучитьНастройки().Отбор;
	КонецЕсли;
	ДанныеОтбора = ПолучитьИзВременногоХранилища(АдресПараметров);
	Возврат ДанныеОтбора.Значение;

КонецФункции

&НаСервере
Процедура ИнициализироватьОтбор(СхемаОтбора, СохраненныйОтбор = Неопределено, Переименования = Неопределено)

	Если ПустаяСтрока(АдресСхемыОтбора) Тогда
		АдресСхемыОтбора = ПоместитьВоВременноеХранилище(СхемаОтбора, УникальныйИдентификатор);
	Иначе
		ПоместитьВоВременноеХранилище(СхемаОтбора, АдресСхемыОтбора);
	КонецЕсли;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыОтбора));
	УсловияОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы;
	УсловияОтбора.Очистить();
	Если ТипЗнч(СохраненныйОтбор) = Тип("ОтборКомпоновкиДанных") Тогда
		ПеренестиУсловия(СохраненныйОтбор.Элементы, УсловияОтбора, Переименования);
	КонецЕсли;
	ПоказатьВводПолей(Элементы, Ложь, Истина, РедактируемыйНаборПолей(СхемаОтбора) <> Неопределено);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СообщитьОбОшибке(Знач ТекстСообщения, Знач ПутьКПолю = "")

	Уведомление = Новый СообщениеПользователю;
	Уведомление.Текст = ТекстСообщения;
	Уведомление.Поле = ПутьКПолю;
	Уведомление.Сообщить();

КонецПроцедуры

&НаСервере
Функция ЕстьУсловияОтбора()

	Возврат ЗначениеЗаполнено(АдресСхемыОтбора) И КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество() > 0;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьВводПолей(КоллекцияЭлементов, Знач ВводПолей, Знач ЕстьСхема, Знач ПоляРедактируются)

	КоллекцияЭлементов.ГруппаПолей.Видимость = ВводПолей;
	КоллекцияЭлементов.ВернутьсяКУсловиям.Видимость = ЕстьСхема;
	КоллекцияЭлементов.НастройкиОтбор.Видимость = Не ВводПолей И ЕстьСхема;
	КоллекцияЭлементов.Применить.Видимость = Не ВводПолей И ЕстьСхема;
	КоллекцияЭлементов.ЗадатьПоляВручную.Видимость = Не ВводПолей И ПоляРедактируются;
	КоллекцияЭлементов.ВыбратьПоляОбъекта.Видимость = ВводПолей;
	КоллекцияЭлементов.ПодсказкаСхемыОтчета.Видимость = Не ВводПолей И ЕстьСхема И Не ПоляРедактируются;
	КоллекцияЭлементов.ИспользоватьПоля.Заголовок = ?(ЕстьСхема, НСтр("ru = 'Применить поля'"),
		НСтр("ru = 'Перейти к условиям'"));

КонецПроцедуры

&НаСервере
Процедура СохранитьРезультат()

	ДанныеОтбора = ПолучитьИзВременногоХранилища(АдресПараметров);
	ДанныеОтбора.СхемаОтбора = ТекущаяСхемаОтбора();
	ДанныеОтбора.Значение = ТекущийОтбор();
	ПоместитьВоВременноеХранилище(ДанныеОтбора, АдресПараметров);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПеренестиУсловия(УсловияИсточника, УсловияПриемника, Переименования = Неопределено)

	Для Каждого Условие Из УсловияИсточника Цикл
		КопияУсловия = УсловияПриемника.Добавить(ТипЗнч(Условие));
		ЗаполнитьЗначенияСвойств(КопияУсловия, Условие,
			"Использование, Представление, РежимОтображения, ИдентификаторПользовательскойНастройки");
		Если ТипЗнч(Условие) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			КопияУсловия.ТипГруппы = Условие.ТипГруппы;
			ПеренестиУсловия(Условие.Элементы, КопияУсловия.Элементы, Переименования);
		Иначе
			КопияУсловия.ЛевоеЗначение = ОперандПослеПереименования(Условие.ЛевоеЗначение, Переименования);
			КопияУсловия.ВидСравнения = Условие.ВидСравнения;
			КопияУсловия.ПравоеЗначение = ОперандПослеПереименования(Условие.ПравоеЗначение, Переименования);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОперандПослеПереименования(Знач Операнд, Переименования)

	Если Переименования = Неопределено Или ТипЗнч(Операнд) <> Тип("ПолеКомпоновкиДанных") Тогда
		Возврат Операнд;
	КонецЕсли;
	ПутьКПолю = Строка(Операнд);
	ИмяПоля = СтрРазделить(ПутьКПолю, ".")[0];
	НовоеИмя = Переименования.Получить(ВРег(ИмяПоля));
	Если НовоеИмя = Неопределено Тогда
		Возврат Операнд;
	КонецЕсли;
	Возврат Новый ПолеКомпоновкиДанных(НовоеИмя + Сред(ПутьКПолю, СтрДлина(ИмяПоля) + 1));

КонецФункции

#КонецОбласти

#КонецОбласти
