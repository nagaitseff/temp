#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	АдресПараметров = Параметры.АдресПараметров;
	Данные = ПолучитьИзВременногоХранилища(АдресПараметров);
	АдресСхемы = ПоместитьВоВременноеХранилище(Данные.Схема, УникальныйИдентификатор);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы));
	Если ТипЗнч(Данные.Отбор) = Тип("ОтборКомпоновкиДанных") Тогда
		ПеренестиУсловия(Данные.Отбор.Элементы, КомпоновщикНастроек.Настройки.Отбор.Элементы);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура Применить(Команда)
	СохранитьРезультат();
	Закрыть(АдресПараметров);
КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура СохранитьРезультат()
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ПоместитьВоВременноеХранилище(Настройки.Отбор, АдресПараметров);
КонецПроцедуры
&НаСервере
Процедура ПеренестиУсловия(Источник, Приемник)
	Для Каждого Условие Из Источник Цикл
		Новое = Приемник.Добавить(ТипЗнч(Условие));
		Если ТипЗнч(Условие) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ЗаполнитьЗначенияСвойств(Новое, Условие, "Использование,ТипГруппы");
			ПеренестиУсловия(Условие.Элементы, Новое.Элементы);
		Иначе
			ЗаполнитьЗначенияСвойств(Новое, Условие, "Использование,ЛевоеЗначение,ВидСравнения,ПравоеЗначение");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти
