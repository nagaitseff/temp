// ============================================================
// АПИКлиент.os — транспорт к IT_TechAdmin API
//
// Создание:
//   Клиент = Новый АПИКлиент;                                      // адрес по умолчанию
//   Клиент = Новый АПИКлиент("https://ukm-web/ad/IT/IT_TechAdmin/hs/");
//   Клиент.Токен = "erp-restore-api-token";
//
// Аутентификация: по умолчанию доменная (текущий пользователь ОС).
// Если передать логин/пароль — используется basic-аутентификация.
// Токен всегда уходит заголовком "token", а не в URL — так он не попадает
// в логи веб-сервера (дока разрешает query/тело/заголовки, выбран самый чистый вариант).
//
// Версия: 1.0.0
// Совместимость: oscript 2.1.0+
// ============================================================

Перем Токен Экспорт;
Перем ТаймаутСекунд Экспорт;
Перем ДоменнаяАутентификация Экспорт;
Перем ПоследнийКод Экспорт;            // разобранный код последнего ответа
Перем ПоследнееСообщение Экспорт;      // понятный текст последней ошибки
Перем ВремяЖизниКэша Экспорт;          // сек, кэш справочников (агенты/кластеры/инфобазы)

Перем Протокол;
Перем СерверХост;
Перем Порт;
Перем ПутьБазы;
Перем Логин;
Перем Пароль;
Перем Кэш;
Перем Утилиты;

// ------------------------------------------------------------
// Конструктор
// ------------------------------------------------------------

Процедура ПриСозданииОбъекта(Знач Адрес = "https://ukm-web/ad/IT/IT_TechAdmin/hs/",
	Знач ИмяПользователя = "", Знач ПарольПользователя = "",
	Знач ИспользоватьДоменнуюАутентификацию = Истина)

	Токен = "";
	ТаймаутСекунд = 120;
	ДоменнаяАутентификация = ИспользоватьДоменнуюАутентификацию;
	ПоследнийКод = Неопределено;
	ПоследнееСообщение = "";
	ВремяЖизниКэша = 60;

	Протокол = "https";
	СерверХост = "";
	Порт = 443;
	ПутьБазы = "/";

	Логин = ИмяПользователя;
	Пароль = ПарольПользователя;

	Кэш = Новый Соответствие;

	Утилиты = ПодключитьСценарий("src\Модули\АПИСлужебный.os");
	// если класс кладётся в другое место — поправьте относительный путь выше

	УстановитьТочкуВхода(Адрес);
КонецПроцедуры

Процедура УстановитьТочкуВхода(Знач Адрес) Экспорт
	Разбор = Утилиты.РазобратьТочкуВхода(Адрес);
	Протокол = Разбор.Протокол;
	СерверХост = Разбор.Сервер;
	Порт = Разбор.Порт;
	ПутьБазы = Разбор.Путь;
КонецПроцедуры

// ------------------------------------------------------------
// Транспорт (внутреннее)
// ------------------------------------------------------------

Функция СформироватьСоединение()
	Если Логин = "" Тогда
		// доменная аутентификация: логин/пароль не передаются,
		// идём от текущего пользователя ОС
		Возврат Новый HTTPСоединение(СерверХост, Порт, "", "", Неопределено,
			ТаймаутСекунд, Новый ЗащищенноеСоединениеOpenSSL, Истина);
	КонецЕсли;

	Защищённое = ?(Протокол = "https", Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
	Возврат Новый HTTPСоединение(СерверХост, Порт, Логин, Пароль, Неопределено,
		ТаймаутСекунд, Защищённое);
КонецФункции

// Единая точка всех запросов.
//   МетодHTTP  — "GET" / "POST"
//   Путь       — путь после базового, например "agents" или "loading1c/status"
//   ПараметрыЗапроса — Структура/Соответствие GET-параметров (может быть Неопределено)
//   Тело       — Структура для POST-тела (может быть Неопределено)
// Возвращает структуру {Успех, Данные, КодОтвета, Сообщение}.
Функция ВыполнитьЗапрос(Знач МетодHTTP, Знач Путь, ПараметрыЗапроса = Неопределено, Тело = Неопределено)
	Результат = Новый Структура("Успех, Данные, КодОтвета, Сообщение",
		Ложь, Неопределено, 0, "");

	ПолныйПуть = ПутьБазы + Путь;
	СтрокаПараметров = Утилиты.СтрокаПараметровЗапроса(ПараметрыЗапроса);
	Если СтрокаПараметров <> "" Тогда
		ПолныйПуть = ПолныйПуть + "?" + СтрокаПараметров;
	КонецЕсли;

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	Если Токен <> "" Тогда
		Заголовки.Вставить("token", Токен);
	КонецЕсли;

	Запрос = Новый HTTPЗапрос(ПолныйПуть, Заголовки);
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос = Новый HTTPЗапрос(ПолныйПуть, Заголовки);
		Запрос.УстановитьТелоИзСтроки(ЗаписатьJSON(Тело), КодировкаТекста.UTF8);
	КонецЕсли;

	Попытка
		Соединение = СформироватьСоединение();
		Если МетодHTTP = "GET" Тогда
			Ответ = Соединение.Получить(Запрос);
		Иначе
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		КонецЕсли;
	Исключение
		Результат.Сообщение = "Ошибка соединения: " + ОписаниеОшибки();
		ПоследнееСообщение = Результат.Сообщение;
		Возврат Результат;
	КонецПопытки;

	Результат.КодОтвета = Ответ.КодСостояния;
	ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();

	Данные = Неопределено;
	Если Не ПустаяСтрока(ТекстОтвета) Тогда
		Попытка
			Данные = ПрочитатьJSON(ТекстОтвета);
		Исключение
			Данные = Неопределено;
		КонецПопытки;
	КонецЕсли;

	Если Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300 Тогда
		Результат.Успех = Истина;
		Результат.Данные = Данные;
	Иначе
		Результат.Сообщение = Утилиты.ОписаниеОшибки(Данные);
		Если ПустаяСтрока(Результат.Сообщение) Тогда
			Результат.Сообщение = "HTTP " + Ответ.КодСостояния;
		КонецЕсли;
	КонецЕсли;

	// разбор кода результата API (формат "00.xx" / "01.xx")
	Если Данные <> Неопределено Тогда
		ПоследнийКод = Утилиты.РазобратьКодОтвета(Утилиты.ЗначениеПоляJSON(Данные, "code", Неопределено));
		Если ПоследнийКод <> Неопределено И Не ПоследнийКод.Успех Тогда
			Результат.Успех = Ложь;
			Если ПустаяСтрока(Результат.Сообщение) Тогда
				Результат.Сообщение = ПоследнийКод.Описание;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ПоследнееСообщение = Результат.Сообщение;
	Возврат Результат;
КонецФункции

// ------------------------------------------------------------
// Кэш
// ------------------------------------------------------------

Процедура ЗаписатьВКэш(Знач Ключ, Знач Значение) Экспорт
	Кэш.Вставить(Ключ, Новый Структура("Значение, Время", Значение, ТекущаяДата()));
КонецПроцедуры

Функция ПолучитьИзКэша(Знач Ключ)
	Запись = Кэш.Получить(Ключ);
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если (ТекущаяДата() - Запись.Время) > (ВремяЖизниКэша * 8) Тогда
		// ТекущаяДата() в секундах; допускаем небольшой запас
		Кэш.Удалить(Ключ);
		Возврат Неопределено;
	КонецЕсли;

	Возврат Запись.Значение;
КонецФункции

Процедура ОчиститьКэш() Экспорт
	Кэш.Очистить();
КонецПроцедуры

// ------------------------------------------------------------
// Справочники: агенты, кластеры, инфобазы, пользователи
// ------------------------------------------------------------

Функция ПолучитьАгентов(Знач ИспользоватьКэш = Истина) Экспорт
	Если ИспользоватьКэш Тогда
		ИзКэша = ПолучитьИзКэша("agents");
		Если ИзКэша <> Неопределено Тогда
			Возврат Новый Структура("Успех, Данные, КодОтвета, Сообщение", Истина, ИзКэша, 200, "");
		КонецЕсли;
	КонецЕсли;

	Ответ = ВыполнитьЗапрос("GET", "agents");
	Если Ответ.Успех И ИспользоватьКэш Тогда
		ЗаписатьВКэш("agents", Ответ.Данные);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция ПолучитьКластеры(Знач Агент = Неопределено) Экспорт
	Параметры = Неопределено;
	Если Агент <> Неопределено Тогда
		Параметры = Новый Структура("agent", Строка(Агент));
	КонецЕсли;
	Возврат ВыполнитьЗапрос("GET", "clusters", Параметры);
КонецФункции

Функция ПолучитьИнфобазы(Знач Агент = Неопределено, Знач Кластер = Неопределено) Экспорт
	Параметры = Новый Структура;
	Если Агент <> Неопределено Тогда
		Параметры.Вставить("agent", Строка(Агент));
	КонецЕсли;
	Если Кластер <> Неопределено Тогда
		Параметры.Вставить("cluster", Строка(Кластер));
	КонецЕсли;
	Возврат ВыполнитьЗапрос("GET", "infobases", Параметры);
КонецФункции

Функция ПолучитьПользователей() Экспорт
	Возврат ВыполнитьЗапрос("GET", "users");
КонецФункции

// ------------------------------------------------------------
// Сеансы
// ------------------------------------------------------------

// Возвращает активные сеансы базы. Можно отфильтровать по пользователю/приложению:
//   Отфильтровать = Новый Структура("Пользователь, ИсключитьПользователя, Приложение", "Иванов", "", "designer");
Функция ПолучитьСеансы(Знач ИмяБазы, КритерииОтбора = Неопределено) Экспорт
	Ответ = ВыполнитьЗапрос("GET", "sessions", Новый Структура("base", ИмяБазы));
	Если Ответ.Успех И КритерииОтбора <> Неопределено Тогда
		Сеансы = Утилиты.ЗначениеПоляJSON(Ответ.Данные, "sessions", Неопределено);
		Если Сеансы = Неопределено Тогда
			Сеансы = Ответ.Данные;
		КонецЕсли;
		Ответ.Данные = Утилиты.ОтфильтроватьСеансы(Сеансы, КритерииОтбора);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Завершает сеанс и проверяет, что он действительно пропал.
//   Сеанс — Структура/Соответствие с полем session (идентификатор сеанса)
//   ИмяБазы — имя базы, в списке сеансов которой сеанс должен исчезнуть
// Особый случай: код 00.12 — "ошибка удаления сеанса по таймауту";
// делается один повтор.
Функция ЗавершитьСеанс(Сеанс, Знач ИмяБаза = "") Экспорт
	РезультатОшибки = Новый Структура("Успех, Данные, КодОтвета, Сообщение", Ложь, Неопределено, 0, "");

	Идентификатор = Утилиты.ЗначениеПоляJSON(Сеанс, "session",
		Утилиты.ЗначениеПоляJSON(Сеанс, "Сеанс", ""));
	Если ПустаяСтрока(СокрЛП(Строка(Идентификатор))) Тогда
		РезультатОшибки.Сообщение = "Не найден идентификатор сеанса";
		ПоследнееСообщение = РезультатОшибки.Сообщение;
		Возврат РезультатОшибки;
	КонецЕсли;

	Ответ = ВыполнитьЗапрос("POST", "sessions/kill", Неопределено,
		Новый Структура("session", Идентификатор));

	// повтор при таймауте удаления (код 00.12)
	Если Не Ответ.Успех И ПоследнийКод <> Неопределено
		И ПоследнийКод.Основной = 0 И ПоследнийКод.Дополнительный = 12 Тогда
		Ответ = ВыполнитьЗапрос("POST", "sessions/kill", Неопределено,
			Новый Структура("session", Идентификатор));
	КонецЕсли;

	Если Не Ответ.Успех Тогда
		Возврат Ответ;
	КонецЕсли;

	// проверка "не остались ли лишние"
	Если ИмяБаза <> "" Тогда
		Пауза(2);
		Проверка = ВыполнитьЗапрос("GET", "sessions", Новый Структура("base", ИмяБаза));
		Если Проверка.Успех Тогда
			Список = Утилиты.ЗначениеПоляJSON(Проверка.Данные, "sessions", Проверка.Данные);
			Для Каждого Оставшийся Из Список Цикл
				Если Строка(Утилиты.ЗначениеПоляJSON(Оставшийся, "session", "")) = Строка(Идентификатор) Тогда
					Ответ.Успех = Ложь;
					Ответ.Сообщение = "Сеанс " + Идентификатор + " не завершился";
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Возврат Ответ;
КонецФункции

// Завершает все сеансы базы, прошедшие фильтр. Возвращает число завершённых.
Функция ЗавершитьСеансыБазы(Знач ИмяБазы, КритерииОтбора = Неопределено) Экспорт
	Итог = Новый Структура("Успех, Количество, Сообщение", Истина, 0, "");

	Список = ПолучитьСеансы(ИмяБазы, КритерииОтбора);
	Если Не Список.Успех Тогда
		Итог.Успех = Ложь;
		Итог.Сообщение = Список.Сообщение;
		Возврат Итог;
	КонецЕсли;

	Для Каждого Сеанс Из Список.Данные Цикл
		Ответ = ЗавершитьСеанс(Сеанс, ИмяБазы);
		Если Ответ.Успех Тогда
			Итог.Количество = Итог.Количество + 1;
		Иначе
			Итог.Успех = Ложь;
			Итог.Сообщение = Ответ.Сообщение;
		КонецЕсли;
	КонецЦикла;

	Возврат Итог;
КонецФункции

// ------------------------------------------------------------
// Блокировка базы
// ------------------------------------------------------------

// Блокирует базу. Поля тела (сверены с API):
//   base, server, port, reason, code, description, author, phone, start, stop
// Параметры: Сервер, Порт, База + необязательные Причина, Код, Описание,
// Автор, Телефон, Начало, Окончание.
Функция ЗаблокироватьБазу(Параметры) Экспорт
	РезультатОшибки = Новый Структура("Успех, Данные, КодОтвета, Сообщение", Ложь, Неопределено, 0, "");
	Если Параметры = Неопределено Тогда
		РезультатОшибки.Сообщение = "Параметры блокировки не переданы";
		Возврат РезультатОшибки;
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("base",        Строка(Утилиты.ЗначениеПоляJSON(Параметры, "База", Утилиты.ЗначениеПоляJSON(Параметры, "base", ""))));
	Тело.Вставить("server",      Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Сервер", Утилиты.ЗначениеПоляJSON(Параметры, "server", ""))));
	Тело.Вставить("port",        Утилиты.ЧислоИзСтроки(Утилиты.ЗначениеПоляJSON(Параметры, "Порт", Утилиты.ЗначениеПоляJSON(Параметры, "port", 0))));
	Тело.Вставить("reason",      Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Причина", Утилиты.ЗначениеПоляJSON(Параметры, "reason", ""))));
	Тело.Вставить("code",        Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Код", Утилиты.ЗначениеПоляJSON(Параметры, "code", ""))));
	Тело.Вставить("description", Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Описание", Утилиты.ЗначениеПоляJSON(Параметры, "description", ""))));
	Тело.Вставить("author",      Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Автор", Утилиты.ЗначениеПоляJSON(Параметры, "author", ""))));
	Тело.Вставить("phone",       Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Телефон", Утилиты.ЗначениеПоляJSON(Параметры, "phone", ""))));
	Тело.Вставить("start",       Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Начало", Утилиты.ЗначениеПоляJSON(Параметры, "start", ""))));
	Тело.Вставить("stop",        Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Окончание", Утилиты.ЗначениеПоляJSON(Параметры, "stop", ""))));

	Возврат ВыполнитьЗапрос("POST", "block", Неопределено, Тело);
КонецФункции

Функция РазблокироватьБазу(Знач ИмяБазы) Экспорт
	Возврат ВыполнитьЗапрос("POST", "unblock", Неопределено, Новый Структура("base", ИмяБазы));
КонецФункции

// ------------------------------------------------------------
// Обслуживание
// ------------------------------------------------------------

Функция СоздатьЗаявкуНаОбслуживание(Параметры) Экспорт
	Возврат ВыполнитьЗапрос("POST", "maintenance", Неопределено, Параметры);
КонецФункции

// ------------------------------------------------------------
// Восстановление базы: /loading1c/new и /loading1c/status
// ------------------------------------------------------------

// Запускает восстановление базы из архива.
// Поля тела: base, archive, description, licenseenable, user, osuser.
// Поле licenseenable включает/выключает лицензирование после восстановления,
// description — произвольный текст заявки.
// Поле user передаёт логин пользователя ОС узла восстановления,
// osuser — имя пользователя ОС; в доке назначения расходятся,
// поэтому заполняются оба, вызов может уточнить только нужное.
Функция НачатьВосстановление(Параметры) Экспорт
	РезультатОшибки = Новый Структура("Успех, Данные, КодОтвета, Сообщение", Ложь, Неопределено, 0, "");
	Если Параметры = Неопределено Тогда
		РезультатОшибки.Сообщение = "Параметры восстановления не переданы";
		Возврат РезультатОшибки;
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("base",          Строка(Утилиты.ЗначениеПоляJSON(Параметры, "База", Утилиты.ЗначениеПоляJSON(Параметры, "base", ""))));
	Тело.Вставить("archive",       Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Архив", Утилиты.ЗначениеПоляJSON(Параметры, "archive", ""))));
	Тело.Вставить("description",   Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Описание", Утилиты.ЗначениеПоляJSON(Параметры, "description", ""))));
	Тело.Вставить("licenseenable", Утилиты.ЗначениеПоляJSON(Параметры, "Лицензирование", Утилиты.ЗначениеПоляJSON(Параметры, "licenseenable", Истина)));
	Тело.Вставить("user",          Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Пользователь", Утилиты.ЗначениеПоляJSON(Параметры, "user", ""))));
	Тело.Вставить("osuser",        Строка(Утилиты.ЗначениеПоляJSON(Параметры, "ПользовательОС", Утилиты.ЗначениеПоляJSON(Параметры, "osuser", ""))));

	Ответ = ВыполнитьЗапрос("POST", "loading1c/new", Неопределено, Тело);

	// достаём ГУИД заявки, если он есть в ответе
	Если Ответ.Успех И Ответ.Данные <> Неопределено Тогда
		ГУИД = Утилиты.ЗначениеПоляJSON(Ответ.Данные, "request_id",
			Утилиты.ЗначениеПоляJSON(Ответ.Данные, "id", ""));
		Ответ.Вставить("ГУИДЗаявки", Строка(ГУИД));
	Иначе
		Ответ.Вставить("ГУИДЗаявки", "");
	КонецЕсли;

	Возврат Ответ;
КонецФункции

// Текущий статус заявки восстановления.
// Статусы: 0 — в очереди, 1 — выполняется, 2 — готово, -1 — ошибка.
// В ответе также приходит update_date.
Функция ПолучитьСтатусВосстановления(Знач ГУИДЗаявки) Экспорт
	Ответ = ВыполнитьЗапрос("GET", "loading1c/status", Новый Структура("id", ГУИДЗаявки));
	Если Ответ.Успех Тогда
		КодСтатуса = Утилиты.ЗначениеПоляJSON(Ответ.Данные, "state",
			Утилиты.ЗначениеПоляJSON(Ответ.Данные, "code", 0));
		Разбор = Утилиты.СтатусВосстановления(КодСтатуса);
		Ответ.Вставить("Статус", Разбор);
		Ответ.Вставить("ДатаОбновления",
			Утилиты.ИзISOДаты(Утилиты.ЗначениеПоляJSON(Ответ.Данные, "update_date", "")));
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Опрашивает статус до завершения или истечения таймаута.
//   ТаймаутСек — максимум ожидания (по умолчанию 7200, т. е. 2 часа, как в пайплайне)
//   ИнтервалСек — пауза между опросами (по умолчанию 60)
// Возвращает структуру с итоговым Статусом.
Функция ОжидатьСтатусВосстановления(Знач ГУИДЗаявки, Знач ТаймаутСек = 7200, Знач ИнтервалСек = 60) Экспорт
	Итог = Новый Структура("Успех, Таймаут, Статус, Сообщение", Ложь, Ложь, Неопределено, "");

	Дедлайн = ТекущаяДата() + ТаймаутСек;

	Пока Истина Цикл
		Ответ = ПолучитьСтатусВосстановления(ГУИДЗаявки);
		Если Не Ответ.Успех Тогда
			Итог.Сообщение = Ответ.Сообщение;
			Возврат Итог;
		КонецЕсли;

		Итог.Статус = Ответ.Статус;

		Если Итог.Статус.Завершено Тогда
			Итог.Успех = Итог.Статус.Успех;
			Итог.Сообщение = Итог.Статус.Описание;
			Возврат Итог;
		КонецЕсли;

		Если ТекущаяДата() >= Дедлайн Тогда
			Итог.Таймаут = Истина;
			Итог.Сообщение = "Таймаут ожидания восстановления: " + ТаймаутСек + " сек";
			Возврат Итог;
		КонецЕсли;

		Пауза(ИнтервалСек);
	КонецЦикла;
КонецФункции

// ------------------------------------------------------------
// run1c/generate
// ------------------------------------------------------------

// Запускает генерацию файла запуска Предприятия.
// Поле user — логин в базе, osuser — пользователь ОС; в доке назначения
// расходятся, заполняются оба.
Функция СгенерироватьЗапуск(Параметры) Экспорт
	РезультатОшибки = Новый Структура("Успех, Данные, КодОтвета, Сообщение", Ложь, Неопределено, 0, "");
	Если Параметры = Неопределено Тогда
		РезультатОшибки.Сообщение = "Параметры генерации не переданы";
		Возврат РезультатОшибки;
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("base",   Строка(Утилиты.ЗначениеПоляJSON(Параметры, "База", Утилиты.ЗначениеПоляJSON(Параметры, "base", ""))));
	Тело.Вставить("user",   Строка(Утилиты.ЗначениеПоляJSON(Параметры, "Пользователь", Утилиты.ЗначениеПоляJSON(Параметры, "user", ""))));
	Тело.Вставить("osuser", Строка(Утилиты.ЗначениеПоляJSON(Параметры, "ПользовательОС", Утилиты.ЗначениеПоляJSON(Параметры, "osuser", ""))));

	Возврат ВыполнитьЗапрос("POST", "run1c/generate", Неопределено, Тело);
КонецФункции
