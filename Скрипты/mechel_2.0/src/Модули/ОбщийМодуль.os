#Использовать json
#Использовать v8runner
#Использовать asserts
#Использовать fs
#Использовать oint

Перем КонстантыРабот;

// Инициализация предопределенных общих параметров для использования библиотеки.
// 
// Параметры:
//     ПутьКФайлуСПараметрами - константы по переданному пути (рабочая директория сборки)
// Возвращаемое значение:
//     Структура - Структура установленных констант из файла;
// 
Функция ПредустановленныеПараметрыКонстант(ПутьКФайлуСПараметрами) Экспорт

	Если НЕ ФС.Существует(ПутьКФайлуСПараметрами) Тогда
		ВызватьИсключение "Нет файла констант";
	КонецЕсли;

	ПреобразовательJSON = Новый ПарсерJSON();
	ЧитатьJSON = Новый ЧтениеТекста();
	
	ЧитатьJSON.Открыть(ПутьКФайлуСПараметрами);
	СтрокаJSON = ЧитатьJSON.Прочитать();
	ЧитатьJSON.Закрыть();
	
	Возврат ПреобразовательJSON.ПрочитатьJSON(СтрокаJSON, , , Истина);

КонецФункции

// Проверяет, есть ли изменения в гите за последние 20 часов.
//    Вызывается исключение, если есть ошибки получения данных, либо не установлен или не найден гит.
// 
// Параметры:
//     ВремяНачалаПроверки - Строка - Время начала (--since) проверки изменений гит в формате git log
//     СтрокаПоиска - Строка - Что искать в измененных файлах вывода гита.
//     КодВозврата - Число - Результат выполнения метода, ошибка по-умолчанию = 1, успех = 0
//     ВремяОкончанияПроверки - Строка - Время окончания (--until) проверки изменений гит в формате git log
// Возвращаемое значение:
//     Булево - Истина, изменения есть;
// 
Функция ЕстьОбновленияВРепозитории(
	ВремяНачалаПроверки, 
	СтрокаПоиска, 
	КодВозврата = Неопределено, 
	ВремяОкончанияПроверки = Неопределено) Экспорт
	
	Перем ПутьКГит;

	Если ФС.Существует("C:\\Program Files\\Git") Тогда
		ПутьКГит = "C:\\Program Files\\Git\\bin\\git.exe";
	ИначеЕсли ФС.Существует("C:\\Git") Тогда
		ПутьКГит = "C:\\Git\\bin\\git.exe";
	Иначе
		ВызватьИсключение "Не обнаружена программа Git! Работа невозможна.";
	КонецЕсли;
	
	ВремяНачалаПроверки = СтрЗаменить(ВремяНачалаПроверки, "'", """");
	
	Команда = Новый Команда;
	Команда.УстановитьКоманду(ПутьКГит);
	Команда.УстановитьРабочийКаталог(".\\");
	Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	ПараметрыЗапуска = Новый Массив;
	ПараметрыЗапуска.Добавить("rev-list");
	ПараметрыЗапуска.Добавить("--count HEAD");
	ПараметрыЗапуска.Добавить(ВремяНачалаПроверки);

	Если ВремяОкончанияПроверки <> Неопределено Тогда
		ПараметрыЗапуска.Добавить(ВремяОкончанияПроверки);
	КонецЕсли;

	Команда.ДобавитьПараметры(ПараметрыЗапуска);

	КодВозврата = Команда.Исполнить();
	КоличествоКоммитов = Команда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение КоличествоКоммитов;
	КонецЕсли;

	Команда = Новый Команда;
	Команда.УстановитьКоманду(ПутьКГит);
	Команда.УстановитьРабочийКаталог(".\\");
	Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);
	ПараметрыЗапуска = Новый Массив;
	ПараметрыЗапуска.Добавить("-c core.quotepath=false");
	ПараметрыЗапуска.Добавить("diff");
	ПараметрыЗапуска.Добавить("--name-only");
	ПараметрыЗапуска.Добавить("HEAD~" + КоличествоКоммитов);
	
	Команда.ДобавитьПараметры(ПараметрыЗапуска);

	КодВозврата = Команда.Исполнить();
	ВыводГита = Команда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение ВыводГита;
	КонецЕсли;

	ЕстьИзменения = СтрНайти(ВыводГита, СтрокаПоиска);

	Если ЕстьИзменения <> 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

// Формирует список заголовков слитых коммитов за указанное время
// По-умолчанию за текущие сутки, если параметры не были переданы.
//
// Параметры:
//    НачалоПроверки - Дата - ДатаВремя в формате (01.01.2024 00:00:00)
//    ОкончаниеПроверки - Дата - ДатаВремя в формате (01.01.2024 23:59:59)
// 
Функция ПеречислениеКоммитовСообщениемЗаПоследниеСутки(
	НачалоПроверки = Неопределено, 
	ОкончаниеПроверки = Неопределено) Экспорт

	Перем ПутьКГит;

	Если НачалоПроверки = Неопределено Тогда
		НачалоПроверки = НачалоДня(ТекущаяДата());
	КонецЕсли;

	Если ОкончаниеПроверки = Неопределено Тогда
		ОкончаниеПроверки = КонецДня(ТекущаяДата());
	КонецЕсли;

	Если ФС.Существует("C:\\Program Files\\Git") Тогда
		ПутьКГит = "C:\\Program Files\\Git\\bin\\git.exe";
	ИначеЕсли ФС.Существует("C:\\Git") Тогда
		ПутьКГит = "C:\\Git\\bin\\git.exe";
	Иначе
		ВызватьИсключение "Не обнаружена программа Git! Работа невозможна.";
	КонецЕсли;

	Команда = Новый Команда;
	Команда.УстановитьКоманду(ПутьКГит);
	Команда.УстановитьРабочийКаталог(".\\");
	Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);

	ПараметрыЗапуска = Новый Массив;
	ПараметрыЗапуска.Добавить("log");
	ПараметрыЗапуска.Добавить("--first-parent");
	ПараметрыЗапуска.Добавить("HEAD");
	ПараметрыЗапуска.Добавить("--since=""" + НачалоПроверки + """");
	ПараметрыЗапуска.Добавить("--until=""" + ОкончаниеПроверки + """");
	ПараметрыЗапуска.Добавить("--pretty=format:""%s""");
	ПараметрыЗапуска.Добавить("--grep=""into"" -i");

	Команда.ДобавитьПараметры(ПараметрыЗапуска);

	КодВозврата = Команда.Исполнить();
	ВыводГита = Команда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение ВыводГита;
	КонецЕсли;

	Приостановить(5000);

	Возврат ВыводГита;
	
КонецФункции

// Определяет возможность вывода отладки средствами OneScript.
//
// Параметры:
//    Использовать - Булево - Истина, включить отладку;
// 
Процедура ИспользоватьВыводОтладки(Использовать = Неопределено) Экспорт
	
	Если Использовать Тогда
		Лог = Логирование.ПолучитьЛог("oscript.lib.v8runner");
		Лог.УстановитьУровень(УровниЛога.Отладка);
	КонецЕсли;

КонецПроцедуры