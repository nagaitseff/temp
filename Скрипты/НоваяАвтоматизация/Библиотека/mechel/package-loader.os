Процедура ПриЗагрузкеБиблиотеки(Путь, СтандартнаяОбработка, Отказ)
	СтандартнаяОбработка = Ложь;
	ДобавитьМодуль(ОбъединитьПути(Путь, "src", "Модули", "АПИСлужебный.os"), "АПИСлужебный");
	ДобавитьМодуль(ОбъединитьПути(Путь, "src", "Модули", "ПомощникПайплайна.os"), "ПомощникПайплайна");
	ДобавитьКласс(ОбъединитьПути(Путь, "src", "Классы", "ЛогМечел.os"), "ЛогМечел");
	ДобавитьКласс(ОбъединитьПути(Путь, "src", "Классы", "АПИКлиент.os"), "АПИКлиент");
КонецПроцедуры
