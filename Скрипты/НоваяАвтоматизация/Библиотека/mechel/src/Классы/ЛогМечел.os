Перем Компонент;
Перем Порог;
Перем ФайлЛога;
Перем Секреты;

Процедура ПриСозданииОбъекта(Знач ИмяКомпонента = "mechel", Знач Уровень = "INFO", Знач ПутьКФайлу = "")
	Компонент = ИмяКомпонента;
	Порог = ВесУровня(Уровень);
	ФайлЛога = ПутьКФайлу;
	Секреты = Новый Массив;
КонецПроцедуры

Процедура ДобавитьСекрет(Знач Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "Секрет для маскирования должен быть строкой";
	КонецЕсли;
	Если Значение <> "" И Секреты.Найти(Значение) = Неопределено Тогда
		Секреты.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

Процедура Отладка(Знач Сообщение) Экспорт
	Записать("DEBUG", Сообщение);
КонецПроцедуры

Процедура Информация(Знач Сообщение) Экспорт
	Записать("INFO", Сообщение);
КонецПроцедуры

Процедура Предупреждение(Знач Сообщение) Экспорт
	Записать("WARN", Сообщение);
КонецПроцедуры

Процедура Ошибка(Знач Сообщение) Экспорт
	Записать("ERROR", Сообщение);
КонецПроцедуры

Процедура Записать(Знач Уровень, Знач Сообщение)
	Если ВесУровня(Уровень) < Порог Тогда
		Возврат;
	КонецЕсли;
	СтрокаЛога = Формат(ТекущаяДата(), "ДФ=yyyy-MM-dd'T'HH:mm:ss")
		+ " [" + Уровень + "] [" + Компонент + "] " + Строка(Сообщение);
	СтрокаЛога = АПИСлужебный.СкрытьСекреты(СтрокаЛога, Секреты);
	СтрокаЛога = СтрЗаменить(СтрЗаменить(СтрокаЛога, Символы.ВК, " "), Символы.ПС, " ");
	Сообщить(СтрокаЛога);
	Если ФайлЛога <> "" Тогда
		Запись = Новый ЗаписьТекста;
		Попытка
			Запись.Открыть(ФайлЛога, КодировкаТекста.UTF8, , Истина);
			Запись.ЗаписатьСтроку(СтрокаЛога);
			Запись.Закрыть();
		Исключение
			// Сбой файлового лога не меняет результат уже выполненной операции API.
			Запись.Закрыть();
			Сообщить("[WARN] [mechel.log] Не удалось дополнить файл лога; сообщение выведено в консоль");
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

Функция ВесУровня(Знач Уровень)
	Уровень = ВРег(Уровень);
	Если Уровень = "DEBUG" Тогда
		Возврат 10;
	ИначеЕсли Уровень = "INFO" Тогда
		Возврат 20;
	ИначеЕсли Уровень = "WARN" Тогда
		Возврат 30;
	ИначеЕсли Уровень = "ERROR" Тогда
		Возврат 40;
	ИначеЕсли Уровень = "OFF" Тогда
		Возврат 100;
	КонецЕсли;
	ВызватьИсключение "Уровень лога: DEBUG, INFO, WARN, ERROR или OFF";
КонецФункции
