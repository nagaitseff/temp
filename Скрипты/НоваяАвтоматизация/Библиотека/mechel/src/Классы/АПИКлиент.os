// Клиент документированных HTTP-сервисов оркестратора.
// Успех: возвращается result. Ошибка: исключение, без повторной отправки запроса.
// Публичный интерфейс и параметры: docs/СПРАВОЧНИК.md.

Перем АдресСервера;
Перем БазовыйПуть;
Перем Токен;
Перем Логин;
Перем Пароль;
Перем АутентификацияОС;
Перем ТаймаутHTTP;
Перем Лог;
Перем Транспорт;
Перем Секреты;

Процедура ПриСозданииОбъекта(
	Знач Адрес = "https://ukm-web/ad/IT/IT_TechAdmin/hs/",
	Журнал = Неопределено,
	ТестовыйТранспорт = Неопределено)

	Разбор = АПИСлужебный.РазобратьАдрес(Адрес);
	АдресСервера = Разбор.Сервер;
	БазовыйПуть = Разбор.Путь;
	Токен = "";
	Логин = "";
	Пароль = "";
	АутентификацияОС = Истина;
	ТаймаутHTTP = 120;
	Секреты = Новый Массив;
	Лог = ?(Журнал = Неопределено, Новый ЛогМечел("mechel.api"), Журнал);
	Транспорт = ТестовыйТранспорт;
КонецПроцедуры

Процедура УстановитьТокен(Знач Значение) Экспорт
	ПроверитьСтроку(Значение, "токен", Истина);
	Если СтрНайти(Значение, Символы.ПС) > 0 Или СтрНайти(Значение, Символы.ВК) > 0 Тогда
		ВызватьИсключение "Токен не должен содержать перевод строки";
	КонецЕсли;
	Токен = Значение;
	ЗарегистрироватьСекрет(Значение);
КонецПроцедуры

Процедура УстановитьАутентификацию(Знач Пользователь = "", Знач ПарольПользователя = "",
	Знач ИспользоватьАутентификациюОС = Истина) Экспорт
	ПроверитьСтроку(Пользователь, "пользователь HTTP", Истина);
	ПроверитьСтроку(ПарольПользователя, "пароль HTTP", Истина);
	НоваяАутентификацияОС = АПИСлужебный.ВБулево(ИспользоватьАутентификациюОС);
	Если НоваяАутентификацияОС И (Пользователь <> "" Или ПарольПользователя <> "") Тогда
		ВызватьИсключение "Для явной учётной записи передайте ИспользоватьАутентификациюОС = Ложь";
	КонецЕсли;
	АутентификацияОС = НоваяАутентификацияОС;
	Логин = Пользователь;
	Пароль = ПарольПользователя;
	ЗарегистрироватьСекрет(Пароль);
КонецПроцедуры

Процедура УстановитьТаймаут(Знач Секунды) Экспорт
	ПроверитьЦелое(Секунды, "таймаут HTTP", 1);
	ТаймаутHTTP = Секунды;
КонецПроцедуры

// Справочники и чтение объектов 1С — без API-токена.

Функция ПолучитьАгентов() Экспорт
	Ответ = ВыполнитьЗапрос("GET", "Objects1C/GetAgents");
	Возврат Ответ["result"];
КонецФункции

Функция ПолучитьКластеры(Знач Агент = "") Экспорт
	ПроверитьСтроку(Агент, "agent", Истина);
	Параметры = Новый Структура;
	Если Агент <> "" Тогда Параметры.Вставить("agent", Агент); КонецЕсли;
	Ответ = ВыполнитьЗапрос("GET", "Objects1C/GetClusters", Параметры);
	Возврат Ответ["result"];
КонецФункции

Функция ПолучитьПроектныеКоманды() Экспорт
	Ответ = ВыполнитьЗапрос("GET", "Objects1C/GetProjectTeams");
	Возврат Ответ["result"];
КонецФункции

Функция ПолучитьПроекты() Экспорт
	Ответ = ВыполнитьЗапрос("GET", "Objects1C/GetProjects");
	Возврат Ответ["result"];
КонецФункции

Функция ПолучитьИнфобазы(Знач Агент = "", Знач Кластер = "") Экспорт
	ПроверитьСтроку(Агент, "agent", Истина);
	ПроверитьСтроку(Кластер, "cluster", Истина);
	Параметры = Новый Структура;
	Если Агент <> "" Тогда Параметры.Вставить("agent", Агент); КонецЕсли;
	Если Кластер <> "" Тогда Параметры.Вставить("cluster", Кластер); КонецЕсли;
	Ответ = ВыполнитьЗапрос("GET", "Objects1C/GetInfobases", Параметры);
	Возврат Ответ["result"];
КонецФункции

Функция ПолучитьСеансыКластера(Знач Кластер) Экспорт
	ПроверитьСтроку(Кластер, "cluster");
	Ответ = ВыполнитьЗапрос("GET", "Objects1C/GetSessions", Новый Структура("cluster", Кластер));
	// Схема объектов сеансов в API.md не задана. Поля не переименовываем и не угадываем.
	Возврат Ответ["result"];
КонецФункции

Функция ПолучитьПользователейБазы(Знач Инфобаза, Знач ВозвращатьИД = Истина, Знач ТолькоОС = Ложь) Экспорт
	ПроверитьСтроку(Инфобаза, "infobase");
	Параметры = Новый Структура("infobase,get_id,only_ad", Инфобаза,
		АПИСлужебный.ВБулево(ВозвращатьИД), АПИСлужебный.ВБулево(ТолькоОС));
	Ответ = ВыполнитьЗапрос("GET", "Objects1C/GetInfobaseUsers", Параметры);
	Возврат Ответ["result"];
КонецФункции

// Защищённые методы: token в параметрах GET или в теле POST.

Функция ПолучитьБлокировку(Знач Инфобаза) Экспорт
	Возврат ПолучитьПоБазе("Objects1C/GetInfobaseBlock", Инфобаза);
КонецФункции

Функция УстановитьБлокировку(Знач Инфобаза, Параметры) Экспорт
	Тело = ПараметрыБазы(Инфобаза, Параметры,
		"SessionsLockEnabled,LockBeginTime,LockEndTime,SessionStartPermissionCode,LockMessage,LockParameter,LockScheduledJobs,comment");
	НормализоватьБулево(Тело, "SessionsLockEnabled");
	НормализоватьБулево(Тело, "LockScheduledJobs");
	НормализоватьДату(Тело, "LockBeginTime");
	НормализоватьДату(Тело, "LockEndTime");
	ПроверитьСтроковыеПоля(Тело, "SessionStartPermissionCode,LockMessage,LockParameter");
	ЗарегистрироватьСекрет(АПИСлужебный.ЗначениеПоля(Тело, "SessionStartPermissionCode", ""));
	Ответ = ВыполнитьЗапрос("POST", "Objects1C/SetInfobaseBlock", , Тело, Истина);
	Возврат Ответ["result"];
КонецФункции

Функция СнятьБлокировку(Знач Инфобаза, Знач СнятьБлокировкуРегламентныхЗаданий = Истина,
	Знач Комментарий = "") Экспорт
	Параметры = Новый Структура("SessionsLockEnabled,comment", Ложь, Комментарий);
	Если АПИСлужебный.ВБулево(СнятьБлокировкуРегламентныхЗаданий) Тогда
		Параметры.Вставить("LockScheduledJobs", Ложь);
	КонецЕсли;
	Возврат УстановитьБлокировку(Инфобаза, Параметры);
КонецФункции

Функция ПолучитьОбслуживание(Знач Инфобаза) Экспорт
	Возврат ПолучитьПоБазе("Objects1C/GetInfobaseMaintenance", Инфобаза);
КонецФункции

Функция УстановитьОбслуживание(Знач Инфобаза, Параметры) Экспорт
	Тело = ПараметрыБазы(Инфобаза, Параметры,
		"MaintenanceDisabled,MaintenanceDisabledDate,MaintenanceDisabledNote,comment");
	НормализоватьБулево(Тело, "MaintenanceDisabled");
	НормализоватьДату(Тело, "MaintenanceDisabledDate");
	ПроверитьСтроковыеПоля(Тело, "MaintenanceDisabledNote");
	Ответ = ВыполнитьЗапрос("POST", "Objects1C/SetInfobaseMaintenance", , Тело, Истина);
	Возврат Ответ["result"];
КонецФункции

Функция ЗавершитьПроцесс(Знач Кластер, Знач ИДПроцесса, Знач Комментарий = "") Экспорт
	ПроверитьСтроку(Кластер, "cluster");
	ПроверитьСтроку(ИДПроцесса, "process");
	ПроверитьКомментарий(Комментарий);
	Тело = Новый Структура("cluster,process,comment", Кластер, ИДПроцесса, Комментарий);
	Ответ = ВыполнитьЗапрос("POST", "Objects1C/TerminateProcess", , Тело, Истина);
	Возврат Ответ["result"];
КонецФункции

Функция ЗавершитьСеанс(Знач Инфобаза, Знач НомерСеанса, Знач ТаймаутУдаления = 30,
	Знач Комментарий = "") Экспорт
	ПроверитьСтроку(Инфобаза, "infobase");
	ПроверитьЦелое(НомерСеанса, "session", 1);
	ПроверитьЦелое(ТаймаутУдаления, "timeout удаления сеанса", 1);
	ПроверитьКомментарий(Комментарий);
	Тело = Новый Структура("infobase,session,timeout,comment",
		Инфобаза, НомерСеанса, ТаймаутУдаления, Комментарий);
	Ответ = ВыполнитьЗапрос("POST", "Objects1C/KillSession", , Тело, Истина,
		Макс(ТаймаутHTTP, ТаймаутУдаления + 5));
	// Код 12 (таймаут) остаётся ошибкой. Повторного kill и предположений об успехе нет.
	Возврат Ответ["result"];
КонецФункции

Функция СброситьКэш(Знач Инфобаза, Знач Комментарий = "") Экспорт
	Тело = ПараметрыБазы(Инфобаза, Новый Структура("comment", Комментарий), "comment");
	Ответ = ВыполнитьЗапрос("POST", "Objects1C/CacheReset", , Тело, Истина);
	Возврат Ответ["result"];
КонецФункции

// Асинхронные выгрузки аудита. Результат запроса — не подтверждение готовности отчёта.

Функция ЗапуститьАИР(Знач Полный = Ложь, Знач Инфобаза = "") Экспорт
	ПроверитьСтроку(Инфобаза, "infobase", Истина);
	Параметры = Новый Структура("full", ?(АПИСлужебный.ВБулево(Полный), 1, 0));
	Если Инфобаза <> "" Тогда Параметры.Вставить("infobase", Инфобаза); КонецЕсли;
	Ответ = ВыполнитьЗапрос("GET", "audit/AIR", Параметры);
	Возврат Ответ["result"];
КонецФункции

Функция ЗапуститьВИР(Знач МаркерГруппы = 0, Знач Инфобаза = "") Экспорт
	ПроверитьЦелое(МаркерГруппы, "groupmarker", 0);
	ПроверитьСтроку(Инфобаза, "infobase", Истина);
	Параметры = Новый Структура("groupmarker", МаркерГруппы);
	Если Инфобаза <> "" Тогда Параметры.Вставить("infobase", Инфобаза); КонецЕсли;
	Ответ = ВыполнитьЗапрос("GET", "audit/VIR", Параметры);
	Возврат Ответ["result"];
КонецФункции

// Восстановление. Источник и приёмник — идентификаторы ИБ, не пути к архивам.

Функция ЗапуститьВосстановление(Знач БазаИсточник, Знач БазаПриемник, Параметры = Неопределено) Экспорт
	ПроверитьСтроку(БазаИсточник, "sourceinfobase");
	ПроверитьСтроку(БазаПриемник, "targetinfobase");
	Если ВРег(СокрЛП(БазаИсточник)) = ВРег(СокрЛП(БазаПриемник)) Тогда
		ВызватьИсключение "Источник и приёмник восстановления совпадают";
	КонецЕсли;
	Тело = СкопироватьПараметры(Параметры,
		"test,forcecreate,description,licenseenable,dbmstype,db,makecopy,user,osname,comment");
	Тело.Вставить("sourceinfobase", БазаИсточник);
	Тело.Вставить("targetinfobase", БазаПриемник);
	Для Каждого Имя Из СтрРазделить("test,forcecreate,licenseenable", ",") Цикл
		Если Тело.Свойство(Имя) Тогда
			Тело[Имя] = ?(АПИСлужебный.ВБулево(Тело[Имя]), 1, 0);
		КонецЕсли;
	КонецЦикла;
	НормализоватьБулево(Тело, "makecopy");
	ПроверитьСтроковыеПоля(Тело, "description,dbmstype,db,user,osname");
	Если Не ПустаяСтрока(АПИСлужебный.ЗначениеПоля(Тело, "osname", "")) Тогда
		ПроверитьСтроку(АПИСлужебный.ЗначениеПоля(Тело, "user", ""), "user при заданном osname");
	КонецЕсли;
	ПроверитьКомментарий(АПИСлужебный.ЗначениеПоля(Тело, "comment", ""));
	Если АПИСлужебный.ЗначениеПоля(Тело, "forcecreate", 0) = 1 Тогда
		ТипСУБД = АПИСлужебный.ЗначениеПоля(Тело, "dbmstype", "");
		БазаСУБД = АПИСлужебный.ЗначениеПоля(Тело, "db", "");
		ПроверитьСтроку(ТипСУБД, "dbmstype при forcecreate=1");
		ПроверитьСтроку(БазаСУБД, "db при forcecreate=1");
		ДопустимыеСУБД = СтрРазделить("MSSQLServer,PostgreSQL,IBMDB2,OracleDatabase", ",");
		Если ДопустимыеСУБД.Найти(ТипСУБД) = Неопределено Тогда
			ВызватьИсключение "Неизвестный dbmstype для forcecreate";
		КонецЕсли;
		ЧастиБазыСУБД = СтрРазделить(БазаСУБД, "|");
		Если ЧастиБазыСУБД.Количество() <> 2
			Или ПустаяСтрока(ЧастиБазыСУБД[0]) Или ПустаяСтрока(ЧастиБазыСУБД[1]) Тогда
			ВызватьИсключение "Для forcecreate задайте db в формате ЭкземплярСУБД|БазаДанных";
		КонецЕсли;
	КонецЕсли;
	Ответ = ВыполнитьЗапрос("POST", "loading1c/new", , Тело, Истина);
	Попытка
		ПроверитьГУИД(Ответ["result"]);
	Исключение
		Сбой("loading1c/new", "Сервер сообщил об успехе, но не вернул корректный GUID в result. "
			+ "Заявка могла быть создана; проверьте оркестратор перед повторным запуском");
	КонецПопытки;
	Возврат Ответ["result"];
КонецФункции

Функция ПолучитьСтатусВосстановления(Знач ГУИД) Экспорт
	ПроверитьГУИД(ГУИД);
	Возврат ЗапроситьСтатусВосстановления(ГУИД, ТаймаутHTTP);
КонецФункции

Функция ОжидатьЗавершенияВосстановления(Знач ГУИД, Знач ТаймаутСекунд = 7200,
	Знач ИнтервалОпросаСекунд = 60) Экспорт
	ПроверитьГУИД(ГУИД);
	ПроверитьЦелое(ТаймаутСекунд, "таймаут ожидания", 1);
	ПроверитьЦелое(ИнтервалОпросаСекунд, "интервал опроса", 1);
	Срок = ТекущаяДата() + ТаймаутСекунд;
	ПредыдущийКод = Неопределено;
	Пока Истина Цикл
		Остаток = Срок - ТекущаяДата();
		Если Остаток <= 0 Тогда
			Сбой("loading1c/status", "Истёк таймаут ожидания заявки " + ГУИД
				+ ". Заявка не отменена; проверьте её статус перед повторным восстановлением");
		КонецЕсли;
		Статус = ЗапроситьСтатусВосстановления(ГУИД, Мин(ТаймаутHTTP, Остаток));
		Если Статус.Код <> ПредыдущийКод Тогда
			Лог.Информация(Статус.Описание + "; заявка=" + ГУИД);
			ПредыдущийКод = Статус.Код;
		КонецЕсли;
		Лог.Отладка("Заявка=" + ГУИД + "; update_date=" + Безопасно(Статус.ДатаОбновления));
		Если Статус.Завершено Тогда
			Если Не Статус.Успех Тогда
				Сбой("loading1c/status", Статус.Описание + "; заявка=" + ГУИД);
			КонецЕсли;
			Возврат Статус;
		КонецЕсли;
		Остаток = Срок - ТекущаяДата();
		Если Остаток > 0 Тогда
			// Приостановить принимает миллисекунды.
			Приостановить(Мин(ИнтервалОпросаСекунд, Остаток) * 1000);
		КонецЕсли;
	КонецЦикла;
КонецФункции

// Метод реализован по таблице параметров API.md; расхождение user/osuser
// в таблице ошибок зафиксировано в КОНТРАКТ_API.md. Автоматически не вызывается.
Функция СгенерироватьЗапуск(Знач Инфобаза, Знач ИмяПриложения, Знач Пользователь,
	Знач Комментарий = "") Экспорт
	ПроверитьСтроку(Инфобаза, "infobase");
	ПроверитьСтроку(ИмяПриложения, "appname");
	ПроверитьСтроку(Пользователь, "user");
	ПроверитьКомментарий(Комментарий);
	Параметры = Новый Структура("infobase,appname,user,comment",
		Инфобаза, ИмяПриложения, Пользователь, Комментарий);
	Ответ = ВыполнитьЗапрос("GET", "run1c/generate", Параметры, , Истина);
	// Сгенерированный токен — секрет; результат не записывается в лог.
	Если ТипЗнч(Ответ["result"]) <> Тип("Строка") Или ПустаяСтрока(Ответ["result"]) Тогда
		Сбой("run1c/generate", "Ошибка протокола: ожидался непустой токен в result");
	КонецЕсли;
	ЗарегистрироватьСекрет(Ответ["result"]);
	Возврат Ответ["result"];
КонецФункции

// Внутренние функции.

Функция ЗапроситьСтатусВосстановления(Знач ГУИД, Знач Таймаут)
	Ответ = ВыполнитьЗапрос("GET", "loading1c/status", Новый Структура("guid", ГУИД), , Истина, Таймаут);
	Попытка
		Возврат АПИСлужебный.СтатусВосстановления(Ответ["result"],
			АПИСлужебный.ЗначениеПоля(Ответ, "update_date", ""));
	Исключение
		Сбой("loading1c/status", ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ПолучитьПоБазе(Знач Метод, Знач Инфобаза)
	ПроверитьСтроку(Инфобаза, "infobase");
	Ответ = ВыполнитьЗапрос("GET", Метод, Новый Структура("infobase", Инфобаза), , Истина);
	Возврат Ответ["result"];
КонецФункции

Функция ВыполнитьЗапрос(Знач МетодHTTP, Знач МетодAPI, Параметры = Неопределено,
	Тело = Неопределено, Знач НуженТокен = Ложь, Знач Таймаут = Неопределено)

	Если НуженТокен Тогда
		Если ПустаяСтрока(Токен) Тогда
			Сбой(МетодAPI, "Не задан API-токен. Передайте значение Jenkins credentials через УстановитьТокен");
		КонецЕсли;
		Если МетодHTTP = "GET" Тогда
			Если Параметры = Неопределено Тогда
				Параметры = Новый Структура;
			КонецЕсли;
			Параметры.Вставить("token", Токен);
		Иначе
			Если Тело = Неопределено Тогда
				Тело = Новый Структура;
			КонецЕсли;
			Тело.Вставить("token", Токен);
		КонецЕсли;
	КонецЕсли;
	Если Таймаут = Неопределено Тогда Таймаут = ТаймаутHTTP; КонецЕсли;
	Путь = БазовыйПуть + МетодAPI;
	ЗапросПараметры = АПИСлужебный.СтрокаПараметровЗапроса(Параметры);
	Если ЗапросПараметры <> "" Тогда Путь = Путь + "?" + ЗапросПараметры; КонецЕсли;
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Accept", "application/json");
	ТекстТела = "";
	Если Тело <> Неопределено Тогда
		ТекстТела = АПИСлужебный.ВJSON(Тело);
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	КонецЕсли;
	Лог.Отладка(МетодHTTP + " " + МетодAPI + ": начало запроса");
	Попытка
		Если Транспорт <> Неопределено Тогда
			РезультатHTTP = Транспорт.Отправить(МетодHTTP, Путь, Заголовки, ТекстТела, Таймаут);
			КодHTTP = РезультатHTTP.КодСостояния;
			ТекстОтвета = РезультатHTTP.Тело;
		Иначе
			// В OneScript 2.1 HTTPS задаётся схемой адреса. SSL-объект не поддерживается.
			Соединение = Новый HTTPСоединение(АдресСервера, 0, Логин, Пароль, Неопределено,
				Таймаут, Неопределено, АутентификацияОС);
			Соединение.РазрешитьАвтоматическоеПеренаправление = Ложь;
			Запрос = Новый HTTPЗапрос(Путь, Заголовки);
			Если Тело <> Неопределено Тогда
				Запрос.УстановитьТелоИзСтроки(ТекстТела, КодировкаТекста.UTF8);
			КонецЕсли;
			ОтветHTTP = Соединение.ВызватьHTTPМетод(МетодHTTP, Запрос);
			КодHTTP = ОтветHTTP.КодСостояния;
			ТекстОтвета = ОтветHTTP.ПолучитьТелоКакСтроку();
		КонецЕсли;
	Исключение
		Причина = "Ошибка транспорта. Результат операции может быть неизвестен; запрос не повторялся.";
		// Системное исключение защищённого запроса может содержать полный URL.
		Если Не НуженТокен Тогда
			Причина = Причина + " " + Безопасно(ОписаниеОшибки());
		КонецЕсли;
		Сбой(МетодAPI, Причина);
	КонецПопытки;
	Если КодHTTP <> 200 Тогда
		Сбой(МетодAPI, "HTTP " + Строка(КодHTTP) + ". Проверьте адрес, доступность и HTTP-аутентификацию");
	КонецЕсли;
	Попытка
		Ответ = АПИСлужебный.ИзJSON(ТекстОтвета);
		КодAPI = АПИСлужебный.ЗначениеПоля(Ответ, "code");
		// Старый Groovy-клиент чтения блокировки также принимает "00:00".
		Если МетодAPI = "Objects1C/GetInfobaseBlock" И КодAPI = "00:00" Тогда
			КодAPI = "00.00";
		КонецЕсли;
		Успех = АПИСлужебный.КодУспеха(КодAPI);
	Исключение
		Сбой(МетодAPI, "Ошибка протокола: " + ОписаниеОшибки());
	КонецПопытки;
	Если Не Успех Тогда
		Описание = АПИСлужебный.ЗначениеПоля(Ответ, "description", "Описание ошибки не передано");
		Сбой(МетодAPI, "API code=" + Строка(Ответ["code"]) + "; " + Безопасно(Описание));
	КонецЕсли;
	Если Не АПИСлужебный.ЕстьПоле(Ответ, "result") Тогда
		Сбой(МетодAPI, "Ошибка протокола: в успешном ответе отсутствует result");
	КонецЕсли;
	Лог.Отладка(МетодHTTP + " " + МетодAPI + ": HTTP 200, API code=" + Строка(Ответ["code"]));
	Возврат Ответ;
КонецФункции

Функция ПараметрыБазы(Знач Инфобаза, Параметры, Знач Разрешенные)
	ПроверитьСтроку(Инфобаза, "infobase");
	Тело = СкопироватьПараметры(Параметры, Разрешенные);
	Тело.Вставить("infobase", Инфобаза);
	ПроверитьКомментарий(АПИСлужебный.ЗначениеПоля(Тело, "comment", ""));
	Возврат Тело;
КонецФункции

Функция СкопироватьПараметры(Параметры, Знач Разрешенные)
	Результат = Новый Структура;
	Если Параметры = Неопределено Тогда Возврат Результат; КонецЕсли;
	Если ТипЗнч(Параметры) <> Тип("Структура") И ТипЗнч(Параметры) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Параметры метода должны быть Структурой или Соответствием";
	КонецЕсли;
	Имена = СтрРазделить(Разрешенные, ",");
	Для Каждого Параметр Из Параметры Цикл
		Если Имена.Найти(Параметр.Ключ) = Неопределено Тогда
			ВызватьИсключение "Неизвестный параметр метода API: " + Безопасно(Параметр.Ключ);
		КонецЕсли;
		Если Параметр.Значение <> Неопределено Тогда
			Результат.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура НормализоватьБулево(Параметры, Знач Имя)
	Если Параметры.Свойство(Имя) Тогда Параметры[Имя] = АПИСлужебный.ВБулево(Параметры[Имя]); КонецЕсли;
КонецПроцедуры

Процедура НормализоватьДату(Параметры, Знач Имя)
	Если Параметры.Свойство(Имя) Тогда Параметры[Имя] = АПИСлужебный.ISOДата(Параметры[Имя]); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСтроковыеПоля(Параметры, Знач Имена)
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Если Параметры.Свойство(Имя) Тогда ПроверитьСтроку(Параметры[Имя], Имя, Истина); КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьСтроку(Знач Значение, Знач Имя, Знач РазрешитьПустую = Ложь)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение "Параметр " + Имя + " должен быть строкой";
	КонецЕсли;
	Если Не РазрешитьПустую И ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Не заполнен обязательный параметр " + Имя;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЦелое(Знач Значение, Знач Имя, Знач Минимум)
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "Параметр " + Имя + " должен быть целым числом";
	КонецЕсли;
	Если Значение <> Цел(Значение) Или Значение < Минимум Тогда
		ВызватьИсключение "Некорректное значение параметра " + Имя;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьКомментарий(Знач Комментарий)
	ПроверитьСтроку(Комментарий, "comment", Истина);
	Если СтрДлина(Комментарий) > 100 Тогда
		ВызватьИсключение "Комментарий API не должен превышать 100 символов";
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьГУИД(Знач Значение)
	ПроверитьСтроку(Значение, "guid");
	Попытка
		Идентификатор = Новый УникальныйИдентификатор(Значение);
	Исключение
		ВызватьИсключение "Ожидался GUID заявки на восстановление";
	КонецПопытки;
КонецПроцедуры

Процедура ЗарегистрироватьСекрет(Знач Значение)
	Если Значение <> "" И Секреты.Найти(Значение) = Неопределено Тогда
		Секреты.Добавить(Значение);
		Лог.ДобавитьСекрет(Значение);
	КонецЕсли;
КонецПроцедуры

Функция Безопасно(Знач Текст)
	Возврат АПИСлужебный.СкрытьСекреты(Текст, Секреты);
КонецФункции

Процедура Сбой(Знач Метод, Знач Причина)
	Сообщение = Безопасно("Оркестратор " + Метод + ": " + Причина);
	Сообщение = СтрЗаменить(СтрЗаменить(Сообщение, Символы.ВК, " "), Символы.ПС, " ");
	Лог.Ошибка(Сообщение);
	ВызватьИсключение Сообщение;
КонецПроцедуры
