Процедура ПроверитьЧтение() Экспорт
	Лог = Новый ЛогМечел("ПроверитьАПИ", "INFO");
	Лог.Информация("Скрипт: " + СтартовыйСценарий().Источник);
	Лог.Информация("Библиотека mechel2 2.0.2: " + ТекущийСценарий().Источник);

	Адрес = ПолучитьПеременнуюСреды("MECHEL_API_URL");
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "https://ukm-web/ad/IT/IT_TechAdmin/hs/";
	КонецЕсли;
	Клиент = Новый АПИКлиент(Адрес, Лог);
	Инфобаза = СокрЛП(ПолучитьПеременнуюСреды("MECHEL_TEST_INFOBASE"));
	Если Не ПустаяСтрока(Инфобаза) Тогда
		Клиент.УстановитьТокен(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_API_TOKEN"));
	КонецЕсли;

	Лог.Информация("GET Objects1C/GetAgents");
	Клиент.ПолучитьАгентов();
	Лог.Информация("Чтение списка агентов выполнено");
	Если ПустаяСтрока(Инфобаза) Тогда
		Лог.Предупреждение("MECHEL_TEST_INFOBASE не задана. Проверен только список агентов.");
		Возврат;
	КонецЕсли;

	Лог.Информация("GET Objects1C/GetInfobaseBlock для " + Инфобаза);
	Блокировка = Клиент.ПолучитьБлокировку(Инфобаза);
	Если ТипЗнч(Блокировка) <> Тип("Соответствие") Тогда
		ВызватьИсключение "GetInfobaseBlock: ожидался JSON-объект с параметрами блокировки";
	КонецЕсли;
	Лог.Информация("Чтение параметров блокировки выполнено");
КонецПроцедуры
