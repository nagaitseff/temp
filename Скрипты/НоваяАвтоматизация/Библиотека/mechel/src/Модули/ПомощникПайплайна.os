// Общие соглашения новых скриптов. Здесь нет запуска 1С или изменения баз.

Функция ОбязательнаяПеременнаяСреды(Знач Имя) Экспорт
	Значение = ПолучитьПеременнуюСреды(Имя);
	Если ПустаяСтрока(Значение) Тогда
		ВызватьИсключение "Не задана обязательная переменная среды: " + Имя;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция КомментарийJenkins(Знач ИмяДжобы, Знач НомерСборки, Знач Автор = "") Экспорт
	Если ПустаяСтрока(Строка(ИмяДжобы)) Или ПустаяСтрока(Строка(НомерСборки)) Тогда
		ВызватьИсключение "Для комментария Jenkins нужны имя джобы и номер сборки";
	КонецЕсли;
	Номер = ?(ТипЗнч(НомерСборки) = Тип("Число"), Формат(НомерСборки, "ЧГ=0; ЧДЦ=0; ЧН=0"), Строка(НомерСборки));
	Комментарий = "Jenkins: job=" + ИмяДжобы + " #" + Номер;
	Если Не ПустаяСтрока(Автор) Тогда
		Комментарий = Комментарий + " | " + Автор;
	КонецЕсли;
	Комментарий = СтрЗаменить(СтрЗаменить(Комментарий, Символы.ВК, " "), Символы.ПС, " ");
	Возврат Лев(Комментарий, 100);
КонецФункции

Функция ПроверитьСетевойПутьРасширения(Знач Путь) Экспорт
	Если ТипЗнч(Путь) <> Тип("Строка") Тогда
		ВызватьИсключение "Путь расширения должен быть строкой UNC";
	КонецЕсли;
	Путь = СокрЛП(Путь);
	Если Лев(Путь, 2) <> "\\" Или НРег(Прав(Путь, 4)) <> ".cfe" Тогда
		ВызватьИсключение "Ожидался сетевой путь \\сервер\ресурс\каталог\расширение.cfe";
	КонецЕсли;
	Части = СтрРазделить(Сред(Путь, 3), "\");
	Если Части.Количество() < 3 Тогда
		ВызватьИсключение "В UNC-пути нужны сервер, общий ресурс и файл расширения";
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		Если Часть = "" Или Часть = "." Или Часть = ".."
			Или СтрНайти(Часть, "*") > 0 Или СтрНайти(Часть, "?") > 0
			Или СтрНайти(Часть, "/") > 0 Или СтрНайти(Часть, ":") > 0
			Или СтрНайти(Часть, Символы.ПС) > 0 Или СтрНайти(Часть, Символы.ВК) > 0
			Или СтрНайти(Часть, Символы.Таб) > 0 Тогда
			ВызватьИсключение "Некорректный UNC-путь расширения";
		КонецЕсли;
	КонецЦикла;
	// Существование файла и права учётной записи проверяются на рабочем агенте.
	Возврат Путь;
КонецФункции
