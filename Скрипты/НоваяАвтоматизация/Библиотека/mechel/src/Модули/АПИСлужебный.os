// Чистые функции. Не выполняют HTTP-запросы и не зависят от сторонних пакетов.

Функция ЕстьПоле(Источник, ИмяПоля) Экспорт
	Если ТипЗнч(Источник) = Тип("Структура")
		Или ТипЗнч(Источник) = Тип("ФиксированнаяСтруктура") Тогда
		Возврат Источник.Свойство(ИмяПоля);
	ИначеЕсли ТипЗнч(Источник) = Тип("Соответствие")
		Или ТипЗнч(Источник) = Тип("ФиксированноеСоответствие") Тогда
		Для Каждого Элемент Из Источник Цикл
			Если Элемент.Ключ = ИмяПоля Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ЗначениеПоля(Источник, ИмяПоля, ПоУмолчанию = Неопределено) Экспорт
	Если Не ЕстьПоле(Источник, ИмяПоля) Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Возврат Источник[ИмяПоля];
КонецФункции

Функция ВJSON(Знач Данные) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

Функция ИзJSON(Знач Текст) Экспорт
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		ВызватьИсключение "Ожидался JSON-текст";
	КонецЕсли;
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Попытка
		Результат = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		// Не включаем в исключение исходный ответ: он может содержать секрет.
		ВызватьИсключение "Ответ не является корректным JSON";
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Функция КодУспеха(Знач Код) Экспорт
	Если ТипЗнч(Код) = Тип("Число") Тогда
		Если Код < 0 Или Код <> Цел(Код) Тогда
			ВызватьИсключение "Некорректный числовой код API";
		КонецЕсли;
		Возврат Код = 0;
	КонецЕсли;
	Если ТипЗнч(Код) <> Тип("Строка") Тогда
		ВызватьИсключение "В ответе API отсутствует корректный code";
	КонецЕсли;
	Если Код = "0" Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрДлина(Код) <> 5 Или Сред(Код, 3, 1) <> "."
		Или Не ТолькоЦифры(Лев(Код, 2) + Прав(Код, 2)) Тогда
		ВызватьИсключение "Некорректный строковый код API";
	КонецЕсли;
	// В частности, 00.01 и 00.12 — ошибки, а не разновидности успеха.
	Возврат Код = "00.00";
КонецФункции

Функция ВБулево(Знач Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Если Значение = 0 Или Значение = 1 Тогда
			Возврат Значение = 1;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Текст = НРег(СокрЛП(Значение));
		Если Текст = "true" Или Текст = "истина" Или Текст = "да" Или Текст = "1" Тогда
			Возврат Истина;
		ИначеЕсли Текст = "false" Или Текст = "ложь" Или Текст = "нет" Или Текст = "0" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ВызватьИсключение "Ожидалось булево значение: true/false, истина/ложь, да/нет или 1/0";
КонецФункции

Функция ISOДата(Знач Значение) Экспорт
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-dd'T'HH:mm:ss");
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И СтрДлина(Значение) = 19 Тогда
		Попытка
			ЧислаДаты = Лев(Значение, 4) + Сред(Значение, 6, 2) + Сред(Значение, 9, 2)
				+ Сред(Значение, 12, 2) + Сред(Значение, 15, 2) + Прав(Значение, 2);
			Если ТолькоЦифры(ЧислаДаты) И ISOДата(Дата(ЧислаДаты)) = Значение Тогда
				Возврат Значение;
			КонецЕсли;
		Исключение
			// Общая ошибка формата ниже.
		КонецПопытки;
	КонецЕсли;
	ВызватьИсключение "Дата должна быть значением Дата или строкой yyyy-MM-ddTHH:mm:ss без часового пояса";
КонецФункции

Функция СтрокаПараметровЗапроса(Параметры) Экспорт
	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Параметр Из Параметры Цикл
		Если Параметр.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = Параметр.Значение;
		Если ТипЗнч(Значение) = Тип("Булево") Тогда
			Текст = ?(Значение, "1", "0");
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
			Если Значение <> Цел(Значение) Тогда
				ВызватьИсключение "Числовой GET-параметр должен быть целым";
			КонецЕсли;
			Текст = Формат(Значение, "ЧГ=0; ЧДЦ=0; ЧН=0");
		Иначе
			Текст = Строка(Значение);
		КонецЕсли;
		Части.Добавить(
			КодироватьСтроку(Строка(Параметр.Ключ), СпособКодированияСтроки.КодировкаURL)
			+ "=" + КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");
КонецФункции

Функция РазобратьАдрес(Знач Адрес) Экспорт
	Если ТипЗнч(Адрес) <> Тип("Строка") Или ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не задан адрес HTTP-сервисов оркестратора";
	КонецЕсли;
	Адрес = СокрЛП(Адрес);
	Разделитель = СтрНайти(Адрес, "://");
	Если Разделитель = 0 Тогда
		ВызватьИсключение "Адрес оркестратора должен начинаться с http:// или https://";
	КонецЕсли;
	Схема = НРег(Лев(Адрес, Разделитель - 1));
	Если Схема <> "http" И Схема <> "https" Тогда
		ВызватьИсключение "Адрес оркестратора должен начинаться с http:// или https://";
	КонецЕсли;
	Для Каждого СимволЗапрета Из СтрРазделить("?,#,@,\," + Символы.ПС + "," + Символы.ВК + "," + Символы.Таб, ",") Цикл
		Если СтрНайти(Адрес, СимволЗапрета) > 0 Тогда
			ВызватьИсключение "В адресе оркестратора недопустимы параметры, фрагмент, учётные данные и управляющие символы";
		КонецЕсли;
	КонецЦикла;
	Остаток = Сред(Адрес, Разделитель + 3);
	Слэш = СтрНайти(Остаток, "/");
	Узел = ?(Слэш = 0, Остаток, Лев(Остаток, Слэш - 1));
	Путь = ?(Слэш = 0, "/", Сред(Остаток, Слэш));
	Если ПустаяСтрока(Узел) Или СтрНайти(Узел, " ") > 0 Тогда
		ВызватьИсключение "В адресе оркестратора не указан корректный сервер";
	КонецЕсли;
	Если Прав(Путь, 1) <> "/" Тогда
		Путь = Путь + "/";
	КонецЕсли;
	Возврат Новый Структура("Сервер,Путь", Схема + "://" + Узел, Путь);
КонецФункции

Функция СтатусВосстановления(Знач Код, Знач ДатаОбновления = "") Экспорт
	Если ТипЗнч(Код) <> Тип("Число") Тогда
		ВызватьИсключение "В loading1c/status поле result должно содержать числовой статус";
	КонецЕсли;
	Если Код = 0 Тогда
		Описание = "Восстановление завершено";
	ИначеЕсли Код = -1 Тогда
		Описание = "Восстановление завершилось с ошибкой";
	ИначеЕсли Код = 1 Тогда
		Описание = "Восстановление выполняется";
	ИначеЕсли Код = 2 Тогда
		Описание = "Восстановление приостановлено; требуется действие администраторов";
	Иначе
		ВызватьИсключение "Неизвестный статус loading1c/status";
	КонецЕсли;
	Возврат Новый Структура("Код,Описание,Завершено,Успех,ДатаОбновления",
		Код, Описание, Код = 0 Или Код = -1, Код = 0, ДатаОбновления);
КонецФункции

Функция СкрытьСекреты(Знач Текст, Секреты) Экспорт
	Текст = Строка(Текст);
	Если Секреты = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Формы = Новый Массив;
	Для Каждого Секрет Из Секреты Цикл
		Если ТипЗнч(Секрет) <> Тип("Строка") Тогда
			ВызватьИсключение "Для маскирования нужен массив строк";
		КонецЕсли;
		Если Не ПустаяСтрока(Секрет) Тогда
			ДобавитьФормуСекрета(Формы, Секрет);
			ДобавитьФормуСекрета(Формы,
				КодироватьСтроку(Секрет, СпособКодированияСтроки.КодировкаURL));
			JSONСекрет = ВJSON(Секрет);
			ДобавитьФормуСекрета(Формы, Сред(JSONСекрет, 2, СтрДлина(JSONСекрет) - 2));
		КонецЕсли;
	КонецЦикла;
	// Сначала длинные формы: старый токен-префикс не должен оставлять хвост нового.
	Для Каждого Форма Из Формы Цикл
		Текст = СтрЗаменить(Текст, Форма, "***");
	КонецЦикла;
	Возврат Текст;
КонецФункции

Процедура ДобавитьФормуСекрета(Формы, Знач Форма)
	Если Форма = "" Или Формы.Найти(Форма) <> Неопределено Тогда Возврат; КонецЕсли;
	Позиция = 0;
	Пока Позиция < Формы.Количество() И СтрДлина(Формы[Позиция]) >= СтрДлина(Форма) Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Формы.Вставить(Позиция, Форма);
КонецПроцедуры

Функция ТолькоЦифры(Знач Текст)
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции
