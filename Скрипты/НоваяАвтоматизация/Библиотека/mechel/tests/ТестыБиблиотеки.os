#Использовать ".."
#Использовать "fixtures"

Перем КоличествоПроверок;
Перем Клиент;
Перем Транспорт;
Перем ГУИД;
Перем Секрет;

Процедура Проверить(Знач Условие, Знач Название)
	КоличествоПроверок = КоличествоПроверок + 1;
	Если Не Условие Тогда ВызватьИсключение "Проверка не пройдена: " + Название; КонецЕсли;
КонецПроцедуры

Процедура ОжидаетсяОшибка(Знач Выражение, Знач Фрагмент)
	БылаОшибка = Ложь;
	Попытка
		Результат = Вычислить(Выражение);
	Исключение
		БылаОшибка = Истина;
		Проверить(СтрНайти(ОписаниеОшибки(), Фрагмент) > 0, "текст ошибки: " + Фрагмент);
	КонецПопытки;
	Проверить(БылаОшибка, "ожидалось исключение: " + Выражение);
КонецПроцедуры

Процедура НовыйКлиент()
	Транспорт = Новый ТранспортЗаглушка;
	Клиент = Новый АПИКлиент("https://ukm-web/ad/IT/IT_TechAdmin/hs/", Новый ЛогМечел("test", "OFF"), Транспорт);
КонецПроцедуры

Функция ПоследнийВызов()
	Возврат Транспорт.Вызовы[Транспорт.Вызовы.Количество() - 1];
КонецФункции

Процедура ПроверитьВызов(Знач Метод, Знач Путь, Знач НуженТокен = Ложь)
	Вызов = ПоследнийВызов();
	Проверить(Вызов.Метод = Метод, Метод + " " + Путь);
	ОжидаемыйПуть = "/ad/IT/IT_TechAdmin/hs/" + Путь;
	Если НуженТокен И Метод = "GET" Тогда
		ОжидаемыйПуть = ОжидаемыйПуть + ?(СтрНайти(Путь, "?") > 0, "&", "?")
			+ "token=" + КодироватьСтроку(Секрет, СпособКодированияСтроки.КодировкаURL);
	КонецЕсли;
	Проверить(Вызов.Путь = ОжидаемыйПуть, "точный путь: " + Путь);
	Проверить(Не АПИСлужебный.ЕстьПоле(Вызов.Заголовки, "token"), "нет токена в заголовках");
	Если НуженТокен И Метод = "POST" Тогда
		Тело = АПИСлужебный.ИзJSON(Вызов.Тело);
		Проверить(Тело["token"] = Секрет, "POST передаёт токен в JSON");
	Иначе
		Проверить(Вызов.Тело = "", "GET без тела");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьУтилиты()
	Проверить(АПИСлужебный.КодУспеха(0), "числовой успех");
	Проверить(АПИСлужебный.КодУспеха("00.00"), "строковый успех");
	Проверить(АПИСлужебный.КодУспеха("0"), "число в строке");
	Проверить(Не АПИСлужебный.КодУспеха("00.01"), "00.01 — ошибка");
	Проверить(Не АПИСлужебный.КодУспеха("00.12"), "00.12 — ошибка");
	Проверить(Не АПИСлужебный.КодУспеха(12), "12 — ошибка");
	ОжидаетсяОшибка("АПИСлужебный.КодУспеха(Неопределено)", "code");
	ОжидаетсяОшибка("АПИСлужебный.КодУспеха(""garbage"")", "код API");
	Проверить(АПИСлужебный.ВБулево("true") И АПИСлужебный.ВБулево("Да"), "истинные флаги");
	Проверить(Не АПИСлужебный.ВБулево("false") И Не АПИСлужебный.ВБулево(0), "ложные флаги");
	ОжидаетсяОшибка("АПИСлужебный.ВБулево(""возможно"")", "булево");
	Проверить(АПИСлужебный.ISOДата(Дата(2026, 11, 18, 10, 30, 45)) = "2026-11-18T10:30:45", "ISO без выдуманного Z");
	Проверить(АПИСлужебный.ISOДата("2026-11-18T10:30:45") = "2026-11-18T10:30:45", "ISO строка");
	ОжидаетсяОшибка("АПИСлужебный.ISOДата(""2026-02-31T00:00:00"")", "Дата должна");
	ОжидаетсяОшибка("АПИСлужебный.ISOДата(""2026-11-18T10:30:45Z"")", "Дата должна");
	Текст = АПИСлужебный.ВJSON(Новый Структура("Русский,Флаг", "текст", Ложь));
	Данные = АПИСлужебный.ИзJSON(Символ(65279) + Текст);
	Проверить(Данные["Русский"] = "текст" И Данные["Флаг"] = Ложь, "UTF-8 и JSON boolean");
	Проверить(АПИСлужебный.ЕстьПоле(Данные, "Флаг") И Не АПИСлужебный.ЕстьПоле(Данные, "Нет"), "различение наличия полей");
	Проверить(АПИСлужебный.ЗначениеПоля(Неопределено, "x", "нет") = "нет", "значение по умолчанию");
	ОжидаетсяОшибка("АПИСлужебный.ИзJSON(""<html>login</html>"")", "JSON");
	Параметры = Новый Структура("infobase", "S:8541|ERP TEST&копия");
	Проверить(АПИСлужебный.СтрокаПараметровЗапроса(Параметры)
		= "infobase=S%3A8541%7CERP%20TEST%26%D0%BA%D0%BE%D0%BF%D0%B8%D1%8F", "URL encoding значений параметров");
	Проверить(АПИСлужебный.СтрокаПараметровЗапроса(Новый Структура("flag", Ложь)) = "flag=0", "GET boolean как 0");
	Проверить(АПИСлужебный.СтрокаПараметровЗапроса(Новый Структура("number", 0)) = "number=0", "нулевой числовой GET-параметр");
	ОжидаетсяОшибка("АПИСлужебный.СтрокаПараметровЗапроса(Новый Структура(""number"",1.5))", "целым");
	Проверить(АПИСлужебный.СтрокаПараметровЗапроса(Неопределено) = "", "пустые GET-параметры");
	Адрес = АПИСлужебный.РазобратьАдрес("https://ukm-web/ad/IT/IT_TechAdmin/hs");
	Проверить(Адрес.Сервер = "https://ukm-web" И Адрес.Путь = "/ad/IT/IT_TechAdmin/hs/", "имя сервера без точки и слэши");
	ОжидаетсяОшибка("АПИСлужебный.РазобратьАдрес(""https://user:password@host/hs/"")", "учётные данные");
	ОжидаетсяОшибка("АПИСлужебный.РазобратьАдрес(""https://host/hs/?token=x"")", "параметры");
	ОжидаетсяОшибка("АПИСлужебный.РазобратьАдрес(""host/hs/"")", "http");
	Проверить(АПИСлужебный.СтатусВосстановления(0).Успех, "result=0 — готово");
	Проверить(Не АПИСлужебный.СтатусВосстановления(1).Завершено, "result=1 — выполняется");
	Проверить(Не АПИСлужебный.СтатусВосстановления(2).Завершено, "result=2 — пауза, не успех");
	Проверить(АПИСлужебный.СтатусВосстановления(-1).Завершено И Не АПИСлужебный.СтатусВосстановления(-1).Успех, "result=-1 — ошибка");
	ОжидаетсяОшибка("АПИСлужебный.СтатусВосстановления(7)", "Неизвестный статус");
	ОжидаетсяОшибка("АПИСлужебный.СтатусВосстановления(""0"")", "числовой статус");
КонецПроцедуры

Процедура ПроверитьКонтракты()
	НовыйКлиент();
	Транспорт.ДобавитьОтвет(Новый Массив);
	Результат = Клиент.ПолучитьАгентов();
	Проверить(ТипЗнч(Результат) = Тип("Массив"), "result возвращён без обёртки");
	ПроверитьВызов("GET", "Objects1C/GetAgents");
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьКластеры("S:1540");
	ПроверитьВызов("GET", "Objects1C/GetClusters?agent=S%3A1540");
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьПроектныеКоманды();
	ПроверитьВызов("GET", "Objects1C/GetProjectTeams");
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьПроекты();
	ПроверитьВызов("GET", "Objects1C/GetProjects");
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьИнфобазы("", "S:8541");
	ПроверитьВызов("GET", "Objects1C/GetInfobases?cluster=S%3A8541");
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьСеансыКластера("S:8541");
	ПроверитьВызов("GET", "Objects1C/GetSessions?cluster=S%3A8541");
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьПользователейБазы("S:8541|ERP", Истина, Ложь);
	ПроверитьВызов("GET", "Objects1C/GetInfobaseUsers?infobase=S%3A8541%7CERP&get_id=1&only_ad=0");
	ОжидаетсяОшибка("Клиент.ПолучитьБлокировку(""ERP"")", "Не задан API-токен");
	Клиент.УстановитьТокен(Секрет);
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьБлокировку("ERP");
	ПроверитьВызов("GET", "Objects1C/GetInfobaseBlock?infobase=ERP", Истина);
	Транспорт.ДобавитьОтвет();
	Параметры = Новый Структура("SessionsLockEnabled,LockScheduledJobs,LockBeginTime", "true", Ложь, Дата(2026, 11, 18));
	Клиент.УстановитьБлокировку("ERP", Параметры);
	ПроверитьВызов("POST", "Objects1C/SetInfobaseBlock", Истина);
	Тело = АПИСлужебный.ИзJSON(ПоследнийВызов().Тело);
	Проверить(Тело["infobase"] = "ERP" И Тело["SessionsLockEnabled"] = Истина И Тело["LockScheduledJobs"] = Ложь, "поля блокировки и настоящий JSON boolean");
	Проверить(Тело["LockBeginTime"] = "2026-11-18T00:00:00" И Не АПИСлужебный.ЕстьПоле(Тело, "LockEndTime"), "преобразование даты, отсутствующие поля не добавляются");
	Проверить(Параметры.SessionsLockEnabled = "true", "параметры вызывающего кода не меняются");
	Транспорт.ДобавитьОтвет();
	Клиент.СнятьБлокировку("ERP", Ложь);
	Тело = АПИСлужебный.ИзJSON(ПоследнийВызов().Тело);
	Проверить(Тело["SessionsLockEnabled"] = Ложь И Не АПИСлужебный.ЕстьПоле(Тело, "LockScheduledJobs"), "разблокировка может сохранить состояние регзаданий");
	Транспорт.ДобавитьОтвет();
	Клиент.ПолучитьОбслуживание("ERP");
	ПроверитьВызов("GET", "Objects1C/GetInfobaseMaintenance?infobase=ERP", Истина);
	Транспорт.ДобавитьОтвет();
	Клиент.УстановитьОбслуживание("ERP", Новый Структура("MaintenanceDisabled", Истина));
	ПроверитьВызов("POST", "Objects1C/SetInfobaseMaintenance", Истина);
	Транспорт.ДобавитьОтвет();
	Клиент.ЗавершитьПроцесс("S:8541", "process-id");
	ПроверитьВызов("POST", "Objects1C/TerminateProcess", Истина);
	Тело = АПИСлужебный.ИзJSON(ПоследнийВызов().Тело);
	Проверить(Тело["cluster"] = "S:8541" И Тело["process"] = "process-id", "процесс идентифицируется кластером и ИД");
	Транспорт.ДобавитьОтвет();
	Клиент.ЗавершитьСеанс("ERP", 123, 180);
	ПроверитьВызов("POST", "Objects1C/KillSession", Истина);
	Тело = АПИСлужебный.ИзJSON(ПоследнийВызов().Тело);
	Проверить(Тело["session"] = 123 И Тело["timeout"] = 180 И Тело["infobase"] = "ERP", "session — число, infobase передан");
	Проверить(ПоследнийВызов().Таймаут = 185, "HTTP ждёт дольше удаления сеанса");
	Транспорт.ДобавитьОтвет();
	Клиент.СброситьКэш("ERP");
	ПроверитьВызов("POST", "Objects1C/CacheReset", Истина);
	Транспорт.ДобавитьОтвет();
	Клиент.ЗапуститьАИР(Истина, "ERP");
	ПроверитьВызов("GET", "audit/AIR?full=1&infobase=ERP");
	Транспорт.ДобавитьОтвет();
	Клиент.ЗапуститьВИР(2, "ERP");
	ПроверитьВызов("GET", "audit/VIR?groupmarker=2&infobase=ERP");
	Транспорт.ДобавитьОтвет(ГУИД, "00.00");
	Результат = Клиент.ЗапуститьВосстановление("SOURCE", "TARGET",
		Новый Структура("makecopy,test,user,osname", "1", Истина, "Аналитик", "DOMAIN\analyst"));
	Проверить(Результат = ГУИД, "GUID берётся прямо из result");
	ПроверитьВызов("POST", "loading1c/new", Истина);
	Тело = АПИСлужебный.ИзJSON(ПоследнийВызов().Тело);
	Проверить(Тело["sourceinfobase"] = "SOURCE" И Тело["targetinfobase"] = "TARGET", "направление копирования");
	Проверить(ТипЗнч(Тело["makecopy"]) = Тип("Булево") И Тело["makecopy"] И Тело["test"] = 1,
		"makecopy — JSON boolean, test — число");
	Проверить(Тело["user"] = "Аналитик" И Тело["osname"] = "DOMAIN\analyst", "пользователь ИБ и учётная запись ОС");
	Транспорт.ДобавитьСыройОтвет(200, "{""code"":""00.00"",""description"":"""",""result"":2,""update_date"":""2026-11-18T09:43:04""}");
	Статус = Клиент.ПолучитьСтатусВосстановления(ГУИД);
	ПроверитьВызов("GET", "loading1c/status?guid=" + ГУИД, Истина);
	Проверить(Статус.Код = 2 И Не Статус.Завершено И Статус.ДатаОбновления = "2026-11-18T09:43:04", "статус и update_date из реального формата");
	Транспорт.ДобавитьОтвет("generated-secret");
	Клиент.СгенерироватьЗапуск("ERP", "app", "Analyst");
	ПроверитьВызов("GET", "run1c/generate?infobase=ERP&appname=app&user=Analyst&comment=", Истина);
КонецПроцедуры

Процедура ПроверитьОшибки()
	НовыйКлиент();
	Клиент.УстановитьТокен(Секрет);
	ОжидаетсяОшибка("Клиент.ЗапуститьВосстановление(""ERP"",""erp"")", "совпадают");
	ОжидаетсяОшибка("Клиент.ЗапуститьВосстановление(""SRC"",""DST"",Новый Структура(""archive"",""old.bak""))", "Неизвестный параметр");
	ОжидаетсяОшибка("Клиент.ЗапуститьВосстановление(""SRC"",""DST"",Новый Структура(""forcecreate"",1))", "dbmstype");
	ОжидаетсяОшибка("Клиент.ЗапуститьВосстановление(""SRC"",""DST"",Новый Структура(""osname"",""DOMAIN\analyst""))", "user при заданном osname");
	ОжидаетсяОшибка("Клиент.УстановитьБлокировку(""ERP"",Новый Структура(""LockScheduledJob"",Истина))", "Неизвестный параметр");
	ОжидаетсяОшибка("Клиент.ЗавершитьСеанс(""ERP"",""123"")", "целым числом");
	ОжидаетсяОшибка("Клиент.ПолучитьСтатусВосстановления(""not-a-guid"")", "GUID");
	ОжидаетсяОшибка("Клиент.СброситьКэш(""ERP"",""xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"")", "100 символов");
	Проверить(Транспорт.Вызовы.Количество() = 0, "ошибки параметров обнаружены до HTTP");
	Транспорт.ДобавитьСыройОтвет(401, "<html>unauthorized</html>");
	ОжидаетсяОшибка("Клиент.ПолучитьАгентов()", "HTTP 401");
	Транспорт.ДобавитьСыройОтвет(200, "<html>login</html>");
	ОжидаетсяОшибка("Клиент.ПолучитьАгентов()", "Ошибка протокола");
	Транспорт.ДобавитьСыройОтвет(200, "{""result"":[]}");
	ОжидаетсяОшибка("Клиент.ПолучитьАгентов()", "code");
	Транспорт.ДобавитьСыройОтвет(200, "{""code"":0}");
	ОжидаетсяОшибка("Клиент.ПолучитьАгентов()", "отсутствует result");
	Транспорт.ДобавитьОтвет(Неопределено, "00.01");
	ОжидаетсяОшибка("Клиент.ПолучитьАгентов()", "API code=00.01");
	Транспорт.ДобавитьОтвет(Неопределено, 12);
	ОжидаетсяОшибка("Клиент.ЗавершитьСеанс(""ERP"",123)", "API code=12");
	Транспорт.ДобавитьСыройОтвет(200, АПИСлужебный.ВJSON(Новый Структура("code,description", 8, "denied " + Секрет)));
	Попытка
		Клиент.ПолучитьБлокировку("ERP");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	Проверить(СтрНайти(ТекстОшибки, "API code=8") > 0 И СтрНайти(ТекстОшибки, Секрет) = 0, "секрет в description маскируется");
	Транспорт.ДобавитьОтвет(Новый Структура("request_id", ГУИД));
	ОжидаетсяОшибка("Клиент.ЗапуститьВосстановление(""SRC"",""DST"")", "Заявка могла быть создана");
	ДоОшибки = Транспорт.Вызовы.Количество();
	Транспорт.ДобавитьСбой("network failure " + Секрет);
	Транспорт.ДобавитьОтвет(ГУИД);
	Попытка
		Клиент.ЗапуститьВосстановление("SRC", "DST");
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	Проверить(СтрНайти(ТекстОшибки, "запрос не повторялся") > 0 И СтрНайти(ТекстОшибки, Секрет) = 0, "ошибка транспорта без токена");
	Проверить(Транспорт.Вызовы.Количество() = ДоОшибки + 1, "POST не повторяется при потере ответа");
	НовыйКлиент();
	Клиент.УстановитьТокен(Секрет);
	Транспорт.ДобавитьОтвет(0, "00.00");
	Статус = Клиент.ОжидатьЗавершенияВосстановления(ГУИД, 5, 1);
	Проверить(Статус.Успех, "ожидание завершается на result=0");
	Транспорт.ДобавитьОтвет(-1, "00.00");
	ОжидаетсяОшибка("Клиент.ОжидатьЗавершенияВосстановления(ГУИД,5,1)", "с ошибкой");
	Транспорт.ДобавитьОтвет(1, "00.00");
	ОжидаетсяОшибка("Клиент.ОжидатьЗавершенияВосстановления(ГУИД,1,60)", "таймаут ожидания");
	Проверить(ПоследнийВызов().Таймаут <= 1, "HTTP-таймаут ограничен общим сроком ожидания");
КонецПроцедуры

Процедура ПроверитьЛогИПомощник()
	Секреты = Новый Массив;
	Секреты.Добавить(Секрет);
	Скрытый = АПИСлужебный.СкрытьСекреты("token=" + КодироватьСтроку(Секрет, СпособКодированияСтроки.КодировкаURL) + " raw=" + Секрет, Секреты);
	Проверить(СтрНайти(Скрытый, Секрет) = 0 И СтрНайти(Скрытый, "%2B") = 0, "маскируется исходный и URL-кодированный секрет");
	Секреты.Вставить(0, "test");
	Проверить(АПИСлужебный.СкрытьСекреты(Секрет, Секреты) = "***", "перекрывающиеся секреты маскируются целиком");
	ФайлЛога = ПолучитьИмяВременногоФайла("log");
	Журнал = Новый ЛогМечел("test", "INFO", ФайлЛога);
	Журнал.ДобавитьСекрет(Секрет);
	Журнал.Отладка("SHOULD_NOT_APPEAR");
	Журнал.Информация("secret=" + Секрет);
	Чтение = Новый ЧтениеТекста(ФайлЛога, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	УдалитьФайлы(ФайлЛога);
	Проверить(СтрНайти(Текст, "SHOULD_NOT_APPEAR") = 0 И СтрНайти(Текст, Секрет) = 0 И СтрНайти(Текст, "[INFO] [test] secret=***") > 0, "файловый лог и уровень INFO");
	// Ошибка файлового лога после выполнения API не должна превращаться в ошибку операции.
	Журнал = Новый ЛогМечел("test", "INFO", ФайлЛога + "\missing\test.log");
	Журнал.Информация("Ожидаемая проверка недоступного файла лога");
	Проверить(Истина, "сбой файла лога не вызывает исключение");
	Проверить(ПомощникПайплайна.КомментарийJenkins("job", 2144, "Author") = "Jenkins: job=job #2144 | Author", "формат комментария Jenkins");
	Проверить(СтрДлина(ПомощникПайплайна.КомментарийJenkins("job", 1,
		"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx")) = 100, "ограничение комментария");
	Путь = "\\server\share\folder\Расширение.cfe";
	Проверить(ПомощникПайплайна.ПроверитьСетевойПутьРасширения(Путь) = Путь, "UNC с кириллицей");
	ОжидаетсяОшибка("ПомощникПайплайна.ПроверитьСетевойПутьРасширения(""C:\test.cfe"")", "сетевой путь");
	ОжидаетсяОшибка("ПомощникПайплайна.ПроверитьСетевойПутьРасширения(""\\server\share\..\test.cfe"")", "Некорректный UNC");
КонецПроцедуры

КоличествоПроверок = 0;
ГУИД = "4c401c09-752a-4c74-8d2d-4d524ec9aa84";
Секрет = "test+token/пароль";
Попытка
	ПроверитьУтилиты();
	ПроверитьКонтракты();
	ПроверитьОшибки();
	ПроверитьЛогИПомощник();
	Сообщить("PASS: " + Строка(КоличествоПроверок) + " проверок; обращения к оркестратору отсутствуют.");
Исключение
	Сообщить("FAIL: " + ОписаниеОшибки());
	ЗавершитьРаботу(1);
КонецПопытки;
