Перем Вызовы Экспорт;
Перем Ответы;

Процедура ПриСозданииОбъекта()
	Вызовы = Новый Массив;
	Ответы = Новый Массив;
КонецПроцедуры

Процедура ДобавитьОтвет(Результат = Неопределено, КодAPI = 0) Экспорт
	Пакет = Новый Структура("code,description,result", КодAPI, "", Результат);
	ДобавитьСыройОтвет(200, АПИСлужебный.ВJSON(Пакет));
КонецПроцедуры

Процедура ДобавитьСыройОтвет(Знач КодHTTP, Знач Текст) Экспорт
	Ответы.Добавить(Новый Структура("КодСостояния,Тело,Ошибка", КодHTTP, Текст, ""));
КонецПроцедуры

Процедура ДобавитьСбой(Знач Текст) Экспорт
	Ответы.Добавить(Новый Структура("КодСостояния,Тело,Ошибка", 0, "", Текст));
КонецПроцедуры

Функция Отправить(Знач Метод, Знач Путь, Заголовки, Знач Тело, Знач Таймаут) Экспорт
	Вызовы.Добавить(Новый Структура("Метод,Путь,Заголовки,Тело,Таймаут", Метод, Путь, Заголовки, Тело, Таймаут));
	Если Ответы.Количество() = 0 Тогда ВызватьИсключение "Не настроен тестовый ответ"; КонецЕсли;
	Ответ = Ответы[0];
	Ответы.Удалить(0);
	Если Ответ.Ошибка <> "" Тогда ВызватьИсключение Ответ.Ошибка; КонецЕсли;
	Возврат Ответ;
КонецФункции
