#Использовать "../api"

// Только для tests/http_mock.py. Не принимает адрес рабочего оркестратора.
Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
	ВызватьИсключение "Запускайте через http_mock.py";
КонецЕсли;
Адрес = АргументыКоманднойСтроки[0];
Если Не СтрНачинаетсяС(Адрес, "http://127.0.0.1:") Тогда
	ВызватьИсключение "HTTP-тест разрешён только на локальном mock-сервере";
КонецЕсли;
Клиент = Новый АПИКлиент(Адрес, Новый ЛогМечел("http-test", "DEBUG"));
Клиент.УстановитьАутентификацию("", "", Ложь);
Клиент.УстановитьТаймаут(5);
Клиент.УстановитьТокен("http-test+token/&?");
База = "Сервер:8541|База Тест";
Кластер = "Сервер:8541";
Клиент.ПолучитьАгентов();
Клиент.ПолучитьКластеры("Сервер:1540");
Клиент.ПолучитьПроектныеКоманды();
Клиент.ПолучитьПроекты();
Клиент.ПолучитьИнфобазы("Сервер:1540", Кластер);
Клиент.ПолучитьСеансыКластера(Кластер);
Пользователи = Клиент.ПолучитьПользователейБазы(База);
Если Пользователи[0]["name"] <> "Иван" Тогда ВызватьИсключение "UTF-8 ответа повреждён"; КонецЕсли;
Блокировка = Клиент.ПолучитьБлокировку(База);
Если Блокировка["SessionsLockEnabled"] <> Ложь Тогда
	ВызватьИсключение "Некорректный результат чтения блокировки";
КонецЕсли;
Результат = Клиент.УстановитьБлокировку(База,
	Новый Структура("SessionsLockEnabled,LockScheduledJobs,LockBeginTime,LockEndTime,SessionStartPermissionCode,LockMessage,LockParameter,comment",
		Истина, Ложь, Дата(2026, 11, 25, 8, 30, 0), "2026-11-25T09:30:00", "test-permission-code",
		"На обслуживании", "test", "Локальный тест"));
Если Результат <> Истина Тогда ВызватьИсключение "Некорректный результат POST"; КонецЕсли;
Клиент.СнятьБлокировку(База, Истина, "Проверка снятия");
Клиент.ПолучитьОбслуживание(База);
Клиент.УстановитьОбслуживание(База,
	Новый Структура("MaintenanceDisabled,MaintenanceDisabledDate,MaintenanceDisabledNote,comment",
		Истина, Дата(2026, 11, 26), "Проверка", "Локальный тест"));
Если Клиент.ЗавершитьПроцесс(Кластер, "test-process", "Локальный тест") <> "" Тогда
	ВызватьИсключение "TerminateProcess должен передать пустой результат как есть";
КонецЕсли;
Если Клиент.ЗавершитьСеанс(База, 123, 30, "Локальный тест") <> Истина Тогда
	ВызватьИсключение "KillSession должен передать булев результат";
КонецЕсли;
Клиент.СброситьКэш(База, "Локальный тест");
Клиент.ЗапуститьАИР(Истина, База);
Клиент.ЗапуститьВИР(2, База);
ТокенЗапуска = Клиент.СгенерироватьЗапуск(База, "test-app", "Аналитик", "Локальный тест");
Если ТокенЗапуска <> "fake-launch-token" Тогда ВызватьИсключение "Некорректный ответ run1c"; КонецЕсли;
ГУИД = Клиент.ЗапуститьВосстановление("SOURCE", "TARGET",
	Новый Структура("test,makecopy,user,osname", 1, Истина, "Аналитик", "DOMAIN\analyst"));
Статус = Клиент.ОжидатьЗавершенияВосстановления(ГУИД, 10, 1);
Если Не Статус.Успех Тогда ВызватьИсключение "Не дождались статуса 0"; КонецЕсли;
Отклонено = Ложь;
Попытка
	Клиент.ПолучитьБлокировку("REDIRECT");
Исключение
	Отклонено = СтрНайти(ОписаниеОшибки(), "HTTP 302") > 0;
КонецПопытки;
Если Не Отклонено Тогда ВызватьИсключение "Перенаправление должно быть отклонено"; КонецЕсли;
Сообщить("PASS: HTTPСоединение, все адреса API, опрос 1 → 2 → 0 и отказ от перенаправления.");
