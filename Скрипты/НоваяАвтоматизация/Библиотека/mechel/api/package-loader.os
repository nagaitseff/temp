Процедура ПриЗагрузкеБиблиотеки(Путь, СтандартнаяОбработка, Отказ)
	СтандартнаяОбработка = Ложь;
	Исходники = ОбъединитьПути(Путь, "..", "src");
	ДобавитьМодуль(ОбъединитьПути(Исходники, "Модули", "АПИСлужебный.os"), "АПИСлужебный");
	ДобавитьМодуль(ОбъединитьПути(Исходники, "Модули", "ПомощникПайплайна.os"), "ПомощникПайплайна");
	ДобавитьМодуль(ОбъединитьПути(Исходники, "Модули", "ДиагностикаМечел.os"), "ДиагностикаМечел");
	ДобавитьКласс(ОбъединитьПути(Исходники, "Классы", "ЛогМечел.os"), "ЛогМечел");
	ДобавитьКласс(ОбъединитьПути(Исходники, "Классы", "АПИКлиент.os"), "АПИКлиент");
КонецПроцедуры
