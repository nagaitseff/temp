// Для размещения в C:\OneScript_2\api. Использует установленную mechel2.
#Использовать "../lib/mechel2/api"

Функция АдресаВосстановления(НуженПолныйАдрес)
	Источник = СокрЛП(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_SOURCE"));
	Приемник = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_TARGET");
	Защита = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗащитаПриемника.os"));
	Приемник = Защита.ПроверитьПриемник(Приемник, НуженПолныйАдрес).Адрес;
	Если ВРег(Источник) = ВРег(Приемник) Тогда
		ВызватьИсключение "Источник и приёмник должны быть разными";
	КонецЕсли;
	Возврат Новый Структура("Источник,Приемник", Источник, Приемник);
КонецФункции

Процедура СоздатьЗаявку(Клиент, Лог, ПарольИБ)
	Режим = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_MODE");
	Если Режим <> "test" И Режим <> "restore" Тогда
		ВызватьИсключение "Для создания заявки нужен режим test или restore";
	КонецЕсли;
	Если Не ПустаяСтрока(ПолучитьПеременнуюСреды("MECHEL_RESTORE_GUID")) Тогда
		ВызватьИсключение "GUID уже задан. Используйте команду wait";
	КонецЕсли;

	Адреса = АдресаВосстановления(Ложь);
	Параметры = Новый Структура("test,makecopy,comment", ?(Режим = "test", 1, 0),
		АПИСлужебный.ВБулево(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_MAKE_COPY")),
		КомментарийКЗаявке());
	ИмяПользователя = СокрЛП(ПолучитьПеременнуюСреды("MECHEL_RESTORE_USER"));
	ИмяОС = СокрЛП(ПолучитьПеременнуюСреды("MECHEL_RESTORE_OSNAME"));
	Если Не ПустаяСтрока(ИмяПользователя) Тогда
		Параметры.Вставить("user", ИмяПользователя);
	КонецЕсли;
	Если Не ПустаяСтрока(ПарольИБ) Тогда
		Если ПустаяСтрока(ИмяПользователя) Тогда
			ВызватьИсключение "Для установки пароля укажите MECHEL_RESTORE_USER";
		КонецЕсли;
		Параметры.Вставить("password", ПарольИБ);
		Лог.Информация("Оркестратор установит пароль для " + ИмяПользователя + " при восстановлении");
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяОС) Тогда
		Если ПустаяСтрока(ИмяПользователя) Тогда
			ВызватьИсключение "Для MECHEL_RESTORE_OSNAME укажите MECHEL_RESTORE_USER";
		КонецЕсли;
		Параметры.Вставить("osname", ИмяОС);
	КонецЕсли;

	ФайлГУИД = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_GUID_FILE"));
	ПутьГУИД = ФайлГУИД.ПолноеИмя;
	ПутьПопытки = ПутьГУИД + ".pending";
	Если ФайлГУИД.Существует() Или (Новый Файл(ПутьПопытки)).Существует() Тогда
		ВызватьИсключение "Для этого файла уже была попытка отправки. Проверьте заявку перед повторным запуском";
	КонецЕсли;
	СоздатьКаталог(ФайлГУИД.Путь);
	// Маркер создаётся до POST, чтобы повтор шага не отправлял вторую заявку.
	Запись = Новый ЗаписьТекста(ПутьПопытки, КодировкаТекста.ANSI);
	Запись.Закрыть();

	Лог.Информация("Создание заявки: " + Адреса.Источник + " → " + Адреса.Приемник);
	Лог.Отладка("Режим " + Режим + ", создать актуальную копию: " + Строка(Параметры.makecopy));
	Лог.Отладка("Комментарий заявки: " + Параметры.comment);
	ГУИД = Клиент.ЗапуститьВосстановление(Адреса.Источник, Адреса.Приемник, Параметры);
	Лог.Информация("Заявка принята. GUID: " + ГУИД);
	// GUID содержит только ASCII. Файл читается Jenkins как UTF-8 без BOM.
	Запись = Новый ЗаписьТекста(ПутьПопытки, КодировкаТекста.ANSI);
	Запись.ЗаписатьСтроку(ГУИД);
	Запись.Закрыть();
	ПереместитьФайл(ПутьПопытки, ПутьГУИД);
КонецПроцедуры

Функция КомментарийКЗаявке()
	ИмяДжобы = ПолучитьПеременнуюСреды("JOB_NAME");
	НомерСборки = ПолучитьПеременнуюСреды("BUILD_NUMBER");
	Если Не ПустаяСтрока(ИмяДжобы) И Не ПустаяСтрока(НомерСборки) Тогда
		Возврат ПомощникПайплайна.КомментарийJenkins(ИмяДжобы, НомерСборки);
	КонецЕсли;
	Возврат "OneScript: восстановление ИБ";
КонецФункции

Процедура ДождатьсяРезультата(Клиент, Лог)
	ГУИД = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_GUID");
	СтрокаМинут = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_WAIT_MINUTES");
	Попытка
		Минуты = Число(СтрокаМинут);
	Исключение
		ВызватьИсключение "Время опроса должно быть положительным целым числом минут";
	КонецПопытки;
	Если Минуты <= 0 Или Минуты <> Цел(Минуты) Тогда
		ВызватьИсключение "Время опроса должно быть положительным целым числом минут";
	КонецЕсли;
	Лог.Информация("Опрос заявки " + ГУИД + ". Интервал 60 секунд, таймаут " + СтрокаМинут + " мин.");
	Результат = Клиент.ОжидатьЗавершенияВосстановления(ГУИД, Минуты * 60, 60);
	Лог.Информация("Заявка " + ГУИД + " завершена со статусом " + Строка(Результат.Код));
КонецПроцедуры

Процедура ВыполнитьСкрипт()
	Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
		ВызватьИсключение "Укажите команду check, create или wait";
	КонецЕсли;
	Команда = АргументыКоманднойСтроки[0];
	Если Команда <> "check" И Команда <> "create" И Команда <> "wait" Тогда
		ВызватьИсключение "Укажите команду check, create или wait";
	КонецЕсли;

	УровеньЛога = ПолучитьПеременнуюСреды("MECHEL_LOG_LEVEL");
	Лог = Новый ЛогМечел("ВосстановитьИБ", ?(ПустаяСтрока(УровеньЛога), "INFO", УровеньЛога));
	Если Команда = "check" Тогда
		Адреса = АдресаВосстановления(Истина);
		Лог.Информация("Проверены адреса восстановления: " + Адреса.Источник + " → " + Адреса.Приемник);
		Возврат;
	КонецЕсли;
	Токен = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_API_TOKEN");
	Лог.ДобавитьСекрет(Токен);
	Лог.Отладка("Скрипт: " + ТекущийСценарий().Источник);
	Адрес = ПолучитьПеременнуюСреды("MECHEL_API_URL");
	Если ПустаяСтрока(Адрес) Тогда
		Клиент = Новый АПИКлиент(, Лог);
	Иначе
		Клиент = Новый АПИКлиент(Адрес, Лог);
	КонецЕсли;
	Клиент.УстановитьТокен(Токен);
	ПарольИБ = ПолучитьПеременнуюСреды("MECHEL_ENTERPRISE_PASSWORD");
	Если Не ПустаяСтрока(ПарольИБ) Тогда
		Клиент.ЗарегистрироватьСекрет(ПарольИБ);
	КонецЕсли;
	Если Команда = "create" Тогда
		СоздатьЗаявку(Клиент, Лог, ПарольИБ);
	Иначе
		ДождатьсяРезультата(Клиент, Лог);
	КонецЕсли;
КонецПроцедуры

ВыполнитьСкрипт();
