// Для размещения в C:\OneScript_2\api. Рабочий каталог — checkout ERP.
#Использовать "../lib/mechel2/api"

Функция АргументЗапуска(Значение)
	Кавычка = Символ(34);
	Если СтрНайти(Значение, Кавычка) > 0 Или СтрНайти(Значение, Символы.ВК) > 0
		Или СтрНайти(Значение, Символы.ПС) > 0 Или Прав(Значение, 1) = "\" Тогда
		ВызватьИсключение "В параметре запуска 1С есть недопустимый символ";
	КонецЕсли;
	Возврат Кавычка + Значение + Кавычка;
КонецФункции

Процедура ОграничитьДоступККаталогу(Каталог)
	СистемныйКаталог = ОбъединитьПути(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("SystemRoot"), "System32");
	WhoAmI = АргументЗапуска(ОбъединитьПути(СистемныйКаталог, "whoami.exe"));
	Процесс = СоздатьПроцесс(WhoAmI + " /user /fo csv /nh", , Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	РегулярноеВыражение = Новый РегулярноеВыражение("S-1-[0-9]+(?:-[0-9]+)+");
	Совпадения = РегулярноеВыражение.НайтиСовпадения(Процесс.ПотокВывода.Прочитать());
	Если Процесс.КодВозврата <> 0 Или Совпадения.Количество() <> 1 Тогда
		ВызватьИсключение "Не удалось определить Windows-учётку для файла параметров 1С";
	КонецЕсли;
	Доступ = "*" + Совпадения[0].Значение + ":(OI)(CI)F";
	КодВозврата = 0;
	ICacls = АргументЗапуска(ОбъединитьПути(СистемныйКаталог, "icacls.exe"));
	ЗапуститьПриложение(ICacls + " " + АргументЗапуска(Каталог) + " /grant:r " + АргументЗапуска(Доступ)
		+ " /inheritance:r /Q", , Истина, КодВозврата);
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось ограничить доступ к файлу параметров 1С";
	КонецЕсли;
КонецПроцедуры

Функция КаталогЗапуска(ФайлЛога)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ВРег(ФайлЛога.ПолноеИмя));
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "mechel-1c-" + ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

Процедура УдалитьФайлыЗапуска(Каталог)
	Если Не (Новый Файл(Каталог)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("enterprise.args,enterprise.log,fm_release.epf", ",") Цикл
		ФайлЗапуска = Новый Файл(ОбъединитьПути(Каталог, Имя));
		Если ФайлЗапуска.Существует() И ФайлЗапуска.ЭтоФайл() Тогда
			УдалитьФайлы(ФайлЗапуска.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Если НайтиФайлы(Каталог, "*", Ложь).Количество() = 0 Тогда
		УдалитьФайлы(Каталог);
	КонецЕсли;
КонецПроцедуры

Функция ОпубликоватьВывод1С(ФайлВывода, УжеОпубликовано, Лог, КлиентЗакрыт = Ложь)
	Если Не ФайлВывода.Существует() Тогда
		Возврат УжеОпубликовано;
	КонецЕсли;
	Чтение = Новый ЧтениеТекста;
	Попытка
		Чтение.Открыть(ФайлВывода.ПолноеИмя, КодировкаТекста.UTF8, , , Ложь);
		Текст = Чтение.Прочитать();
	Исключение
		// Если клиент держит файл открытым, следующая попытка дочитает его.
		Если КлиентЗакрыт Тогда
			Лог.Предупреждение("Не удалось прочитать файл сообщений /Out после закрытия 1С");
		КонецЕсли;
		Текст = Неопределено;
	КонецПопытки;
	Чтение.Закрыть();
	Если ПустаяСтрока(Текст) Тогда
		Возврат УжеОпубликовано;
	КонецЕсли;

	Если СтрДлина(Текст) < УжеОпубликовано Тогда
		УжеОпубликовано = 0;
	КонецЕсли;
	// Пока клиент пишет лог, публикуем только целые строки для маскирования секретов.
	ДоПозиции = ?(КлиентЗакрыт, СтрДлина(Текст), СтрНайти(Текст, Символы.ПС, НаправлениеПоиска.СКонца));
	Если ДоПозиции <= УжеОпубликовано Тогда
		Возврат УжеОпубликовано;
	КонецЕсли;
	НовыйТекст = Сред(Текст, УжеОпубликовано + 1, ДоПозиции - УжеОпубликовано);
	Для Каждого СтрокаВывода Из СтрРазделить(НовыйТекст, Символы.ПС, Ложь) Цикл
		Если Не ПустаяСтрока(СтрокаВывода) Тогда
			Лог.Информация("1С /Out — " + СокрЛП(СтрокаВывода));
		КонецЕсли;
	КонецЦикла;
	Возврат ДоПозиции;
КонецФункции

Функция ВыполнитьКлиент(ПутьПлатформы, Параметры, ФайлЛога, Лог, Обработка = Неопределено)
	Каталог = КаталогЗапуска(ФайлЛога);
	Если (Новый Файл(Каталог)).Существует() Тогда
		ВызватьИсключение "Временный каталог этого запуска 1С уже существует";
	КонецЕсли;
	СоздатьКаталог(Каталог);
	ПроцессЗапущен = Ложь;
	Попытка
		ОграничитьДоступККаталогу(Каталог);
		Если Обработка <> Неопределено Тогда
			КопияОбработки = Новый Файл(ОбъединитьПути(Каталог, "fm_release.epf"));
			Лог.Информация("Копирование обработки в " + КопияОбработки.ПолноеИмя);
			КопироватьФайл(Обработка.ПолноеИмя, КопияОбработки.ПолноеИмя);
			Если КопияОбработки.Размер() <> Обработка.Размер() Тогда
				ВызватьИсключение "Размер копии EPF отличается от исходного файла";
			КонецЕсли;
			Параметры = Параметры + " /Execute " + АргументЗапуска(КопияОбработки.ПолноеИмя) + " /DisableHomePageForms";
		КонецЕсли;
		ФайлПараметров = ОбъединитьПути(Каталог, "enterprise.args");
		ФайлВывода = Новый Файл(ОбъединитьПути(Каталог, "enterprise.log"));
		Параметры = Параметры + " /DisableStartupMessages /DisableStartupDialogs /DisableSplash"
			+ " /DisableUnrecoverableErrorMessage"
			+ " /Out " + АргументЗапуска(ФайлВывода.ПолноеИмя);
		// 1С 8.3.27 определяет UTF-8 по BOM. Это важно для кириллицы в адресе и путях.
		ПолучитьДвоичныеДанныеИзСтроки(Параметры, КодировкаТекста.UTF8, Истина).Записать(ФайлПараметров);
		Процесс = СоздатьПроцесс(АргументЗапуска(ПутьПлатформы) + " /@ " + АргументЗапуска(ФайлПараметров), Каталог);
		Процесс.Запустить();
		ПроцессЗапущен = Истина;
		ИД = Строка(Процесс.Идентификатор);
		Лог.Информация("Процесс 1cv8.exe запущен, PID " + ИД);

		Опубликовано = 0;
		Начало = ТекущаяДата();
		СледующийОтчет = Начало + 30;
		Пока Не Процесс.ОжидатьЗавершения(2000) Цикл
			Опубликовано = ОпубликоватьВывод1С(ФайлВывода, Опубликовано, Лог);
			Если ТекущаяДата() >= СледующийОтчет Тогда
				Ожидание = Строка(ТекущаяДата() - Начало);
				СостояниеВывода = ?(Опубликовано = 0, ". Сообщений /Out пока нет", "");
				Лог.Информация("Процесс 1cv8.exe PID " + ИД + " ещё работает, прошло " + Ожидание + " сек" + СостояниеВывода);
				СледующийОтчет = ТекущаяДата() + 30;
			КонецЕсли;
		КонецЦикла;
		Опубликовано = ОпубликоватьВывод1С(ФайлВывода, Опубликовано, Лог, Истина);
		Если Опубликовано = 0 Тогда
			Лог.Предупреждение("Сообщений платформы /Out нет");
		КонецЕсли;
		КодВозврата = Процесс.КодВозврата;
		Лог.Информация("Процесс 1cv8.exe PID " + ИД + " завершился с кодом " + Строка(КодВозврата));
	Исключение
		Лог.Ошибка("Ошибка подготовки или запуска 1С: " + ОписаниеОшибки());
		Если ПроцессЗапущен И Не Процесс.Завершен Тогда
			Процесс.Завершить(Истина);
			Процесс.ОжидатьЗавершения(5000);
		КонецЕсли;
		УдалитьФайлыЗапуска(Каталог);
		ВызватьИсключение "Ошибка выполнения 1С";
	КонецПопытки;
	УдалитьФайлыЗапуска(Каталог);
	Возврат КодВозврата;
КонецФункции

Функция ПараметрыКонфигуратора(Действие, Лог)
	ПараметрыРасширения = " -Extension Mechel";
	Если Действие = "check-cfe" Тогда
		Лог.Информация("Проверка применимости расширения Mechel");
		Возврат " /CheckCanApplyConfigurationExtensions" + ПараметрыРасширения;
	ИначеЕсли Действие = "apply-cfe" Тогда
		Лог.Информация("Применение расширения Mechel");
		Возврат " /UpdateDBCfg -Dynamic-" + ПараметрыРасширения;
	КонецЕсли;

	ИмяФайла = ?(Действие = "apply-cf", "1Cv8.cf", "Mechel.cfe");
	Каталог = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_CONFIG_DIR");
	ФайлКонфигурации = Новый Файл(ОбъединитьПути(Каталог, ИмяФайла));
	Если Не ФайлКонфигурации.Существует() Или Не ФайлКонфигурации.ЭтоФайл() Или ФайлКонфигурации.Размер() = 0 Тогда
		ВызватьИсключение "Нет непустого файла сборки " + ФайлКонфигурации.ПолноеИмя;
	КонецЕсли;
	Лог.Информация("Загрузка " + ФайлКонфигурации.ПолноеИмя);
	КомандаЗагрузки = " /LoadCfg " + АргументЗапуска(ФайлКонфигурации.ПолноеИмя);
	Возврат КомандаЗагрузки + ?(Действие = "apply-cf", " /UpdateDBCfg -Dynamic-", ПараметрыРасширения);
КонецФункции

Процедура ВыполнитьСкрипт()
	Подсказка = "Укажите команду check, run, apply-cf, load-cfe, check-cfe, apply-cfe или cleanup";
	Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
		ВызватьИсключение Подсказка;
	КонецЕсли;
	Действие = АргументыКоманднойСтроки[0];
	Если СтрРазделить("check,run,apply-cf,load-cfe,check-cfe,apply-cfe,cleanup", ",").Найти(Действие) = Неопределено Тогда
		ВызватьИсключение Подсказка;
	КонецЕсли;
	ФайлЛога = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_ENTERPRISE_LOG"));
	Если Действие = "cleanup" Тогда
		УдалитьФайлыЗапуска(КаталогЗапуска(ФайлЛога));
		Возврат;
	КонецЕсли;

	Приемник = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_TARGET");
	Защита = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗащитаПриемника.os"));
	База = Защита.ПроверитьПриемник(Приемник);
	ИмяВхода = СокрЛП(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_ENTERPRISE_USER"));
	Пароль = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_ENTERPRISE_PASSWORD");
	КодРазрешения = ПолучитьПеременнуюСреды("MECHEL_SESSION_PERMISSION_CODE");
	ФорматПароля = Новый РегулярноеВыражение("\A(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])[A-Za-z0-9]{6,}\z");
	ФорматПароля.ИгнорироватьРегистр = Ложь;
	Если Не ФорматПароля.Совпадает(Пароль) Тогда
		ВызватьИсключение "Пароль для 1С должен содержать от 6 символов, латинские буквы обоих регистров и цифры";
	КонецЕсли;
	УровеньЛога = ПолучитьПеременнуюСреды("MECHEL_LOG_LEVEL");
	Если Действие <> "check" Тогда
		СоздатьКаталог(ФайлЛога.Путь);
	КонецЕсли;
	Лог = Новый ЛогМечел("ЗапуститьОбработкуИБ", ?(ПустаяСтрока(УровеньЛога), "INFO", УровеньЛога),
		?(Действие = "check", "", ФайлЛога.ПолноеИмя));
	Лог.ДобавитьСекрет(Пароль);
	Лог.ДобавитьСекрет(КодРазрешения);
	Лог.Отладка("Скрипт: " + ТекущийСценарий().Источник + ", команда " + Действие);

	Платформа = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_1C_EXE"));
	Если Не Платформа.Существует() Или Не Платформа.ЭтоФайл() Тогда
		ВызватьИсключение "На агенте не найден 1cv8.exe: " + Платформа.ПолноеИмя;
	КонецЕсли;
	Обработка = Неопределено;
	Если Действие = "check" Или Действие = "run" Тогда
		Обработка = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_EPF_FILE"));
		Если Не Обработка.Существует() Или Не Обработка.ЭтоФайл() Тогда
			ВызватьИсключение "В выбранной ветке не найдена обработка: " + Обработка.ПолноеИмя;
		КонецЕсли;
		Если Обработка.Размер() = 0 Тогда
			ВызватьИсключение "Файл обработки пуст: " + Обработка.ПолноеИмя;
		КонецЕсли;
	КонецЕсли;

	РежимКлиента = ?(Обработка = Неопределено, "DESIGNER", "ENTERPRISE");
	Параметры = РежимКлиента + " /S " + АргументЗапуска(База.Кластер + "\" + База.Имя)
		+ " /WA- /N " + АргументЗапуска(ИмяВхода) + " /P " + АргументЗапуска(Пароль);
	Если Не ПустаяСтрока(КодРазрешения) Тогда
		Параметры = Параметры + " /UC " + АргументЗапуска(КодРазрешения);
	КонецЕсли;
	Если Действие = "check" Тогда
		Лог.Информация("Проверены адрес приёмника, платформа, обработка и параметры пароля");
		Лог.Отладка("Платформа: " + Платформа.ПолноеИмя + ", обработка: " + Обработка.ПолноеИмя);
		Возврат;
	КонецЕсли;

	УстановитьПеременнуюСреды("MECHEL_ENTERPRISE_PASSWORD", "");
	УстановитьПеременнуюСреды("MECHEL_SESSION_PERMISSION_CODE", "");
	Лог.Информация("Запуск " + ?(РежимКлиента = "DESIGNER", "конфигуратора", "1С:Предприятия")
		+ " на базе " + База.Адрес + " под " + ИмяВхода);
	Если Не ПустаяСтрока(КодРазрешения) Тогда
		Лог.Информация("Клиенту передаётся код разрешения запуска /UC");
	КонецЕсли;
	Лог.Информация("Клиент " + Платформа.ПолноеИмя);
	Если Обработка = Неопределено Тогда
		Параметры = Параметры + ПараметрыКонфигуратора(Действие, Лог);
	Иначе
		Лог.Информация("Внешняя обработка " + Обработка.ПолноеИмя);
	КонецЕсли;
	Лог.Информация("Ход запуска пишется в " + ФайлЛога.ПолноеИмя);
	КодВозврата = ВыполнитьКлиент(Платформа.ПолноеИмя, Параметры, ФайлЛога, Лог, Обработка);
	Если КодВозврата <> 0 Тогда
		Если Действие = "check-cfe" Тогда
			Операция = "Проверка применимости Mechel завершилась с кодом ";
		ИначеЕсли Действие = "run" Тогда
			Операция = "1С:Предприятие завершилось с кодом ";
		Иначе
			Операция = "Конфигуратор завершился с кодом ";
		КонецЕсли;
		ТекстОшибки = Операция + Строка(КодВозврата) + ". Лог " + ФайлЛога.ПолноеИмя;
		Лог.Ошибка(ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	Если Действие = "check-cfe" Тогда
		Лог.Информация("Проверка применимости Mechel пройдена");
	КонецЕсли;
КонецПроцедуры

ВыполнитьСкрипт();
