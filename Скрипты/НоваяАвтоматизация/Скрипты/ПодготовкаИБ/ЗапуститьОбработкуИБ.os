// Для размещения в C:\OneScript_2\api. Рабочий каталог — checkout ERP.
#Использовать "../lib/mechel2/api"

Функция АдресБазы(Приемник)
	Части = СтрРазделить(Приемник, "|", Истина);
	ФорматКластера = Новый РегулярноеВыражение("\A[^\s\\""/;]+:[0-9]{1,5}\z");
	ФорматИмени = Новый РегулярноеВыражение("\A[^\r\n\\""/]+\z");
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение "Укажите TARGET_INFOBASE в формате СЕРВЕР:ПОРТ|ИмяИБ";
	КонецЕсли;
	Кластер = Части[0];
	ИмяБазы = Части[1];
	Если Не ФорматКластера.Совпадает(Кластер) Или ПустаяСтрока(ИмяБазы)
		Или Не ФорматИмени.Совпадает(ИмяБазы) Тогда
		ВызватьИсключение "Укажите TARGET_INFOBASE в формате СЕРВЕР:ПОРТ|ИмяИБ";
	КонецЕсли;
	ПозицияПорта = СтрНайти(Кластер, ":", НаправлениеПоиска.СКонца);
	Порт = Число(Сред(Кластер, ПозицияПорта + 1));
	Если Порт < 1 Или Порт > 65535 Тогда
		ВызватьИсключение "Порт в TARGET_INFOBASE должен быть в диапазоне 1–65535";
	КонецЕсли;
	Возврат Новый Структура("Кластер,Имя", Кластер, ИмяБазы);
КонецФункции

Функция АргументЗапуска(Значение)
	Кавычка = Символ(34);
	Если СтрНайти(Значение, Кавычка) > 0 Или СтрНайти(Значение, Символы.ВК) > 0
		Или СтрНайти(Значение, Символы.ПС) > 0 Или Прав(Значение, 1) = "\" Тогда
		ВызватьИсключение "В параметре запуска 1С есть недопустимый символ";
	КонецЕсли;
	Возврат Кавычка + Значение + Кавычка;
КонецФункции

Функция Коннектор1С()
	Попытка
		Возврат Новый COMОбъект("V83.COMConnector");
	Исключение
		ВызватьИсключение "Проверьте регистрацию V83.COMConnector и его библиотеки типов для 1С 8.3.27.2342 и разрядность OneScript";
	КонецПопытки;
КонецФункции

Функция ПараметрСоединения(Значение)
	Кавычка = Символ(34);
	Возврат Кавычка + СтрЗаменить(Значение, Кавычка, Кавычка + Кавычка) + Кавычка;
КонецФункции

Процедура СнятьТребованиеСменыПароля(Соединение, ИмяВхода, Лог)
	Регистр = Соединение.Метаданные.РегистрыСведений.Найти("СведенияОПользователях");
	Если Регистр = Неопределено Или Регистр = Null Тогда
		Возврат;
	КонецЕсли;
	Реквизит = Регистр.Ресурсы.Найти("ПотребоватьСменуПароляПриВходе");
	Если Реквизит = Неопределено Или Реквизит = Null Тогда
		Возврат;
	КонецЕсли;
	Пользователь = Соединение.Пользователи.НайтиПоИмени(ИмяВхода);
	Если Пользователь = Неопределено Или Пользователь = Null Или Пользователь.Пустая() Тогда
		Возврат;
	КонецЕсли;

	НаборЗаписей = Соединение.РегистрыСведений.СведенияОПользователях.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запись = НаборЗаписей.Получить(0);
	Если Запись.ПотребоватьСменуПароляПриВходе Тогда
		Запись.ПотребоватьСменуПароляПриВходе = Ложь;
		НаборЗаписей.Записать();
		Лог.Отладка("Снят флаг ERP «Потребовать смену пароля при входе» для " + ИмяВхода);
	КонецЕсли;
КонецПроцедуры

Процедура СменитьПароль(Коннектор, База, ИмяВхода, НовыйПароль, ТекущийПароль, Лог)
	СтрокаИБ = "Srvr=" + ПараметрСоединения(База.Кластер) + ";Ref=" + ПараметрСоединения(База.Имя)
		+ ";Usr=" + ПараметрСоединения(ИмяВхода) + ";Pwd=" + ПараметрСоединения(ТекущийПароль) + ";";
	Лог.Информация("Смена пароля для " + ИмяВхода + " на " + База.Кластер + "|" + База.Имя);
	Лог.Отладка("Подключение к восстановленной базе через COM с текущим паролем");
	Попытка
		Соединение = Коннектор.Connect(СтрокаИБ);
		ПользовательИБ = Соединение.ПользователиИнформационнойБазы.ТекущийПользователь();
	Исключение
		ВызватьИсключение "Не удалось войти через COM под " + ИмяВхода
			+ ". Проверьте текущий пароль пользователя в копии источника и разрешение на внешнее соединение";
	КонецПопытки;
	Если ПользовательИБ = Неопределено Или ПользовательИБ = Null Или ВРег(ПользовательИБ.Имя) <> ВРег(ИмяВхода) Тогда
		ВызватьИсключение "COM-сеанс открыт под другой учётной записью. Ожидался " + ИмяВхода;
	КонецЕсли;

	Попытка
		Соединение.НачатьТранзакцию();
		Если НовыйПароль <> ТекущийПароль Тогда
			ПользовательИБ.Пароль = НовыйПароль;
			ПользовательИБ.Записать();
		КонецЕсли;
		СнятьТребованиеСменыПароля(Соединение, ИмяВхода, Лог);
		Соединение.ЗафиксироватьТранзакцию();
	Исключение
		Попытка
			Если Соединение.ТранзакцияАктивна() Тогда
				Соединение.ОтменитьТранзакцию();
			КонецЕсли;
		Исключение
			Лог.Предупреждение("Не удалось подтвердить отмену транзакции COM");
		КонецПопытки;
		ВызватьИсключение "1С не завершила смену пароля. Проверьте права пользователя и правила паролей в ИБ";
	КонецПопытки;
	Лог.Информация("Пароль для запуска 1С подготовлен для " + ИмяВхода);
КонецПроцедуры

Процедура ОграничитьДоступККаталогу(Каталог)
	СистемныйКаталог = ОбъединитьПути(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("SystemRoot"), "System32");
	WhoAmI = АргументЗапуска(ОбъединитьПути(СистемныйКаталог, "whoami.exe"));
	Процесс = СоздатьПроцесс(WhoAmI + " /user /fo csv /nh", , Истина);
	Процесс.Запустить();
	Процесс.ОжидатьЗавершения();
	РегулярноеВыражение = Новый РегулярноеВыражение("S-1-[0-9]+(?:-[0-9]+)+");
	Совпадения = РегулярноеВыражение.НайтиСовпадения(Процесс.ПотокВывода.Прочитать());
	Если Процесс.КодВозврата <> 0 Или Совпадения.Количество() <> 1 Тогда
		ВызватьИсключение "Не удалось определить Windows-учётку для файла параметров 1С";
	КонецЕсли;
	Доступ = "*" + Совпадения[0].Значение + ":(OI)(CI)F";
	КодВозврата = 0;
	ICacls = АргументЗапуска(ОбъединитьПути(СистемныйКаталог, "icacls.exe"));
	ЗапуститьПриложение(ICacls + " " + АргументЗапуска(Каталог) + " /grant:r " + АргументЗапуска(Доступ)
		+ " /inheritance:r /Q", , Истина, КодВозврата);
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Не удалось ограничить доступ к файлу параметров 1С";
	КонецЕсли;
КонецПроцедуры

Функция ВыполнитьКлиент(ПутьПлатформы, Параметры, ФайлЛога, Пароль, Лог)
	Каталог = ПолучитьИмяВременногоФайла("mechel-1c");
	СоздатьКаталог(Каталог);
	Попытка
		ОграничитьДоступККаталогу(Каталог);
		Лог.Отладка("Подготовлен временный каталог для параметров запуска 1С");
		ФайлПараметров = ОбъединитьПути(Каталог, "enterprise.args");
		ЛогПлатформы = ОбъединитьПути(Каталог, "enterprise.log");
		Параметры = Параметры + " /Out " + АргументЗапуска(ЛогПлатформы);
		// 1С 8.3.27 определяет UTF-8 по BOM. Это важно для кириллицы в адресе и путях.
		ПолучитьДвоичныеДанныеИзСтроки(Параметры, КодировкаТекста.UTF8, Истина).Записать(ФайлПараметров);
		КодВозврата = 0;
		ЗапуститьПриложение(АргументЗапуска(ПутьПлатформы) + " /@ " + АргументЗапуска(ФайлПараметров),
			, Истина, КодВозврата);
		Если (Новый Файл(ЛогПлатформы)).Существует() Тогда
			Чтение = Новый ЧтениеТекста(ЛогПлатформы, КодировкаТекста.UTF8);
			ТекстЛога = СтрЗаменить(Чтение.Прочитать(), Пароль, "***");
			Чтение.Закрыть();
			СоздатьКаталог(ФайлЛога.Путь);
			ПолучитьДвоичныеДанныеИзСтроки(ТекстЛога, КодировкаТекста.UTF8, Ложь).Записать(ФайлЛога.ПолноеИмя);
		КонецЕсли;
	Исключение
		УдалитьФайлы(Каталог);
		Лог.Ошибка("Не удалось выполнить запуск 1С с защищённым файлом параметров или сохранить лог платформы");
		Лог.Отладка(ОписаниеОшибки());
		ВызватьИсключение "Ошибка выполнения 1С:Предприятия";
	КонецПопытки;
	УдалитьФайлы(Каталог);
	Возврат КодВозврата;
КонецФункции

Процедура ВыполнитьСкрипт()
	Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
		ВызватьИсключение "Укажите команду check, reset или run";
	КонецЕсли;
	Действие = АргументыКоманднойСтроки[0];
	Если Действие <> "check" И Действие <> "reset" И Действие <> "run" Тогда
		ВызватьИсключение "Укажите команду check, reset или run";
	КонецЕсли;

	Приемник = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_TARGET");
	База = АдресБазы(Приемник);
	ИмяВхода = СокрЛП(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_ENTERPRISE_USER"));
	Пароль = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_ENTERPRISE_PASSWORD");
	ФорматПароля = Новый РегулярноеВыражение("\A(?=.*[A-Z])(?=.*[a-z])(?=.*[0-9])[A-Za-z0-9]{6,}\z");
	ФорматПароля.ИгнорироватьРегистр = Ложь;
	Если Не ФорматПароля.Совпадает(Пароль) Тогда
		ВызватьИсключение "Пароль для 1С должен содержать от 6 символов, латинские буквы обоих регистров и цифры";
	КонецЕсли;
	УровеньЛога = ПолучитьПеременнуюСреды("MECHEL_LOG_LEVEL");
	Лог = Новый ЛогМечел("ЗапуститьОбработкуИБ", ?(ПустаяСтрока(УровеньЛога), "INFO", УровеньЛога));
	Лог.ДобавитьСекрет(Пароль);
	Лог.Отладка("Скрипт: " + ТекущийСценарий().Источник + ", команда " + Действие);

	Если Действие <> "run" Тогда
		ТекущийПароль = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_ENTERPRISE_CURRENT_PASSWORD");
		Лог.ДобавитьСекрет(ТекущийПароль);
		Коннектор = Коннектор1С();
		Если Действие = "reset" Тогда
			СменитьПароль(Коннектор, База, ИмяВхода, Пароль, ТекущийПароль, Лог);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Платформа = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_1C_EXE"));
	Обработка = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_EPF_FILE"));
	Если Не Платформа.Существует() Или Не Платформа.ЭтоФайл() Тогда
		ВызватьИсключение "На агенте не найден 1cv8.exe: " + Платформа.ПолноеИмя;
	КонецЕсли;
	Если Не Обработка.Существует() Или Не Обработка.ЭтоФайл() Тогда
		ВызватьИсключение "В выбранной ветке не найдена обработка: " + Обработка.ПолноеИмя;
	КонецЕсли;

	ФайлЛога = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_ENTERPRISE_LOG"));
	Параметры = "ENTERPRISE /S " + АргументЗапуска(База.Кластер + "\" + База.Имя)
		+ " /WA- /N " + АргументЗапуска(ИмяВхода) + " /P " + АргументЗапуска(Пароль)
		+ " /Execute " + АргументЗапуска(Обработка.ПолноеИмя)
		+ " /DisableStartupMessages /DisableStartupDialogs /DisableSplash"
		+ " /DisableUnrecoverableErrorMessage /DisableHomePageForms";

	Если Действие = "check" Тогда
		Лог.Информация("Проверены адрес приёмника, платформа, обработка, пароль для входа и COMConnector");
		Лог.Отладка("Платформа: " + Платформа.ПолноеИмя + ", обработка: " + Обработка.ПолноеИмя);
		Возврат;
	КонецЕсли;

	УстановитьПеременнуюСреды("MECHEL_ENTERPRISE_PASSWORD", "");
	УстановитьПеременнуюСреды("MECHEL_ENTERPRISE_CURRENT_PASSWORD", "");
	Лог.Информация("Запуск " + Обработка.Имя + " на базе " + Приемник + " под " + ИмяВхода);
	Лог.Информация("Ждём закрытия 1С. Лог платформы: " + ФайлЛога.ПолноеИмя);
	КодВозврата = ВыполнитьКлиент(Платформа.ПолноеИмя, Параметры, ФайлЛога, Пароль, Лог);
	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "1С:Предприятие завершилось с кодом " + Строка(КодВозврата)
			+ ". Проверьте лог " + ФайлЛога.ПолноеИмя;
	КонецЕсли;
	Лог.Информация("1С:Предприятие завершилось с кодом 0");
КонецПроцедуры

ВыполнитьСкрипт();
