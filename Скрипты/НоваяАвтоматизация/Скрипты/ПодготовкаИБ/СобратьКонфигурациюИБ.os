// Для размещения в C:\OneScript_2\api. Рабочий каталог — checkout ERP.
#Использовать "../lib/mechel2/api"

Функция РабочийКаталогСборки(КаталогРезультата)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ВРег(КаталогРезультата));
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "mechel-build-"
		+ Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма), 24));
КонецФункции

Процедура ОчиститьКаталогСборки(Каталог, Лог)
	РабочийКаталог = Новый Файл(Каталог);
	Имя = РабочийКаталог.Имя;
	Префикс = "mechel-build-";
	ПутьВТемп = Новый Файл(ОбъединитьПути(КаталогВременныхФайлов(), Имя));
	Если ВРег(РабочийКаталог.ПолноеИмя) <> ВРег(ПутьВТемп.ПолноеИмя)
		Или Не СтрНачинаетсяС(Имя, Префикс) Или СтрДлина(Имя) <> СтрДлина(Префикс) + 24 Тогда
		ВызватьИсключение "Некорректный путь временного каталога сборки";
	КонецЕсли;
	Если Не РабочийКаталог.Существует() Тогда
		Возврат;
	КонецЕсли;
	Если Не РабочийКаталог.ЭтоКаталог() Тогда
		ВызватьИсключение "Ожидался временный каталог сборки: " + РабочийКаталог.ПолноеИмя;
	КонецЕсли;
	УдалитьФайлы(РабочийКаталог.ПолноеИмя);
	Если РабочийКаталог.Существует() Тогда
		ВызватьИсключение "Не удалось удалить временный каталог сборки: " + РабочийКаталог.ПолноеИмя;
	КонецЕсли;
	Лог.Информация("Удалён временный каталог сборки " + РабочийКаталог.ПолноеИмя);
КонецПроцедуры

Функция ВКавычках(Знач Путь)
	Возврат Символ(34) + Путь + Символ(34);
КонецФункции

Процедура ЗаписатьВывод(Поток, Лог, Ошибка)
	Текст = Поток.Прочитать();
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаВывода Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		СтрокаВывода = СокрЛП(СтрокаВывода);
		Если Не ПустаяСтрока(СтрокаВывода) Тогда
			Если Ошибка Тогда
				Лог.Предупреждение(СтрокаВывода);
			Иначе
				Лог.Информация(СтрокаВывода);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗапуститьКомандуСборки(Утилита, Каталог, Команда, Описание, Лог)
	ИмяУтилиты = (Новый Файл(Утилита)).Имя;
	Лог.Информация(Описание);
	Лог.Отладка(ИмяУтилиты + " " + Команда);
	Процесс = СоздатьПроцесс(ВКавычках(Утилита) + " " + Команда, Каталог, Истина, Ложь, КодировкаТекста.UTF8);
	Процесс.Запустить();
	СледующийОтчет = ТекущаяДата() + 30;
	Пока Не Процесс.Завершен Или Процесс.ПотокВывода.ЕстьДанные Или Процесс.ПотокОшибок.ЕстьДанные Цикл
		ЗаписатьВывод(Процесс.ПотокВывода, Лог, Ложь);
		ЗаписатьВывод(Процесс.ПотокОшибок, Лог, Истина);
		Если ТекущаяДата() >= СледующийОтчет Тогда
			Лог.Отладка(ИмяУтилиты + " продолжает работу, PID " + Строка(Процесс.Идентификатор));
			СледующийОтчет = ТекущаяДата() + 30;
		КонецЕсли;
		Приостановить(200);
	КонецЦикла;
	Если Процесс.КодВозврата <> 0 Тогда
		ВызватьИсключение Описание + ". Код " + ИмяУтилиты + ": " + Строка(Процесс.КодВозврата);
	КонецЕсли;
КонецПроцедуры

Функция СоздатьФайловуюБазу(Утилита, КаталогБазы, ИмяФайла, Лог)
	КаталогДанных = ОбъединитьПути(КаталогБазы, "data");
	КаталогБД = ОбъединитьПути(КаталогБазы, "db");
	СоздатьКаталог(КаталогДанных);
	СоздатьКаталог(КаталогБД);
	ПараметрыБазы = " --data=" + ВКавычках(КаталогДанных) + " --db-path=" + ВКавычках(КаталогБД);
	ЗапуститьКомандуСборки(Утилита, КаталогБазы, "infobase create" + ПараметрыБазы,
		"Создание файловой базы для " + ИмяФайла, Лог);
	Возврат Новый Структура("КаталогБД,Параметры", КаталогБД, ПараметрыБазы);
КонецФункции

Процедура ПроверитьСобранныйФайл(ПутьРезультата, Лог)
	Результат = Новый Файл(ПутьРезультата);
	Если Не Результат.Существует() Или Не Результат.ЭтоФайл() Или Результат.Размер() = 0 Тогда
		ВызватьИсключение "Не создан непустой файл " + Результат.ПолноеИмя;
	КонецЕсли;
	Лог.Информация("Собран " + Результат.Имя + " (" + Строка(Результат.Размер()) + " байт)");
КонецПроцедуры

Процедура СобратьКонфигурацию(Утилита, КаталогБазы, Исходники, ПутьРезультата, Лог)
	База = СоздатьФайловуюБазу(Утилита, КаталогБазы, "1Cv8.cf", Лог);
	ЗапуститьКомандуСборки(Утилита, КаталогБазы, "infobase config import" + База.Параметры + " " + ВКавычках(Исходники),
		"Импорт XML основной конфигурации из " + Исходники, Лог);
	ЗапуститьКомандуСборки(Утилита, КаталогБазы, "infobase config save" + База.Параметры + " " + ВКавычках(ПутьРезультата),
		"Выгрузка 1Cv8.cf", Лог);
	ПроверитьСобранныйФайл(ПутьРезультата, Лог);
КонецПроцедуры

Процедура ЗапуститьКонфигураторСборки(Платформа, КаталогБД, Команда, Описание, ПутьЛога, Лог)
	ИмяЛога = (Новый Файл(ПутьЛога)).ИмяБезРасширения;
	ПутьСтатуса = ОбъединитьПути(КаталогБД, ИмяЛога + ".result");
	Аргументы = "DESIGNER /F " + ВКавычках(КаталогБД)
		+ " /DisableStartupMessages /DisableStartupDialogs /DisableSplash /DisableUnrecoverableErrorMessage"
		+ " /Out " + ВКавычках(ПутьЛога) + " /DumpResult " + ВКавычках(ПутьСтатуса) + " " + Команда;
	Описание = Описание + ". Журнал платформы " + ПутьЛога;
	ЗапуститьКомандуСборки(Платформа, КаталогБД, Аргументы, Описание, Лог);
	Если Не (Новый Файл(ПутьСтатуса)).Существует() Тогда
		ВызватьИсключение "Конфигуратор не записал результат. " + Описание;
	КонецЕсли;
	Чтение = Новый ЧтениеТекста(ПутьСтатуса, КодировкаТекста.UTF8);
	КодКоманды = СокрЛП(Чтение.Прочитать());
	Чтение.Закрыть();
	Если КодКоманды <> "0" Тогда
		ВызватьИсключение "Код команды конфигуратора: " + КодКоманды + ". " + Описание;
	КонецЕсли;
КонецПроцедуры

Процедура СобратьРасширение(Утилита, Платформа, КаталогБазы, Исходники, ПутьРезультата, КаталогЛогов, Лог)
	База = СоздатьФайловуюБазу(Утилита, КаталогБазы, "Mechel.cfe", Лог);
	ЗапуститьКомандуСборки(Утилита, КаталогБазы, "infobase config extension create" + База.Параметры
		+ " --name=Mechel --name-prefix=Mechel", "Создание расширения Mechel в пустой базе", Лог);
	ЗапуститьКонфигураторСборки(Платформа, База.КаталогБД, "/LoadConfigFromFiles " + ВКавычках(Исходники)
		+ " -Extension Mechel -Format Hierarchical", "Загрузка XML расширения Mechel через конфигуратор",
		ОбъединитьПути(КаталогЛогов, "build-mechel-import.log"), Лог);
	ЗапуститьКонфигураторСборки(Платформа, База.КаталогБД, "/DumpCfg " + ВКавычках(ПутьРезультата)
		+ " -Extension Mechel", "Выгрузка Mechel.cfe через конфигуратор",
		ОбъединитьПути(КаталогЛогов, "build-mechel-dump.log"), Лог);
	ПроверитьСобранныйФайл(ПутьРезультата, Лог);
КонецПроцедуры

Процедура ПроверитьИсходники(Каталог)
	ФайлОписания = Новый Файл(ОбъединитьПути(Каталог, "Configuration.xml"));
	Если Не ФайлОписания.Существует() Или Не ФайлОписания.ЭтоФайл() Или ФайлОписания.Размер() = 0 Тогда
		ВызватьИсключение "В выбранной ветке нет непустого " + ФайлОписания.ПолноеИмя;
	КонецЕсли;
КонецПроцедуры

Функция ПутьКУтилите(ИмяПеременной)
	Утилита = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды(ИмяПеременной));
	Если Не Утилита.Существует() Или Не Утилита.ЭтоФайл() Тогда
		ВызватьИсключение "На агенте не найдена утилита " + Утилита.ПолноеИмя;
	КонецЕсли;
	Возврат Утилита.ПолноеИмя;
КонецФункции

Процедура ВыполнитьСкрипт()
	Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
		ВызватьИсключение "Укажите команду build или cleanup";
	КонецЕсли;
	Команда = АргументыКоманднойСтроки[0];
	Если Команда <> "build" И Команда <> "cleanup" Тогда
		ВызватьИсключение "Укажите команду build или cleanup";
	КонецЕсли;
	Выход = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_CONFIG_DIR"));
	ВременныйКаталог = РабочийКаталогСборки(Выход.ПолноеИмя);
	УровеньЛога = ПолучитьПеременнуюСреды("MECHEL_LOG_LEVEL");
	Лог = Новый ЛогМечел("СобратьКонфигурациюИБ", ?(ПустаяСтрока(УровеньЛога), "INFO", УровеньЛога),
		ОбъединитьПути(Выход.ПолноеИмя, "build-config.log"));
	Если Команда = "cleanup" Тогда
		ОчиститьКаталогСборки(ВременныйКаталог, Лог);
		Возврат;
	КонецЕсли;

	Утилита = ПутьКУтилите("MECHEL_IBCMD_EXE");
	ИсходникиCF = ОбъединитьПути(ТекущийКаталог(), "src", "cf");
	ИсходникиCFE = ОбъединитьПути(ТекущийКаталог(), "src", "cfe", "Mechel");
	Выбор = ПолучитьПеременнуюСреды("MECHEL_BUILD_SELECTION");
	Если ПустаяСтрока(Выбор) Тогда
		Выбор = "both";
	КонецЕсли;
	СобиратьCF = Выбор = "cf" Или Выбор = "both";
	СобиратьCFE = Выбор = "cfe" Или Выбор = "both";
	Если Не СобиратьCF И Не СобиратьCFE Тогда
		ВызватьИсключение "Допустимые значения MECHEL_BUILD_SELECTION: cf, cfe, both";
	КонецЕсли;
	Если СобиратьCF Тогда
		ПроверитьИсходники(ИсходникиCF);
	КонецЕсли;
	Если СобиратьCFE Тогда
		Платформа = ПутьКУтилите("MECHEL_1C_EXE");
		ПроверитьИсходники(ИсходникиCFE);
	КонецЕсли;
	Если (Новый Файл(ВременныйКаталог)).Существует() Тогда
		ВызватьИсключение "Временный каталог этой сборки уже существует: " + ВременныйКаталог;
	КонецЕсли;

	СоздатьКаталог(Выход.ПолноеИмя);
	Артефакты = Новый Массив;
	Если СобиратьCF Тогда Артефакты.Добавить("1Cv8.cf"); КонецЕсли;
	Если СобиратьCFE Тогда Артефакты.Добавить("Mechel.cfe"); КонецЕсли;
	ИменаАртефактов = СтрСоединить(Артефакты, " и ");
	Лог.Информация("Сборка " + ИменаАртефактов + ". Коммит " + ПолучитьПеременнуюСреды("MECHEL_ERP_COMMIT"));
	Лог.Отладка("Временный каталог " + ВременныйКаталог);
	ФайлCF = ОбъединитьПути(ВременныйКаталог, "1Cv8.cf");
	ФайлCFE = ОбъединитьПути(ВременныйКаталог, "Mechel.cfe");
	Попытка
		Если СобиратьCF Тогда
			СобратьКонфигурацию(Утилита, ОбъединитьПути(ВременныйКаталог, "cf"), ИсходникиCF, ФайлCF, Лог);
		КонецЕсли;
		Если СобиратьCFE Тогда
			СобратьРасширение(Утилита, Платформа, ОбъединитьПути(ВременныйКаталог, "cfe"), ИсходникиCFE,
				ФайлCFE, Выход.ПолноеИмя, Лог);
		КонецЕсли;
		Для Каждого ИмяАртефакта Из Артефакты Цикл
			Источник = Новый Файл(ОбъединитьПути(ВременныйКаталог, ИмяАртефакта));
			Копия = Новый Файл(ОбъединитьПути(Выход.ПолноеИмя, ИмяАртефакта));
			КопироватьФайл(Источник.ПолноеИмя, Копия.ПолноеИмя);
			Если Копия.Размер() <> Источник.Размер() Тогда
				ВызватьИсключение "Размер копии отличается от исходного файла: " + Копия.ПолноеИмя;
			КонецЕсли;
			Лог.Информация("Скопирован " + Копия.ПолноеИмя + " (" + Строка(Копия.Размер()) + " байт)");
		КонецЦикла;
	Исключение
		Лог.Ошибка(ОписаниеОшибки());
		Попытка
			ОчиститьКаталогСборки(ВременныйКаталог, Лог);
		Исключение
			Лог.Ошибка("Сбой очистки временной сборки. " + ОписаниеОшибки());
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьКаталогСборки(ВременныйКаталог, Лог);
КонецПроцедуры

ВыполнитьСкрипт();
