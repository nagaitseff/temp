// Для размещения в C:\OneScript_2\api. Рабочий каталог — checkout ERP.
#Использовать "../lib/mechel2/api"

Функция РабочийКаталогСборки(КаталогРезультата)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ВРег(КаталогРезультата));
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "mechel-build-"
		+ Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма), 24));
КонецФункции

Процедура ОчиститьКаталогСборки(Каталог)
	РабочийКаталог = Новый Файл(Каталог);
	Префикс = Новый Файл(ОбъединитьПути(КаталогВременныхФайлов(), "mechel-build-"));
	Если Не СтрНачинаетсяС(ВРег(РабочийКаталог.ПолноеИмя), ВРег(Префикс.ПолноеИмя)) Тогда
		ВызватьИсключение "Некорректный путь временного каталога сборки";
	КонецЕсли;
	Если РабочийКаталог.Существует() И РабочийКаталог.ЭтоКаталог() Тогда
		УдалитьФайлы(РабочийКаталог.ПолноеИмя);
	КонецЕсли;
КонецПроцедуры

Функция ВКавычках(Знач Путь)
	Возврат Символ(34) + Путь + Символ(34);
КонецФункции

Процедура ЗаписатьВывод(Поток, Лог, Ошибка)
	Текст = Поток.Прочитать();
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаВывода Из СтрРазделить(Текст, Символы.ПС, Ложь) Цикл
		СтрокаВывода = СокрЛП(СтрокаВывода);
		Если Не ПустаяСтрока(СтрокаВывода) Тогда
			Если Ошибка Тогда
				Лог.Предупреждение(СтрокаВывода);
			Иначе
				Лог.Информация(СтрокаВывода);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗапуститьIbcmd(Утилита, Каталог, Команда, Описание, Лог)
	Лог.Информация(Описание);
	Лог.Отладка("ibcmd " + Команда);
	Процесс = СоздатьПроцесс(ВКавычках(Утилита) + " infobase " + Команда, Каталог, Истина, Ложь, КодировкаТекста.UTF8);
	Процесс.Запустить();
	СледующийОтчет = ТекущаяДата() + 30;
	Пока Не Процесс.Завершен Или Процесс.ПотокВывода.ЕстьДанные Или Процесс.ПотокОшибок.ЕстьДанные Цикл
		ЗаписатьВывод(Процесс.ПотокВывода, Лог, Ложь);
		ЗаписатьВывод(Процесс.ПотокОшибок, Лог, Истина);
		Если ТекущаяДата() >= СледующийОтчет Тогда
			Лог.Отладка("ibcmd продолжает работу, PID " + Строка(Процесс.Идентификатор));
			СледующийОтчет = ТекущаяДата() + 30;
		КонецЕсли;
		Приостановить(200);
	КонецЦикла;
	Если Процесс.КодВозврата <> 0 Тогда
		ВызватьИсключение Описание + ". Код ibcmd: " + Строка(Процесс.КодВозврата);
	КонецЕсли;
КонецПроцедуры

Процедура СобратьФайл(Утилита, КаталогБазы, Исходники, ПутьРезультата, ИмяРасширения, Лог)
	КаталогДанных = ОбъединитьПути(КаталогБазы, "data");
	КаталогБД = ОбъединитьПути(КаталогБазы, "db");
	СоздатьКаталог(КаталогДанных);
	СоздатьКаталог(КаталогБД);
	ПараметрыБазы = " --data=" + ВКавычках(КаталогДанных) + " --db-path=" + ВКавычках(КаталогБД);
	ПараметрыРасширения = "";
	ИмяФайла = (Новый Файл(ПутьРезультата)).Имя;
	ЗапуститьIbcmd(Утилита, КаталогБазы, "create" + ПараметрыБазы, "Создание файловой базы для " + ИмяФайла, Лог);
	Если Не ПустаяСтрока(ИмяРасширения) Тогда
		ЗапуститьIbcmd(Утилита, КаталогБазы, "config extension create" + ПараметрыБазы
			+ " --name=" + ИмяРасширения + " --name-prefix=" + ИмяРасширения, "Создание расширения " + ИмяРасширения, Лог);
		ПараметрыРасширения = " --extension=" + ИмяРасширения;
	КонецЕсли;
	ЗапуститьIbcmd(Утилита, КаталогБазы, "config import" + ПараметрыБазы + ПараметрыРасширения + " " + ВКавычках(Исходники),
		"Импорт XML из " + Исходники, Лог);
	ЗапуститьIbcmd(Утилита, КаталогБазы, "config save" + ПараметрыБазы + ПараметрыРасширения + " " + ВКавычках(ПутьРезультата),
		"Выгрузка " + ИмяФайла, Лог);
	Результат = Новый Файл(ПутьРезультата);
	Если Не Результат.Существует() Или Не Результат.ЭтоФайл() Или Результат.Размер() = 0 Тогда
		ВызватьИсключение "ibcmd не создал непустой файл " + ИмяФайла;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьИсходники(Каталог)
	ФайлОписания = Новый Файл(ОбъединитьПути(Каталог, "Configuration.xml"));
	Если Не ФайлОписания.Существует() Или Не ФайлОписания.ЭтоФайл() Или ФайлОписания.Размер() = 0 Тогда
		ВызватьИсключение "В выбранной ветке нет непустого " + ФайлОписания.ПолноеИмя;
	КонецЕсли;
КонецПроцедуры

Процедура ВыполнитьСкрипт()
	Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
		ВызватьИсключение "Укажите команду build или cleanup";
	КонецЕсли;
	Команда = АргументыКоманднойСтроки[0];
	Выход = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_CONFIG_DIR"));
	ВременныйКаталог = РабочийКаталогСборки(Выход.ПолноеИмя);
	Если Команда = "cleanup" Тогда
		ОчиститьКаталогСборки(ВременныйКаталог);
		Возврат;
	ИначеЕсли Команда <> "build" Тогда
		ВызватьИсключение "Укажите команду build или cleanup";
	КонецЕсли;

	Утилита = Новый Файл(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_IBCMD_EXE"));
	Если Не Утилита.Существует() Или Не Утилита.ЭтоФайл() Тогда
		ВызватьИсключение "На агенте не найден ibcmd.exe: " + Утилита.ПолноеИмя;
	КонецЕсли;
	ИсходникиCF = ОбъединитьПути(ТекущийКаталог(), "src", "cf");
	ИсходникиCFE = ОбъединитьПути(ТекущийКаталог(), "src", "cfe", "Mechel");
	Выбор = ПолучитьПеременнуюСреды("MECHEL_BUILD_SELECTION");
	Если ПустаяСтрока(Выбор) Тогда
		Выбор = "both";
	КонецЕсли;
	СобиратьCF = Выбор = "cf" Или Выбор = "both";
	СобиратьCFE = Выбор = "cfe" Или Выбор = "both";
	Если Не СобиратьCF И Не СобиратьCFE Тогда
		ВызватьИсключение "Допустимые значения MECHEL_BUILD_SELECTION: cf, cfe, both";
	КонецЕсли;
	Если СобиратьCF Тогда
		ПроверитьИсходники(ИсходникиCF);
	КонецЕсли;
	Если СобиратьCFE Тогда
		ПроверитьИсходники(ИсходникиCFE);
	КонецЕсли;
	Если (Новый Файл(ВременныйКаталог)).Существует() Тогда
		ВызватьИсключение "Временный каталог этой сборки уже существует: " + ВременныйКаталог;
	КонецЕсли;

	СоздатьКаталог(Выход.ПолноеИмя);
	УровеньЛога = ПолучитьПеременнуюСреды("MECHEL_LOG_LEVEL");
	Лог = Новый ЛогМечел("СобратьКонфигурациюИБ", ?(ПустаяСтрока(УровеньЛога), "INFO", УровеньЛога),
		ОбъединитьПути(Выход.ПолноеИмя, "build-config.log"));
	Артефакты = Новый Массив;
	Если СобиратьCF Тогда Артефакты.Добавить("1Cv8.cf"); КонецЕсли;
	Если СобиратьCFE Тогда Артефакты.Добавить("Mechel.cfe"); КонецЕсли;
	ИменаАртефактов = СтрСоединить(Артефакты, " и ");
	Лог.Информация("Сборка " + ИменаАртефактов + ". Коммит " + ПолучитьПеременнуюСреды("MECHEL_ERP_COMMIT"));
	Лог.Отладка("Временный каталог " + ВременныйКаталог);
	ФайлCF = ОбъединитьПути(ВременныйКаталог, "1Cv8.cf");
	ФайлCFE = ОбъединитьПути(ВременныйКаталог, "Mechel.cfe");
	Попытка
		Если СобиратьCF Тогда
			СобратьФайл(Утилита.ПолноеИмя, ОбъединитьПути(ВременныйКаталог, "cf"), ИсходникиCF, ФайлCF, "", Лог);
		КонецЕсли;
		Если СобиратьCFE Тогда
			СобратьФайл(Утилита.ПолноеИмя, ОбъединитьПути(ВременныйКаталог, "cfe"), ИсходникиCFE, ФайлCFE, "Mechel", Лог);
		КонецЕсли;
		Для Каждого ИмяАртефакта Из Артефакты Цикл
			КопироватьФайл(ОбъединитьПути(ВременныйКаталог, ИмяАртефакта), ОбъединитьПути(Выход.ПолноеИмя, ИмяАртефакта));
		КонецЦикла;
		Лог.Информация("Собраны " + ИменаАртефактов + " в " + Выход.ПолноеИмя);
	Исключение
		Лог.Ошибка(ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	ОчиститьКаталогСборки(ВременныйКаталог);
КонецПроцедуры

ВыполнитьСкрипт();
