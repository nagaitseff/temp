// Для размещения в C:\OneScript_2\api. Блокировка принадлежит конкретному запуску Jenkins.
#Использовать "../lib/mechel2/api"

Функция БлокировкаВключена(Параметры)
	Если Не АПИСлужебный.ЕстьПоле(Параметры, "SessionsLockEnabled") Тогда
		ВызватьИсключение "Оркестратор не вернул признак блокировки начала сеансов";
	КонецЕсли;
	Возврат АПИСлужебный.ВБулево(Параметры["SessionsLockEnabled"]);
КонецФункции

Процедура ВыполнитьСкрипт()
	Если АргументыКоманднойСтроки.Количество() <> 1 Тогда
		ВызватьИсключение "Укажите команду lock или unlock";
	КонецЕсли;
	Команда = АргументыКоманднойСтроки[0];
	Если Команда <> "lock" И Команда <> "unlock" Тогда
		ВызватьИсключение "Укажите команду lock или unlock";
	КонецЕсли;

	Защита = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗащитаПриемника.os"));
	Приемник = Защита.ПроверитьПриемник(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_RESTORE_TARGET")).Адрес;
	ИмяДжобы = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("JOB_NAME");
	НомерСборки = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("BUILD_NUMBER");
	Комментарий = ПомощникПайплайна.КомментарийJenkins(ИмяДжобы, НомерСборки);
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(ПолучитьПеременнуюСреды("JENKINS_URL") + "|" + ИмяДжобы + "|" + НомерСборки);
	Метка = "Подготовка базы. Jenkins #" + НомерСборки + " / "
		+ Лев(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма), 24);

	УровеньЛога = ПолучитьПеременнуюСреды("MECHEL_LOG_LEVEL");
	Лог = Новый ЛогМечел("БлокировкаИБ", ?(ПустаяСтрока(УровеньЛога), "INFO", УровеньЛога));
	Адрес = ПолучитьПеременнуюСреды("MECHEL_API_URL");
	Клиент = ?(ПустаяСтрока(Адрес), Новый АПИКлиент(, Лог), Новый АПИКлиент(Адрес, Лог));
	Клиент.УстановитьТокен(ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_API_TOKEN"));
	КодРазрешения = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_SESSION_PERMISSION_CODE");
	Клиент.ЗарегистрироватьСекрет(КодРазрешения);
	Блокировка = Клиент.ПолучитьБлокировку(Приемник);
	Включена = БлокировкаВключена(Блокировка);
	СвояБлокировка = АПИСлужебный.ЗначениеПоля(Блокировка, "LockMessage") = Метка;
	Если Команда = "unlock" Тогда
		Если Не Включена Тогда
			Лог.Информация("Вход в " + Приемник + " уже открыт");
		ИначеЕсли СвояБлокировка Тогда
			Клиент.СнятьБлокировку(Приемник, Ложь, Комментарий, Истина);
			Лог.Информация("Снята блокировка начала сеансов на " + Приемник);
		Иначе
			Лог.Предупреждение("Снятие пропущено. На " + Приемник + " действует блокировка другой операции");
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Включена И Не СвояБлокировка Тогда
		ВызватьИсключение "На базе действует блокировка другой операции: " + Приемник;
	КонецЕсли;
	Начало = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_SESSION_LOCK_BEGIN");
	Окончание = ПомощникПайплайна.ОбязательнаяПеременнаяСреды("MECHEL_SESSION_LOCK_END");
	Параметры = Новый Структура("SessionsLockEnabled,LockBeginTime,LockEndTime,SessionStartPermissionCode,LockMessage,comment",
		Истина, Начало, Окончание, КодРазрешения, Метка, Комментарий);
	Лог.Информация("Установка блокировки на " + Приемник + " с " + Начало + " до " + Окончание);
	Лог.Отладка("SetInfobaseBlock: флаги передаются строками, даты в ISO");
	Клиент.УстановитьБлокировку(Приемник, Параметры, Истина);
	Блокировка = Клиент.ПолучитьБлокировку(Приемник);
	Если Не БлокировкаВключена(Блокировка) Или АПИСлужебный.ЗначениеПоля(Блокировка, "LockMessage") <> Метка Тогда
		ВызватьИсключение "Оркестратор не подтвердил блокировку этой сборки на " + Приемник;
	КонецЕсли;
	Лог.Информация("Блокировка начала сеансов подтверждена");
КонецПроцедуры

ВыполнитьСкрипт();
