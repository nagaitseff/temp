// Разместить рядом со скриптами восстановления и запуска обработки.

Функция ПроверитьПриемник(Знач Адрес, Знач НуженПолныйАдрес = Истина) Экспорт
	Части = СтрРазделить(СокрЛП(Адрес), "|", Истина);
	Кластер = "";
	Если Части.Количество() = 2 Тогда
		Кластер = СокрЛП(Части[0]);
		ИмяБазы = СокрЛП(Части[1]);
	ИначеЕсли Части.Количество() = 1 Тогда
		ИмяБазы = СокрЛП(Части[0]);
	Иначе
		ВызватьИсключение "Укажите TARGET_INFOBASE в формате СЕРВЕР:ПОРТ|ИмяИБ";
	КонецЕсли;

	ЗащищенныеБазы = СтрРазделить("ERP_KGOK_DAILY,ERP_YU_DAILY,ERP_YKUZ_DAILY,ERP_YU,ERP_KGOK,ERP_YKUZ", ",");
	Если ЗащищенныеБазы.Найти(ВРег(ИмяБазы)) <> Неопределено Тогда
		ВызватьИсключение "База " + ВРег(ИмяБазы) + " защищена. Выберите другой TARGET_INFOBASE";
	КонецЕсли;
	Если НуженПолныйАдрес И Части.Количество() <> 2 Тогда
		ВызватьИсключение "Укажите TARGET_INFOBASE в формате СЕРВЕР:ПОРТ|ИмяИБ";
	КонецЕсли;

	ФорматИмени = Новый РегулярноеВыражение("\A[^\r\n\\""/]+\z");
	Если Не ФорматИмени.Совпадает(ИмяБазы) Тогда
		ВызватьИсключение "Укажите корректное имя базы в TARGET_INFOBASE";
	КонецЕсли;
	Если Части.Количество() = 2 Тогда
		ФорматКластера = Новый РегулярноеВыражение("\A[^\s\\""/;]+:[0-9]{1,5}\z");
		Если Не ФорматКластера.Совпадает(Кластер) Тогда
			ВызватьИсключение "Укажите TARGET_INFOBASE в формате СЕРВЕР:ПОРТ|ИмяИБ";
		КонецЕсли;
		ПозицияПорта = СтрНайти(Кластер, ":", НаправлениеПоиска.СКонца);
		Порт = Число(Сред(Кластер, ПозицияПорта + 1));
		Если Порт < 1 Или Порт > 65535 Тогда
			ВызватьИсключение "Порт в TARGET_INFOBASE должен быть в диапазоне 1–65535";
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("Кластер,Имя,Адрес", Кластер, ИмяБазы,
		?(Кластер = "", ИмяБазы, Кластер + "|" + ИмяБазы));
КонецФункции
