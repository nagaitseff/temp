&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Префикс = "ОтключитьЛогикуНачалаРаботыСистемы;MechelToolkitTask=";
	Если Лев(ПараметрЗапуска, СтрДлина(Префикс)) <> Префикс Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПутьРезультата = "";
	Код = "0";
	Сообщения = Новый Массив;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(Сред(ПараметрЗапуска, СтрДлина(Префикс) + 1));
		Задание = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
		ПутьРезультата = Задание.ПутьРезультата;
		Если Задание.Действие = "install-toolkit" Тогда
			Если ToolkitУстановленНаСервере() Тогда
				Сообщения.Добавить("InfostartToolkitCORP уже установлен. Используется текущая версия.");
			Иначе
				ФайлРасширения = Новый Файл(Задание.ФайлРасширения);
				Если Не ФайлРасширения.Существует() Тогда
					ВызватьИсключение "Не найден файл " + Задание.ФайлРасширения;
				КонецЕсли;
				Данные = Новый ДвоичныеДанные(ФайлРасширения.ПолноеИмя);
				Сообщения.Добавить(УстановитьToolkitНаСервере(Данные));
			КонецЕсли;
		ИначеЕсли Задание.Действие = "toolkit-roles" Тогда
			Сообщения = НазначитьРольНаСервере();
		Иначе
			ВызватьИсключение "Неизвестная операция настройки Infostart Toolkit";
		КонецЕсли;
	Исключение
		Код = "1";
		Диагностика = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщения.Добавить(Диагностика);
		Сообщить(Диагностика);
	КонецПопытки;

	Если Не ПустаяСтрока(ПутьРезультата) Тогда
		ТекстРезультата = Новый ТекстовыйДокумент;
		ТекстРезультата.УстановитьТекст(Код + Символы.ПС + СтрСоединить(Сообщения, Символы.ПС));
		ТекстРезультата.Записать(ПутьРезультата, КодировкаТекста.UTF8);
	КонецЕсли;
	ПрекратитьРаботуСистемы(Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ToolkitУстановленНаСервере()
	УстановитьПривилегированныйРежим(Истина);
	Отбор = Новый Структура("Имя", "InfostartToolkitCORP");
	Возврат РасширенияКонфигурации.Получить(Отбор, ИсточникРасширенийКонфигурации.БазаДанных).Количество() > 0;
КонецФункции

&НаСервереБезКонтекста
Функция УстановитьToolkitНаСервере(Данные)
	УстановитьПривилегированныйРежим(Истина);
	Если ToolkitУстановленНаСервере() Тогда
		Возврат "InfostartToolkitCORP уже установлен. Используется текущая версия.";
	КонецЕсли;

	ОписаниеРасширения = Новый ОписаниеКонфигурации(Данные);
	Если ОписаниеРасширения.Имя <> "InfostartToolkitCORP" Тогда
		ВызватьИсключение "В файле ожидалось расширение InfostartToolkitCORP, получено " + ОписаниеРасширения.Имя;
	КонецЕсли;
	Расширение = РасширенияКонфигурации.Создать();
	Расширение.БезопасныйРежим = Ложь;
	Расширение.Активно = Истина;
	Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
	Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
	Расширение.ЗащитаОтОпасныхДействий = Защита;
	Расширение.Записать(Данные);
	Возврат "Установлен InfostartToolkitCORP. Безопасный режим и предупреждение об опасных действиях выключены.";
КонецФункции

&НаСервереБезКонтекста
Функция НазначитьРольНаСервере()
	УстановитьПривилегированныйРежим(Истина);
	Роль = Метаданные.Роли.Найти("ИТК_ПолныйДоступ");
	Если Роль = Неопределено Тогда
		ВызватьИсключение "Роль ИТК_ПолныйДоступ недоступна. Проверьте, что InfostartToolkitCORP активен и применим.";
	КонецЕсли;
	Расширение = Роль.РасширениеКонфигурации();
	Если Расширение = Неопределено Или Расширение.Имя <> "InfostartToolkitCORP" Тогда
		ВызватьИсключение "Роль ИТК_ПолныйДоступ должна принадлежать расширению InfostartToolkitCORP";
	КонецЕсли;

	ПользователиИБ = Новый Массив;
	Для Каждого Имя Из СтрРазделить("DataExchange,Разработчик,Аналитик", ",") Цикл
		Пользователь = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
		Если Пользователь = Неопределено Тогда
			ВызватьИсключение "Не найден пользователь " + Имя + " для назначения роли Toolkit";
		КонецЕсли;
		ПользователиИБ.Добавить(Пользователь);
	КонецЦикла;

	Сообщения = Новый Массив;
	Для Каждого Пользователь Из ПользователиИБ Цикл
		Если Пользователь.Роли.Содержит(Роль) Тогда
			Сообщения.Добавить(Пользователь.Имя + " уже имеет роль Infostart Toolkit (Полные права).");
		Иначе
			Пользователь.Роли.Добавить(Роль);
			Пользователь.Записать();
			Сообщения.Добавить(Пользователь.Имя + " получил роль Infostart Toolkit (Полные права).");
		КонецЕсли;
	КонецЦикла;
	Возврат Сообщения;
КонецФункции
