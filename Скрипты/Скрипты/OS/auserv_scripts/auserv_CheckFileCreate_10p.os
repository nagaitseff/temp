#Использовать v8runner
#Использовать cmdline
#Использовать fs
#Использовать v8find

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьФайловуюБазуИПроверитьЗагрузку()
	
	ПереданныеПараметры = ПарсингПереданныхПараметров();
	РабочийКаталог = ПереданныеПараметры["РабочийКаталог"];
	ТипБазы = ПереданныеПараметры["ТипБазы"];
	ИмяВетки = ПереданныеПараметры["ИмяВетки"];

	Если ТипБазы <> "configuration" Тогда
		Возврат;
	КонецЕсли;

	СетевойКаталог = "//ukm-sapp108/artifacts/origin/";
	АвтономныйСервер = Платформа1С.ПутьКIBCMD("8.3");

	ОсновнойКаталогРепозитория = РабочийКаталог;

	РабочийКаталог = РабочийКаталог + "/build";
	Если НЕ ФС.Существует(РабочийКаталог) Тогда
		СоздатьКаталог(РабочийКаталог);
	КонецЕсли;

	РабочийКаталог = РабочийКаталог + "/" + ИмяВетки;
	Если НЕ ФС.Существует(РабочийКаталог) Тогда
		СоздатьКаталог(РабочийКаталог);
	КонецЕсли;

	УдалитьФайлы(РабочийКаталог);

	ДатаКаталог = РабочийКаталог + "/data";
	КаталогБД = РабочийКаталог + "/db_data";
	Если НЕ ФС.Существует(ДатаКаталог) Тогда
		СоздатьКаталог(ДатаКаталог);
		СоздатьКаталог(КаталогБД);
	КонецЕсли;

	СозданиеФайловойБазы(АвтономныйСервер, РабочийКаталог, ДатаКаталог, КаталогБД);

	ЗагрузкаФайловВБазу(АвтономныйСервер, ОсновнойКаталогРепозитория, РабочийКаталог, ДатаКаталог, КаталогБД);

	СохранитьАртефакт(АвтономныйСервер, РабочийКаталог, ДатаКаталог, КаталогБД, СетевойКаталог, ИмяВетки);
	
	УдалитьФайлы(РабочийКаталог);

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("РабочийКаталог");
	Парсер.ДобавитьПараметр("ТипБазы");
	Парсер.ДобавитьПараметр("ИмяВетки");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

Процедура СозданиеФайловойБазы(АвтономныйСервер, РабочийКаталог, ДатаКаталог, КаталогБД)
	
	Сообщить("Начало создания файловой базы: " + ТекущаяДата());

	Команда = Новый Команда;
	Команда.УстановитьКоманду(АвтономныйСервер);
	Команда.УстановитьРабочийКаталог(РабочийКаталог);
	Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);

	ДатаКаталог = ПреобразоватьПутьКWindows(ДатаКаталог);
	КаталогБД = ПреобразоватьПутьКWindows(КаталогБД);

	ПараметрыКоманды = Новый Массив;
	ПараметрыКоманды.Добавить("infobase");
	ПараметрыКоманды.Добавить("create");
	ПараметрыКоманды.Добавить("--data=" + ОбернутьВКавычки(ДатаКаталог));
	ПараметрыКоманды.Добавить("--db-path=" + ОбернутьВКавычки(КаталогБД));

	Команда.ДобавитьПараметры(ПараметрыКоманды);

	КодВозврата = Команда.Исполнить();
	ВыводКоманды = Команда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение ВыводКоманды;
	КонецЕсли;

	Сообщить("База успешно создана: " + ТекущаяДата());

КонецПроцедуры

Процедура ЗагрузкаФайловВБазу(АвтономныйСервер, ОсновнойКаталогРепозитория, РабочийКаталог, ДатаКаталог, КаталогБД)
	
	Сообщить("Начало загрузки из файлов: " + ТекущаяДата());

	Команда = Новый Команда;
	Команда.УстановитьКоманду(АвтономныйСервер);
	Команда.УстановитьРабочийКаталог(РабочийКаталог);
	Команда.УстановитьКодировкуВывода(КодировкаТекста.UTF8);

	ДатаКаталог = ПреобразоватьПутьКWindows(ДатаКаталог);
	КаталогБД = ПреобразоватьПутьКWindows(КаталогБД);

	ПараметрыКоманды = Новый Массив;
	ПараметрыКоманды.Добавить("infobase");
	ПараметрыКоманды.Добавить("config");
	ПараметрыКоманды.Добавить("import");
	ПараметрыКоманды.Добавить("--data=" + ОбернутьВКавычки(ДатаКаталог));
	ПараметрыКоманды.Добавить("--db-path=" + ОбернутьВКавычки(КаталогБД));
	ПараметрыКоманды.Добавить(ОсновнойКаталогРепозитория + "\src\cf");

	Команда.ДобавитьПараметры(ПараметрыКоманды);

	КодВозврата = Команда.Исполнить();
	ВыводКоманды = Команда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение ВыводКоманды;
	КонецЕсли;

	Сообщить("Данные успешно загружены: " + ТекущаяДата());

КонецПроцедуры

Процедура СохранитьАртефакт(АвтономныйСервер, РабочийКаталог, ДатаКаталог, КаталогБД, СетевойКаталог, ИмяВетки)
	
	Сообщить("Начало сохранения файла: " + ТекущаяДата());

	// Создание каталогов
	СетевойКаталог = СетевойКаталог + "/" + ИмяВетки;
	Если НЕ ФС.Существует(СетевойКаталог) Тогда
		СоздатьКаталог(СетевойКаталог);
	КонецЕсли;

	Команда = Новый Команда;
	Команда.УстановитьКоманду(АвтономныйСервер);
	Команда.УстановитьРабочийКаталог(РабочийКаталог);
	Команда.УстановитьКодировкуВывода(КодировкаТекста.OEM);

	ДатаКаталог = ПреобразоватьПутьКWindows(ДатаКаталог);
	КаталогБД = ПреобразоватьПутьКWindows(КаталогБД);
	СетевойКаталог = ПреобразоватьПутьКWindows(СетевойКаталог);

	ПараметрыКоманды = Новый Массив;
	ПараметрыКоманды.Добавить("infobase");
	ПараметрыКоманды.Добавить("config");
	ПараметрыКоманды.Добавить("save");
	ПараметрыКоманды.Добавить("--data=" + ОбернутьВКавычки(ДатаКаталог));
	ПараметрыКоманды.Добавить("--db-path=" + ОбернутьВКавычки(КаталогБД));
	ПараметрыКоманды.Добавить(ОбернутьВКавычки(СетевойКаталог) + "\1Cv8.cf");

	Команда.ДобавитьПараметры(ПараметрыКоманды);

	КодВозврата = Команда.Исполнить();
	ВыводКоманды = Команда.ПолучитьВывод();

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение ВыводКоманды;
	КонецЕсли;

	Сообщить("Файл успешно сохранен: " + ТекущаяДата());
	Сообщить("Путь к файлу: " + СетевойКаталог);

КонецПроцедуры

Функция ОбернутьВКавычки(Знач Строка)
	Если Лев(Строка, 1) = """" И Прав(Строка, 1) = """" Тогда
		Возврат Строка;
	Иначе
		Возврат """" + Строка + """";
	КонецЕсли;
КонецФункции

Функция ПреобразоватьПутьКWindows(Путь)

	Возврат СтрЗаменить(Путь, "/", "\");
	
КонецФункции

#КонецОбласти

#Область Инициализация

СоздатьФайловуюБазуИПроверитьЗагрузку();

#КонецОбласти