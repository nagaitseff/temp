#Использовать json
#Использовать cmdline
#Использовать mechel

#Область Переменные

Перем КонстантыРабот;
Перем КодВозврата;

#КонецОбласти

#Область ИнициализацияИИсполнение

Процедура Инициализация()
	
	ПарсингПереданныхПараметров = ПарсингПереданныхПараметров();
	Сервер = ПарсингПереданныхПараметров["Сервер"];
	ПортБазы = ПарсингПереданныхПараметров["ПортБазы"];
	ИмяБазы = ПарсингПереданныхПараметров["ИмяБазы"];
	ИмяОбработки = ПарсингПереданныхПараметров["ИмяОбработки"];
	ВключитьОтладку = ПарсингПереданныхПараметров["ВключитьОтладку"];
	
	Если ВРег(ВключитьОтладку) = "TRUE" Тогда
		ВключитьОтладкуБулево = Истина;
	Иначе
		ВключитьОтладкуБулево = Ложь;
	КонецЕсли;
	ОбщийМодуль.ИспользоватьВыводОтладки(ВключитьОтладкуБулево);

	Если НЕ ЗначениеЗаполнено(Сервер) Тогда
		ВызватьИсключение "Не указан сервер базы!";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПортБазы) Тогда
		ВызватьИсключение "Не указан порт базы или задан не верно!";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
		ВызватьИсключение "Не указано имя базы или задано не верно!";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяОбработки) Тогда
		ВызватьИсключение "Не указано имя обработки!";
	КонецЕсли;
	
	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");
	СтрокаЗапуска = Символ(34) + КонстантыРабот.platform.X64 + Символ(34) 
	+ " ENTERPRISE /S " + Символ(34) + Сервер + ":" + ПортБазы 
	+ "\" + ИмяБазы + Символ(34)
	+ " /N " + Символ(34) + КонстантыРабот.logpassERP.login + Символ(34) 
	+ " /P " + Символ(34) + КонстантыРабот.logpassERP.password + Символ(34)
	+ " /UC " + КонстантыРабот.UC 
	+ " /Execute "".\tools\OS\" + ИмяОбработки + ".epf""" 
	+ " /DisableStartupMessages /DisableStartupDialogs /DisableSplash " 
	+ "/DisableUnrecoverableErrorMessage /DisableHomePageForms";

	Сообщить("Начало обновления: " + ТекущаяДата());
	КодВозврата = 0;
	ЗапуститьПриложение(СтрокаЗапуска, , Истина, КодВозврата);
	Сообщить("Окончание обновления: " + ТекущаяДата());
	Сообщить(КодВозврата);

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Обновление базы в режиме 1С:Предприятие завершилось с ошибкой!";
	КонецЕсли;
	
	Если ФС.Существует(КонстантыРабот.temp.temp_files) Тогда
		УдалитьФайлы(КонстантыРабот.temp.temp_files, "*.txt");
	КонецЕсли;

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("Сервер");
	Парсер.ДобавитьПараметр("ПортБазы");
	Парсер.ДобавитьПараметр("ИмяБазы");
	Парсер.ДобавитьПараметр("ИмяОбработки");
	Парсер.ДобавитьПараметр("ВключитьОтладку");
	
	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти