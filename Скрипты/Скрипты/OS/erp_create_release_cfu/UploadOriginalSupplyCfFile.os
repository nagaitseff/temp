#Использовать json
#Использовать v8runner
#Использовать asserts
#Использовать fs
#Использовать mechel
#Использовать cmdline

#Область ОписаниеПеременных

Перем КонстантыРабот; // константы значений переданные из файла JSON

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()

	ПереданныеПараметры = ПарсингПереданныхПараметров();
	Сервер = ПереданныеПараметры["Сервер"];
	ИмяБазы = ПереданныеПараметры["ИмяБазы"];
	Порт = ПереданныеПараметры["Порт"];
	ВключитьОтладку = ПереданныеПараметры["ВключитьОтладку"];

	Если ВРег(ВключитьОтладку) = "TRUE" Тогда
		ВключитьОтладкуБулево = Истина;
	Иначе
		ВключитьОтладкуБулево = Ложь;
	КонецЕсли;

	ОбщийМодуль.ИспользоватьВыводОтладки(ВключитьОтладкуБулево);

	Если НЕ ЗначениеЗаполнено(Сервер) Тогда
		ВызватьИсключение "Не заполнен сервер базы данных";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
		ВызватьИсключение "Не заполнено имя базы данных";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Порт) Тогда
		ВызватьИсключение "Не заполнен порт базы данных";
	КонецЕсли;

	ВременныйКаталогСФайломПоддержки = "C:\ERP_Project\CF_Supply\";
	СоздатьНужныйКаталог(ВременныйКаталогСФайломПоддержки);
	КопироватьФайл(".\tools\OS\erp_create_release_cfu\list.xml", ВременныйКаталогСФайломПоддержки + "\list.txt");
	
	ТриМинуты = 1800;
	Приостановить(ТриМинуты);

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");	
	СтрокаЗапуска = Символ(34) + КонстантыРабот.platform.X64 + Символ(34) 
		+ " DESIGNER /S " + Символ(34) + Сервер + ":" + Порт + "\" + ИмяБазы + Символ(34)
		+ " /N" + Символ(34) + КонстантыРабот.logpassERP.login + Символ(34) 
		+ " /P" + Символ(34) + КонстантыРабот.logpassERP.password + Символ(34)
		+ " /UC " + КонстантыРабот.UC + " /DumpConfigToFiles " + Символ(34) + ВременныйКаталогСФайломПоддержки + Символ(34) 
		+ " -listFile " + Символ(34) + ВременныйКаталогСФайломПоддержки + "list.txt " + Символ(34) + " /DisableStartupMessages /DisableStartupDialogs /DisableSplash " 
		+ "/DisableUnrecoverableErrorMessage";

	КодВозврата = 0;
	ЗапуститьПриложение(СтрокаЗапуска, , Истина, КодВозврата);

	Если КодВозврата <> 0 Тогда
		ВызватьИсключение "Файл не выгружен, код возврата: " + КодВозврата;
	КонецЕсли;

	КаталогСФайламиПоставкиКонфигурации = КонстантыРабот.artifacts.net_common + "release\";

	КопироватьФайл(
		ВременныйКаталогСФайломПоддержки + "\Ext\ParentConfigurations\УправлениеПредприятием.cf", 
		КаталогСФайламиПоставкиКонфигурации + "УправлениеПредприятием.cf");

	УдалитьФайлы(ВременныйКаталогСФайломПоддержки);

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("Сервер");
	Парсер.ДобавитьПараметр("ИмяБазы");
	Парсер.ДобавитьПараметр("Порт");
	Парсер.ДобавитьПараметр("ВключитьОтладку");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

Процедура СоздатьНужныйКаталог(ИмяКаталога)

	КаталогСуществует = ФС.КаталогСуществует(ИмяКаталога);

	Если Не КаталогСуществует Тогда
		СоздатьКаталог(ИмяКаталога);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти