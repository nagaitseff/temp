#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()

	ПереданныеПараметры = ПарсингПереданныхПараметров();
	Сообщение = ПереданныеПараметры["Сообщение"];
	IDГруппы = ПереданныеПараметры["ИдентификаторГруппы"];
	IDТемы = ПереданныеПараметры["ИдентификаторТемы"];
	ТипСообщения = ПереданныеПараметры["ТипСообщения"];
	
	Если Не ЗначениеЗаполнено(Сообщение) Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(IDГруппы) Тогда
		IDГруппы = "-1002228562819";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ТипСообщения) Тогда
		ТипСообщения = "md";
	КонецЕсли;

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");
	ТокенТелеграм = КонстантыРабот.telegram.token;

	КопироватьФайл("\\ukm-sapp108\\ERP_Project\\organizationProxy.json", ".\\organizationProxy.json");

	Мессенджер = Новый Мессенджер();
	Мессенджер.ИнициализироватьТранспорт("telegram", Новый Структура("Логин", ТокенТелеграм));
	Мессенджер.УстановитьПутьКПараметрамПроксиОрганизации("telegram", ".\\organizationProxy.json");
	Мессенджер.ОтправитьСообщение("telegram", IDГруппы, Сообщение, , ТипСообщения, IDТемы);

КонецПроцедуры


Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("Сообщение");
	Парсер.ДобавитьПараметр("ИдентификаторГруппы");
	Парсер.ДобавитьПараметр("ИдентификаторТемы");
	Парсер.ДобавитьПараметр("ТипСообщения");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти