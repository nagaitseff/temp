#Использовать json
#Использовать fs
#Использовать messenger
#Использовать cmdline

#Область ОписаниеПеременных

Перем КонстантыРабот; // константы значений переданные из файла JSON

#КонецОбласти

#Область СтандартныеПроцедурыИФункции

Процедура Инициализация()

	ПараметрыКоманднойСтроки = ПарсингПереданныхПараметров();
	ИмяБазы = ПараметрыКоманднойСтроки["ИмяБазы"];

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");
	Токен = КонстантыРабот.telegram.token;
	IDChat = КонстантыРабот.telegram.IDChat;
	IDChatYKUZ = КонстантыРабот.telegram.IDChatYKUZ;

	ПутьККоммитам = ".\\commits.json";
	Если Не ФС.Существует(ПутьККоммитам) Тогда
		ВызватьИсключение "Нет файла сообщений";
	КонецЕсли;

	Если Не ФС.Существует(".\\organizationProxy.json") Тогда
		КопироватьФайл("\\ukm-sapp108\\ERP_Project\\organizationProxy.json", ".\\organizationProxy.json");
	КонецЕсли;
	
	СообщениеДляБота =	"*База " + ИмяБазы + ", собрана, вошли следующие работы:*";
	СообщениеПоРаботам = СообщениеКоммитов(ПутьККоммитам);
	Если СообщениеПоРаботам <> "" Тогда
		СообщениеТелеграм = СообщениеДляБота + Символы.ПС + СообщениеПоРаботам;
		Мессенджер = Новый Мессенджер();
		Мессенджер.ИнициализироватьТранспорт("telegram", Новый Структура("Логин", Токен));
		Мессенджер.УстановитьПутьКПараметрамПроксиОрганизации("telegram", ".\\organizationProxy.json");
		Мессенджер.ОтправитьСообщение("telegram", IDChat, СообщениеТелеграм, , "md");
		Мессенджер.ОтправитьСообщение("telegram", IDChatYKUZ, СообщениеТелеграм, , "md");
	КонецЕсли;

КонецПроцедуры

Функция СообщениеКоммитов(Знач ПутьККоммитам) 

	СообщениеДляОтправки = "";

	ПреобразовательJSON = Новый ПарсерJSON();
	ЧитатьJSON = Новый ЧтениеТекста();
	
	ЧитатьJSON.Открыть(ПутьККоммитам, КодировкаТекста.UTF8);
	СтрокаJSON = ЧитатьJSON.Прочитать();
	ЧитатьJSON.Закрыть();
	
	ПрочитаннаяСтрока = ПреобразовательJSON.ПрочитатьJSON(СтрокаJSON, , , Истина);
	Разделитель = "==========================================";
	Для Каждого СтрокаСообщения Из ПрочитаннаяСтрока Цикл
		Заголовок = "*" + СтрокаСообщения.title + "*";
		СППР = СтрокаСообщения.sppr;
		Автор = СтрокаСообщения.author;
		Гитлаб = СтрокаСообщения.gitlab;
		Если ЗначениеЗаполнено(Гитлаб) Тогда
			СообщениеДляОтправки = 
				СообщениеДляОтправки + Символы.ПС 
				+ Заголовок + Символы.ПС
				+ СППР + Символы.ПС
				+ Автор + Символы.ПС
				+ Гитлаб + Символы.ПС
				+ Разделитель;
		Иначе
			СообщениеДляОтправки = 
				СообщениеДляОтправки + Символы.ПС 
				+ Заголовок + Символы.ПС
				+ Автор + Символы.ПС
				+ Разделитель;
		КонецЕсли;
	КонецЦикла;

	Возврат СообщениеДляОтправки;
	
КонецФункции

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("ИмяБазы");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти