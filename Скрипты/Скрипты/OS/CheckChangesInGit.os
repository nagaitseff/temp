#Использовать json
#Использовать gitrunner
#Использовать cmdline
#Использовать mechel

#Область ОписаниеПеременных

Перем КонстантыРабот;

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОбновлениеРаботВГит()

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант("./ConstantsForJobs.json");

	ПереданныеПараметры = ПарсингПереданныхПараметров();
	ВремяПроверки = ПереданныеПараметры["ВремяПроверки"];
	НужноПроверить = ПереданныеПараметры["ЭтоРасширение"];
	ЗаписатьРезультат = ПереданныеПараметры["ЗаписатьРезультат"];

	Если ВремяПроверки = "" Тогда
		Если КонстантыРабот.git_time  = "" Тогда
			ВызватьИсключение "Не заполнено время проверки данных в ГИТ";
		КонецЕсли;
		ВремяПроверки = КонстантыРабот.git_time;
	Иначе
		ВремяПроверки = "--since='" + ВремяПроверки + "'";
	КонецЕсли;

	ЭтоРасширение = Ложь;
	Если ВРег(НужноПроверить) = "РАСШИРЕНИЕ" Тогда
		НужноПроверить = "src/cfe/Mechel";
		ЭтоРасширение = Истина;
	Иначе
		НужноПроверить = "src/cf/";
	КонецЕсли;

	ЕстьОбновленияРасширения = ПроверитьИзмененияВРасширении(ВремяПроверки, НужноПроверить);
	
	Если ВРег(ЗаписатьРезультат) = "ИСТИНА" Тогда
		ЗаписатьРезультатПроверки(ЕстьОбновленияРасширения, ЭтоРасширение);
	КонецЕсли;

	Сообщить(ЕстьОбновленияРасширения);
	
КонецПроцедуры

Функция ПроверитьИзмененияВРасширении(Знач ВремяПроверки, Знач НужноПроверить)

	ЕстьОбновленияРасширения = 
		ОбщийМодуль.ЕстьОбновленияВРепозитории(ВремяПроверки, НужноПроверить);
	
	Если ВРег(ЕстьОбновленияРасширения) = "ИСТИНА" 
		ИЛИ ВРег(ЕстьОбновленияРасширения) = "ДА" 
		ИЛИ ЕстьОбновленияРасширения = Истина Тогда
		Возврат 1;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("ВремяПроверки");
	Парсер.ДобавитьПараметр("ЭтоРасширение");
	Парсер.ДобавитьПараметр("ЗаписатьРезультат");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

Процедура ЗаписатьРезультатПроверки(ЕстьОбновленияРасширения, ЭтоРасширение)
	
	Если ЭтоРасширение Тогда
		ЗаписьТекста = Новый ЗаписьТекста(".\create_ext.txt");
	Иначе
		ЗаписьТекста = Новый ЗаписьТекста(".\create_cf.txt");
	КонецЕсли;
	
	ЗаписьТекста.ЗаписатьСтроку(ЕстьОбновленияРасширения);

	ЗаписьТекста.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область Инициализация

ПроверитьОбновлениеРаботВГит();

#КонецОбласти