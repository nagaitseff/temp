#Использовать json
#Использовать gitrunner
#Использовать v8runner
#Использовать asserts
#Использовать fs
#Использовать mechel
#Использовать cmdline

#Область ОписаниеПеременных

Перем КонстантыРабот;
Перем УправлениеКонфигуратором;
Перем НомерРелиза;

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");

	ПереданныеПараметры = ПарсингПереданныхПараметров();
	НомерРелиза = ПереданныеПараметры["НомерРелиза"];
	ИмяКаталогаСФайлом = ПереданныеПараметры["ИмяКаталогаСФайлом"];
	ИмяРасширения = ПереданныеПараметры["ИмяРасширения"];
	ВключитьОтладку = ПереданныеПараметры["ВключитьОтладку"];

	Если ВРег(ВключитьОтладку) = "TRUE" Тогда
		ВключитьОтладкуБулево = Истина;
	Иначе
		ВключитьОтладкуБулево = Ложь;
	КонецЕсли;
	
	ОбщийМодуль.ИспользоватьВыводОтладки(ВключитьОтладкуБулево);

	Если НЕ ЗначениеЗаполнено(НомерРелиза) Тогда
		ВызватьИсключение "Не заполнен номер релиза";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяКаталогаСФайлом) Тогда
		ВызватьИсключение "Не указано имя каталога выгрузки данных. 
			|(evelop или release)";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяРасширения) Тогда
		ВызватьИсключение "Не указано имя расширения";
	КонецЕсли;

	ЭтоРелиз = Ложь;
	КаталогСФайломПоставкиДляАдминов = "";
	Если ИмяКаталогаСФайлом = "develop_5405" 
		ИЛИ ИмяКаталогаСФайлом = "develop" Тогда
		КаталогСФайлом = КонстантыРабот.artifacts.net_common + ИмяКаталогаСФайлом + "\";
	Иначе
		ЭтоРелиз = Истина;
		КаталогСФайлом = КонстантыРабот.artifacts.net_common + ИмяКаталогаСФайлом + "\" + НомерРелиза;
		СоздатьНужныйКаталог(КаталогСФайлом);
		КаталогСФайлом = КаталогСФайлом + "\";

		КаталогСФайломПоставкиДляАдминов = КонстантыРабот.artifacts.release_adminDirCopy + ИмяКаталогаСФайлом + "\" + НомерРелиза;
		СоздатьНужныйКаталог(КаталогСФайломПоставкиДляАдминов);
		КаталогСФайломПоставкиДляАдминов = КаталогСФайломПоставкиДляАдминов + "\";
	КонецЕсли;

	УправлениеКонфигуратором = Новый УправлениеКонфигуратором();
	СобратьИСохранитьРасширение(ИмяРасширения, КаталогСФайлом, ИмяКаталогаСФайлом, КаталогСФайломПоставкиДляАдминов, ЭтоРелиз);

КонецПроцедуры

Процедура СобратьИСохранитьРасширение(
	Знач ИмяРасширения, 
	Знач КаталогСФайлом, 
	Знач ИмяКаталогаСФайлом, 
	Знач КаталогСФайломПоставкиДляАдминов,
	Знач ЭтоРелиз)

	ВременныйКаталог = КонстантыРабот.temp.temp_files + ИмяКаталогаСФайлом + "\";
	СоздатьНужныйКаталог(ВременныйКаталог);

	Если ФС.Существует(ВременныйКаталог) Тогда
		ВременныйПутьКФайлу = ВременныйКаталог + ИмяРасширения + ".cfe";
	Иначе
		ВызватьИсключение "Нет каталога " + ВременныйКаталог;
	КонецЕсли;

	УправлениеКонфигуратором.КаталогСборки(ВременныйКаталог);

	Если ФС.КаталогСуществует(ВременныйКаталог + "v8r_TempDB") Тогда
		УдалитьФайлы(УправлениеКонфигуратором.ПутьКВременнойБазе());
	КонецЕсли;

	УправлениеКонфигуратором.ИспользоватьВерсиюПлатформы(
		КонстантыРабот.platform.version, 
		РазрядностьПлатформы.x64x86);

	УправлениеКонфигуратором.ЗагрузитьРасширениеИзФайлов(".\src\cfe\" + ИмяРасширения, ИмяРасширения);

	УправлениеКонфигуратором.ВыгрузитьРасширениеВФайл(ВременныйПутьКФайлу, ИмяРасширения);

	Приостановить(10000);

	ФайлКонфигурации = Новый Файл(ВременныйПутьКФайлу);
	Ожидаем.Что(
		ФайлКонфигурации.Существует(), 
		"Файл конфигурации <" + ВременныйПутьКФайлу + "> существует, а это не так").ЭтоИстина();
	
	КопироватьФайл(ВременныйПутьКФайлу, КаталогСФайлом + ИмяРасширения + ".cfe");
	
	Если ЭтоРелиз Тогда
		КопироватьФайл(ВременныйПутьКФайлу, КаталогСФайломПоставкиДляАдминов + ИмяРасширения + ".cfe");
	КонецЕсли;

	Если ФС.Существует(ВременныйКаталог) Тогда
		УдалитьФайлы(ВременныйКаталог, "*.txt");
	КонецЕсли;

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("НомерРелиза");
	Парсер.ДобавитьПараметр("ИмяКаталогаСФайлом");
	Парсер.ДобавитьПараметр("ИмяРасширения");
	Парсер.ДобавитьПараметр("ВключитьОтладку");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

Процедура СоздатьНужныйКаталог(ИмяКаталога)

	КаталогСуществует = ФС.КаталогСуществует(ИмяКаталога);

	Если Не КаталогСуществует Тогда
		СоздатьКаталог(ИмяКаталога);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти