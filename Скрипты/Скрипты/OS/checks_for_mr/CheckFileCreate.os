#Использовать v8runner
#Использовать cmdline
#Использовать fs

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьФайловуюБазуИПроверитьЗагрузку()
	
	ПереданныеПараметры = ПарсингПереданныхПараметров();
	ТипБазы = ПереданныеПараметры["ТипБазы"];

	ПутьКБазе = "./build/";
	Если НЕ ФС.Существует(ПутьКБазе) Тогда
		СоздатьКаталог(ПутьКБазе);
	КонецЕсли;

	Если ТипБазы = "extension" Тогда
		ПутьКБазе = "./build/ib_extension";
	ИначеЕсли ТипБазы = "configuration" Тогда
		ПутьКБазе = "./build/ib_configuration";
	Иначе
		ВызватьИсключение "Не определен тип собираемого файла!"
	КонецЕсли;
	
	Если НЕ ФС.Существует(ПутьКБазе) Тогда
		СоздатьКаталог(ПутьКБазе);
	КонецЕсли;

	УправлениеКонфигуратором = Новый УправлениеКонфигуратором();
	УправлениеКонфигуратором.ИспользоватьВерсиюПлатформы(
		"8.3.27", 
		РазрядностьПлатформы.x64x86);

	ПутьКФайлу = ПутьКБазе + "\";
	УправлениеКонфигуратором.СоздатьФайловуюБазу(ПутьКБазе);
	УправлениеКонфигуратором.КаталогСборки(ПутьКБазе);
	УправлениеКонфигуратором.УстановитьКонтекст("/F" + ПутьКБазе, "", "");
	Если ТипБазы = "extension" Тогда
		ИмяРасширения = "Mechel";
		УправлениеКонфигуратором.ЗагрузитьРасширениеИзФайлов("./src/cfe/" + ИмяРасширения, ИмяРасширения);
		ПутьКФайлу = ПутьКФайлу + ИмяРасширения + ".cfe";
		УправлениеКонфигуратором.ВыгрузитьРасширениеВФайл(ПутьКФайлу, ИмяРасширения);
		Приостановить(10000);
		ФайлРасширения = Новый Файл(ПутьКФайлу);
		Ожидаем.Что(
			ФайлРасширения.Существует(), 
			"Файл расширения <" + ПутьКФайлу + "> существует, а это не так").ЭтоИстина();
		КопироватьФайл(ПутьКФайлу, "./build/" + ИмяРасширения + ".cfe");
	Иначе
		УправлениеКонфигуратором.ЗагрузитьКонфигурациюИзФайлов("./src/cf");
		ПутьКФайлу = ПутьКФайлу + "1Cv8.cf";
		УправлениеКонфигуратором.ВыгрузитьКонфигурациюВФайл(ПутьКФайлу);
		Приостановить(10000);
		ФайлКонфигурации = Новый Файл(ПутьКФайлу);
		Ожидаем.Что(
			ФайлКонфигурации.Существует(), 
			"Файл конфигурации <" + ПутьКФайлу + "> существует, а это не так").ЭтоИстина();
		КопироватьФайл(ПутьКФайлу, "./build/1Cv8.cf");
	КонецЕсли;

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("ТипБазы");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

СоздатьФайловуюБазуИПроверитьЗагрузку();

#КонецОбласти