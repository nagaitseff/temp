#Использовать v8rac
#Использовать cmdline
#Использовать mechel

#Область ОписаниеПеременных

Перем КонстантыРабот; // константы значений переданные из файла JSON

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()

	Приостановить(60000);

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");

	ОбщийМодуль.ИспользоватьВыводОтладки(Ложь);

	ПереданныеПараметры = ПарсингПереданныхПараметров();

	ИмяБазы = ПереданныеПараметры["ИмяБазы"];
	АдресСервера = ПереданныеПараметры["АдресСервера"];
	КомандаПеререгистрацииБазы = ПереданныеПараметры["КомандаПеререгистрацииБазы"];
	ЛогинКластера = ПереданныеПараметры["ЛогинКластера"];
	ГУИДКластера = ПереданныеПараметры["ГУИДКластера"];

	ПеререгистрацияБазы(ИмяБазы, АдресСервера, КомандаПеререгистрацииБазы, ЛогинКластера, ГУИДКластера);

КонецПроцедуры

Процедура ПеререгистрацияБазы(
	Знач ИмяБазы, 
	Знач АдресСервера, 
	КомандаПеререгистрацииБазы = "", 
	ЛогинКластера = Неопределено,
	ГУИДКластера = Неопределено)
	
	ВерсияПлатформы = "8.3";

	УправлениеКластером = Новый УправлениеКластером;
	УправлениеКластером.УстановитьКластер(АдресСервера);
	УправлениеКластером.ИспользоватьВерсию(ВерсияПлатформы);

	УправлениеКластером.УстановитьАвторизациюКластера(ЛогинКластера, КонстантыРабот.racAdmin.pwd);

	УправлениеКластером.Подключить();

	Приостановить(10000);
	
	ИдентификаторИнформационнойБазы = УправлениеКластером.НайтиИнформационнуюБазу(ИмяБазы);

	Если (ИдентификаторИнформационнойБазы = "" 
		И КомандаПеререгистрацииБазы <> "delete") 
		ИЛИ (ИдентификаторИнформационнойБазы = "" 
		И КомандаПеререгистрацииБазы = "delete") Тогда
		ВыводРезультата = УправлениеКластером.СоздатьИнформационнуюБазу(
			ГУИДКластера, 
			ИмяБазы, 
			"MSSQLServer", 
			КонстантыРабот.sqlserver.S132, 
			ИмяБазы, 
			КонстантыРабот.sql.login, 
			КонстантыРабот.sql.password, , 
			2000, , 
			Истина, 
			Ложь);
		Сообщить(ВыводРезультата);
	Иначе
		УправлениеКластером.УстановитьАвторизациюИнформационнойБазы(
			ИдентификаторИнформационнойБазы, 
			КонстантыРабот.logpassERP.login, 
			КонстантыРабот.logpassERP.password);
		
		УправлениеКластером.УдалитьИнформационнуюБазу(ИдентификаторИнформационнойБазы, Ложь, Ложь);
	КонецЕсли;

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("ИмяБазы");
	Парсер.ДобавитьПараметр("АдресСервера");
	Парсер.ДобавитьПараметр("КомандаПеререгистрацииБазы");
	Парсер.ДобавитьПараметр("ЛогинКластера");
	Парсер.ДобавитьПараметр("ГУИДКластера");
	
	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти