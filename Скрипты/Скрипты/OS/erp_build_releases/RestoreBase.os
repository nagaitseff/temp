#Использовать mechel
#Использовать fs
#Использовать cmdline
#Использовать sql
#Использовать TMSSQL

#Область ОписаниеПеременных

Перем Соединение; // соединение с сервером SQL
Перем УправлениеMSSQL; // компонента управления
Перем ТекстОшибки; // текст сформированной ошибки
Перем КонстантыРабот; // предустановленные значения констант
Перем ПараметрыКоманднойСтроки; // переданные параметры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");
	ПараметрыКоманднойСтроки = ПарсингПереданныхПараметров();

	ИмяБазы     = ПараметрыКоманднойСтроки["ИмяБазы"];
	ПутьКАрхиву = ПараметрыКоманднойСтроки["ПутьКАрхиву"];

	Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
		ВызватьИсключение "Не указано имя базы!"
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПутьКАрхиву) Тогда
		ВызватьИсключение "Не указан путь к файлу архива!"
	КонецЕсли;

	ИмяАрхива   = ИмяБазыАрхиваИзПути(ПутьКАрхиву);

	Соединение      = Новый Соединение();
	УправлениеMSSQL = Новый УправлениеMSSQL;
	
	УправлениеMSSQL.РежимОтладки = Истина;

	ОтключениеНовыхПодключенийКСерверу(ИмяБазы);

	ВосстановитьБазуИзАрхива(ИмяБазы, ПутьКАрхиву, ИмяАрхива);

	ВосстановлениеПодключениеКБазе(ИмяБазы);

КонецПроцедуры

Процедура ОтключениеНовыхПодключенийКСерверу(ИмяБазы);
	
	Соединение.ТипСУБД = Соединение.ТипыСУБД.MSSQLServer;
	Соединение.Сервер = КонстантыРабот.sqlserver.S132;
	Соединение.ИмяПользователя = КонстантыРабот.sql.login;
	Соединение.Пароль = КонстантыРабот.sql.password;
	Соединение.ИмяБазы = ИмяБазы;
	Соединение.Открыть();

	Если Соединение.Открыто Тогда
		Запрос = Новый Запрос();
		Запрос.УстановитьСоединение(Соединение);
		Запрос.Текст = "
			|USE [master];
			|ALTER DATABASE [" + ИмяБазы + "] SET OFFLINE WITH ROLLBACK IMMEDIATE;";
		Попытка
			Запрос.ВыполнитьКоманду();
		Исключение
			ВызватьИсключение "Не удалось перевести базу данных в режим OFFLINE.";
		КонецПопытки;
		Соединение.Закрыть();
	Иначе
		ВызватьИсключение "Состояние: " + Соединение.Состояние + ", Последнее сообщение об ошибке " 
			+ Соединение.ПоследнееСообщениеОбОшибке;	
	КонецЕсли;

	Приостановить(10000);

КонецПроцедуры

Процедура ВосстановитьБазуИзАрхива(ИмяБазы, ПутьКАрхиву, ИмяАрхива)
	
	ПараметрыПодключения = УправлениеMSSQL.ПараметрыПодключения;
	ПараметрыПодключения.Вставить("АдресСервераSQL", КонстантыРабот.sqlserver.S132);
	ПараметрыПодключения.Вставить("ИмяПользователяSQL", КонстантыРабот.sql.login);
	ПараметрыПодключения.Вставить("ПарольПользователяSQL", КонстантыРабот.sql.password);
	ПараметрыПодключения.Вставить("ИмяБазыДанныхSQL", ИмяБазы);

	ТаблицаФайловБДИсточника = Новый ТаблицаЗначений;
	ТаблицаФайловБДИсточника.Колонки.Добавить("ЛогическоеИмя");
	ТаблицаФайловБДИсточника.Колонки.Добавить("ФизическоеИмя");

	НовСтрока = ТаблицаФайловБДИсточника.Добавить();
	НовСтрока.ЛогическоеИмя = ИмяАрхива;
	НовСтрока.ФизическоеИмя = ИмяБазы;
	НовСтрока = ТаблицаФайловБДИсточника.Добавить();
	НовСтрока.ЛогическоеИмя = ИмяАрхива + "_log";
	НовСтрока.ФизическоеИмя = ИмяБазы + "_log";

	Если УправлениеMSSQL.ВосстановитьИзРезервнойКопииБД(ПутьКАрхиву, ТаблицаФайловБДИсточника) Тогда
		Сообщить("ВосстановитьИзРезервнойКопииБД: УСПЕШНО");
	Иначе
		ТекстОшибки = УправлениеMSSQL.ТекстОшибки;
		Сообщить("ВосстановитьИзРезервнойКопииБД: " + ТекстОшибки);
	КонецЕсли;

	Приостановить(10000);

КонецПроцедуры

Процедура ВосстановлениеПодключениеКБазе(ИмяБазы)
	
	Соединение.ТипСУБД = Соединение.ТипыСУБД.MSSQLServer;
	Соединение.Сервер = КонстантыРабот.sqlserver.S132;
	Соединение.ИмяПользователя = КонстантыРабот.sql.login;
	Соединение.Пароль = КонстантыРабот.sql.password;
	Соединение.ИмяБазы = ИмяБазы;
	Соединение.Открыть();

	Если Соединение.Открыто Тогда
		Запрос = Новый Запрос();
		Запрос.УстановитьСоединение(Соединение);
		Запрос.Текст = "
			|ALTER DATABASE [" + ИмяБазы + "] SET ONLINE;";
		Попытка
			Запрос.ВыполнитьКоманду();
		Исключение
			ВызватьИсключение "Не удалось перевести базу данных в режим ONLINE.";
		КонецПопытки;
		Соединение.Закрыть();
	Иначе
		ВызватьИсключение "Состояние: " + Соединение.Состояние + ", Последнее сообщение об ошибке " 
			+ Соединение.ПоследнееСообщениеОбОшибке;	
	КонецЕсли;

	Приостановить(10000);

КонецПроцедуры

Функция ИмяБазыАрхиваИзПути(Знач ПутьКАрхиву)

	РазделениеПутиАрхива = СтрРазделить(ПутьКАрхиву, "\");
	ПоследнееЗначениеМассива = РазделениеПутиАрхива[РазделениеПутиАрхива.ВГраница()];
	ИмяБазыАрхива = Лев(ПоследнееЗначениеМассива, (СтрНайти(ПоследнееЗначениеМассива, ".")) - 1);

	Возврат ИмяБазыАрхива;

КонецФункции

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("ИмяБазы");
	Парсер.ДобавитьПараметр("ПутьКАрхиву");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти