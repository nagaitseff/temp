#Использовать oint
#Использовать mechel
#Использовать json
#Использовать cmdline

#Область ОписаниеПеременных

Перем КонстантыРабот; // константы значений переданные из файла JSON
Перем УправлениеКонфигуратором; // общая переменная для управления конфигуратором
Перем КаталогФайловУстановки; // каталог для хранения установочных файлов

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()
	
	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");
	ПараметрыКоманднойСтроки = ПарсингПереданныхПараметров();

	Токен = КонстантыРабот.telegram.token;
	IDChat = КонстантыРабот.telegram.IDChatRelease;
	IDChatUK = КонстантыРабот.telegram.IDChatYKUZ;
	
	СообщениеДляБота = ПараметрыКоманднойСтроки["СообщениеДляБота"];
	
	Если НЕ ЗначениеЗаполнено(СообщениеДляБота) Тогда

		НомерРелиза = ПараметрыКоманднойСтроки["НомерРелиза"];
		ИмяБазы = ПараметрыКоманднойСтроки["ИмяБазы"];

		СписокКоммитов = ОбщийМодуль.ПеречислениеКоммитовСообщениемЗаПоследниеСутки();

		Приостановить(5000);

		СообщениеДляБота = 
			"Предрелизная база " + ИмяБазы + " успешно собрана и обновлена, вошли следующие работы: " + Символы.ПС;
		
		Если ЗначениеЗаполнено(НомерРелиза) Тогда
			СообщениеДляБота = СообщениеДляБота + "Релиз: " + НомерРелиза + Символы.ПС;
		КонецЕсли;
		
		СообщениеДляБота = СообщениеДляБота + СписокКоммитов;
	КонецЕсли;

	OPI_Telegram.ОтправитьТекстовоеСообщение(Токен, IDChat, СообщениеДляБота);
	OPI_Telegram.ОтправитьТекстовоеСообщение(Токен, IDChatUK, СообщениеДляБота);

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("НомерРелиза");
	Парсер.ДобавитьПараметр("ИмяБазы");
	Парсер.ДобавитьПараметр("СообщениеДляБота");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти