#Использовать mechel
#Использовать json
#Использовать cmdline

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()
	
	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");
	
	ПараметрыКоманднойСтроки = ПарсингПереданныхПараметров();

	Message = ПараметрыКоманднойСтроки["Message"];
	CHAT_ID = ПараметрыКоманднойСтроки["CHAT_ID"];
	THREAD_ID = ПараметрыКоманднойСтроки["THREAD_ID"];

	TOKEN = КонстантыРабот.telegram.token;
	Если THREAD_ID = "" Тогда
		OPI_Telegram.ОтправитьТекстовоеСообщение(TOKEN, CHAT_ID, Message);
	Иначе
		OPI_Telegram.ОтправитьТекстовоеСообщение(TOKEN, CHAT_ID + "*" + THREAD_ID, Message);
	КонецЕсли;

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("Message");
	Парсер.ДобавитьПараметр("CHAT_ID");
	Парсер.ДобавитьПараметр("THREAD_ID");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти