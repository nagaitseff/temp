#Использовать json
#Использовать v8runner
#Использовать asserts
#Использовать fs
#Использовать mechel
#Использовать cmdline

#Область ОписаниеПеременных

Перем КонстантыРабот; // константы значений переданные из файла JSON
Перем УправлениеКонфигуратором; // общая переменная для управления конфигуратором

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");

	ПереданныеПараметры = ПарсингПереданныхПараметров();
	Сервер = ПереданныеПараметры["Сервер"];
	ИмяБазы = ПереданныеПараметры["ИмяБазы"];
	Порт = ПереданныеПараметры["Порт"];
	НомерРелиза   = ПереданныеПараметры["НомерРелиза"];
	ИмяКаталогаСФайлом = ПереданныеПараметры["ИмяКаталогаСФайлом"];
	ИмяРасширения = ПереданныеПараметры["ИмяРасширения"];
	ВключитьОтладку = ПереданныеПараметры["ВключитьОтладку"];

	Если ВРег(ВключитьОтладку) = "TRUE" Тогда
		ВключитьОтладкуБулево = Истина;
	Иначе
		ВключитьОтладкуБулево = Ложь;
	КонецЕсли;

	ОбщийМодуль.ИспользоватьВыводОтладки(ВключитьОтладкуБулево);

	Если НЕ ЗначениеЗаполнено(Сервер) Тогда
		ВызватьИсключение "Не заполнен сервер базы данных";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяБазы) Тогда
		ВызватьИсключение "Не заполнено имя базы данных";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Порт) Тогда
		ВызватьИсключение "Не заполнен порт базы данных";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(НомерРелиза) Тогда
		ВызватьИсключение "Не заполнен номер релиза";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяКаталогаСФайлом) Тогда
		ВызватьИсключение "Не указано имя каталога с файлом расширения. 
		|(develop или номер релиза, например: 2.5.25.01)";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяРасширения) Тогда
		ВызватьИсключение "Не указано имя расширения для загрузки.";
	КонецЕсли;

	Если ИмяКаталогаСФайлом = "develop_5405" 
		ИЛИ ИмяКаталогаСФайлом = "develop" Тогда
		КаталогСФайлом = КонстантыРабот.artifacts.net_common + ИмяКаталогаСФайлом + "\";
	Иначе
		КаталогСФайлом = КонстантыРабот.artifacts.net_common + ИмяКаталогаСФайлом + "\" + НомерРелиза;
		СоздатьНужныйКаталог(КаталогСФайлом);
		КаталогСФайлом = КаталогСФайлом + "\";
	КонецЕсли;
	
	ФайлРасширения = Новый Файл(КаталогСФайлом + ИмяРасширения + ".cfe");
	Если ФайлРасширения.Существует() Тогда
		УправлениеКонфигуратором = Новый УправлениеКонфигуратором();
		ЗагрузитьФайлРасширения(Сервер, ИмяБазы, Порт, ИмяРасширения, КаталогСФайлом, ИмяКаталогаСФайлом);
	Иначе
		ВызватьИсключение "Нет файла расширения";
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьФайлРасширения(
	Знач Сервер, Знач ИмяБазы, Знач Порт, Знач ИмяРасширения, Знач КаталогСФайлом, Знач ИмяКаталогаСФайлом)

	ПараметрыСтрокиСоединения = УправлениеКонфигуратором.ПараметрыСтрокиСоединения();
	ПараметрыСтрокиСоединения.Сервер = Сервер;
	ПараметрыСтрокиСоединения.ИмяБазы = ИмяБазы;
	ПараметрыСтрокиСоединения.Порт = Порт;

	УправлениеКонфигуратором.УстановитьКонтекст(
		ПараметрыСтрокиСоединения, 
		КонстантыРабот.logpassERP.login, 
		КонстантыРабот.logpassERP.password);
	
	УправлениеКонфигуратором.ИспользоватьВерсиюПлатформы(
		КонстантыРабот.platform.version, 
		РазрядностьПлатформы.x64x86);

	УправлениеКонфигуратором.УстановитьКлючРазрешенияЗапуска(КонстантыРабот.UC);
	
	УправлениеКонфигуратором.ЗагрузитьРасширениеИзФайла(
		КаталогСФайлом + ИмяРасширения + ".cfe", 
		ИмяРасширения, 
		Истина);

	КаталогВременныхДанных = КонстантыРабот.temp.temp_files + ИмяКаталогаСФайлом;
	Если ФС.Существует(КаталогВременныхДанных) Тогда
		УдалитьФайлы(КаталогВременныхДанных, "*.txt");
	КонецЕсли;
	
	ТриМинуты = 1800;
	Приостановить(ТриМинуты);

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("Сервер");
	Парсер.ДобавитьПараметр("ИмяБазы");
	Парсер.ДобавитьПараметр("Порт");
	Парсер.ДобавитьПараметр("НомерРелиза");
	Парсер.ДобавитьПараметр("ИмяКаталогаСФайлом");
	Парсер.ДобавитьПараметр("ИмяРасширения");
	Парсер.ДобавитьПараметр("ВключитьОтладку");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

Процедура СоздатьНужныйКаталог(ИмяКаталога)

	КаталогСуществует = ФС.КаталогСуществует(ИмяКаталога);

	Если Не КаталогСуществует Тогда
		СоздатьКаталог(ИмяКаталога);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти