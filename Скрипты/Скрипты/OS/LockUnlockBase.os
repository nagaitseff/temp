#Использовать v8rac
#Использовать cmdline
#Использовать mechel

#Область ОписаниеПеременных

Перем КонстантыРабот; // константы значений переданные из файла JSON
Перем ПереданныеПараметры; // переданные переменные

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Инициализация()

	КонстантыРабот = ОбщийМодуль.ПредустановленныеПараметрыКонстант(".\\ConstantsForJobs.json");

	ПереданныеПараметры = ПарсингПереданныхПараметров();

	ИмяБазы                      = ПереданныеПараметры["ИмяБазы"];
	ИмяСервера                   = ПереданныеПараметры["ИмяСервера"];
	ИмяАдминистратораКластера    = ПереданныеПараметры["ИмяАдминистратораКластера"];
	КомандаУправленияБлокировкой = ПереданныеПараметры["КомандаУправленияБлокировкой"];
	СнятьБлокировкуРегЗаданий    = ПереданныеПараметры["СнятьБлокировкуРегЗаданий"];

	ЗаблокироватьСнятьБлокировкуБазыИРегламентныхЗаданий(
		ИмяБазы, 
		ИмяСервера, 
		ИмяАдминистратораКластера, 
		СнятьБлокировкуРегЗаданий, 
		КомандаУправленияБлокировкой);

КонецПроцедуры

Процедура ЗаблокироватьСнятьБлокировкуБазыИРегламентныхЗаданий(
	Знач ИмяБазы, 
	Знач ИмяСервера, 
	Знач ИмяАдминистратораКластера, 
	СнятьБлокировкуРегЗаданий = "",
	КомандаУправленияБлокировкой = "")
	
	Приостановить(12000);

	УправлениеКластером = Новый УправлениеКластером;
	УправлениеКластером.УстановитьКластер(ИмяСервера);
	УправлениеКластером.ИспользоватьВерсию(КонстантыРабот.platform.version);

	УправлениеКластером.УстановитьАвторизациюКластера(ИмяАдминистратораКластера, КонстантыРабот.racAdmin.pwd);

	УправлениеКластером.Подключить();

	ИдентификаторИнформационнойБазы = УправлениеКластером.НайтиИнформационнуюБазу(ИмяБазы);
	
	УправлениеКластером.УстановитьАвторизациюИнформационнойБазы(
		ИдентификаторИнформационнойБазы, 
		КонстантыРабот.logpassERP.login, 
		КонстантыРабот.logpassERP.password);

	Если КомандаУправленияБлокировкой = "unlock" Тогда
		Если СнятьБлокировкуРегЗаданий = "true" Тогда
			УправлениеКластером.СнятьБлокировкуИнформационнойБазы(ИдентификаторИнформационнойБазы, Ложь);
			Сообщить("База успешно разблокирована");
			Сообщить("Регламентные задания разблокированы");
		Иначе
			УправлениеКластером.СнятьБлокировкуИнформационнойБазы(ИдентификаторИнформационнойБазы, Истина);
			Сообщить("База успешно разблокирована");
			Сообщить("Регламентные задания остались заблокированы");
		КонецЕсли;
	Иначе
		ТриЧаса = 10800;
		УправлениеКластером.БлокировкаИнформационнойБазы(
			ИдентификаторИнформационнойБазы, 
			"База заблокирована, обновление.", 
			КонстантыРабот.UC,
			ТекущаяДата(),
			ТекущаяДата() + ТриЧаса,
			Истина);
		Приостановить(10000);
		УправлениеКластером.ОтключитьСеансыИнформационнойБазы(ИдентификаторИнформационнойБазы);
		УправлениеКластером.ОтключитьСоединенияИнформационнойБазы(ИдентификаторИнформационнойБазы);
		Сообщить("База успешно заблокирована.");
	КонецЕсли;

КонецПроцедуры

Функция ПарсингПереданныхПараметров()
	
	Парсер = Новый ПарсерАргументовКоманднойСтроки();
	Парсер.ДобавитьПараметр("ИмяБазы");
	Парсер.ДобавитьПараметр("ИмяСервера");
	Парсер.ДобавитьПараметр("ИмяАдминистратораКластера");
	Парсер.ДобавитьПараметр("КомандаУправленияБлокировкой");
	Парсер.ДобавитьПараметр("СнятьБлокировкуРегЗаданий");

	Возврат Парсер.Разобрать(АргументыКоманднойСтроки);
	
КонецФункции

#КонецОбласти

#Область Инициализация

Инициализация();

#КонецОбласти