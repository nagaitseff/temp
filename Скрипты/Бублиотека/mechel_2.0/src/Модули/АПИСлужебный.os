// ============================================================
// АПИСлужебный.os — служебные функции для работы с API и пайплайном
//
// Подключение в скрипте:
//   АПИСлужебный = ПодключитьСценарий("src\Модули\АПИСлужебный.os");
//
// Версия: 1.0.0
// Совместимость: oscript 2.1.0+
// ============================================================

// ------------------------------------------------------------
// Базовые помощники
// ------------------------------------------------------------

// Безопасное преобразование строки в число.
// Возвращает ПоУмолчанию, если строка не содержит число.
Функция ЧислоИзСтроки(Знач Значение, Знач ПоУмолчанию = 0) Экспорт
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
КонецФункции

// Безопасно получает значение поля из Структуры или Соответствия.
// Оба типа обрабатываются одинаково: сначала пытаемся Свойство (структуры),
// затем Получить (соответствия). При отсутствии поля возвращает ПоУмолчанию.
Функция ЗначениеПоляJSON(Источник, ИмяПоля, Знач ПоУмолчанию = Неопределено) Экспорт
	Если Источник = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	// Структура / ФиксированнаяСтруктура: метод Свойство
	ЕстьСвойство = Ложь;
	Попытка
		ЕстьСвойство = Источник.Свойство(ИмяПоля);
	Исключение
		ЕстьСвойство = Ложь;
	КонецПопытки;
	Если ЕстьСвойство = Истина Тогда
		Возврат Источник[ИмяПоля];
	КонецЕсли;

	// Соответствие / ФиксированноеСоответствие: метод Получить
	Попытка
		Значение = Источник.Получить(ИмяПоля);
		Если Значение <> Неопределено Тогда
			Возврат Значение;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат ПоУмолчанию;
КонецФункции

// ------------------------------------------------------------
// Даты ISO 8601
// ------------------------------------------------------------

// Форматирует дату в строку ISO 8601: "2024-01-15T10:30:00Z"
Функция ISOДата(Дата) Экспорт
	Если Дата = Неопределено ИЛИ Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "";
	КонецЕсли;

	СтрокаДаты = Формат(Дата, "ДФ=yyyy-MM-dd");
	СтрокаВремени = Формат(Дата, "ДФ=HH:mm:ss");
	Возврат СтрокаДаты + "T" + СтрокаВремени + "Z";
КонецФункции

// Разбирает дату ISO 8601: "2024-01-15T10:30:00", с "Z" или смещением "+03:00".
// Возвращает Неопределено, если строка не содержит корректную дату.
Функция ИзISOДаты(Знач СтрокаДаты) Экспорт
	Очищенная = СокрЛП(Строка(СтрокаДаты));
	Если ПустаяСтрока(Очищенная) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// отрезаем зону: "Z" в конце
	Если СтрЗаканчиваетсяНа(НРег(Очищенная), "z") Тогда
		Очищенная = Лев(Очищенная, СтрДлина(Очищенная) - 1);
	КонецЕсли;

	// отрезаем зону: смещение после "T" ("+03:00" / "-03:00")
	ПозицияT = СтрНайти(Очищенная, "T");
	Если ПозицияT > 0 Тогда
		Хвост = Сред(Очищенная, ПозицияT);
		ПозицияПлюс = СтрНайти(Хвост, "+");
		ПозицияМинус = СтрНайти(Хвост, "-");
		ПозицияЗоны = Макс(ПозицияПлюс, ПозицияМинус);
		Если ПозицияЗоны > 0 Тогда
			Очищенная = Лев(Очищенная, ПозицияT + ПозицияЗоны - 2);
		КонецЕсли;
	КонецЕсли;

	// собираем строку вида "20240115103000"
	Очищенная = СтрЗаменить(Очищенная, "-", "");
	Очищенная = СтрЗаменить(Очищенная, "T", "");
	Очищенная = СтрЗаменить(Очищенная, " ", "");
	Очищенная = СтрЗаменить(Очищенная, ":", "");
	Очищенная = СтрЗаменить(Очищенная, ".", "");
	Очищенная = Лев(Очищенная + "00000000000000", 14);

	Попытка
		Возврат Дата(Очищенная);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// ------------------------------------------------------------
// Код ответа API
// ------------------------------------------------------------

// Разбирает код ответа API. API возвращает код числом или строкой вида "00.00"/"01.12".
//   Основной       — целая часть (группа результата: 00 — успех, 01 и выше — ошибка)
//   Дополнительный — дробная часть (конкретная ошибка, например 12 — ошибка удаления сеанса)
//   Успех          — Истина, если Основной = 0
Функция РазобратьКодОтвета(Знач Код) Экспорт
	Результат = Новый Структура("Основной, Дополнительный, Успех", 0, 0, Ложь);

	Если Код = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Код) = Тип("Число") Тогда
		Результат.Основной = Цел(Код);
	Иначе
		СтрокаКода = СокрЛП(Строка(Код));
		Части = СтрРазделить(СтрокаКода, ".", Истина);
		Если Части.Количество() > 0 Тогда
			Результат.Основной = ЧислоИзСтроки(Части[0]);
		КонецЕсли;
		Если Части.Количество() > 1 Тогда
			Результат.Дополнительный = ЧислоИзСтроки(Части[1]);
		КонецЕсли;
	КонецЕсли;

	Результат.Успех = (Результат.Основной = 0);
	Возврат Результат;
КонецФункции

// Быстрая проверка: код ответа означает успех.
Функция УспешныйКод(Знач Код) Экспорт
	Возврат РазобратьКодОтвета(Код).Успех;
КонецФункции

// ------------------------------------------------------------
// Строка базы
// ------------------------------------------------------------

// Формирует строку базы в формате "Сервер:Порт|Имя".
// Пример: "UKM-SAPP123:8541|ERP_KGOK_RELEASE_DRAFT"
Функция СтрокаБазы(Сервер, Порт, ИмяБазы) Экспорт
	Возврат "" + Сервер + ":" + Порт + "|" + ИмяБазы;
КонецФункции

// Разбирает строку "Сервер:Порт|Имя" в структуру {Сервер, Порт, Имя}.
// Порт может отсутствовать — тогда в структуре остаётся 0.
Функция РазобратьСтрокуБазы(Знач Строка) Экспорт
	Результат = Новый Структура("Сервер, Порт, Имя", "", 0, "");

	Очищенная = СокрЛП(Строка(Строка));
	Если ПустаяСтрока(Очищенная) Тогда
		Возврат Результат;
	КонецЕсли;

	ПозицияРазделителя = СтрНайти(Очищенная, "|");
	Если ПозицияРазделителя = 0 Тогда
		Результат.Имя = Очищенная;
		Возврат Результат;
	КонецЕсли;

	Результат.Имя = Сред(Очищенная, ПозицияРазделителя + 1);
	Хост = Лев(Очищенная, ПозицияРазделителя - 1);

	ПозицияДвоеточия = СтрНайти(Хост, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Сервер = Лев(Хост, ПозицияДвоеточия - 1);
		Результат.Порт = ЧислоИзСтроки(Сред(Хост, ПозицияДвоеточия + 1));
	Иначе
		Результат.Сервер = Хост;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// ------------------------------------------------------------
// Точка входа
// ------------------------------------------------------------

// Разбирает точку входа вида "https://ukm-web/ad/IT/IT_TechAdmin/hs/"
// в структуру {Протокол, Сервер, Порт, Путь}.
// Путь возвращается БЕЗ завершающего слэша — клиент добавляет его при запросе.
Функция РазобратьТочкуВхода(Знач ТочкаВхода) Экспорт
	Результат = Новый Структура("Протокол, Сервер, Порт, Путь", "https", "", 443, "/");

	Очищенная = СокрЛП(Строка(ТочкаВхода));
	Если ПустаяСтрока(Очищенная) Тогда
		Возврат Результат;
	КонецЕсли;

	Остаток = Очищенная;

	// протокол
	ПозицияПротокола = СтрНайти(Остаток, "://");
	Если ПозицияПротокола > 0 Тогда
		Результат.Протокол = НРег(Лев(Остаток, ПозицияПротокола - 1));
		Остаток = Сред(Остаток, ПозицияПротокола + 3);
	КонецЕсли;
	Если Результат.Протокол = "http" Тогда
		Результат.Порт = 80;
	КонецЕсли;

	// хост[:порт] и путь
	ПозицияСлэша = СтрНайти(Остаток, "/");
	Если ПозицияСлэша = 0 Тогда
		Результат.Сервер = Остаток;
	Иначе
		Результат.Сервер = Лев(Остаток, ПозицияСлэша - 1);
		Результат.Путь = Сред(Остаток, ПозицияСлэша);
	КонецЕсли;

	// порт в хосте
	ПозицияДвоеточия = СтрНайти(Результат.Сервер, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Порт = ЧислоИзСтроки(Сред(Результат.Сервер, ПозицияДвоеточия + 1), Результат.Порт);
		Результат.Сервер = Лев(Результат.Сервер, ПозицияДвоеточия - 1);
	КонецЕсли;

	// нормализуем путь: без завершающего слэша, но со стартовым
	Если СтрЗаканчиваетсяНа(Результат.Путь, "/") Тогда
		Результат.Путь = Лев(Результат.Путь, СтрДлина(Результат.Путь) - 1);
	КонецЕсли;
	Если Не СтрНачинаетсяС(Результат.Путь, "/") Тогда
		Результат.Путь = "/" + Результат.Путь;
	КонецЕсли;
	Если Результат.Путь = "" Тогда
		Результат.Путь = "/";
	КонецЕсли;

	Возврат Результат;
КонецФункции

// ------------------------------------------------------------
// GET-параметры
// ------------------------------------------------------------

// Собирает строку GET-параметров из Структуры или Соответствия.
// Ключи и значения кодируются в URL. Возвращает "", если параметров нет.
// Пример: ?token=...&update_date=...
Функция СтрокаПараметровЗапроса(Параметры) Экспорт
	Если Параметры = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	Для Каждого Пара Из Параметры Цикл
		Ключ = КодироватьСтроку(Строка(Пара.Ключ), СпособКодированияСтроки.КодировкаURL);
		Значение = КодироватьСтроку(Строка(Пара.Значение), СпособКодированияСтроки.КодировкаURL);
		Части.Добавить(Ключ + "=" + Значение);
	КонецЦикла;

	Возврат СтрСоединить(Части, "&");
КонецФункции

// ------------------------------------------------------------
// Сеансы
// ------------------------------------------------------------

// Отбирает сеансы по критериям.
//   Критерии.Пользователь       — оставить сеансы, где имя пользователя содержит подстроку
//   Критерии.ИсключитьПользователя — убрать сеансы, где имя содержит подстроку
//   Критерии.Приложение         — оставить сеансы, где имя приложения содержит подстроку
// Пустой критерий не фильтрует. Имена полей берутся из полей сеанса:
// username (или Пользователь) и app (или Приложение).
Функция ОтфильтроватьСеансы(Сеансы, Критерии) Экспорт
	Результат = Новый Массив;
	Если Сеансы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ОтборПользователь = "";
	ОтборИсключить = "";
	ОтборПриложение = "";
	Если Критерии <> Неопределено Тогда
		ОтборПользователь = Строка(ЗначениеПоляJSON(Критерии, "Пользователь", ""));
		ОтборИсключить = Строка(ЗначениеПоляJSON(Критерии, "ИсключитьПользователя", ""));
		ОтборПриложение = Строка(ЗначениеПоляJSON(Критерии, "Приложение", ""));
	КонецЕсли;

	Для Каждого Сеанс Из Сеансы Цикл
		Пользователь = НРег(СокрЛП(Строка(ЗначениеПоляJSON(Сеанс, "username",
			ЗначениеПоляJSON(Сеанс, "Пользователь", "")))));
		Приложение = НРег(СокрЛП(Строка(ЗначениеПоляJSON(Сеанс, "app",
			ЗначениеПоляJSON(Сеанс, "Приложение", "")))));

		Если СтрДлина(ОтборПользователь) > 0
			И СтрНайти(Пользователь, НРег(ОтборПользователь)) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДлина(ОтборИсключить) > 0
			И СтрНайти(Пользователь, НРег(ОтборИсключить)) > 0 Тогда
			Продолжить;
		КонецЕсли;

		Если СтрДлина(ОтборПриложение) > 0
			И СтрНайти(Приложение, НРег(ОтборПриложение)) = 0 Тогда
			Продолжить;
		КонецЕсли;

		Результат.Добавить(Сеанс);
	КонецЦикла;

	Возврат Результат;
КонецФункции

// ------------------------------------------------------------
// Статус восстановления
// ------------------------------------------------------------

// Разбирает статус заявки восстановления из /status.
// Значения кода (по живому логу): 0 — в очереди, 1 — выполняется,
// 2 — выполнена успешно, -1 — ошибка.
// Возвращает структуру {Код, Завершено, Успех, Описание}.
Функция СтатусВосстановления(Знач Статус) Экспорт
	Код = ЧислоИзСтроки(Статус, 0);

	Результат = Новый Структура("Код, Завершено, Успех, Описание", Код, Ложь, Ложь, "");

	Если Код = 0 Тогда
		Результат.Описание = "Заявка в очереди";
	ИначеЕсли Код = 1 Тогда
		Результат.Описание = "Восстановление выполняется";
	ИначеЕсли Код = 2 Тогда
		Результат.Завершено = Истина;
		Результат.Успех = Истина;
		Результат.Описание = "Восстановление выполнено успешно";
	ИначеЕсли Код = -1 Тогда
		Результат.Завершено = Истина;
		Результат.Описание = "Ошибка восстановления";
	Иначе
		Результат.Описание = "Неизвестный статус: " + Код;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// ------------------------------------------------------------
// Комментарий заявки
// ------------------------------------------------------------

// Формирует комментарий заявки в формате пайплайна:
// "Jenkins: job=ИмяЗадания #2144 | Произвольное описание"
Функция КомментарийЗаявки(ИмяЗадания, НомерСборки, Знач Описание = "") Экспорт
	Комментарий = "Jenkins: job=" + ИмяЗадания + " #" + НомерСборки;
	Если Не ПустаяСтрока(Описание) Тогда
		Комментарий = Комментарий + " | " + Описание;
	КонецЕсли;
	Возврат Комментарий;
КонецФункции

// ------------------------------------------------------------
// Исключения
// ------------------------------------------------------------

// Извлекает понятный текст ошибки из ответа API или объекта исключения.
// Ищет поля detail / message / error / description (в этом порядке),
// для ИнформацияОбОшибке возвращает её Описание.
Функция ОписаниеОшибки(Данные) Экспорт
	Если Данные = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("ИнформацияОбОшибке") Тогда
		Возврат Данные.Описание;
	КонецЕсли;

	Имена = Новый Массив("detail", "message", "error", "description");
	Для Каждого Имя Из Имена Цикл
		Текст = ЗначениеПоляJSON(Данные, Имя, Неопределено);
		Если Текст <> Неопределено Тогда
			Возврат СокрЛП(Строка(Текст));
		КонецЕсли;
	КонецЦикла;

	Возврат "";
КонецФункции
