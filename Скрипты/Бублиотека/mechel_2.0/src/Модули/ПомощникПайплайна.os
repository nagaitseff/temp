// ============================================================
// ПомощникПайплайна.os — логика пайплайна обновления конфигураций
//
// Подключение в скрипте:
//   Пайплайн = ПодключитьСценарий("src\Модули\ПомощникПайплайна.os");
//
// Задачи модуля:
//   - разбор и валидация параметров пайплайна
//   - определение изменённых файлов между ветками Git
//   - решение, что накатывать: конфигурацию (src/cf) или расширение (src/cfe)
//   - формирование и контроль запуска клиента Предприятия
//
// Версия: 1.0.0
// Совместимость: oscript 2.1.0+, vanessa-runner 2.6
// ============================================================

// ------------------------------------------------------------
// Базовые помощники
// ------------------------------------------------------------

// Преобразует строковое значение в булево.
// Истину дают: "да", "true", "1", "yes", "on", "и" (без учёта регистра).
Функция ВБулево(Знач Значение) Экспорт
	Если Значение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат (Значение <> 0);
	КонецЕсли;

	Строка = НРег(СокрЛП(Строка(Значение)));
	Возврат (Строка = "да" ИЛИ Строка = "true" ИЛИ Строка = "1"
		ИЛИ Строка = "yes" ИЛИ Строка = "on" ИЛИ Строка = "и");
КонецФункции

// Возвращает значение переменной окружения или ПоУмолчанию.
Функция ПеременнаяСреды(Знач Имя, Знач ПоУмолчанию = "") Экспорт
	Значение = Неопределено;
	Попытка
		Значение = Константы.Получить(Имя);
	Исключение
		// в oscript констант нет — не страшно
	КонецПопытки;

	// oscript: доступ через КонтекстПеременных невозможен напрямую,
	// используем стандартный способ — объект "Окружение" недоступен,
	// поэтому дополнительно пробуем служебное хранилище.
	Если Значение <> Неопределено И Значение <> "" Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат ПоУмолчанию;
КонецФункции

// ------------------------------------------------------------
// Параметры пайплайна
// ------------------------------------------------------------

// Разбирает и валидирует параметры пайплайна.
//   ПараметрыЗапуска — Структура или Соответствие с ключами пайплайна
// Обязательные поля: База, ВеткаИсточник, ВеткаПриёмник, Пользователь.
// Необязательные (со значениями по умолчанию):
//   ТаймаутВосстановления = 7200 (сек, 2 часа)
//   ИнтервалОпроса        = 60   (сек)
//   ТочкаВхода            = "https://ukm-web/ad/IT/IT_TechAdmin/hs/"
//   Токен                 = ""
// Возвращает структуру {Успех, ОписаниеОшибки, Параметры}.
Функция ПарсингПараметров(ПараметрыЗапуска) Экспорт
	Результат = Новый Структура("Успех, ОписаниеОшибки, Параметры", Ложь, "", Новый Структура);

	Если ПараметрыЗапуска = Неопределено Тогда
		Результат.ОписаниеОшибки = "Параметры запуска не переданы";
		Возврат Результат;
	КонецЕсли;

	П = Результат.Параметры;

	// обязательные
	Обязательные = Новый Массив("База", "ВеткаИсточник", "ВеткаПриёмник", "Пользователь");
	Для Каждого Имя Из Обязательные Цикл
		Значение = ЗначениеПоля(ПараметрыЗапуска, Имя, "");
		Если ПустаяСтрока(СокрЛП(Строка(Значение))) Тогда
			Результат.ОписаниеОшибки = "Не задан обязательный параметр: " + Имя;
			Возврат Результат;
		КонецЕсли;
		П.Вставить(Имя, СокрЛП(Строка(Значение)));
	КонецЦикла;

	// необязательные — с умолчаниями
	П.Вставить("ТаймаутВосстановления", ЧислоИзСтрокиБезИсключений(ЗначениеПоля(ПараметрыЗапуска, "ТаймаутВосстановления", "7200"), 7200));
	П.Вставить("ИнтервалОпроса", ЧислоИзСтрокиБезИсключений(ЗначениеПоля(ПараметрыЗапуска, "ИнтервалОпроса", "60"), 60));
	П.Вставить("ТочкаВхода", Строка(ЗначениеПоля(ПараметрыЗапуска, "ТочкаВхода", "https://ukm-web/ad/IT/IT_TechAdmin/hs/")));
	П.Вставить("Токен", Строка(ЗначениеПоля(ПараметрыЗапуска, "Токен", "")));
	П.Вставить("Задание", Строка(ЗначениеПоля(ПараметрыЗапуска, "Задание", "")));
	П.Вставить("НомерСборки", Строка(ЗначениеПоля(ПараметрыЗапуска, "НомерСборки", "")));
	П.Вставить("ОписаниеЗаявки", Строка(ЗначениеПоля(ПараметрыЗапуска, "ОписаниеЗаявки", "")));
	П.Вставить("УбиватьСеансы", ВБулево(ЗначениеПоля(ПараметрыЗапуска, "УбиватьСеансы", "да")));
	П.Вставить("ПутьКРепозиторию", СокрЛП(Строка(ЗначениеПоля(ПараметрыЗапуска, "ПутьКРепозиторию", "."))));
	П.Вставить("ИмяКомпьютера", Строка(ЗначениеПоля(ПараметрыЗапуска, "ИмяКомпьютера", "")));
	П.Вставить("КаталогВыгрузки", СокрЛП(Строка(ЗначениеПоля(ПараметрыЗапуска, "КаталогВыгрузки", ""))));

	// консистентность
	Если П.ТаймаутВосстановления <= 0 Тогда
		Результат.ОписаниеОшибки = "ТаймаутВосстановления должен быть положительным числом";
		Возврат Результат;
	КонецЕсли;
	Если П.ИнтервалОпроса <= 0 Тогда
		Результат.ОписаниеОшибки = "ИнтервалОпроса должен быть положительным числом";
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Возврат Результат;
КонецФункции

// ------------------------------------------------------------
// Git
// ------------------------------------------------------------

// Возвращает путь к исполняемому файлу git.
// Сначала берёт из параметров, затем из переменной среды GIT_PATH,
// иначе просто "git" (рассчитан на PATH).
Функция ПутьКГит(Знач ЯвныйПуть = "") Экспорт
	Если Не ПустаяСтрока(СокрЛП(ЯвныйПуть)) Тогда
		Возврат ЯвныйПуть;
	КонецЕсли;

	ИзСреды = ПеременнаяСреды("GIT_PATH", "");
	Если Не ПустаяСтрока(СокрЛП(ИзСреды)) Тогда
		Возврат ИзСреды;
	КонецЕсли;

	Возврат "git";
КонецФункции

// Возвращает список файлов, изменённых между двумя ветками.
// Использует: git diff --name-only ВеткаПриёмник...ВеткаИсточник
// (три точки — изменения источника относительно общего предка).
// Возвращает Массив строк. При ошибке возвращает пустой массив
// и заполняет ОписаниеОшибки.
Функция ИзмененныеФайлыМеждуВетками(Знач ПутьКРепозиторию, Знач ВеткаИсточник, Знач ВеткаПриёмник, Знач ЯвныйПутьКГит = "") Экспорт
	Результат = Новый Массив;

	Гит = ПутьКГит(ЯвныйПутьКГит);
	Команда = Гит + " diff --name-only " + ВеткаПриёмник + "..." + ВеткаИсточник;

	Процесс = Новый Процесс;
	Процесс.КаталогРабочейДиректории = ПутьКРепозиторию;
	Процесс.ПоказыватьОкно = Ложь;

	Попытка
		Процесс.Запустить(Команда);
		Процесс.ЖдатьЗавершения(60000); // 60 секунд на diff
	Исключение
		// ничего не добавляем в результат — репозиторий недоступен или git не найден
		Возврат Результат;
	КонецПопытки;

	Если Процесс.КодВозврата <> 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Вывод = Процесс.ПолучитьВывод();
	Строки = СтрРазделить(Вывод, Символы.ПС, Ложь);
	Для Каждого Строка Из Строки Цикл
		Чистая = СокрЛП(Строка);
		Если Не ПустаяСтрока(Чистая) Тогда
			// приводим разделитель к единому виду "/"
			Чистая = СтрЗаменить(Чистая, "\", "/");
			Результат.Добавить(Чистая);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Определяет, что менять в базе по списку изменённых файлов.
// Логика (важен порядок проверок):
//   1. Сначала смотрим src/cfe — расширение.
//   2. Потом src/cf — конфигурация.
// Если проверять в обратном порядке, src/cfe попадёт в "конфигурацию"
// как ложное срабатывание.
// Возвращает структуру {Конфигурация, Расширение, ИзмененияКонфигурации, ИзмененияРасширения}.
Функция ОценитьФайлыИзменений(ИзмененныеФайлы) Экспорт
	Результат = Новый Структура("Конфигурация, Расширение, ИзмененияКонфигурации, ИзмененияРасширения",
		Ложь, Ложь, Новый Массив, Новый Массив);

	Если ИзмененныеФайлы = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Файл Из ИзмененныеФайлы Цикл
		Нормализованный = НРег(СокрЛП(Строка(Файл)));

		Если СтрНачинаетсяС(Нормализованный, "src/cfe") Тогда
			Результат.ИзмененияРасширения.Добавить(Файл);
		ИначеЕсли СтрНачинаетсяС(Нормализованный, "src/cf") Тогда
			Результат.ИзмененияКонфигурации.Добавить(Файл);
		КонецЕсли;
		// прочие каталоги (src/dt, src/config и прочее) не влияют на решение
	КонецЦикла;

	Результат.Конфигурация = (Результат.ИзмененияКонфигурации.Количество() > 0);
	Результат.Расширение   = (Результат.ИзмененияРасширения.Количество() > 0);

	Возврат Результат;
КонецФункции

// ------------------------------------------------------------
// Конфигуратор и Предприятие
// ------------------------------------------------------------

// Инициализирует каталог под конфигуратор: проверяет, что путь к 1С
// существует, создаёт каталог выгрузки при необходимости.
// Возвращает структуру {Успех, ОписаниеОшибки, ПутьК1С}.
Функция ИнициализироватьКонфигуратором(Параметры) Экспорт
	Результат = Новый Структура("Успех, ОписаниеОшибки, ПутьК1С", Ложь, "", "");

	ПутьК1С = СокрЛП(Строка(ЗначениеПоля(Параметры, "ПутьК1С", "")));
	Если ПустаяСтрока(ПутьК1С) Тогда
		ПутьК1С = ПеременнаяСреды("PATH_TO_1C", "");
	КонецЕсли;
	Если ПустаяСтрока(ПутьК1С) Тогда
		ПутьК1С = "C:\Program Files\1cv8";
	КонецЕсли;

	Если Не ФайлСуществует(ПутьК1С) Тогда
		Результат.ОписаниеОшибки = "Каталог 1С не найден: " + ПутьК1С;
		Возврат Результат;
	КонецЕсли;

	КаталогВыгрузки = СокрЛП(Строка(ЗначениеПоля(Параметры, "КаталогВыгрузки", "")));
	Если Не ПустаяСтрока(КаталогВыгрузки) Тогда
		Попытка
			СоздатьКаталог(КаталогВыгрузки);
		Исключение
			// каталог уже существует или недоступен — не критично,
			// конфигуратор сам сообщит, если не сможет писать
		КонецПопытки;
	КонецЕсли;

	Результат.ПутьК1С = ПутьК1С;
	Результат.Успех = Истина;
	Возврат Результат;
КонецФункции

// Формирует строку запуска клиента Предприятия с нужными ключами.
// Серверная база: /S Сервер:Порт\Имя, файловая: /F Путь.
// Возвращает Структуру {Успех, ОписаниеОшибки, СтрокаЗапуска}.
Функция СтрокаЗапускаПредприятия(Параметры) Экспорт
	Результат = Новый Структура("Успех, ОписаниеОшибки, СтрокаЗапуска", Ложь, "", "");

	ПутьК1С = СокрЛП(Строка(ЗначениеПоля(Параметры, "ПутьК1С", "")));
	Если ПустаяСтрока(ПутьК1С) Тогда
		ПутьК1С = ПеременнаяСреды("PATH_TO_1C", "");
	КонецЕсли;
	Если ПустаяСтрока(ПутьК1С) Тогда
		ПутьК1С = "C:\Program Files\1cv8";
	КонецЕсли;

	ПутьК1С = ПутьК1С + "\8.3.????\bin\1cv8.exe";
	// если структура каталогов другая — берём исполняемый файл напрямую
	Если Не ФайлСуществует(ПутьК1С) Тогда
		ПрямойПуть = ПутьК1С;
		Если Не ФайлСуществует(ПрямойПуть) Тогда
			Результат.ОписаниеОшибки = "Не найден исполняемый файл 1cv8.exe по пути: " + ПутьК1С;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	База = СокрЛП(Строка(ЗначениеПоля(Параметры, "База", "")));
	Сервер = СокрЛП(Строка(ЗначениеПоля(Параметры, "Сервер", "")));
	Порт = ЧислоИзСтрокиБезИсключений(ЗначениеПоля(Параметры, "Порт", "0"), 0);

	Если Не ПустаяСтрока(Сервер) Тогда
		СтрокаБазы = Сервер;
		Если Порт > 0 Тогда
			СтрокаБазы = СтрокаБазы + ":" + Порт;
		КонецЕсли;
		СтрокаБазы = СтрокаБазы + "\" + База;
		КлючБазы = "/S """ + СтрокаБазы + """";
	Иначе
		КлючБазы = "/F """ + База + """";
	КонецЕсли;

	Пользователь = СокрЛП(Строка(ЗначениеПоля(Параметры, "Пользователь", "")));
	Пароль       = Строка(ЗначениеПоля(Параметры, "Пароль", ""));

	СтрокаЗапуска = """" + ПутьК1С + """ enterprise " + КлючБазы;
	Если Не ПустаяСтрока(Пользователь) Тогда
		СтрокаЗапуска = СтрокаЗапуска + " /N """ + Пользователь + """";
	КонецЕсли;
	Если Не ПустаяСтрока(Пароль) Тогда
		СтрокаЗапуска = СтрокаЗапуска + " /P """ + Пароль + """";
	КонецЕсли;

	Результат.СтрокаЗапуска = СтрокаЗапуска;
	Результат.Успех = Истина;
	Возврат Результат;
КонецФункции

// Запускает клиент Предприятия и проверяет, что процесс стартовал
// и не завершился сразу с ошибкой.
// Таймаут ожидания в секундах (по умолчанию 120).
// Возвращает структуру {Успех, ОписаниеОшибки, КодВозврата}.
Функция ЗапуститьПредприятиеСПроверкой(Знач СтрокаЗапуска, Знач ТаймаутСекунд = 120) Экспорт
	Результат = Новый Структура("Успех, ОписаниеОшибки, КодВозврата", Ложь, "", -1);

	Если ПустаяСтрока(СокрЛП(СтрокаЗапуска)) Тогда
		Результат.ОписаниеОшибки = "Строка запуска пуста";
		Возврат Результат;
	КонецЕсли;

	Процесс = Новый Процесс;
	Процесс.ПоказыватьОкно = Ложь;

	Попытка
		Процесс.Запустить(СтрокаЗапуска);
	Исключение
		Результат.ОписаниеОшибки = "Не удалось запустить процесс: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	ТаймаутМс = ТаймаутСекунд * 1000;
	Процесс.ЖдатьЗавершения(ТаймаутМс);

	Если Не Процесс.Завершён Тогда
		// процесс жив дольше таймаута — считаем это успехом:
		// Предприятие работает, ошибки запуска нет
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	КодВозврата = Процесс.КодВозврата;
	Результат.КодВозврата = КодВозврата;

	Если КодВозврата = 0 Тогда
		Результат.Успех = Истина;
	Иначе
		Результат.ОписаниеОшибки = "Предприятие завершилось с кодом " + КодВозврата;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Псевдонимы для совместимости с ПомощникПайплайна.os
Функция ЗначениеПоля(Источник, ИмяПоля, Знач ПоУмолчанию = Неопределено) Экспорт
	Возврат ЗначениеПоляJSON(Источник, ИмяПоля, ПоУмолчанию);
КонецФункции

Функция ЧислоИзСтрокиБезИсключений(Знач Значение, Знач ПоУмолчанию = 0) Экспорт
	Возврат ЧислоИзСтроки(Значение, ПоУмолчанию);
КонецФункции
