// ============================================================
// ТестыБиблиотеки.os — проверки библиотеки Mechel
//
// Запуск с корня каталога Mechel:
//   oscript tests\ТестыБиблиотеки.os
//
// Покрывают ТОЛЬКО чистую логику (парсеры, формирование строк,
// статусы, фильтры). Транспорт и запуск процессов сетью не тестируются —
// они проверяются на ноде против живого API.
//
// Живые значения взяты из лога пайплайна:
//   строка базы      — UKM-SAPP123:8541|ERP_KGOK_RELEASE_DRAFT
//   комментарий      — "Jenkins: job=... #2144 | ..."
//   коды ответов     — "00.00", "01.12" (12 — таймаут удаления сеанса)
//   статусы заявок   — 0 (очередь), 1 (выполняется), 2 (готово), -1 (ошибка)
//   таймаут/интервал — 7200 сек / 60 сек
// ============================================================

Перем Пройдено;
Перем Упало;

Пройдено = 0;
Упало = 0;

Утилиты = ПодключитьСценарий("..\\src\\Модули\\АПИСлужебный.os");
Пайплайн = ПодключитьСценарий("..\\src\\Модули\\ПомощникПайплайна.os");

// ------------------------------------------------------------
// Помощник тестов
// ------------------------------------------------------------

Процедура Проверить(Знач Условие, Знач ИмяТеста)
	Если Условие = Истина Тогда
		Пройдено = Пройдено + 1;
	Иначе
		Упало = Упало + 1;
		Сообщить("ПРОВАЛ: " + ИмяТеста);
	КонецЕсли;
КонецПроцедуры

// ------------------------------------------------------------
// АПИСлужебный: базовые помощники
// ------------------------------------------------------------

// ЧислоИзСтроки
Проверить(Утилиты.ЧислоИзСтроки("123") = 123, "ЧислоИзСтроки_число");
Проверить(Утилиты.ЧислоИзСтроки("abc") = 0, "ЧислоИзСтроки_нечисло");
Проверить(Утилиты.ЧислоИзСтроки("abc", 5) = 5, "ЧислоИзСтроки_умолчание");

// ЗначениеПоляJSON: и Структура, и Соответствие (тот самый баг со Свойством)
Поля = Новый Структура("Имя, Код", "ERP", "00.00");
Проверить(Утилиты.ЗначениеПоляJSON(Поля, "Имя", "") = "ERP", "ЗначениеПоляJSON_структура");
Проверить(Утилиты.ЗначениеПоляJSON(Поля, "Нет", "умолчание") = "умолчание", "ЗначениеПоляJSON_структура_нет_поля");

Соотв = Новый Соответствие;
Соотв.Вставить("detail", "сеанс не найден");
Проверить(Утилиты.ЗначениеПоляJSON(Соотв, "detail", "") = "сеанс не найден", "ЗначениеПоляJSON_соответствие");
Проверить(Утилиты.ЗначениеПоляJSON(Соотв, "message", "нет") = "нет", "ЗначениеПоляJSON_соответствие_нет");
Проверить(Утилиты.ЗначениеПоляJSON(Неопределено, "x", 7) = 7, "ЗначениеПоляJSON_нуль");

// Псевдонимы, на которые опирается ПомощникПайплайна
Проверить(Утилиты.ЗначениеПоля(Поля, "Код", "") = "00.00", "Псевдоним_ЗначениеПоля");
Проверить(Утилиты.ЧислоИзСтрокиБезИсключений("60", 0) = 60, "Псевдоним_ЧислоИзСтроки");

// ------------------------------------------------------------
// Даты
// ------------------------------------------------------------

// ISOДата: формируем дату в 1С-формате и проверяем вывод
ДатаТест = Дата(20240115103000);
Проверить(Утилиты.ISOДата(ДатаТест) = "2024-01-15T10:30:00Z", "ISOДата_формат");

// ИзISOДаты: три вида записи из лога/ответов API
Проверить(Утилиты.ИзISOДаты("2024-01-15T10:30:00") = ДатаТест, "ИзISOДаты_без_зоны");
Проверить(Утилиты.ИзISOДаты("2024-01-15T10:30:00Z") = ДатаТест, "ИзISOДаты_Z");
Проверить(Утилиты.ИзISOДаты("2024-01-15T10:30:00+03:00") = ДатаТест, "ИзISOДаты_смещение");
Проверить(Утилиты.ИзISOДаты("") = Неопределено, "ИзISOДаты_пустая");
Проверить(Утилиты.ИзISOДаты("мусор") = Неопределено, "ИзISOДаты_мусор");

// ------------------------------------------------------------
// Код ответа API
// ------------------------------------------------------------

Разбор = Утилиты.РазобратьКодОтвета(0);
Проверить(Разбор.Успех, "КодОтвета_ноль_успех");
Проверить(Разбор.Основной = 0 И Разбор.Дополнительный = 0, "КодОтвета_ноль_части");

Разбор = Утилиты.РазобратьКодОтвета("00.00");
Проверить(Разбор.Успех, "КодОтвета_строка_успех");

Разбор = Утилиты.РазобратьКодОтвета("01.12");
Проверить(Не Разбор.Успех, "КодОтвета_01_12_неуспех");
Проверить(Разбор.Основной = 1 И Разбор.Дополнительный = 12, "КодОтвета_01_12_части");

Разбор = Утилиты.РазобратьКодОтвета("00.12");
Проверить(Разбор.Успех И Разбор.Дополнительный = 12, "КодОтвета_00_12_таймаут_удаления");

Проверить(Утилиты.УспешныйКод("00.00") И Не Утилиты.УспешныйКод("01.03"), "УспешныйКод");

// ------------------------------------------------------------
// Строка базы — живое значение из лога
// ------------------------------------------------------------

Проверить(Утилиты.СтрокаБазы("UKM-SAPP123", 8541, "ERP_KGOK_RELEASE_DRAFT")
	= "UKM-SAPP123:8541|ERP_KGOK_RELEASE_DRAFT", "СтрокаБазы_живое_значение");

Разбор = Утилиты.РазобратьСтрокуБазы("UKM-SAPP123:8541|ERP_KGOK_RELEASE_DRAFT");
Проверить(Разбор.Сервер = "UKM-SAPP123" И Разбор.Порт = 8541
	И Разбор.Имя = "ERP_KGOK_RELEASE_DRAFT", "РазобратьСтрокуБазы_полная");

Разбор = Утилиты.РазобратьСтрокуБазы("UKM-SAPP123|ERP_TEST");
Проверить(Разбор.Сервер = "UKM-SAPP123" И Разбор.Порт = 0 И Разбор.Имя = "ERP_TEST",
	"РазобратьСтрокуБазы_без_порта");

Разбор = Утилиты.РазобратьСтрокуБазы("ERP_TEST");
Проверить(Разбор.Имя = "ERP_TEST" И Разбор.Сервер = "", "РазобратьСтрокуБазы_только_имя");

// ------------------------------------------------------------
// Точка входа
// ------------------------------------------------------------

Разбор = Утилиты.РазобратьТочкуВхода("https://ukm-web/ad/IT/IT_TechAdmin/hs/");
Проверить(Разбор.Протокол = "https" И Разбор.Сервер = "ukm-web"
	И Разбор.Путь = "/ad/IT/IT_TechAdmin/hs", "ТочкаВхода_полная");
Проверить(Не СтрЗаканчиваетсяНа(Разбор.Путь, "/"), "ТочкаВхода_без_хвостового_слэша");

Разбор = Утилиты.РазобратьТочкуВхода("http://localhost:8541/hs/");
Проверить(Разбор.Сервер = "localhost" И Разбор.Порт = 8541 И Разбор.Протокол = "http",
	"ТочкаВхода_порт_в_URL");

Разбор = Утилиты.РазобратьТочкуВхода("");
Проверить(Разбор.Протокол = "https" И Разбор.Порт = 443, "ТочкаВхода_пустая_умолчания");

// ------------------------------------------------------------
// GET-параметры
// ------------------------------------------------------------

Проверить(Утилиты.СтрокаПараметровЗапроса(Неопределено) = "", "GET_параметры_нуль");
Проверить(Утилиты.СтрокаПараметровЗапроса(Новый Структура) = "", "GET_параметры_пустые");

ПараметрыGET = Новый Структура("base", "ERP TEST");
СтрокаGET = Утилиты.СтрокаПараметровЗапроса(ПараметрыGET);
Проверить(СтрокаGET = "base=ERP%20TEST", "GET_параметры_кодирование_пробела");

// ------------------------------------------------------------
// Сеансы: фильтр
// ------------------------------------------------------------

Сеанс1 = Новый Структура("username, app", "Иванов", "1CV8");
Сеанс2 = Новый Структура("username, app", "Петров", "COMConnector");
Сеанс3 = Новый Структура("username, app", "jenkins_agent", "1CV8");
Сеансы = Новый Массив(Сеанс1, Сеанс2, Сеанс3);

Критерии = Новый Структура("Пользователь, ИсключитьПользователя, Приложение", "Иванов", "", "");
Проверить(Утилиты.ОтфильтроватьСеансы(Сеансы, Критерии).Количество() = 1, "Сеансы_отбор_пользователь");

Критерии = Новый Структура("Пользователь, ИсключитьПользователя, Приложение", "", "", "COMConnector");
Проверить(Утилиты.ОтфильтроватьСеансы(Сеансы, Критерии).Количество() = 1, "Сеансы_отбор_приложение");

Критерии = Новый Структура("Пользователь, ИсключитьПользователя, Приложение", "", "Иванов", "");
Проверить(Утилиты.ОтфильтроватьСеансы(Сеансы, Критерии).Количество() = 2, "Сеансы_исключение_пользователя");

Критерии = Новый Структура("Пользователь, ИсключитьПользователя, Приложение", "", "", "");
Проверить(Утилиты.ОтфильтроватьСеансы(Сеансы, Критерии).Количество() = 3, "Сеансы_пустые_критерии");
Проверить(Утилиты.ОтфильтроватьСеансы(Сеансы, Неопределено).Количество() = 3, "Сеансы_критерии_нуль");
Проверить(Утилиты.ОтфильтроватьСеансы(Неопределено, Неопределено).Количество() = 0, "Сеансы_список_нуль");

// ------------------------------------------------------------
// Статус восстановления
// ------------------------------------------------------------

Разбор = Утилиты.СтатусВосстановления(0);
Проверить(Не Разбор.Завершено И Не Разбор.Успех, "СтатусВосстановления_очередь");

Разбор = Утилиты.СтатусВосстановления(1);
Проверить(Не Разбор.Завершено, "СтатусВосстановления_выполняется");

Разбор = Утилиты.СтатусВосстановления(2);
Проверить(Разбор.Завершено И Разбор.Успех, "СтатусВосстановления_готово");

Разбор = Утилиты.СтатусВосстановления(-1);
Проверить(Разбор.Завершено И Не Разбор.Успех, "СтатусВосстановления_ошибка");

// ------------------------------------------------------------
// Комментарий заявки — живой формат из лога
// ------------------------------------------------------------

Проверить(Утилиты.КомментарийЗаявки("FirstMaintence", 2144, "Восстановление базы")
	= "Jenkins: job=FirstMaintence #2144 | Восстановление базы", "КомментарийЗаявки_полный");
Проверить(Утилиты.КомментарийЗаявки("FirstMaintence", 2144)
	= "Jenkins: job=FirstMaintence #2144", "КомментарийЗаявки_без_описания");

// ------------------------------------------------------------
// Описания ошибок
// ------------------------------------------------------------

Проверить(Утилиты.ОписаниеОшибки(Новый Структура("detail", "файл архива не найден"))
	= "файл архива не найден", "ОписаниеОшибки_detail");

БезDetail = Новый Структура("message", "нет доступа");
Проверить(Утилиты.ОписаниеОшибки(БезDetail) = "нет доступа", "ОписаниеОшибки_message");
Проверить(Утилиты.ОписаниеОшибки(Новый Структура) = "", "ОписаниеОшибки_пустая_структура");
Проверить(Утилиты.ОписаниеОшибки(Неопределено) = "", "ОписаниеОшибки_нуль");

// ------------------------------------------------------------
// ПомощникПайплайна
// ------------------------------------------------------------

// ВБулево
Проверить(Пайплайн.ВБулево("да") И Пайплайн.ВБулево("true") И Пайплайн.ВБулево("1")
	И Пайплайн.ВБулево("yes"), "ВБулево_истина");
Проверить(Не Пайплайн.ВБулево("нет") И Не Пайплайн.ВБулево("0") И Не Пайплайн.ВБулево(""), "ВБулево_ложь");
Проверить(Пайплайн.ВБулево(Истина) И Не Пайплайн.ВБулево(0), "ВБулево_типы");

// ПарсингПараметров: валидные параметры и умолчания
ПараметрыПайплайна = Новый Структура("База, ВеткаИсточник, ВеткаПриёмник, Пользователь",
	"ERP_KGOK_RELEASE_DRAFT", "release/next", "release/current", "jenkins");
Разбор = Пайплайн.ПарсингПараметров(ПараметрыПайплайна);
Проверить(Разбор.Успех, "ПарсингПараметров_валидные");
Проверить(Разбор.Параметры.ТаймаутВосстановления = 7200, "ПарсингПараметров_таймаут_умолчание");
Проверить(Разбор.Параметры.ИнтервалОпроса = 60, "ПарсингПараметров_интервал_умолчание");
Проверить(Разбор.Параметры.ТочкаВхода = "https://ukm-web/ad/IT/IT_TechAdmin/hs/",
	"ПарсингПараметров_точка_входа_умолчание");

// ПарсингПараметров: не хватает обязательного
ПараметрыПайплайна.Удалить("База");
// Структура.Удалить недоступна — собираем заново без Базы
ПараметрыПайплайна = Новый Структура("ВеткаИсточник, ВеткаПриёмник, Пользователь",
	"release/next", "release/current", "jenkins");
Разбор = Пайплайн.ПарсингПараметров(ПараметрыПайплайна);
Проверить(Не Разбор.Успех И СтрНайти(Разбор.ОписаниеОшибки, "База") > 0, "ПарсингПараметров_нет_базы");
Проверить(Пайплайн.ПарсингПараметров(Неопределено).Успех = Ложь, "ПарсингПараметров_нуль");

// ОценитьФайлыИзменений: порядок проверки src/cfe ДО src/cf
Файлы = Новый Массив("src/cfe/Расширение1/Подсистемы/Продажи.xml");
Разбор = Пайплайн.ОценитьФайлыИзменений(Файлы);
Проверить(Разбор.Расширение И Не Разбор.Конфигурация, "ОценкаФайлов_только_расширение");

Файлы = Новый Массив("src/cf/Documents/ЗаказДокументы.xml");
Разбор = Пайплайн.ОценитьФайлыИзменений(Файлы);
Проверить(Разбор.Конфигурация И Не Разбор.Расширение, "ОценкаФайлов_только_конфигурация");

Файлы = Новый Массив("src/cfe/Ext/Module.bsl", "src/cf/Documents/Заказ.xml",
	"docs/README.md");
Разбор = Пайплайн.ОценитьФайлыИзменений(Файлы);
Проверить(Разбор.Конфигурация И Разбор.Расширение
	И Разбор.ИзмененияКонфигурации.Количество() = 1
	И Разбор.ИзмененияРасширения.Количество() = 1, "ОценкаФайлов_оба_типа");

// главный кейс: файл расширения не должен «утечь» в конфигурацию
Файлы = Новый Массив("src/cfe/Обработки/ЗагрузкаДанных/Forms/Форма/Ext/Form.xml");
Разбор = Пайплайн.ОценитьФайлыИзменений(Файлы);
Проверить(Разбор.Расширение И Не Разбор.Конфигурация, "ОценкаФайлов_cfe_не_утекает_в_cf");

// прочие каталоги не влияют
Разбор = Пайплайн.ОценитьФайлыИзменений(Новый Массив("docs/guide.md", "src/dt/backup.dt"));
Проверить(Не Разбор.Конфигурация И Не Разбор.Расширение, "ОценкаФайлов_прочие_каталоги");
Разбор = Пайплайн.ОценитьФайлыИзменений(Неопределено);
Проверить(Не Разбор.Конфигурация И Не Разбор.Расширение, "ОценкаФайлов_нуль");

// ------------------------------------------------------------
// Итог
// ------------------------------------------------------------

Сообщить("---- Итоги ----");
Сообщить("Пройдено: " + Пройдено);
Сообщить("Упало: " + Упало);

Если Упало > 0 Тогда
	ЗавершитьСРаботой(1);
Иначе
	ЗавершитьСРаботой(0);
КонецЕсли;
