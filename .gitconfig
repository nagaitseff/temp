[user]
    name = Нагайцев Евгений Петрович
    email = NagaytsevEP@uk.mechel.com

# ==============================================================
# CORE — базовые настройки Git и производительность
# ==============================================================
[core]
    # Не эскейпить кириллицу и пробелы в путях (git status показывает "как есть")
    quotePath = false
    # Разрешить пути >260 символов на Windows (актуально для разобранной 1С-конфигурации)
    longpaths = true
    # Предупреждать при неоднозначной конвертации CRLF, но не блокировать коммит
    safecrlf = false
    # Не трогать переносы строк автоматически — управляем через .gitattributes в репе
    autocrlf = false
    # Редактор для commit-сообщений, интерактивного rebase, merge-сообщений
    editor = code --wait
    # ---- Ускорение для больших репозиториев (1С:ERP) ----
    # Фоновый демон, следит за изменениями ФС через ReadDirectoryChangesW на Windows
    fsmonitor = true
    # Кэш списка untracked-файлов по директориям
    untrackedCache = true
    # Читать заранее посчитанный граф коммитов (быстрый git log --graph, git merge-base)
    commitGraph = true

# Зонтичная опция: index v4 + untrackedCache + оптимизации под 100k+ файлов
[feature]
    manyFiles = true

# ==============================================================
# ОБСЛУЖИВАНИЕ РЕПОЗИТОРИЯ
# ==============================================================
[gc]
    # Пересобирать commit-graph при каждом git gc
    writeCommitGraph = true
    # Порог свободных объектов, при котором gc запускается автоматически
    auto = 0
    autoDetach = true

[maintenance]
    # Репозитории, обслуживаемые через `git maintenance start`
    repo = C:/REP/erp

# ==============================================================
# СЕТЕВЫЕ ОПЕРАЦИИ
# ==============================================================
[fetch]
    # Удалять локальные remote-tracking ветки, которых больше нет на сервере
    prune = true
    # Проверять целостность объектов при fetch (защита от битых pack-файлов)
    fsckObjects = true
    # Пересобирать commit-graph после fetch
    writeCommitGraph = true
    # Параллельный fetch по всем remote (0 = по числу ядер CPU)
    parallel = 0

[receive]
    fsckObjects = true

[pack]
    # 0 = использовать все ядра CPU для упаковки
    threads = 0
    # Больше памяти на окно delta — сильнее сжатие XML/BSL при push/gc
    windowMemory = 1024m

[http]
    # Буфер для больших push (500 МБ; 1 ГБ был избыточен)
    postBuffer = 524288000

# ==============================================================
# БЕЗОПАСНОСТЬ
# ==============================================================
[safe]
    # Явные пути вместо '*' — не снимает CVE-2022-24765-защиту глобально
    directory = C:/REP/erp
    directory = C:/REP/*

# ==============================================================
# КОДИРОВКИ (важно для 1С — UTF-8 везде)
# ==============================================================
[i18n]
    filesEncoding = utf-8
    commitEncoding = utf-8

# ==============================================================
# GUI (встроенный git gui — оставлено на всякий случай)
# ==============================================================
[gui]
    pruneduringfetch = true
    encoding = UTF-8
    diffopts = --ignore-space-at-eol --color-words

# ==============================================================
# LFS
# ==============================================================
[lfs]
    locksverify = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# ==============================================================
# PULL / REBASE / PUSH
# ==============================================================
[pull]
    # false = merge при pull (сохраняет merge-коммиты, если этого требует политика команды)
    rebase = true

[rebase]
    # Автостеш перед rebase, восстановление после — экономит "stash push/pop" вручную
    autoStash = true
    # Использовать fixup!/squash! коммиты для авто-переупорядочивания
    autosquash = true
    # Не обновлять ссылки веток, зависящих от ребейзимой (безопаснее в командной работе)
    updateRefs = false

[push]
    # Если есть субмодули — проверять, что они запушены. Если нет — можно поставить "no"
    recurseSubmodules = no
    # При первом push автоматически создавать upstream, не требуя -u
    autoSetupRemote = true

# ==============================================================
# COMMIT / TAG / GPG
# ==============================================================
[commit]
    gpgSign = false

[tag]
    forceSignAnnotated = false
    # Теги-версии по убыванию (v2.5.10 > v2.5.9)
    sort = -version:refname

[branch]
    # Ветки в git branch по дате последнего коммита (свежие сверху)
    sort = -committerdate

[gpg]
    format = openpgp
    program = gpg

# ==============================================================
# DIFF / MERGE
# ==============================================================
[diff]
    tool = bc
    guitool = bc
    # Гистограммный алгоритм — качественнее на XML и BSL
    algorithm = histogram
    # Подсвечивать перемещённые блоки кода отдельным цветом
    colorMoved = zebra
    # Игнорировать изменение отступов при поиске перемещений
    colorMovedWS = allow-indentation-change
    # Префиксы i/ w/ c/ вместо a/ b/ — понятнее что откуда (index/working/commit)
    mnemonicPrefix = true
    # Обнаруживать переименования и копирования
    renames = copies
    submodule = log

[merge]
    tool = bc
    guitool = bc
    # Стратегия ort — быстрее и точнее старого recursive
    strategy = ort
    # zdiff3 показывает базовую версию в конфликте — критично для XML 1С
    conflictstyle = zdiff3
    summary = true

[log]
    date = iso
    # git log <file> проходит через переименования файла
    follow = true

[blame]
    # Подсвечивать недавние правки ярче
    coloring = highlightRecent
    date = short
    # Помечать строки, которые blame не может атрибутировать
    markUnblamables = true
    # Помечать строки, пропущенные через .git-blame-ignore-revs
    markIgnoredLines = true

# rerere — запоминает разрешённые конфликты и повторно применяет их автоматически
# Огромная экономия времени на релизных мержах 1С
[rerere]
    enabled = false
    autoupdate = false

# ==============================================================
# MERGETOOL / DIFFTOOL — внешние утилиты
# ==============================================================
[mergetool]
    keepTemporaries = false
    keepBackup = false
    prompt = false

[difftool]
    prompt = false

# Beyond Compare — основной инструмент для BSL
[mergetool "bc"]
    cmd = \"C:/Program Files/Beyond Compare/BComp.exe\" \"$LOCAL\" \"$REMOTE\" \"$BASE\" \"$MERGED\"
    trustExitCode = true
    path = C:/Program Files/Beyond Compare/BComp.exe

[difftool "bc"]
    cmd = \"C:/Program Files/Beyond Compare/BComp.exe\" \"$LOCAL\" \"$REMOTE\"
    path = C:/Program Files/Beyond Compare/BComp.exe

# P4Merge — для XML 1С (лучше показывает 3-way)
[mergetool "p4merge"]
    cmd = 'C:/Program Files/Perforce/P4Merge.exe' $BASE $LOCAL $REMOTE $MERGED
    trustExitCode = false
    path = C:/Program Files/Perforce/P4Merge.exe

[difftool "p4merge"]
    cmd = 'C:/Program Files/Perforce/P4Merge.exe' $LOCAL $REMOTE
    path = C:/Program Files/Perforce/P4Merge.exe

# KDiff3 — резервный трёхсторонний merge
[mergetool "kdiff3"]
    cmd = \"C:/Program Files/KDiff3/bin/kdiff3.exe\" -L1Base -L2Local -L3Remote \"$BASE\" \"$LOCAL\" \"$REMOTE\" -o \"$MERGED\"
    trustExitCode = true

[difftool "kdiff3"]
    cmd = \"C:/Program Files/KDiff3/bin/kdiff3.exe\" \"$LOCAL\" \"$REMOTE\"

# WinMerge — на случай если понадобится
[difftool "winmerge"]
    cmd = 'C:/Program Files/WinMerge/WinMergeU.exe' -e -u \"$LOCAL\" \"$REMOTE\"

[mergetool "winmerge"]
    cmd = 'C:/Program Files/WinMerge/WinMergeU.exe' -e -u -dl \"Local\" -dr \"Remote\" \"$MERGED\" \"$LOCAL\" \"$REMOTE\"
    trustExitCode = false

# TortoiseGit — на случай если понадобится
[difftool "tortoisegit"]
    cmd = \"C:/Program Files/TortoiseGit/bin/TortoiseGitDiff.exe\" \"$LOCAL\" \"$REMOTE\"

[mergetool "tortoisegit"]
    cmd = \"C:/Program Files/TortoiseGit/bin/TortoiseGitMerge.exe\" -base:\"$BASE\" -mine:\"$LOCAL\" -theirs:\"$REMOTE\" -merged:\"$MERGED\"

# ==============================================================
# ПРОЧИЕ НАСТРОЙКИ ИНТЕРФЕЙСА
# ==============================================================
[column]
    # Многоколоночный вывод для git branch, git tag
    ui = auto

[help]
    # При опечатке в команде — спросить, что имелось в виду
    autocorrect = prompt

[color]
    ui = auto

[sequence]
    # Редактор для интерактивного rebase (последовательность коммитов)
    editor = code --wait

# ==============================================================
# CREDENTIALS
# ==============================================================
[credential]
    helper = manager

[credential "http://ukm-sapp115"]
    provider = generic

# ==============================================================
# АЛИАСЫ
# ==============================================================
[alias]
    # ---------- ЛОГ И ИСТОРИЯ ----------
    # Красивый граф всех веток с относительными датами и автором
    lg = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all

    # Поиск коммитов, в которых менялась указанная строка кода (pickaxe -S)
    blame-who = "!f() { git log -S\"$1\" --all --oneline --graph; }; f"

    # Поиск коммитов по подстроке в сообщении, регистронезависимо, по всем веткам
    search = "!f() { git log --all -i --grep=\"$1\"; }; f"

    # Показать changed-файлы построчно (--raw), без merge-коммитов. Замена git whatchanged
    changes = log --raw --no-merges

    # ---------- ПОИСК ФИЧ И ФИКСОВ ПО ИМЕНАМ ВЕТОК ----------
    # Ищет мерж-коммиты feature/<name> в develop и release_draft
    fd-feature = "!f() { git log develop release_draft --pretty=format:'%C(yellow)%h%Creset - %C(cyan)%an%Creset (%Cgreen%ai%Creset) : %s' --date-order --grep=\"feature/$1\"; }; f"
    # То же самое по всем веткам
    fd-feature-all = "!f() { git log --all --pretty=format:'%C(yellow)%h%Creset - %C(cyan)%an%Creset (%Cgreen%ai%Creset) : %s' --date-order --grep=\"feature/$1\"; }; f"
    # Только в release_draft
    fd-feature-draft = "!f() { git log release_draft --pretty=format:'%C(yellow)%h%Creset - %C(cyan)%an%Creset (%Cgreen%ai%Creset) : %s' --date-order --grep=\"feature/$1\"; }; f"

    # То же для веток fix/<name>
    fd-fix = "!f() { git log develop release_draft --pretty=format:'%C(yellow)%h%Creset - %C(cyan)%an%Creset (%Cgreen%ai%Creset) : %s' --date-order --grep=\"fix/$1\"; }; f"
    fd-fix-all = "!f() { git log --all --pretty=format:'%C(yellow)%h%Creset - %C(cyan)%an%Creset (%Cgreen%ai%Creset) : %s' --date-order --grep=\"fix/$1\"; }; f"

    # ---------- БЭКАПЫ И ВОССТАНОВЛЕНИЕ ----------
    # Бэкап-ветка с датой из имени текущей ветки (слэши заменены на _)
    backup = "!f() { TICKET=$(git rev-parse --abbrev-ref HEAD | sed -e 's|/|_|g'); git branch \"backup-${TICKET}-$(date +'%Y%m%d_%H%M')\" && echo \"Создана backup-ветка для ${TICKET}\"; }; f"
    # Альтернативный вариант: backup/<branch>_<timestamp>
    backup2 = "!f(){ git branch \"backup/$(git rev-parse --abbrev-ref HEAD)_$(date +%Y%m%d_%H%M%S)\"; }; f"

    # Откатить текущую ветку hard-reset к самой свежей backup/*
    restore-last-backup = "!f(){ b=$(git for-each-ref --format='%(refname:short) %(committerdate:unix)' refs/heads/backup/ | sort -k2nr | head -1 | cut -d' ' -f1); if [ -z \"$b\" ]; then echo 'Нет backup/*'; exit 1; fi; echo \"Reset to $b\"; git reset --hard \"$b\"; }; f"

    # ---------- ОСНОВНЫЕ КОМАНДЫ ----------
    # Краткий status с информацией о ветке и upstream
    st = status -sb
    # Показать имя текущей ветки одной строкой
    current-branch = !git rev-parse --abbrev-ref HEAD
    # Переключение веток (короче чем switch)
    sw = switch
    # Switch с автостешем — не ругается на грязное дерево
    swa = switch --autostash

    # ---------- КОММИТЫ ----------
    # Откатить последний коммит, оставив изменения в staged
    uncommit = reset --soft HEAD~1
    # Amend без открытия редактора (просто добавить staged в предыдущий коммит)
    amend = commit --amend --no-edit

    # ---------- PUSH / PULL ----------
    # Безопасный force push — не затрёт чужие коммиты
    pf = push --force-with-lease
    # Ещё более безопасный force — проверяет и что мы видели все входящие коммиты
    pf-safe = push --force-with-lease --force-if-includes
    # Pull rebase с прогрессом, максимальный параллелизм
    up = !git -c fetch.parallel=0 -c submodule.fetchJobs=0 pull --rebase --progress origin
    # Показать, что придёт с remote (не применяя)
    incoming = !git fetch && git log --oneline HEAD..@{u}
    # Показать, что у нас есть локально, чего нет на remote
    outgoing = log --oneline @{u}..HEAD
    # Показать статус + список своих неотправленных коммитов
    ahead = !git status && echo '--- Коммиты для отправки (@{u}..HEAD): ---' && git log --oneline --graph @{u}..HEAD
    # Убрать локальные refs удалённых веток на remote
    prune-remote = !git remote prune origin

    # ---------- ОЧИСТКА ----------
    # Полный откат рабочего дерева с подтверждением (защита от случайности)
    discard = "!f() { echo 'Вы уверены, что хотите УДАЛИТЬ ВСЕ незакоммиченные изменения (y/n)?'; read answer; if [ \"$answer\" = 'y' ]; then git reset --hard HEAD && git clean -fd; fi; }; f"
    # Жёсткая очистка ВСЕГО, включая игнорируемые файлы. Осторожно!
    clean-all = !git clean -ffdx
    # Удалить локальные ветки, полностью влитые в develop
    clean-merged = !git switch develop && git pull && git branch --merged | grep -vE '(^\\*|master|main|develop)' | xargs -r git branch -d

    # ---------- CHERRY-PICK ----------
    # Cherry-pick без коммита с ort+histogram (лучше для 1С)
    cp-p = cherry-pick -n -x --strategy=ort -X diff-algorithm=histogram
    # То же самое для мерж-коммитов (со стороной -m 1)
    cp-pm = cherry-pick -n -x -m 1 --strategy=ort -X diff-algorithm=histogram
    # Показать staged-изменения (что сейчас в индексе после cherry-pick -n)
    cp-ch = !git --no-pager diff --staged

    # ---------- MERGE ----------
    # Merge с явным коммитом (без fast-forward), без автокоммита — можно посмотреть перед фиксацией
    merge-p = merge --no-ff --no-commit
    # То же самое с ort+histogram
    mer = merge --no-ff --no-commit --strategy=ort -X diff-algorithm=histogram

    # ---------- REBASE ----------
    rc = rebase --continue
    ra = rebase --abort
    rbi = rebase --interactive
    rbia = rebase --interactive --autosquash
    # Интерактивный rebase последних N коммитов: git edrebase 5
    edrebase = "!f() { git rebase -i HEAD~$1; }; f"

    # ---------- STASH ----------
    ss = stash push
    sp = stash pop
    sl = stash list

    # ---------- КОНФЛИКТЫ ----------
    # Список файлов с конфликтами
    conflicts = diff --name-only --diff-filter=U
    # Счётчик конфликтных файлов
    hmc = !git diff --name-only --diff-filter=U | wc -l
    conflict-count = !git diff --name-only --diff-filter=U | wc -l
    cho = !git checkout --ours --

    # Массово принять "наши" в bsl-файлах
    take-ours-bsl = !git diff --name-only --diff-filter=U | grep '\\.bsl$' | xargs -r git checkout --ours --
    # Массово принять "чужие" в xml-файлах
    take-theirs-xml = !git diff --name-only --diff-filter=U | grep '\\.xml$' | xargs -r git checkout --theirs --

    # Разрешить конфликты в бинарных файлах: взять theirs и сразу add
    add-bin = "!f() { git diff --name-only --diff-filter=U | grep '\\.bin$' | xargs -I {} sh -c 'git restore --theirs -- \"{}\" && git add -- \"{}\"'; }; f"
    add-html = "!f() { git diff --name-only --diff-filter=U | grep '\\.html$' | xargs -I {} sh -c 'git restore --theirs -- \"{}\" && git add -- \"{}\"'; }; f"

    # ---------- DIFF / MERGE TOOLS ПО ТИПАМ ФАЙЛОВ ----------
    # Diff/merge только для XML через p4merge (лучше для 1С-выгрузки)
    diffxml = difftool -y -t p4merge -- '*.xml'
    mergexml = mergetool -y -t p4merge -- '*.xml'
    # Diff/merge только для BSL через Beyond Compare
    diffbsl = difftool -y -t bc -- '*.bsl'
    mergebsl = mergetool -y -t bc -- '*.bsl'

    # ---------- УМНЫЕ ДИФФЫ ----------
    # Одна команда: без аргумента — обычный diff; a..b — diff двух ревизий; файл — diff файла
    smartdiff = "!f() { if [ -z \"$1\" ]; then git diff; else case \"$1\" in *..*) git diff \"$1\" ;; *) git diff -- \"$1\" ;; esac; fi; }; f"
    # Diff файла между двумя ветками
    file-diff = "!f() { git diff \"$1\" \"$2\" -- \"$3\"; }; f"
    # Diff с обнаружением переименований и копирований, гистограммный алгоритм
    vdiff = "!f(){ git diff --binary -M20% -C --find-renames --diff-algorithm=histogram \"$1\" \"$2\"; }; f"

    # ---------- BLAME ----------
    # Blame файла с фильтрацией по подстроке (git blame-line <file> <pattern>)
    blame-line = "!f() { git blame \"$1\" | grep -n \"$2\"; }; f"

    # ---------- ТЕГИ ----------
    # Последние 10 тегов по описанию (для навигации по релизам)
    recent-tags = !git describe --tags --abbrev=0 $(git rev-list --tags --max-count=10)

    # ---------- ПАТЧИ ----------
    # Создать патч из последнего коммита
    create-patch = !git format-patch -1 HEAD
    # Применить mailbox-патч с 3-way merge
    apply-patch = !git am --3way

    # ---------- ИНФО ----------
    # Размер репозитория и число объектов (H = человекочитаемо)
    repo-size = !git count-objects -vH
    # Показать только свои коммиты по всем веткам
    my = !git log --author=\"$(git config user.name)\" --oneline --graph --all

    # ---------- ВНЕШНИЕ ИНСТРУМЕНТЫ ----------
    # Инкрементальный merge для сложных случаев (https://github.com/mhagger/git-imerge)
    im = !C:/VSCode/git-imerge.bat
    # Прогнать pre-commit правила OneScript по staged-файлам
    ostaged = !C:/OneScript_2/bin/precommit4onec.bat exec-rules ./ -staged-only
    # Сгенерировать CHANGELOG.md через git-cliff
    changelog = cliff --config cliff.toml --output CHANGELOG.md
    # Статистика вкладов через git-quick-stats
    quick-stats = ! /c/rep/erp/git-quick-stats/git-quick-stats
[http "https://github.com"]
	proxy = http://NagaytsevEP:mechel!Ps3419,LiD*@proxy.gslb.int.mechel.corp:9090
[credential "http://proxy.gslb.int.mechel.corp:9090"]
	provider = generic
